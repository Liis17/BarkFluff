# BarkFluff Web Proxy — зеркало веб-клиента, доступное из РФ
#
# Скопировать в .env рядом с docker-compose.yml: compose читает отсюда
# переменные интерполяции (${...}), а web-контейнер берёт остальное через env_file.

# Docker-образ веб-клиента — тот же, что крутится на ноде.
# Для этой ветки nightly используется суффикс -nightly. Для stable замени на:
# docker.barkfluff.com/barkfluff-web:latest
WEB_IMAGE=docker.barkfluff.com/barkfluff-web-nightly:latest

# Публичный адрес Web-шлюза ТВОЕЙ ноды за Cloudflare (режим Node, не шелл
# web.barkfluff.com — шелл не проксирует gRPC-сервисы!). Например https://gw.example.com.
WEB_PROXY_TARGET=https://gw.barkfluff.com

# Файловые хосты ноды для media-relay, через запятую. /media/{host}/... релеит
# только эти хосты (остальные получают 403 — Web не open proxy). Scheme по
# умолчанию https; для стенда без TLS запись можно указать как http://host.
WEB_PROXY_MEDIA_HOSTS=files.barkfluff.com,files2.barkfluff.com

ASPNETCORE_ENVIRONMENT=Production
