# === Общие настройки ===
# Окружение, общее для backend-сервисов
ASPNETCORE_ENVIRONMENT=Production

# === settings ===
# Порт сервиса Settings
SETTINGS_PORT=7003

# === cloud-messaging ===
# Firebase Admin SDK
FIREBASE_PROJECT_ID=project_id
FIREBASE_PRIVATE_KEY_ID=key_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=email
FIREBASE_CLIENT_ID=client_id

# === web ===
# Firebase Web Push / browser push
WEB_PUSH_FIREBASE_API_KEY=api_key
WEB_PUSH_FIREBASE_AUTH_DOMAIN=domain
WEB_PUSH_FIREBASE_PROJECT_ID=project_id
WEB_PUSH_FIREBASE_STORAGE_BUCKET=bucket
WEB_PUSH_FIREBASE_MESSAGING_SENDER_ID=sender_id
WEB_PUSH_FIREBASE_APP_ID=app_id
WEB_PUSH_VAPID_KEY=vapid_key

# === admin-panel ===
# Telegram-бот авторизации
TELEGRAM_BOT_TOKEN=///
TELEGRAM_ADMINS=000:admin1,001:admin2
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# === admin-panel -> seq ===
SEQ_API_KEY=///

# === admin-panel -> users ===
USERS_SERVICE_HOST=http://users:7001
USERS_SERVICE_TOKEN=///

# === admin-panel -> files ===
FILES_SERVICE_HOST=http://files:7005
FILES_SERVICE_TOKEN=///

# === admin-panel -> identity ===
IDENTITY_SERVICE_HOST=http://identity:7000
IDENTITY_SERVICE_TOKEN=///

# === admin-panel -> bots ===
BOTS_SERVICE_HOST=http://bots:7027
BOTS_SERVICE_TOKEN=///

# === admin-panel -> mail ===
# Почтовые ящики и SMTP/IMAP
MAIL_SMTP_HOST=mail.domain.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=SslOnConnect
MAIL_SMTP_SECURITY=Auto
MAIL_IMAP_HOST=mail.domain.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=SslOnConnect
MAIL_ACCEPT_INVALID_CERTIFICATES=true
MAIL_SUPPORT_PASSWORD=///
MAIL_HELP_PASSWORD=///
MAIL_NOREPLY_PASSWORD=///
MAIL_PRIVACY_PASSWORD=///
MAIL_SECURITY_PASSWORD=///

# === seq ===
SEQ_ADMIN_PASSWORD=password
SEQ_WEBPORT=8880

# === rabbitmq (also settings) ===
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=///

# === postgres (also settings) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=///
POSTGRES_DB=postgres
POSTGRES_PORT=5432



































