#хостнейм 
HOSTNAME=CHARLIEHOSTNAME
NODE_ID=CHARLIENODE_ID

#публичный адрес CONFIGURATION для других сервисов
CONFIGURATION_SERVICE_URL=http://domain:port

#production режим
ASPNETCORE_ENVIRONMENT=Production

#данные для пользователя minio
MINIO_ROOT_USER=user
MINIO_ROOT_PASSWORD=password

#данные для пользователя rabbitmq
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

#данные для postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

#данные чтобы CONFIGURATION мог подключиться к базе
CONFIGURATION_HOST=domain:port
CONFIGURATION_DATABASE=configuration
CONFIGURATION_USERNAME=user
CONFIGURATION_PASSWORD=password

#порты сервисов
BEACON_PORT=7002 #3
CONFIGURATION_PORT=7003 
FILES_PORT=7005 #5
FILES_HTTP1PORT=7006 #5
FASTAUTH_PORT=7008 #7
IDENTITY_PORT=7000 #1
MESSAGES_PORT=7007 #6
NOTIFICATION_PORT=7004 #4
USERS_PORT=7001 #2
UPDATES_PORT=7015 #8
MINIO_PORT=9000
MINIO_WEBPORT=9001
RABBITMQ_1PORT=5672
RABBITMQ_2PORT=15672
REDIS_PORT=6379
POSTGRES_PORT=5432
ONLINER_PORT=7009 #9
WEB_PORT=7016 #11
DEVELOPERS_PORT=7020 #12

#данные для Seq (агрегатор логов)
SEQ_ADMIN_PASSWORD=password
SEQ_WEBPORT=8880
SEQ_API_KEY=

#данные для Admin Panel (Telegram-бот авторизации)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ADMINS=your_telegram_user_id:your_username
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

#токены сервисов для Admin Panel (должны совпадать с токенами в конфигурации)
USERS_SERVICE_TOKEN=your-users-service-token
FILES_SERVICE_TOKEN=your-files-service-token
IDENTITY_SERVICE_TOKEN=your-identity-service-token
CONFIGURATION_SERVICE_TOKEN=your-configuration-service-token
BOTS_SERVICE_TOKEN=your-bots-service-token

#хосты сервисов для Admin Panel
USERS_SERVICE_HOST=http://users:7001
FILES_SERVICE_HOST=http://files:7005
IDENTITY_SERVICE_HOST=http://identity:7000
CONFIGURATION_SERVICE_HOST=http://configuration:7010
BOTS_SERVICE_HOST=http://bots:7027

#данные для Mail (страница "Почта" в Admin Panel)
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=imap.example.com
MAIL_IMAP_PORT=993
#SslOnConnect | StartTls | StartTlsWhenAvailable | None | Auto
MAIL_IMAP_SECURITY=SslOnConnect
MAIL_SMTP_SECURITY=Auto
#установить true если сертификат сервера самоподписанный/невалидный
MAIL_ACCEPT_INVALID_CERTIFICATES=false
MAIL_SUPPORT_PASSWORD=
MAIL_HELP_PASSWORD=
MAIL_NOREPLY_PASSWORD=
MAIL_PRIVACY_PASSWORD=
MAIL_SECURITY_PASSWORD=

#данные Firebase для push-уведомлений (из firebase-adminsdk JSON)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
