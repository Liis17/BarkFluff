<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="files\favicon.ico" />
    <None Remove="files\install.ps1" />
    <None Remove="html\legal\account-deletion.html" />
    <None Remove="html\legal\ACCOUNT_DELETION.md" />
    <None Remove="html\legal\encryption.html" />
    <None Remove="html\legal\ENCRYPTION.md" />
    <None Remove="html\legal\legal.html" />
    <None Remove="html\legal\privacy-policy.html" />
    <None Remove="html\legal\PRIVACY_POLICY.md" />
    <None Remove="html\legal\terms-of-service.html" />
    <None Remove="html\legal\TERMS_OF_SERVICE.md" />
    <None Remove="html\selfhosted.html" />
    <None Remove="html\userpage.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="files\favicon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="files\install.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\barkfluff.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\account-deletion.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\ACCOUNT_DELETION.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\encryption.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\ENCRYPTION.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\legal.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\privacy-policy.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\PRIVACY_POLICY.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\terms-of-service.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\legal\TERMS_OF_SERVICE.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\selfhosted.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="html\userpage.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Telegram.Bot" Version="22.8.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Shared\BarkFluff.Proto\users_api.proto" GrpcServices="Client" />
    <Protobuf Include="..\Shared\BarkFluff.Proto\shared.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
