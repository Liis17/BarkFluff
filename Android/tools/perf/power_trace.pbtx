# Длительность задаёт capture_power.py перед запуском Perfetto.
duration_ms: {{DURATION_MS}}
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 10000

# Основной буфер для ftrace и atrace.
buffers {
  size_kb: 32768
  fill_policy: RING_BUFFER
}

# Отдельный небольшой буфер для питания и статистики процессов.
buffers {
  size_kb: 2048
  fill_policy: RING_BUFFER
}

buffers {
  size_kb: 2048
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "android.power"
    target_buffer: 1
    android_power_config {
      collect_power_rails: true
      battery_poll_ms: 1000
      battery_counters: BATTERY_COUNTER_CHARGE
      battery_counters: BATTERY_COUNTER_CAPACITY_PERCENT
      battery_counters: BATTERY_COUNTER_CURRENT
      battery_counters: BATTERY_COUNTER_CURRENT_AVG
      battery_counters: BATTERY_COUNTER_VOLTAGE
    }
  }
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/suspend_resume"
      atrace_categories: "am"
      atrace_categories: "wm"
      atrace_categories: "view"
      atrace_apps: "com.barkfluff.nightly"
    }
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 2
    process_stats_config {
      proc_stats_poll_ms: 5000
      scan_all_processes_on_start: true
    }
  }
}

data_sources {
  config {
    name: "android.network_packets"
    target_buffer: 0
  }
}
