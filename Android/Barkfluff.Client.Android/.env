# GitHub Secrets для релизной сборки Android
# Создай эти секреты в Settings → Secrets and variables → Actions

# Keystore файл в формате base64
# Получить: base64 -w 0 barkfluff-release.jks
RELEASE_KEYSTORE_BASE64=

# Пароль от keystore
RELEASE_STORE_PASSWORD=

# Alias ключа (указывался при создании keystore)
RELEASE_KEY_ALIAS=

# Пароль от ключа
RELEASE_KEY_PASSWORD=
