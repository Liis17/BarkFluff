        <activity
            android:name=".WidgetsSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BarkfluffClientAndroid"
            android:screenOrientation="portrait" />

        <!-- Получатель системного «Поделиться» (ACTION_SEND / ACTION_SEND_MULTIPLE).
             launchMode=singleTop + документная таска: при свёрнутом приложении система
             всегда создаёт свежий экземпляр activity и доставляет intent на него
             (без singleTask, который ломает доставку intent в фоне). -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.BarkfluffClientAndroid"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:documentLaunchMode="intoExisting"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.BarkfluffClientAndroid"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.PinnedChatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_pinned_chats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.barkfluff.client.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pinned_chats_widget_info" />
        </receiver>

        <receiver
            android:name=".notifications.MarkAsReadReceiver"
            android:exported="false" />

        <receiver
            android:name=".calls.CallActionReceiver"
            android:exported="false" />

        <!-- Telecom self-managed call integration -->
        <service
            android:name=".calls.BarkFluffConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>


        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".notifications.BarkFluffFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Foreground service for active calls -->
        <service
            android:name=".calls.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|mediaProjection|phoneCall" />
        <!-- Foreground service for outgoing media (compress/upload/send queue) -->
        <service
            android:name=".send.MediaSendService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider for sharing camera images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
