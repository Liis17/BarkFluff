<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_background"
    android:fitsSystemWindows="true">

    <!-- Декоративные окружности — позади контента, чисто визуальный слой -->
    <View
        android:id="@+id/decorCircleTopEnd"
        android:layout_width="@dimen/welcome_decor_circle_large"
        android:layout_height="@dimen/welcome_decor_circle_large"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_circle_welcome_primary"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/decorCircleBottomStart"
        android:layout_width="@dimen/welcome_decor_circle_small"
        android:layout_height="@dimen/welcome_decor_circle_small"
        android:layout_marginTop="120dp"
        android:layout_marginStart="-80dp"
        android:background="@drawable/bg_circle_welcome_secondary"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <!-- Logo — плоское изображение без рамки/подложки, тень вместо обводки -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoCard"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="26dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/shape_corner_extra_large_increased"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Hero-заголовок: M3 Expressive Emphasized typography (увеличенный вес).
                 Guidelines §12: «Display + Headline — отличные кандидаты для Emphasized». -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/welcome_title"
                android:textAppearance="@style/TextAppearance.Material3.DisplayMedium.Emphasized"
                android:textColor="@color/onboarding_title_text" />

            <!-- Подзаголовок -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="start"
                android:text="@string/welcome_description"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/onboarding_subtitle_text" />

            <!-- Чипы-фичи -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/featureChipsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFast"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/feature_chip_height"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/welcome_chip_fast"
                    android:textColor="@color/onboarding_chip_text"
                    app:chipBackgroundColor="@color/onboarding_chip_background"
                    app:chipCornerRadius="@dimen/shape_corner_full"
                    app:chipIcon="@drawable/ic_bolt"
                    app:chipIconTint="@color/onboarding_chip_text"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPrivate"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/feature_chip_height"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/welcome_chip_private"
                    android:textColor="@color/onboarding_chip_text"
                    app:chipBackgroundColor="@color/onboarding_chip_background"
                    app:chipCornerRadius="@dimen/shape_corner_full"
                    app:chipIcon="@drawable/ic_lock"
                    app:chipIconTint="@color/onboarding_chip_text"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOwnPack"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/feature_chip_height"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/welcome_chip_own_pack"
                    android:textColor="@color/onboarding_chip_text"
                    app:chipBackgroundColor="@color/onboarding_chip_background"
                    app:chipCornerRadius="@dimen/shape_corner_full"
                    app:chipIcon="@drawable/ic_pets"
                    app:chipIconTint="@color/onboarding_chip_text"
                    app:chipStrokeWidth="0dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Основная кнопка — M3 Expressive pill (64dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_start"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/white"
                app:backgroundTint="@color/onboarding_button_background"
                app:cornerRadius="@dimen/shape_corner_full"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="12dp"
                app:iconTint="@color/white" />

            <!-- Вторичная кнопка — text button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/learnMoreButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_default"
                android:layout_marginBottom="32dp"
                android:text="@string/btn_learn_more"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/onboarding_button_background" />

            <!-- Футер с ссылками -->
            <LinearLayout
                android:id="@+id/footerPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/aboutLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_about"
                    android:textAllCaps="false"
                    android:textColor="@color/onboarding_button_background" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@color/onboarding_home_indicator" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacyLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_privacy"
                    android:textAllCaps="false"
                    android:textColor="@color/onboarding_button_background" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@color/onboarding_home_indicator" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/helpLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_help"
                    android:textAllCaps="false"
                    android:textColor="@color/onboarding_button_background" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
