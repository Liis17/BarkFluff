<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="80dp"
            android:paddingBottom="32dp">

            <!-- Logo с увеличенным радиусом — M3 Expressive extra-extra-large (48dp) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoCard"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/shape_corner_extra_extra_large"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:padding="28dp"
                    android:src="@mipmap/ic_launcher" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Hero-заголовок: M3 Expressive Emphasized typography (увеличенный вес).
                 Guidelines §12: «Display + Headline — отличные кандидаты для Emphasized». -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.DisplayMedium.Emphasized"
                android:textColor="?attr/colorOnSurface" />

            <!-- Подзаголовок — также Emphasized для бренд-консистентности -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/welcome_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
                android:textColor="?attr/colorPrimary" />

            <!-- Описание -->
            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:text="@string/welcome_description"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Основная кнопка — M3 Expressive pill (64dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_start"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:cornerRadius="@dimen/shape_corner_full"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textEnd"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnPrimary" />

            <!-- Вторичная кнопка — Tonal, 56dp pill -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/learnMoreButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_default"
                android:layout_marginBottom="48dp"
                android:text="@string/btn_learn_more"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                app:cornerRadius="@dimen/shape_corner_full" />

            <!-- Футер с ссылками -->
            <LinearLayout
                android:id="@+id/footerPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/aboutLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_about"
                    android:textAllCaps="false" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="?attr/colorOutline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacyLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_privacy"
                    android:textAllCaps="false" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="?attr/colorOutline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/helpLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_help"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
