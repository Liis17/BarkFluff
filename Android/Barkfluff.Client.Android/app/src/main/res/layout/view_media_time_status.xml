<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mediaTimeStatusLayout"
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:layout_gravity="bottom|end"
    android:layout_margin="4dp"
    android:background="@drawable/bg_media_time_status"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/mediaTimeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@android:color/white" />

    <ImageView
        android:id="@+id/mediaReadStatusImageView"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/cd_read_status"
        android:visibility="gone"
        android:tint="@android:color/white" />

</LinearLayout>
