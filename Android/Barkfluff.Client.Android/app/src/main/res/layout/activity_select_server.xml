<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/infoPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Заголовок с Emphasized типографикой -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/server_title"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textColor="@color/onboarding_title_text" />

            <!-- Подзаголовок -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="@string/server_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/onboarding_subtitle_text" />

            <!-- Секция публичных серверов -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/server_public"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/onboarding_button_background" />

            <!-- Список серверов -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/serverListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Индикатор загрузки -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/onboarding_button_background" />

            <!-- Разделитель -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp" />

            <!-- Секция своего сервера — dashed row (статичная, без expand/collapse) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dashed_outline_row"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_link"
                    app:tint="@color/onboarding_button_background" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_custom_row_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/onboarding_title_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_custom_row_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/onboarding_subtitle_text" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/onboarding_button_background" />

            </LinearLayout>

            <!-- Поле ввода адреса — M3 medium corner (12dp) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/serverAddressInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="beacon.servername.com:443"
                app:boxCornerRadiusBottomEnd="@dimen/shape_corner_medium"
                app:boxCornerRadiusBottomStart="@dimen/shape_corner_medium"
                app:boxCornerRadiusTopEnd="@dimen/shape_corner_medium"
                app:boxCornerRadiusTopStart="@dimen/shape_corner_medium"
                app:boxStrokeColor="@color/onboarding_dashed_border"
                app:hintTextColor="@color/onboarding_button_background"
                app:startIconDrawable="@drawable/ic_location"
                app:startIconTint="@color/onboarding_button_background">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/serverAddressEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="@color/onboarding_title_text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Кнопка подключения — M3 Expressive pill -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_default"
                android:layout_marginBottom="24dp"
                android:text="@string/btn_connect"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/white"
                app:backgroundTint="@color/onboarding_button_background"
                app:cornerRadius="@dimen/shape_corner_full"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="12dp"
                app:iconTint="@color/white" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Нижняя информационная панель -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Текст о проблемах подключения -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/server_help_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/onboarding_subtitle_text" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
