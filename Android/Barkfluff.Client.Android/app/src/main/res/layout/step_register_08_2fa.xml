<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_step8_headline"
            android:textAppearance="@style/TextAppearance.Barkfluff.Register.Headline" />

        <!-- Баннер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_register_field_row"
            android:backgroundTint="?attr/colorPrimary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_security"
                app:tint="?attr/colorPrimaryContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/register_2fa_protects"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnPrimary" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="7dp"
            android:text="@string/register_2fa_authenticator_code"
            android:textAppearance="@style/TextAppearance.Barkfluff.Register.FieldLabel" />

        <TextView
            android:id="@+id/twoFaSecretCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_register_field_row"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="16dp"
            tools:text="ABCD EFGH IJKL MNOP"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyCodeButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/register_2fa_copy_code"
                android:textAllCaps="false"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_copy_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openAuthenticatorButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="@string/register_2fa_open_google_authenticator"
                android:textAllCaps="false"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_two_factor" />

        </LinearLayout>

        <!-- TOTP -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otpCodeInputLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="@string/hint_otp_six_digits"
            app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:boxCornerRadiusBottomEnd="@dimen/register_field_radius"
            app:boxCornerRadiusBottomStart="@dimen/register_field_radius"
            app:boxCornerRadiusTopEnd="@dimen/register_field_radius"
            app:boxCornerRadiusTopStart="@dimen/register_field_radius"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otpCodeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/otpErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip2faButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/register_skip_step"
            android:textAllCaps="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
