<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_settings_background"
    android:fitsSystemWindows="true">

    <!-- ══════════════════════════════════════════════
         Тулбар
    ══════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/profile_settings_background"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/personalization_settings_title"
            app:titleTextAppearance="@style/TextAppearance.Barkfluff.Settings2A.Title"
            app:titleTextColor="@color/profile_settings_on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="120dp">

            <!-- ══════════════════════════════════════════════
                 БЛОК 0 — Постер профиля (превью + кнопка)
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_profile_poster"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <!-- Карточка-превью профиля -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:paddingBottom="16dp">

                    <!-- Постер (соотношение 3:1) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/posterConstraint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/profilePosterPreviewImage"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="3:1" />

                        <View
                            android:id="@+id/profilePosterPreviewPlaceholder"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="?attr/colorSurfaceVariant"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="3:1" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Аватар: перекрывает нижнюю половину постера (marginTop = -60dp) -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="-60dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profilePreviewAvatarImage"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent" />

                        <TextView
                            android:id="@+id/profilePreviewAvatarPlaceholder"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="@drawable/background_color_indicator"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:visibility="visible" />

                    </FrameLayout>

                    <!-- Небольшой отступ под аватаром -->
                    <android.widget.Space
                        android:layout_width="match_parent"
                        android:layout_height="8dp" />

                    <!-- Имя -->
                    <TextView
                        android:id="@+id/profilePreviewFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="2dp"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- @username -->
                    <TextView
                        android:id="@+id/profilePreviewUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Кнопка установить новый постер -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSetPoster"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/personalization_set_new_poster"
                        app:icon="@drawable/ic_palette" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 1 — Превью чата
            ══════════════════════════════════════════════ -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

                <FrameLayout
                    android:id="@+id/chatPreviewLayout"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <!-- Фоновое изображение -->
                    <ImageView
                        android:id="@+id/previewBackgroundImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <!-- Слой затемнения: поверх фото, под пузырями -->
                    <View
                        android:id="@+id/previewDimOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#00000000" />

                    <!-- 5 пузырей, прибитых к низу -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:gravity="bottom">

                        <!-- Входящее 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/previewMsg1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_corner_large_increased"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/personalization_chat_preview_1"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Исходящее 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/previewMsg2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="5dp"
                            app:cardBackgroundColor="?attr/colorPrimaryContainer"
                            app:cardCornerRadius="@dimen/shape_corner_large_increased"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/personalization_chat_preview_2"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Входящее 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/previewMsg3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_corner_large_increased"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/personalization_chat_preview_3"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Исходящее 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/previewMsg4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="5dp"
                            app:cardBackgroundColor="?attr/colorPrimaryContainer"
                            app:cardCornerRadius="@dimen/shape_corner_large_increased"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/personalization_chat_preview_4"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Входящее 3 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/previewMsg5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            app:cardCornerRadius="@dimen/shape_corner_large_increased"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="@string/personalization_chat_preview_5"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 2 — Настройки отображения
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_display_settings"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <!-- ─── Закругление сообщений ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_item_top"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/personalization_message_corner_radius"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:id="@+id/cornerRadiusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/cornerRadiusSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="30"
                    android:stepSize="1"
                    android:value="20" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="3dp" />

            <!-- ─── Тогл: Размыть фон + слайдер силы ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_item_middle"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/personalization_blur_background"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBlurBackground"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/settings_switch_thumb"
                        app:trackTint="@color/settings_switch_track" />

                </LinearLayout>

                <!-- ─── Слайдер силы размытия (скрыт если тогл выключен) ─── -->
                <LinearLayout
                    android:id="@+id/blurRadiusSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"
                    android:paddingBottom="9dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/personalization_blur_strength"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/profile_settings_on_surface_variant" />

                        <TextView
                            android:id="@+id/blurRadiusValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/blurRadiusSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="25"
                        android:stepSize="1"
                        android:value="10" />

                </LinearLayout>

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="3dp" />

            <!-- ─── Затемнение фона ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_item_bottom"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/personalization_dim_background"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:id="@+id/dimValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/dimSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="1"
                    android:value="0" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 2.1 — Папки
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_folders"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <!-- ─── Тогл: Компактные папки ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="@drawable/bg_settings_item_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_compact_folders"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_compact_folders_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/profile_settings_on_surface_variant" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCompactFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="3dp" />

            <!-- ─── Тогл: Убрать обводку у папок ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="@drawable/bg_settings_item_middle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_folder_tabs_no_outline"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_folder_tabs_no_outline_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/profile_settings_on_surface_variant" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFolderTabsNoOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="3dp" />

            <!-- ─── Тогл: Убирать чаты папок из «Все чаты» ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="@drawable/bg_settings_item_bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_exclude_from_all"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_exclude_from_all_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/profile_settings_on_surface_variant" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchExcludeFromAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 2.2 — Главная панель вкладок
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_main_tabs"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_settings_item_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/personalization_main_tab_chats"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/profile_settings_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMainTabChats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_settings_item_middle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/personalization_main_tab_calls"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/profile_settings_on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMainTabCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_settings_item_bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/personalization_main_tab_profile"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/profile_settings_on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMainTabProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 2.3 — Онлайн
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_online_time"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:background="@drawable/bg_settings_item_single"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_relative_online_time"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_relative_online_time_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/profile_settings_on_surface_variant" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchRelativeOnlineTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 2.4 — Стикеры
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_stickers"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_item_single"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginEnd="56dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                        app:cardCornerRadius="@dimen/shape_corner_large_increased"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/personalization_sticker_preview_text"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="2dp"
                                android:alpha="0.7"
                                android:text="@string/personalization_sticker_preview_received_time"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:padding="4dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/stickerSizePreviewImage"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_sticker"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Sticker"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            android:alpha="0.82"
                            android:background="?attr/colorSurfaceContainerHighest"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="2dp"
                            android:text="@string/personalization_sticker_preview_time"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </FrameLayout>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/personalization_sticker_size"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/profile_settings_on_surface" />

                    <TextView
                        android:id="@+id/stickerSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personalization_sticker_size_default"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/stickerSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="160"
                    android:valueFrom="96"
                    android:valueTo="240" />

            </LinearLayout>

            <android.widget.Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- ══════════════════════════════════════════════
                 БЛОК 3 — Фон чатов
            ══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/personalization_chat_background"
                android:textAppearance="@style/TextAppearance.Barkfluff.Settings2A.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_item_single"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <!-- Сетка фонов 3 колонки -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/backgroundsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonToggleBackgrounds"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/personalization_expand_backgrounds"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <android.widget.Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- Кнопка добавить фон -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddBackground"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/personalization_add_background"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/shape_corner_full" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
