<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_background"
    android:fitsSystemWindows="true">

    <!-- Декоративная окружность — позади контента -->
    <View
        android:id="@+id/decorCircleTopStart"
        android:layout_width="@dimen/login_decor_circle_size"
        android:layout_height="@dimen/login_decor_circle_size"
        android:layout_marginTop="-60dp"
        android:layout_marginStart="-80dp"
        android:background="@drawable/bg_circle_welcome_primary"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo с крупной формой -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoCard"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/shape_corner_extra_large_increased"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Заголовок с Emphasized типографикой -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/login_welcome"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/onboarding_title_text" />

            <!-- Подзаголовок -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="@string/login_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/onboarding_subtitle_text" />

            <!-- Карточка входа с увеличенными радиусами -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/onboarding_card_surface"
                app:cardCornerRadius="@dimen/shape_corner_extra_large"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Login fields group -->
                    <LinearLayout
                        android:id="@+id/loginFieldsGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Username/Email с плавающим лейблом -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/usernameInputLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="@string/hint_username_or_email"
                            android:textColorHint="@color/onboarding_input_value_text"
                            app:boxBackgroundColor="@color/onboarding_input_fill"
                            app:boxCornerRadiusBottomEnd="@dimen/shape_corner_large_increased"
                            app:boxCornerRadiusBottomStart="@dimen/shape_corner_large_increased"
                            app:boxCornerRadiusTopEnd="@dimen/shape_corner_large_increased"
                            app:boxCornerRadiusTopStart="@dimen/shape_corner_large_increased"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:errorEnabled="true"
                            app:hintTextColor="@color/onboarding_button_background"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="@color/onboarding_button_background">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/usernameEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:maxLength="50"
                                android:maxLines="1"
                                android:textColor="@color/onboarding_title_text" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Password с плавающим лейблом -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/passwordInputLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:hint="@string/hint_password"
                            android:textColorHint="@color/onboarding_input_value_text"
                            app:boxBackgroundColor="@color/onboarding_input_fill"
                            app:boxCornerRadiusBottomEnd="@dimen/shape_corner_large_increased"
                            app:boxCornerRadiusBottomStart="@dimen/shape_corner_large_increased"
                            app:boxCornerRadiusTopEnd="@dimen/shape_corner_large_increased"
                            app:boxCornerRadiusTopStart="@dimen/shape_corner_large_increased"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/onboarding_button_background"
                            app:errorEnabled="true"
                            app:hintTextColor="@color/onboarding_button_background"
                            app:startIconDrawable="@android:drawable/ic_lock_lock"
                            app:startIconTint="@color/onboarding_button_background">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/passwordEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/onboarding_title_text" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Forgot password -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/forgotPasswordLink"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginBottom="8dp"
                            android:text="@string/forgot_password"
                            android:textAllCaps="false"
                            android:textColor="@color/onboarding_button_background" />

                    </LinearLayout>

                    <!-- OTP group (initially hidden) -->
                    <LinearLayout
                        android:id="@+id/otpGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/otp_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/onboarding_title_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:text="@string/otp_subtitle"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/onboarding_subtitle_text" />

                        <!-- 6 OTP digit boxes — responsive: layout_weight=1, минимум 40dp -->
                        <LinearLayout
                            android:id="@+id/otpBoxesLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/otpBox1Layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:minWidth="40dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/otpBox1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/otpBox2Layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:minWidth="40dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/otpBox2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/otpBox3Layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:minWidth="40dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/otpBox3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/otpBox4Layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:minWidth="40dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/otpBox4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/otpBox5Layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:minWidth="40dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/otpBox5"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/otpBox6Layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:minWidth="40dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/otpBox6"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Error text -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/errorCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorErrorContainer"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/errorText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:textColor="?attr/colorOnErrorContainer"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Login button с морфингом — M3 Expressive size L (64dp height, pill) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loginButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height_default"
                            android:text="@string/btn_login"
                            android:textAllCaps="false"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/onboarding_button_background"
                            app:cornerRadius="@dimen/shape_corner_full" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/loginProgressBar"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="?attr/colorOnPrimary"
                            app:indicatorSize="28dp"
                            app:trackThickness="3dp" />

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Change server link -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeServerLink"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_change_server"
                android:textAllCaps="false"
                android:textColor="@color/onboarding_button_background" />

            <!-- Разделитель -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp" />

            <!-- Register button — M3 Expressive size L (64dp height, pill) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_default"
                android:text="@string/btn_create_account"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/onboarding_chip_text"
                app:backgroundTint="@color/onboarding_chip_background"
                app:cornerRadius="@dimen/shape_corner_full"
                app:icon="@drawable/ic_grid"
                app:iconGravity="textStart"
                app:iconTint="@color/onboarding_chip_text" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/footer_text"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/onboarding_subtitle_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
