<?xml version="1.0" encoding="utf-8"?>
<!-- Экран профиля группового чата (терракотовый редизайн) -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingBottom="24dp">

        <!-- Header-band + floating back -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/headerBand"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/profile_elem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="3:1" />

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginTop="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Аватар внахлёст + камера -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-58dp"
            android:background="@drawable/bg_avatar_ring"
            android:padding="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/groupAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:id="@+id/groupAvatarPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="42sp"
                android:textStyle="bold"
                android:background="@drawable/background_color_indicator" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/changeAvatarButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@string/group_change_avatar"
                app:backgroundTint="@color/profile_accent"
                app:fabSize="mini"
                app:maxImageSize="18dp"
                app:srcCompat="@drawable/ic_camera"
                app:tint="@color/profile_on_accent" />

        </FrameLayout>

        <!-- Название + edit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/groupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/profile_text"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Команда «Аврора»" />

            <ImageButton
                android:id="@+id/changeNameButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_action_square"
                android:contentDescription="@string/group_change_name"
                android:padding="7dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/profile_accent" />

        </LinearLayout>

        <TextView
            android:id="@+id/groupSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:textColor="@color/profile_text_dim"
            android:textSize="13.5sp"
            tools:text="6 участников · 3 в сети" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseBackgroundButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/profile_chat_background"
            app:icon="@drawable/ic_photo_library" />

        <!-- Инфо-карта: ID чата -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/profile_elem"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/rowChatId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="13dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_forum"
                    app:tint="@color/profile_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/groupChatIdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/profile_text"
                        android:textSize="15sp"
                        tools:text="−1001 845 302" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_chat_id_label"
                        android:textColor="@color/profile_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_copy_content"
                    app:tint="@color/profile_text_dim" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pill-табы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_group"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tabMembers"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/group_members"
                android:textColor="@color/profile_chip_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tabMedia"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/profile_tab_media"
                android:textColor="@color/profile_chip_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tabFiles"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/media_tab_files"
                android:textColor="@color/profile_chip_text"
                android:textSize="13.5sp" />

        </LinearLayout>

        <!-- Кнопка «Добавить участника» -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addMemberButton"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:text="@string/group_add_member"
            android:textColor="@color/profile_accent"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/profile_accent" />

        <!-- Список участников -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/membersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="12dp"
            tools:listitem="@layout/item_group_member" />

        <!-- Независимые панели вложений: сетка и список не используют общий RecyclerView. -->
        <FrameLayout
            android:id="@+id/attachmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="168dp"
            android:paddingHorizontal="18dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/mediaAttachmentsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/mediaAttachmentsLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mediaAttachmentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_attachment_preview" />

                <TextView
                    android:id="@+id/mediaAttachmentsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/profile_text_dim"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Нет вложений" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/filesAttachmentsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/profile_files_search_hint"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fileSearchEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="255"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:id="@+id/filesAttachmentsLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filesAttachmentsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_attachment_file" />

                    <TextView
                        android:id="@+id/filesAttachmentsEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:textColor="@color/profile_text_dim"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Файлы не найдены" />
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
