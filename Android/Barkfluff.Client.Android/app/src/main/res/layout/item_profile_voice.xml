<?xml version="1.0" encoding="utf-8"?>
<!-- Строка голосового сообщения в профиле чата (таб «Голосовые») -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_action_square"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/playButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_play_circle">

        <ImageView
            android:id="@+id/playIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/profile_on_accent" />
    </FrameLayout>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginHorizontal="14dp"
        android:layout_weight="1"
        android:alpha="0.55"
        android:scaleType="fitXY"
        android:src="@drawable/ic_waveform"
        app:tint="@color/profile_accent" />

    <TextView
        android:id="@+id/audioDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="34dp"
        android:gravity="end"
        android:textColor="@color/profile_text_dim"
        android:textSize="12.5sp"
        tools:text="0:14" />

</LinearLayout>
