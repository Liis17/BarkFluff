<?xml version="1.0" encoding="utf-8"?>
<!-- Строка голосового сообщения в профиле чата (таб «Голосовые») -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_action_square"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/playButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_play_circle">

        <ImageView
            android:id="@+id/playIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/profile_on_accent" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/galleryVoiceProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone" />
    </FrameLayout>

    <com.barkfluff.client.view.VoiceWaveformView
        android:id="@+id/audioWaveform"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="1"
        android:importantForAccessibility="yes" />

    <Button
        android:id="@+id/voiceSpeed"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:padding="0dp"
        android:contentDescription="@string/cd_voice_speed"
        tools:text="1,5×" />

    <TextView
        android:id="@+id/audioDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="34dp"
        android:gravity="end"
        android:textColor="@color/profile_text_dim"
        android:textSize="12.5sp"
        tools:text="0:14" />

</LinearLayout>
