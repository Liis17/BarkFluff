<?xml version="1.0" encoding="utf-8"?>
<!-- Строка устройства; фон (верх/середина/низ группы) задаёт DeviceAdapter по позиции. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_settings_item_middle"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/imageDeviceIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_settings_tonal_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_smartphone"
        app:tint="@color/profile_settings_on_tonal_container" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Barkfluff.Profile.Item"
            android:textColor="@color/profile_settings_on_surface" />

        <TextView
            android:id="@+id/textDeviceDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/profile_settings_on_surface_variant" />

    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/profile_settings_on_surface_variant" />

</LinearLayout>
