<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_step4_headline"
            android:textAppearance="@style/TextAppearance.Barkfluff.Register.Headline" />

        <TextView
            android:id="@+id/emailHelperText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/register_step4_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otpCell1"
                android:layout_width="0dp"
                android:layout_height="@dimen/register_cta_height"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/otpCell2"
                android:layout_width="0dp"
                android:layout_height="@dimen/register_cta_height"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/otpCell3"
                android:layout_width="0dp"
                android:layout_height="@dimen/register_cta_height"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/otpCell4"
                android:layout_width="0dp"
                android:layout_height="@dimen/register_cta_height"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/otpCell5"
                android:layout_width="0dp"
                android:layout_height="@dimen/register_cta_height"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/otpCell6"
                android:layout_width="0dp"
                android:layout_height="@dimen/register_cta_height"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/verificationCodeValidationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_register_rule_chip"
                android:paddingHorizontal="13dp"
                android:paddingVertical="8dp"
                android:text="@string/register_otp_chip_inbox"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_register_rule_chip"
                android:paddingHorizontal="13dp"
                android:paddingVertical="8dp"
                android:text="@string/register_otp_chip_spam"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />

        </LinearLayout>

        <!-- Оставшиеся попытки -->
        <LinearLayout
            android:id="@+id/remainingAttemptsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="?attr/colorError" />

            <TextView
                android:id="@+id/remainingAttemptsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
