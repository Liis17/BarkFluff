<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ChatActivity">

    <!-- ═══════════════════════════════════════════
         ВЕРХНЯЯ ПАНЕЛЬ: [←] [Аватар | Имя | Время] [⋯]
         ═══════════════════════════════════════════ -->

    <!-- Кнопка «Назад» — круглая, слева -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_circle_btn"
        android:contentDescription="Назад"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        android:elevation="4dp"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Кнопка «Меню» — круглая, справа -->
    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_circle_btn"
        android:contentDescription="Дополнительное меню"
        android:padding="12dp"
        android:rotation="90"
        android:src="@drawable/ic_more_vert"
        android:elevation="4dp"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Центральная панель чата — закруглённая карточка между кнопками -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chatInfoCard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnMore">

        <LinearLayout
            android:id="@+id/chatInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <!-- Аватар чата -->
            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/chatAvatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <TextView
                    android:id="@+id/chatAvatarPlaceholder"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/background_color_indicator"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <!-- Индикатор онлайн -->
                <View
                    android:id="@+id/onlineIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/online_indicator"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Имя + статус -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chatNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Имя пользователя" />

                <TextView
                    android:id="@+id/onlineStatusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="в сети" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════
         ФОН ЧАТА — на весь экран, под панелями
         ═══════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/chatBackgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
         ОВЕРЛЕЙ ЗАТЕНЕНИЯ ФОНА — поверх фона, под контентом
         ═══════════════════════════════════════════ -->
    <View
        android:id="@+id/chatDimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
         СПИСОК СООБЩЕНИЙ — на весь экран, под панелями
         paddingTop/Bottom = высота верхней/нижней панели
         ═══════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="72dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/inputRowBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_message_sent" />

    <!-- Индикатор загрузки сообщений -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="24dp"
        app:layout_constraintTop_toTopOf="@id/messagesRecyclerView"
        app:layout_constraintStart_toStartOf="@id/messagesRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/messagesRecyclerView" />

    <!-- Кнопка прокрутки вниз -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scrollToBottomButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Прокрутить вниз"
        android:visibility="gone"
        android:elevation="6dp"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_arrow_down"
        app:layout_constraintBottom_toTopOf="@id/inputRowBottom"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
         ПАНЕЛЬ ПРИКРЕПЛЁННЫХ ФАЙЛОВ
         Показывается над панелью ввода, закруглённая, с отступами
         ═══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/attachmentPreviewBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp"
        android:elevation="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/inputRowBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Иконка скрепки под 45° -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_attachment"
                android:rotation="45"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/attachmentCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Прикреплено фото: 1" />

            <ImageButton
                android:id="@+id/clearAttachmentsButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Очистить вложения"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════
         НИЖНЯЯ ПАНЕЛЬ ВВОДА:
         [📎]  [ Поле ввода сообщения ]  [😊] [➤]
         ═══════════════════════════════════════════ -->

    <!-- Кнопка прикрепления — круглая, слева -->
    <ImageButton
        android:id="@+id/attachButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_circle_btn"
        android:contentDescription="Прикрепить файл"
        android:padding="12dp"
        android:rotation="45"
        android:elevation="4dp"
        android:src="@drawable/ic_attachment"
        app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@id/inputRowBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Кнопка стикеров — круглая, справа -->
    <ImageButton
        android:id="@+id/stickerButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_circle_btn"
        android:contentDescription="Стикеры"
        android:padding="12dp"
        android:elevation="4dp"
        android:src="@drawable/ic_sticker"
        app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@id/inputRowBottom"
        app:layout_constraintEnd_toStartOf="@id/sendButton" />

    <!-- Кнопка отправки — круглая, крайняя справа -->
    <ImageButton
        android:id="@+id/sendButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_circle_btn"
        android:contentDescription="Отправить"
        android:padding="12dp"
        android:elevation="4dp"
        android:src="@drawable/ic_send_filled"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/inputRowBottom"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Поле ввода сообщения — между кнопками, высота 48dp как у кнопок -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/messageInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="8dp"
        android:elevation="4dp"
        app:boxBackgroundColor="?attr/colorSurface"
        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"
        app:hintEnabled="false"
        app:layout_constraintBottom_toBottomOf="@id/inputRowBottom"
        app:layout_constraintStart_toEndOf="@id/attachButton"
        app:layout_constraintEnd_toStartOf="@id/stickerButton">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/messageEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Сообщение"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Вспомогательный невидимый View, задаёт нижнюю границу панели ввода -->
    <View
        android:id="@+id/inputRowBottom"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:visibility="invisible"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/stickerPanelContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Вспомогательный barrier для панели вложений -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/inputRowBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="attachButton,messageInputLayout,stickerButton,sendButton" />

    <!-- ═══════════════════════════════════════════
         INLINE СТИКЕР-ПАНЕЛЬ
         ═══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/stickerPanelContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stickerPanelRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp" />

    </FrameLayout>

    <!-- ═══════════════════════════════════════════
         ОВЕРЛЕЙ ПРЕДПРОСМОТРА СТИКЕРА
         ═══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/stickerPreviewOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:elevation="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/stickerPreviewImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="Предпросмотр стикера" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
