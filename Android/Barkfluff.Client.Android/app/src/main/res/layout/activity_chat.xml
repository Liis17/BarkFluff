<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ChatActivity">

    <!-- ═══════════════════════════════════════════
         ФОН ЧАТА — на весь экран, под панелями
         ═══════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/chatBackgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
         ОВЕРЛЕЙ ЗАТЕНЕНИЯ ФОНА — поверх фона, под контентом
         ═══════════════════════════════════════════ -->
    <View
        android:id="@+id/chatDimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
         СПИСОК СООБЩЕНИЙ — от шапки до низа экрана,
         paddingBottom = высота панели ввода
         ═══════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/chatHeaderBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_message_sent" />

    <!-- ═══════════════════════════════════════════
         ВЕРХНЯЯ ПАНЕЛЬ: [←] [Имя | статус] [☎] [⋯] [Аватар]
         Имя уменьшается, а статус скрывается при прокрутке в историю сообщений.
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/chatHeaderBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <!-- Имя + статус: тап открывает профиль собеседника или карточку группы -->
        <LinearLayout
            android:id="@+id/chatInfoCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/chatNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineHeight="28sp"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textFontWeight="600"
                android:textSize="22sp"
                tools:text="Имя пользователя" />

            <!-- Обёртка нужна, чтобы схлопывать строку статуса по высоте -->
            <FrameLayout
                android:id="@+id/chatStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/onlineStatusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineHeight="16sp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="в сети" />

            </FrameLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAudioCall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_audio_call"
            android:padding="11dp"
            android:src="@drawable/ic_phone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_more_menu"
            android:padding="11dp"
            android:rotation="90"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chatAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:id="@+id/chatAvatarPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/background_color_indicator"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <!-- Индикатор онлайн -->
            <View
                android:id="@+id/onlineIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/online_indicator"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         ПЛАШКА ЗАКРЕПЛЁННОГО СООБЩЕНИЯ (Telegram-style)
         Накладывается поверх верха ленты, ниже шапки чата
         ═══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pinnedMessageBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/chatHeaderBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_pin"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/pinnedBarContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pinnedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    tools:text="Закреплённое сообщение" />

                <TextView
                    android:id="@+id/pinnedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Текст последнего закрепа" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/pinnedListButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_all_pinned"
                android:src="@drawable/ic_menu_hamburger"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Индикатор загрузки сообщений -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="24dp"
        app:layout_constraintTop_toTopOf="@id/messagesRecyclerView"
        app:layout_constraintStart_toStartOf="@id/messagesRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/messagesRecyclerView" />

    <!-- Кнопка прокрутки вниз — закреплена над панелью reply, которая в свою очередь
         якорится к attachmentPreviewBar → inputRowBarrier. Это создаёт цепочку gone-fallback:
         когда обе панели скрыты, кнопка оказывается над input; когда панели появляются,
         кнопка автоматически поднимается. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scrollToBottomButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/cd_scroll_down"
        android:visibility="gone"
        android:elevation="6dp"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_arrow_down"
        app:layout_constraintBottom_toTopOf="@id/replyPreviewBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════
         ПАНЕЛЬ РЕДАКТИРОВАНИЯ (EDIT PREVIEW)
         Показывается над replyPreviewBar (взаимоисключающие режимы),
         содержит заголовок, превью текста оригинала и кнопку отмены
         ═══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/editPreviewBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="4dp"
        android:elevation="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Barkfluff.Chat.InputPreviewBar"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/attachmentPreviewBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_edit"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/editPreviewTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/chat_editing_message"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/editPreviewContentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Исходный текст сообщения" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/clearEditButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_cancel_edit"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════
         ПАНЕЛЬ ОТВЕТА (REPLY PREVIEW)
         Показывается над панелью ввода (или над прикреплёнными файлами, если они есть),
         содержит автора и превью оригинала + кнопку отмены
         ═══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/replyPreviewBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="4dp"
        android:elevation="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Barkfluff.Chat.InputPreviewBar"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/attachmentPreviewBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <View
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/replyPreviewAuthorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    tools:text="Ответ Иван Петров" />

                <TextView
                    android:id="@+id/replyPreviewContentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Привет! Как дела?" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/clearReplyButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_cancel_reply"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════
         ПАНЕЛЬ ПРИКРЕПЛЁННЫХ ФАЙЛОВ
         Показывается над панелью ввода, закруглённая, с отступами
         ═══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/attachmentPreviewBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="4dp"
        android:elevation="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardElevation="4dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Barkfluff.Chat.InputPreviewBar"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/inputRowBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Иконка скрепки под 45° -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_attachment"
                android:rotation="45"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/attachmentCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Прикреплено фото: 1" />

            <ImageButton
                android:id="@+id/clearAttachmentsButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_clear_attachments"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════
         НИЖНЯЯ ПАНЕЛЬ ВВОДА:
         [📎]  [ Поле ввода сообщения ]  [😊] [➤]
         ═══════════════════════════════════════════ -->

    <!-- Грядка ввода: скрепка, поле и стикеры внутри одной pill-плашки -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_chat_input_bar"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@id/inputRowBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sendButton">

        <ImageButton
            android:id="@+id/attachButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_attach_file"
            android:padding="11dp"
            android:rotation="45"
            android:src="@drawable/ic_attachment"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/chat_message_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingHorizontal="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/stickerButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_stickers"
            android:padding="11dp"
            android:src="@drawable/ic_sticker"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Кнопка отправки: круг с микрофоном → вытянутая pill со стрелкой, фон и форма
         анимируются в ChatActivity.updateSendButtonMode() -->
    <ImageButton
        android:id="@+id/sendButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/cd_send"
        android:elevation="4dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        android:src="@drawable/ic_send_filled"
        app:layout_constraintBottom_toBottomOf="@id/inputRowBottom"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Вспомогательный невидимый View, задаёт нижнюю границу панели ввода -->
    <View
        android:id="@+id/inputRowBottom"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:visibility="invisible"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/stickerPanelContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Вспомогательный barrier для панели вложений -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/inputRowBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="inputBar,sendButton" />

    <!-- ═══════════════════════════════════════════
         INLINE СТИКЕР-ПАНЕЛЬ
         ═══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/stickerPanelContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stickerPanelRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp" />

    </FrameLayout>

    <!-- ═══════════════════════════════════════════
         ОВЕРЛЕЙ ПРЕДПРОСМОТРА СТИКЕРА
         ═══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/stickerPreviewOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:elevation="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/stickerPreviewImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_sticker_preview" />

    </FrameLayout>

    <!-- ═══════════════════════════════════════════
         E2E: баннер статуса инвайта приватного чата (ожидание/отклонён).
         Всегда gone для обычных чатов — нулевое влияние на обычный поток.
         ═══════════════════════════════════════════ -->
    <TextView
        android:id="@+id/e2eBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:background="?attr/colorSecondaryContainer"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:gravity="center"
        android:padding="12dp"
        android:elevation="6dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/chatHeaderBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <!-- ═══════════════════════════════════════════
         E2E: запрос приглашения приватного чата «принять/отклонить».
         Всегда gone для обычных чатов.
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/e2eInviteContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="8dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/inputRowBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/e2eInvitePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/e2eInviteAcceptButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/private_chat_invite_accept" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/e2eInviteDeclineButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/private_chat_invite_decline" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
