<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка чата (макет M3E, вариант 3). Прочитанный и непрочитанный чат — одна разметка
  с разными формой, фоном, размером аватара и типографикой; всё это выставляет ChatAdapter.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/chatRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chatAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                tools:visibility="visible" />

            <!-- Плейсхолдер с инициалами -->
            <TextView
                android:id="@+id/chatAvatarPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:visibility="visible"
                tools:background="@color/primary"
                tools:text="AB" />

            <View
                android:id="@+id/onlineIndicator"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/online_indicator"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/privateChatLock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_private_lock_badge"
                android:contentDescription="@string/private_chat_lock_description"
                android:padding="3dp"
                android:src="@drawable/ic_lock"
                android:visibility="gone"
                app:tint="?attr/colorOnPrimaryContainer" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chatTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineHeight="24sp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    tools:text="Имя Фамилия" />

                <TextView
                    android:id="@+id/messageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textFontWeight="500"
                    android:textSize="12sp"
                    tools:text="14:30" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/readStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:src="@drawable/ic_status_sent"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/lastMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineHeight="20sp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    tools:text="Привет! Как дела?" />

                <View
                    android:id="@+id/privatePreviewSkeleton"
                    android:layout_width="104dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_private_preview_skeleton"
                    android:contentDescription="@string/private_chat_preview_hidden"
                    android:visibility="gone" />

                <!-- Unread badge — pill через corner.full -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/unreadBadgeCard"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:minWidth="26dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="@dimen/shape_corner_full"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/unreadBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minWidth="26dp"
                        android:paddingHorizontal="8dp"
                        android:textColor="?attr/colorOnPrimary"
                        android:textFontWeight="600"
                        android:textSize="13sp"
                        tools:text="3"
                        tools:visibility="visible" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
