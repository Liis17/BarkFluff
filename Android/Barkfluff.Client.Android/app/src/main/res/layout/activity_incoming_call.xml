<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Аватар с концентрическими кольцами -->
    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp">

        <View
            android:id="@+id/avatarRingOuter"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_call_ring" />

        <View
            android:id="@+id/avatarRingInner"
            android:layout_width="232dp"
            android:layout_height="232dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_call_ring" />

        <TextView
            android:id="@+id/avatarInitials"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            tools:text="AK"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="48sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/avatarImage"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Имя и тип звонка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="452dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/callerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="BarkFluff"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_phone"
                android:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/callType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/incoming_call_audio"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="96dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/rejectButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_reject"
                android:clickable="true"
                android:contentDescription="@string/incoming_call_reject"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_end"
                android:tint="?attr/colorOnErrorContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/incoming_call_reject"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/acceptButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_accept"
                android:clickable="true"
                android:contentDescription="@string/incoming_call_answer"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_phone"
                android:tint="?attr/colorOnPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/incoming_call_answer"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
