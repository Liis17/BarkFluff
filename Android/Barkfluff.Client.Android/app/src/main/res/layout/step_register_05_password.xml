<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_step5_headline"
            android:textAppearance="@style/TextAppearance.Barkfluff.Register.Headline" />

        <!-- Пароль -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/hint_password_required"
            app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:boxCornerRadiusBottomEnd="@dimen/register_field_radius"
            app:boxCornerRadiusBottomStart="@dimen/register_field_radius"
            app:boxCornerRadiusTopEnd="@dimen/register_field_radius"
            app:boxCornerRadiusTopStart="@dimen/register_field_radius"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Индикатор силы пароля -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_register_rule_chip_success"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_two_factor"
                app:tint="@color/on_success_container" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/passwordDifficultyIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_password_start_typing"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/on_success_container" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/strengthSegment1"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="?attr/colorSurfaceContainerHighest" />

                    <View
                        android:id="@+id/strengthSegment2"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="?attr/colorSurfaceContainerHighest" />

                    <View
                        android:id="@+id/strengthSegment3"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="?attr/colorSurfaceContainerHighest" />

                    <View
                        android:id="@+id/strengthSegment4"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:background="?attr/colorSurfaceContainerHighest" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Требования к паролю -->
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/reqMinLength"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/register_password_req_length" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reqUpperCase"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/register_password_req_upper" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reqLowerCase"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/register_password_req_lower" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reqDigit"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/register_password_req_digit" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reqSpecialChar"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/register_password_req_special" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/register_password_optional_chars" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Подтверждение пароля -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordInputLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_password_confirm_required"
            app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:boxCornerRadiusBottomEnd="@dimen/register_field_radius"
            app:boxCornerRadiusBottomStart="@dimen/register_field_radius"
            app:boxCornerRadiusTopEnd="@dimen/register_field_radius"
            app:boxCornerRadiusTopStart="@dimen/register_field_radius"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/passwordMatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
