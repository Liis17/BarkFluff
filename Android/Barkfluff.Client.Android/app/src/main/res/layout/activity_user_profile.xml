<?xml version="1.0" encoding="utf-8"?>
<!-- Экран профиля пользователя / чата (терракотовый редизайн).
     Оттягивание вниз в самом верху раскрывает аватар в полноширинное фото. -->
<com.barkfluff.client.view.PullToExpandScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingBottom="40dp">

        <!-- Шапка: постер (3:1), аватар, имя и действия.
             Фото имеет квадратные границы и не участвует в расчёте высоты шапки. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profileHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/profilePosterImageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:cropToPadding="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="3:1"
                tools:visibility="visible"
                tools:background="#AABBCC" />

            <View
                android:id="@+id/profilePosterPlaceholder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/profile_elem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="3:1" />

            <View
                android:id="@+id/profilePosterScrim"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_poster_scrim"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/profilePosterPlaceholder"
                app:layout_constraintBottom_toBottomOf="@id/profilePosterPlaceholder" />

            <!-- Растяжка шапки при оттягивании; высота задаётся minHeight из кода. -->
            <Space
                android:id="@+id/profileHeaderStretch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profilePosterPlaceholder" />

            <!-- Кольцо и инициалы аватара, центр — на нижней границе постера (+ растяжка) -->
            <FrameLayout
                android:id="@+id/profileAvatarFrame"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:background="@drawable/bg_avatar_ring"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileHeaderStretch"
                app:layout_constraintBottom_toBottomOf="@id/profileHeaderStretch">

                <TextView
                    android:id="@+id/profileAvatarPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/background_color_indicator"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    tools:text="AB" />

            </FrameLayout>

            <!-- Фото аватара: в покое совпадает с кругом аватара, раскрытое — квадрат на всю ширину -->
            <com.barkfluff.client.view.ProfileAvatarMorphView
                android:id="@+id/profileAvatarImageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_wrapBehaviorInParent="skipped" />

            <View
                android:id="@+id/profileAvatarExpandedScrim"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0"
                android:background="@drawable/bg_profile_avatar_expanded_scrim"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/profileAvatarFrame"
                app:layout_constraintBottom_toBottomOf="parent" />



            <!-- Имя + verified -->
            <LinearLayout
                android:id="@+id/profileNameRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileAvatarFrame">

                <TextView
                    android:id="@+id/profileNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:gravity="center"
                    android:textColor="@color/profile_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Александр Ветров" />

                <ImageView
                    android:id="@+id/verifiedBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/profile_accent"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Ряд действий; уведомления и фон чата — в меню «три точки» -->
            <LinearLayout
                android:id="@+id/profileActionsRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileNameRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionMessageButton"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/profile_action_message"
                    android:textColor="@color/profile_on_accent"
                    android:textSize="15sp"
                    app:backgroundTint="@color/profile_accent"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_chat_bubble"
                    app:iconGravity="textStart"
                    app:iconTint="@color/profile_on_accent" />

                <FrameLayout
                    android:id="@+id/actionCallButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_action_square"
                    android:contentDescription="@string/profile_action_call">

                    <ImageView
                        android:id="@+id/actionCallIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/profile_accent" />
                </FrameLayout>

            </LinearLayout>

            <Space
                android:id="@+id/profileHeaderBottomGap"
                android:layout_width="0dp"
                android:layout_height="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileActionsRow" />

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginTop="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginTop="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@string/cd_more_menu"
                android:src="@drawable/ic_more_vert"
                android:visibility="gone"
                app:tint="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Инфо-карта; разделители рисует LinearLayout только между видимыми строками -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="@color/profile_elem"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_profile_info"
                android:dividerPadding="18dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <include
                    android:id="@+id/rowUsername"
                    layout="@layout/item_profile_info_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/rowStatus"
                    layout="@layout/item_profile_info_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/rowBio"
                    layout="@layout/item_profile_info_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/rowUserId"
                    layout="@layout/item_profile_info_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/rowChatId"
                    layout="@layout/item_profile_info_row"
                    android:visibility="gone" />

                <include
                    android:id="@+id/rowRegistration"
                    layout="@layout/item_profile_info_row"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Заголовок вложений -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.06"
            android:text="@string/profile_attachments_title"
            android:textAllCaps="true"
            android:textColor="@color/profile_text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Pill-табы -->
        <LinearLayout
            android:id="@+id/attachmentTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_pill_group"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tabMedia"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/profile_tab_media"
                android:textColor="@color/profile_chip_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tabFiles"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/media_tab_files"
                android:textColor="@color/profile_chip_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tabVoice"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/profile_tab_voice"
                android:textColor="@color/profile_chip_text"
                android:textSize="13.5sp" />

        </LinearLayout>

        <!-- Независимые панели вкладок: сетка и списки никогда не переиспользуют RecyclerView. -->
        <FrameLayout
            android:id="@+id/attachmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="168dp">

            <FrameLayout
                android:id="@+id/mediaAttachmentsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.loadingindicator.LoadingIndicator
                    android:id="@+id/mediaAttachmentsLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="32dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mediaAttachmentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_attachment_preview" />

                <TextView
                    android:id="@+id/mediaAttachmentsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/profile_text_dim"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Нет вложений" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/filesAttachmentsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/profile_files_search_hint"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fileSearchEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="255"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.loadingindicator.LoadingIndicator
                        android:id="@+id/filesAttachmentsLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="24dp"
                    android:layout_marginBottom="32dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filesAttachmentsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_attachment_file" />

                    <TextView
                        android:id="@+id/filesAttachmentsEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:textColor="@color/profile_text_dim"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Файлы не найдены" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/voiceAttachmentsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.google.android.material.loadingindicator.LoadingIndicator
                    android:id="@+id/voiceAttachmentsLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="32dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/voiceAttachmentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_profile_voice" />

                <TextView
                    android:id="@+id/voiceAttachmentsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/profile_text_dim"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Нет голосовых" />
            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</com.barkfluff.client.view.PullToExpandScrollView>
