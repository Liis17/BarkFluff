<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/memberAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/memberAvatarPlaceholder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible"
            android:background="@drawable/background_color_indicator" />

        <View
            android:id="@+id/memberPresenceDot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/member_online_dot"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/memberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/profile_text"
            android:textSize="15sp"
            tools:text="Анна Соколова" />

        <TextView
            android:id="@+id/memberSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/profile_text_dim"
            android:textSize="12.5sp"
            tools:text="в сети" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/memberMenuButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/group_remove_member"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/profile_text_dim" />

</LinearLayout>
