<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Декоративный круг за контентом, чисто орнаментальный -->
    <View
        android:id="@+id/decorCircle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-70dp"
        android:background="@drawable/bg_decor_circle"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contentPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <!-- Squircle-шапка с иконкой шага -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/headerIconCard"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/headerIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="?attr/colorOnPrimary" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Прогресс: крупный номер шага -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="0.85"
                    android:text="01"
                    android:textAppearance="@style/TextAppearance.Barkfluff.Register.BigNumber"
                    android:textSize="52sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="6dp"
                    android:text="/ 02"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Сегментный прогресс-бар -->
            <LinearLayout
                android:id="@+id/segmentBarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <View
                    android:id="@+id/segment1"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_bar"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/segment2"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_bar"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <!-- Заголовок -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="-0.035"
                android:lineSpacingMultiplier="1.02"
                android:text="@string/reset_password_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Подзаголовок первого шага. -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/reset_password_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Шаг 1: Email/логин -->
            <LinearLayout
                android:id="@+id/step1Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="7dp"
                    android:labelFor="@id/emailEditText"
                    android:text="@string/reset_enter_email_or_login"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="@dimen/shape_corner_large"
                    app:boxCornerRadiusBottomStart="@dimen/shape_corner_large"
                    app:boxCornerRadiusTopEnd="@dimen/shape_corner_large"
                    app:boxCornerRadiusTopStart="@dimen/shape_corner_large"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_field_height"
                        android:autofillHints="username"
                        android:gravity="center_vertical"
                        android:hint="@string/reset_identifier_hint"
                        android:imeOptions="actionDone"
                        android:includeFontPadding="false"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Шаг 2: новый пароль -->
            <LinearLayout
                android:id="@+id/step3Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="7dp"
                    android:labelFor="@id/newPasswordEditText"
                    android:text="@string/hint_new_password"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/newPasswordInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="@dimen/shape_corner_large"
                    app:boxCornerRadiusBottomStart="@dimen/shape_corner_large"
                    app:boxCornerRadiusTopEnd="@dimen/shape_corner_large"
                    app:boxCornerRadiusTopStart="@dimen/shape_corner_large"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/newPasswordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_field_height"
                        android:autofillHints="newPassword"
                        android:gravity="center_vertical"
                        android:imeOptions="actionNext"
                        android:includeFontPadding="false"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/strengthContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_strength_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="11dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/strengthIcon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_gpp_good"
                        app:tint="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/strengthLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal"
                            android:weightSum="4">

                            <View
                                android:id="@+id/strengthSegment1"
                                android:layout_width="0dp"
                                android:layout_height="5dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_segment_bar"
                                android:importantForAccessibility="no" />

                            <View
                                android:id="@+id/strengthSegment2"
                                android:layout_width="0dp"
                                android:layout_height="5dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_segment_bar"
                                android:importantForAccessibility="no" />

                            <View
                                android:id="@+id/strengthSegment3"
                                android:layout_width="0dp"
                                android:layout_height="5dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_segment_bar"
                                android:importantForAccessibility="no" />

                            <View
                                android:id="@+id/strengthSegment4"
                                android:layout_width="0dp"
                                android:layout_height="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_segment_bar"
                                android:importantForAccessibility="no" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="7dp"
                    android:labelFor="@id/confirmPasswordEditText"
                    android:text="@string/hint_confirm_password"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:boxCollapsedPaddingTop="0dp"
                    app:boxCornerRadiusBottomEnd="@dimen/shape_corner_large"
                    app:boxCornerRadiusBottomStart="@dimen/shape_corner_large"
                    app:boxCornerRadiusTopEnd="@dimen/shape_corner_large"
                    app:boxCornerRadiusTopStart="@dimen/shape_corner_large"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconDrawable="@drawable/ic_check_circle"
                    app:endIconMode="custom"
                    app:endIconTint="@color/success"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/login_field_height"
                        android:autofillHints="newPassword"
                        android:gravity="center_vertical"
                        android:imeOptions="actionDone"
                        android:includeFontPadding="false"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Шаг 4: успех -->
            <LinearLayout
                android:id="@+id/successContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check"
                        app:tint="?attr/colorPrimaryContainer" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:letterSpacing="-0.035"
                    android:lineSpacingMultiplier="1.02"
                    android:text="@string/reset_password_success"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/reset_password_success_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_success_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/on_success_container" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/reset_success_chip"
                        android:textColor="@color/on_success_container"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Ошибка -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/error_background"
                android:padding="12dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnErrorContainer"
                android:visibility="gone" />

            <!-- Индикатор загрузки -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Подвал с CTA: по макету кнопка прижата к низу экрана, а не едет за контентом.
         Непрозрачный фон нужен, чтобы скроллящийся контент не просвечивал под кнопками. -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Шаг 1 -->
        <LinearLayout
            android:id="@+id/footerStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendCodeButton"
                style="@style/Widget.Barkfluff.Register.CtaButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:enabled="false"
                android:text="@string/reset_send_code" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToLoginLink"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:text="@string/reset_back_to_login"
                android:textAllCaps="false"
                android:textSize="14.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Шаг 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/savePasswordButton"
            style="@style/Widget.Barkfluff.Register.CtaButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/reset_save_new_password"
            android:visibility="gone" />

        <!-- Экран успеха -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToLoginButton"
            style="@style/Widget.Barkfluff.Register.CtaButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="@string/reset_back_to_login"
            android:visibility="gone"
            app:icon="@drawable/ic_arrow_forward" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
