<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/serverCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/shape_corner_extra_large"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Icon-tile сервера -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serverIconTile"
                android:layout_width="@dimen/server_icon_tile_size"
                android:layout_height="@dimen/server_icon_tile_size"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="@dimen/shape_corner_large"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/serverIconGlyph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:src="@drawable/ic_storage"
                    app:tint="?attr/colorOnPrimary" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Информация о сервере -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Название сервера + verified -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/serverTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/server_item_name_placeholder"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:id="@+id/serverVerifiedIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="?attr/colorPrimary" />

                </LinearLayout>

                <!-- Описание -->
                <TextView
                    android:id="@+id/serverDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/server_item_description_placeholder"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Чипы: Онлайн / пинг -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/serverChipsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOnline"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="@string/server_status_online"
                        android:textColor="@color/on_success_container"
                        app:chipBackgroundColor="@color/success_container"
                        app:chipIcon="@drawable/dot_online_indicator"
                        app:chipIconSize="8dp"
                        app:chipIconTint="@color/profile_presence_online" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPing"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:visibility="gone"
                        app:chipBackgroundColor="?attr/colorPrimaryContainer"
                        app:chipIcon="@drawable/ic_bolt"
                        app:chipIconTint="?attr/colorOnPrimaryContainer" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Локация и публичное имя -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/serverLocationAndPublicName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/server_item_location_placeholder"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- CTA «Подключиться» -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/serverConnectCta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_connect"
            android:textAllCaps="false"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="@dimen/shape_corner_full" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
