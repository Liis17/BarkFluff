<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/serverCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="@dimen/shape_corner_extra_large"
    app:cardElevation="2dp"
    app:rippleColor="?attr/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Icon-tile ноды -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serverIconTile"
                android:layout_width="@dimen/server_icon_tile_size"
                android:layout_height="@dimen/server_icon_tile_size"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="@dimen/shape_corner_large"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/serverIconGlyph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_storage"
                    app:tint="?attr/colorOnPrimary" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Информация о ноде -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/serverTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/server_item_name_placeholder"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/serverVerifiedIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/serverDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/server_item_description_placeholder"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </LinearLayout>

        <!-- Чипы одной строкой: Онлайн / пинг / регион (макет 2c) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/serverChipsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnline"
                style="@style/Widget.Barkfluff.Server.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_status_online"
                android:textColor="@color/onboarding_success_text"
                app:chipBackgroundColor="@color/onboarding_success_background"
                app:chipIcon="@drawable/dot_online_indicator"
                app:chipIconSize="8dp"
                app:chipIconTint="@color/profile_presence_online" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPing"
                style="@style/Widget.Barkfluff.Server.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_bolt" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRegion"
                style="@style/Widget.Barkfluff.Server.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_location" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Публичное имя ноды -->
        <TextView
            android:id="@+id/serverHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- CTA «Подключиться» внутри карточки -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/serverConnectCta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/server_card_cta_height"
            android:layout_marginTop="16dp"
            android:text="@string/btn_connect"
            android:textAllCaps="false"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="@dimen/shape_corner_full"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="10dp"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
