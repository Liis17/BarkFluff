<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/bg_outgoing_upload_scrim">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/outgoingUploadProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@android:color/white"
            app:indicatorSize="44dp"
            app:trackColor="#66FFFFFF"
            app:trackThickness="3dp" />

        <ImageButton
            android:id="@+id/outgoingCancelButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_cancel"
            android:padding="15dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />
    </FrameLayout>
</FrameLayout>
