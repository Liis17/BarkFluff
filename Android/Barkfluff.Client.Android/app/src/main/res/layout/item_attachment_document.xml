<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:minWidth="200dp">

    <!-- Иконка файла -->
    <ImageView
        android:id="@+id/docFileIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_file"
        android:contentDescription="@null"
        app:tint="?attr/colorPrimary" />

    <!-- Имя файла + размер + прогресс -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/docFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="document.pdf" />

        <TextView
            android:id="@+id/docFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="2.5 MB" />

        <!-- Прогресс бар для скачивания -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/docDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            app:trackThickness="4dp"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Контейнер для кнопок — 48dp touch target (M3 / WCAG минимум).
         Визуальный размер иконки сохраняется 24dp через scaleType=center. -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <!-- Кнопка скачать -->
        <ImageButton
            android:id="@+id/docDownloadButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/cd_download_file"
            android:scaleType="center"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- Кнопка открыть (показывается после скачивания) -->
        <ImageButton
            android:id="@+id/docOpenButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_open"
            android:contentDescription="@string/cd_open_file"
            android:scaleType="center"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

    </FrameLayout>

</LinearLayout>
