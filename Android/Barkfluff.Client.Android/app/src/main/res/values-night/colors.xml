<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Basic colors -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Material 3 Expressive Color Scheme (Dark Theme) -->
    <!-- Seed color: #FF6B35 (BarkFluff Orange) -->
    
    <!-- Primary - основной бренд цвет -->
    <color name="primary">#FFB5A0</color>
    <color name="on_primary">#5F2E00</color>
    <color name="primary_container">#CC551A</color>
    <color name="on_primary_container">#FFDAD0</color>

    <!-- Secondary - дополнительный акцент -->
    <color name="secondary">#96C9FF</color>
    <color name="on_secondary">#003255</color>
    <color name="secondary_container">#004C7F</color>
    <color name="on_secondary_container">#D0E4FF</color>

    <!-- Tertiary - amber акцент (dark theme, M3 Expressive) -->
    <color name="tertiary">#F1C147</color>
    <color name="on_tertiary">#3F2E00</color>
    <color name="tertiary_container">#5B4300</color>
    <color name="on_tertiary_container">#FFDF9C</color>

    <!-- Error - семантический цвет ошибок -->
    <color name="error">#FFB4AB</color>
    <color name="on_error">#690005</color>
    <color name="error_container">#93000A</color>
    <color name="on_error_container">#FFDAD6</color>

    <!-- Surface - основные цвета поверхности -->
    <color name="surface">#191C1D</color>
    <color name="on_surface">#E3E2E0</color>
    
    <!-- Surface variants для глубины и иерархии -->
    <color name="surface_container_lowest">#121415</color>
    <color name="surface_container_low">#191C1D</color>
    <color name="surface_container">#2D3132</color>
    <color name="surface_container_high">#3E4142</color>
    <color name="surface_container_highest">#484B4C</color>
    
    <color name="on_surface_variant">#C9C4C2</color>
    
    <!-- Outline и границы -->
    <color name="outline">#938F8D</color>
    <color name="outline_variant">#494544</color>

    <!-- Background -->
    <color name="background">#191C1D</color>
    <color name="on_background">#E3E2E0</color>

    <!-- Inverse цвета для состояний -->
    <color name="inverse_surface">#E3E2E0</color>
    <color name="inverse_on_surface">#31302E</color>
    <color name="inverse_primary">#CC551A</color>

    <!-- Shadow для elevation -->
    <color name="shadow">#000000</color>

    <!-- Scrim для модалок и overlay'ев (M3 стандарт: 60% черного в dark theme) -->
    <color name="scrim_overlay">#99000000</color>

    <!-- Surface Tint для динамических цветов -->
    <color name="surface_tint">#FFB5A0</color>

    <!-- Status bar (dark theme) -->
    <color name="status_bar">#121415</color>

    <!-- Success цвет -->
    <color name="success">#81C784</color>
    <color name="on_success">#1B5E20</color>
    <color name="success_container">#2E7D32</color>
    <color name="on_success_container">#C8E6C9</color>
    
    <!-- Warning цвет -->
    <color name="warning">#FFB74D</color>
    <color name="on_warning">#E65100</color>
    <color name="warning_container">#F57C00</color>
    <color name="on_warning_container">#FFE0B2</color>

    <!-- Profile screens palette (terracotta, dark вариант из веб-макетов) -->
    <color name="profile_accent">#C07A52</color>
    <color name="profile_on_accent">#241309</color>
    <color name="profile_surface">#17100C</color>
    <color name="profile_elem">#1F1612</color>
    <color name="profile_elem_2">#2A1E18</color>
    <color name="profile_accent_soft">#2A1C14</color>
    <color name="profile_text">#F2E6DE</color>
    <color name="profile_text_dim">#B19C90</color>
    <color name="profile_outline">#38271F</color>
    <color name="profile_chip_text">#D3B6A4</color>
    <color name="profile_presence_online">#3EC46D</color>

    <!-- Widget colors — Material You dark theme -->
    <color name="widget_background_color">@android:color/system_neutral1_900</color>
    <color name="widget_text_primary">@android:color/system_neutral1_50</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_200</color>
    <color name="widget_accent_color">@android:color/system_accent1_300</color>
    <color name="widget_accent_text">@android:color/system_neutral1_900</color>
</resources>
