<?xml version="1.0" encoding="utf-8"?>
<!-- Большая красная кнопка завершения звонка -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#C2261B" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F0494E"
                android:endColor="#D2261B" />
        </shape>
    </item>
</selector>
