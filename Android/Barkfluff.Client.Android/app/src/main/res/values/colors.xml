<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Basic colors -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Material 3 Expressive Color Scheme (Light Theme) -->
    <!-- Seed color: #FF6B35 (BarkFluff Orange) -->
    
    <!-- Primary - основной бренд цвет -->
    <color name="primary">#FF6B35</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#FFDAD0</color>
    <color name="on_primary_container">#4A2000</color>

    <!-- Secondary - дополнительный акцент -->
    <color name="secondary">#2196F3</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#D0E4FF</color>
    <color name="on_secondary_container">#001F3A</color>

    <!-- Tertiary - amber акцент (контрастный к orange primary, M3 Expressive) -->
    <color name="tertiary">#785A0B</color>
    <color name="on_tertiary">#FFFFFF</color>
    <color name="tertiary_container">#FFDF9C</color>
    <color name="on_tertiary_container">#261A00</color>

    <!-- Error - семантический цвет ошибок -->
    <color name="error">#BA1A1A</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#FFDAD6</color>
    <color name="on_error_container">#410002</color>

    <!-- Surface - основные цвета поверхности -->
    <color name="surface">#FEF8F6</color>
    <color name="on_surface">#1C1B1A</color>
    
    <!-- Surface variants для глубины и иерархии -->
    <color name="surface_container_lowest">#FFFFFF</color>
    <color name="surface_container_low">#FEF8F6</color>
    <color name="surface_container">#F0F0F0</color>
    <color name="surface_container_high">#E8E8E8</color>
    <color name="surface_container_highest">#E2E2E2</color>
    
    <color name="on_surface_variant">#494544</color>
    
    <!-- Outline и границы -->
    <color name="outline">#7C7775</color>
    <color name="outline_variant">#CDC6C4</color>

    <!-- Background -->
    <color name="background">#FEF8F6</color>
    <color name="on_background">#1C1B1A</color>

    <!-- Inverse цвета для состояний -->
    <color name="inverse_surface">#31302E</color>
    <color name="inverse_on_surface">#F5F0EE</color>
    <color name="inverse_primary">#FFB5A0</color>

    <!-- Shadow для elevation -->
    <color name="shadow">#000000</color>

    <!-- Scrim для модалок и overlay'ев (M3 стандарт: 32% черного) -->
    <color name="scrim_overlay">#52000000</color>

    <!-- Surface Tint для динамических цветов -->
    <color name="surface_tint">#FF6B35</color>

    <!-- Status bar (light theme) -->
    <color name="status_bar">#F5F0EE</color>

    <!-- Success цвет -->
    <color name="success">#2E7D32</color>
    <color name="on_success">#FFFFFF</color>
    <color name="success_container">#C8E6C9</color>
    <color name="on_success_container">#1B5E20</color>
    
    <!-- Warning цвет -->
    <color name="warning">#F57C00</color>
    <color name="on_warning">#FFFFFF</color>
    <color name="warning_container">#FFE0B2</color>
    <color name="on_warning_container">#E65100</color>

    <!-- Onboarding: остался только success-чип «Онлайн» в карточке ноды. Это семантика
         (как presence-зелёный), поэтому статичен и не следует Dynamic Color. Остальные
         цвета онбординга переведены на роли темы (?attr/...). -->
    <color name="onboarding_success_background">#E4F6EA</color>
    <color name="onboarding_success_text">#1F7A45</color>

    <!-- User profiles: Android 12+ dynamic Material You palette. -->
    <color name="profile_accent">@android:color/system_accent1_600</color>
    <color name="profile_on_accent">@android:color/system_neutral1_50</color>
    <color name="profile_surface">@android:color/system_neutral1_50</color>
    <color name="profile_elem">@android:color/system_neutral1_100</color>
    <color name="profile_elem_2">@android:color/system_neutral1_200</color>
    <color name="profile_accent_soft">@android:color/system_accent1_100</color>
    <color name="profile_text">@android:color/system_neutral1_900</color>
    <color name="profile_text_dim">@android:color/system_neutral2_700</color>
    <color name="profile_outline">@android:color/system_neutral2_300</color>
    <color name="profile_chip_text">@android:color/system_accent1_700</color>
    <color name="profile_presence_online">#3EC46D</color>

    <!-- Settings 2a: roles follow the current system accent instead of a fixed brown seed. -->
    <color name="profile_settings_background">@android:color/system_neutral1_50</color>
    <color name="profile_settings_surface">@android:color/system_neutral1_0</color>
    <color name="profile_settings_primary">@android:color/system_accent1_600</color>
    <color name="profile_settings_on_primary_container">@android:color/system_neutral1_50</color>
    <color name="profile_settings_on_surface">@android:color/system_neutral1_900</color>
    <color name="profile_settings_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="profile_settings_icon">@android:color/system_neutral2_700</color>
    <color name="profile_settings_error_container">@color/error_container</color>
    <color name="profile_settings_on_error_container">@color/on_error_container</color>
    <color name="profile_settings_ripple">#1F000000</color>
    <color name="profile_settings_tonal_container">@android:color/system_accent1_100</color>
    <color name="profile_settings_on_tonal_container">@android:color/system_accent1_700</color>
    <color name="profile_settings_divider">@android:color/system_neutral2_200</color>
    <color name="profile_settings_switch_off_track">@android:color/system_neutral2_200</color>
    <color name="profile_settings_switch_off_thumb">@android:color/system_neutral2_500</color>
    <color name="profile_settings_info_container">@android:color/system_accent2_100</color>

    <!-- Floating navigation fallback roles use the system dynamic palette. -->
    <color name="floating_nav_group">@android:color/system_neutral1_100</color>
    <color name="floating_nav_inactive">@android:color/system_neutral1_50</color>
    <color name="floating_nav_inactive_content">@android:color/system_neutral2_700</color>
    <color name="floating_nav_active">@android:color/system_accent1_600</color>
    <color name="floating_nav_active_content">@android:color/system_neutral1_50</color>
    <color name="floating_nav_fab">@android:color/system_accent1_100</color>
    <color name="floating_nav_fab_content">@android:color/system_accent1_700</color>
    <color name="floating_nav_badge">@android:color/system_neutral1_0</color>
    <color name="floating_nav_badge_text">@android:color/system_accent1_700</color>
    <color name="floating_nav_update_badge">@color/error</color>

    <!-- Widget colors (Material You / Android 12+ system tokens, light theme defaults) -->
    <color name="widget_background_color">@android:color/system_neutral1_50</color>
    <color name="widget_text_primary">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_accent_color">@android:color/system_accent1_600</color>
    <color name="widget_accent_text">@android:color/white</color>
</resources>
