<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!-- Хост только для instrumentation-тестов прокрутки: объявлен в debug-манифесте
             приложения, чтобы запускаться в процессе com.barkfluff.client (startActivitySync
             отвергает компоненты тестового APK как чужой процесс) и видеть стили приложения.
             В release-сборки не попадает. -->
        <activity
            android:name="com.barkfluff.client.chat.MessageScrollHostActivity"
            android:exported="false" />
    </application>
</manifest>
