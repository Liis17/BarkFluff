<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.Core" Version="4.0.102.9" />
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
      <PackageReference Include="Grpc.AspNetCore.Server" Version="2.84.0" />
      <PackageReference Include="Grpc.Tools" Version="2.84.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    </ItemGroup>

    <!--
      Черновые контракты федерации (Фаза 0 rearch): пока не подключены ни в один
      сервис (Federation-сервис появится в Фазе 1). Компилируются здесь, чтобы
      codegen валидировал синтаксис/импорты при сборке — иначе эти два файла
      никем не собираются вообще.
    -->
    <ItemGroup>
      <Protobuf Include="federation_api.proto" GrpcServices="Server" />
      <Protobuf Include="federation_internal_api.proto" GrpcServices="Server" />
    </ItemGroup>

</Project>
