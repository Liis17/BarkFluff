    "settings.security.storage.switch_confirm.message %@ %@": {
      "comment": "A confirmation dialog message that asks the user to confirm switching to a new token storage type. The message includes the name of the new storage type and any associated warning message.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
