    "token_storage.user_defaults.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored within the app. Safe for most cases. No password prompt at launch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранение в памяти приложения. Безопасно для большинства случаев. Не требует пароль при запуске."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento en la app. Seguro en la mayoría de los casos. Sin solicitud de contraseña al iniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储在应用内。适用于大多数情况。启动时不需要密码。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherung innerhalb der App. Für die meisten Fälle sicher. Keine Passwortabfrage beim Start."
          }
        }
      }
    },
    "token_storage.user_defaults.name": {
      "localizations": {
        "en": {
