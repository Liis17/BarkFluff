    "settings.language.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When set to “System”, the app follows the device language. If the device language is neither Russian nor English, English is used."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выборе «Системный» язык приложения следует за языком устройства. Если язык устройства не русский и не английский, используется английский."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está en «Sistema», la app sigue el idioma del dispositivo. Si el idioma del dispositivo no es ruso, inglés, español, chino ni alemán, se usa inglés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置为「系统」时，应用将跟随设备语言。如果设备语言不是俄语、英语、西班牙语、中文或德语，则使用英语。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei «System» folgt die App der Gerätesprache. Wenn die Gerätesprache weder Russisch, Englisch, Spanisch, Chinesisch noch Deutsch ist, wird Englisch verwendet."
          }
        }
      }
    },
