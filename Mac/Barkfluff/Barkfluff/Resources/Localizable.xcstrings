    "settings.security.storage.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization tokens are stored on the device. iCloud lets you sync them between devices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токены авторизации хранятся на устройстве. iCloud позволяет синхронизировать их между устройствами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens de autorización se guardan en el dispositivo. iCloud permite sincronizarlos entre dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权令牌存储在设备上。iCloud 允许在设备之间同步它们。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisierungstoken werden auf dem Gerät gespeichert. iCloud ermöglicht die Synchronisierung zwischen Geräten."
          }
        }
      }
