    "token_storage.keychain.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted storage in the system Keychain. May prompt for a password at launch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованное хранение в системном Keychain. Может запрашивать пароль при запуске."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento cifrado en el Keychain del sistema. Puede solicitar contraseña al iniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统 Keychain 中加密存储。启动时可能要求输入密码。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Speicherung im System-Keychain. Kann beim Start ein Passwort verlangen."
          }
        }
      }
    },
