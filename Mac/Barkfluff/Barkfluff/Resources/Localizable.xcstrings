    "token_storage.keychain_icloud.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync tokens across devices via iCloud. Requires a password at launch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация токенов между устройствами через iCloud. Требует пароль при запуске."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización de tokens entre dispositivos vía iCloud. Requiere contraseña al iniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iCloud 在设备间同步令牌。启动时需要密码。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation der Token zwischen Geräten über iCloud. Erfordert ein Passwort beim Start."
          }
        }
      }
    },
