<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Фон окна  -->
    <SolidColorBrush x:Key="BackgroundWindow" Color="Transparent" />

    <!--  Цвета для главной страници мессенджера  -->
    <SolidColorBrush x:Key="OverlayColor" Color="#80000000" />
    <SolidColorBrush x:Key="OpenChatBackgroundColor" Color="#10000000" />

    <!--  Заголовоки  -->
    <SolidColorBrush x:Key="SubtitleText" Color="#FFF39E6D" />
    <SolidColorBrush x:Key="TitleText" Color="#1a1a1a" />
    <SolidColorBrush x:Key="DescriptionText" Color="#FF565656" />
    <SolidColorBrush x:Key="TipsColor" Color="#666666" />

    <!--  Цвета бордера  -->
    <SolidColorBrush x:Key="BorderBlock" Color="#ffffff" />

    <!--  КНОПКИ  -->
    <SolidColorBrush x:Key="ButtonText" Color="#1a1a1a" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#e6e6e6" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#B2B2B2" />
    <Color
        x:Key="ButtonDropShadow"
        A="255"
        B="118"
        G="118"
        R="118" />
    <SolidColorBrush x:Key="ButtonMouseOverBackground" Color="#cccaca" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#cccaca" />

    <!--  Всегда статичные  -->
    <SolidColorBrush x:Key="RequiredButtonText" Color="White" />
    <SolidColorBrush x:Key="RequiredButtonBackground" Color="#df5000" />
    <Color
        x:Key="RequiredButtonDropShadow"
        A="255"
        B="0"
        G="80"
        R="255" />
    <SolidColorBrush x:Key="RequiredButtonMouseOverBackground" Color="#FFC54700" />
    <SolidColorBrush x:Key="RequiredButtonPressedBackground" Color="#FFAB3D00" />

    <!--  текстовые поля (+пинкод триггеры)  -->
    <SolidColorBrush x:Key="TextCaretBrush" Color="#df5000" />
    <SolidColorBrush x:Key="TextGlowBrush" Color="#df5000" />
    <SolidColorBrush x:Key="TextBorderBrush" Color="#9c9c9c" />
    <SolidColorBrush x:Key="TextForegraund" Color="#1a1a1a" />
    <SolidColorBrush x:Key="TextBackground" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#333333" />
    <SolidColorBrush x:Key="TextIcon" Color="#FFF39E6D" />
    <SolidColorBrush x:Key="TextHyperlink" Color="#FFF39E6D" />

    <!--  Сепараторы  -->
    <SolidColorBrush x:Key="SeparatorBackground" Color="#777777" />

    <!--  Круг для отображения статуса действия  -->
    <SolidColorBrush x:Key="StepCircleBackground" Color="#df5000" />
    <SolidColorBrush x:Key="StepCircleForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="StepCircleSuccesForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="StepCircleDisableForeground" Color="#777777" />
    <SolidColorBrush x:Key="StepCircleDisableBackground" Color="#404040" />
    <SolidColorBrush x:Key="StepCircleSuccesBackground" Color="#51ab29" />

    <!--  Индикатор попыток пароля  -->
    <SolidColorBrush x:Key="PasswordAttemptIndicator" Color="#51ab29" />

    <SolidColorBrush x:Key="ProgressRingColor" Color="#df5000" />
    <SolidColorBrush x:Key="ProgressRingAlternativeColor" Color="#FF3D38DE" />

</ResourceDictionary>