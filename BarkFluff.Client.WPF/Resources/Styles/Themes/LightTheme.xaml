<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  главное  -->
    <SolidColorBrush x:Key="BackgroundWindow" Color="#ffffff" />
    <SolidColorBrush x:Key="SubtitleText" Color="#FFF39E6D" />
    <SolidColorBrush x:Key="TitleText" Color="#1a1a1a" />
    <SolidColorBrush x:Key="DescriptionText" Color="#FF565656" />
    <SolidColorBrush x:Key="BorderBlock" Color="#FFEDEDED" />

    <!--  кнопки  -->
    <SolidColorBrush x:Key="ButtonText" Color="#1a1a1a" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#B0B0B0" />

    <SolidColorBrush x:Key="RequiredButtonText" Color="White" />




</ResourceDictionary>
