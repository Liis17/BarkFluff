<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  главное  -->
    <SolidColorBrush x:Key="BackgroundWindow" Color="#202020" />
    <SolidColorBrush x:Key="SubtitleText" Color="#FFF39E6D" />
    <SolidColorBrush x:Key="TitleText" Color="#f1f1f1" />
    <SolidColorBrush x:Key="DescriptionText" Color="#B0B0B0" />
    <SolidColorBrush x:Key="BorderBlock" Color="#242424" />

    <!--  кнопки  -->
    <SolidColorBrush x:Key="ButtonText" Color="#f1f1f1" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#B0B0B0" />

    <SolidColorBrush x:Key="RequiredButtonText" Color="White" />



</ResourceDictionary>
