<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Текст на кнопке  -->
    <Style x:Key="MainButtonTextLeft" TargetType="ui:TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="35,0,0,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="MainButtonTextRight" TargetType="ui:TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,35,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="MainButtonTextSingle" TargetType="ui:TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="35,0,35,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="ButtonSymbolRight" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="10,0,35,0" />
    </Style>
    <Style x:Key="ButtonSymbolLeft" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="35,0,10,0" />
    </Style>
    <Style x:Key="ButtonSymbolSingle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="35,0,35,0" />
    </Style>

    <!--  Главный стиль кнопки  -->
    <Style x:Key="MainButton" TargetType="{x:Type ui:Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Padding" Value="55,112" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="#df5000" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MouseOverBackground" Value="#FFC54700" />
        <Setter Property="PressedBackground" Value="#FFAB3D00" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>




    <Style x:Key="MinimalTextBox" TargetType="ui:TextBox">
        <Setter Property="Background" Value="#282828" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="15,12" />
        <Setter Property="BorderBrush" Value="#404040" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="PlaceholderEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <Grid>
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                            <TextBlock
                                x:Name="PlaceholderTextBlock"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Foreground="#FF9E9E9E"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding PlaceholderText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                                                    <Condition Binding="{Binding PlaceholderEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#6D90F3" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#505050" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Стиль для текстового поля ввода сообщения (прозрачный фон, без рамки)  -->
    <Style
        x:Key="MessageInputTextBox"
        BasedOn="{StaticResource MinimalTextBox}"
        TargetType="ui:TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="-5,10" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="InfoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#B0B0B0" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="MinimalPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#282828" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="15,12" />
        <Setter Property="BorderBrush" Value="#404040" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#6D90F3" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#505050" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerificationTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#282828" />
        <Setter Property="Width" Value="45" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MaxLength" Value="1" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderBrush" Value="#404040" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#6D90F3" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#505050" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  Windows 11 style card container  -->
    <Style x:Key="Win11CardStyle" TargetType="Border">
        <Setter Property="Background" Value="#2D2D2D" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BorderBrush" Value="#3D3D3D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="20"
                    Direction="270"
                    Opacity="0.3"
                    ShadowDepth="6"
                    Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Windows 11 style accent button for PIN code pages  -->
    <Style x:Key="Win11AccentButton" TargetType="{x:Type ui:Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,24,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="#df5000" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MouseOverBackground" Value="#FF6B1A" />
        <Setter Property="PressedBackground" Value="#C44700" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <Grid>
                        <Border
                            x:Name="ShadowBorder"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="12"
                                    Direction="270"
                                    Opacity="0.4"
                                    ShadowDepth="3"
                                    Color="#df5000" />
                            </Border.Effect>
                        </Border>
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.5"
                                        ShadowDepth="4"
                                        Color="#df5000" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Direction="270"
                                        Opacity="0.3"
                                        ShadowDepth="2"
                                        Color="#df5000" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!--  Windows 11 style accent button for PIN code pages  -->
    <Style x:Key="Win11Default" TargetType="{x:Type ui:Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="35" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="#2d2d2d" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MouseOverBackground" Value="#2f2f2f" />
        <Setter Property="PressedBackground" Value="#3d3d3d" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <Grid>
                        <Border
                            x:Name="ShadowBorder"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="12"
                                    Direction="270"
                                    Opacity="0.4"
                                    ShadowDepth="3"
                                    Color="#2d2d2d" />
                            </Border.Effect>
                        </Border>
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.5"
                                        ShadowDepth="4"
                                        Color="#1f1f1f" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Direction="270"
                                        Opacity="0.3"
                                        ShadowDepth="2"
                                        Color="#2d2d2d" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!--  Windows 11 style danger button  -->
    <Style x:Key="Win11DangerButton" TargetType="{x:Type ui:Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="#D42020" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MouseOverBackground" Value="#E63030" />
        <Setter Property="PressedBackground" Value="#B01818" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Button}">
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="LinkTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6D90F3" />
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextDecorations" Value="None" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#5A7AE6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,30" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="AdwaitaSans" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>


    <!--  текстовое поле ввода у чата  -->

    <Style x:Key="TextField" TargetType="ui:TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TextBox">
                    <Grid>
                        <Border
                            x:Name="ContentBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ui:PassiveScrollViewer x:Name="PART_ContentHost" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock
                                    x:Name="Placeholder"
                                    Foreground="{DynamicResource TextBoxPlaceholderForegroundBrush}"
                                    Text="{TemplateBinding PlaceholderText}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border
                            x:Name="AccentBorder"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="15" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AccentBorder" Property="BorderBrush" Value="Red" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="AccentBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="AccentBorder" Property="BorderBrush" Value="Bisque" />
                        </Trigger>
                        <Trigger Property="PlaceholderEnabled" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!--  новые стили для страницы профиля  -->

    <!--  Цвета для темы  -->
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FF4C6EF5" />
    <SolidColorBrush x:Key="SystemAccentColorLightBrush" Color="#E3F2FD" />
    <SolidColorBrush x:Key="SystemAccentColorDarkBrush" Color="#1976D2" />

    <!--  Фоны карточек  -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />

    <!--  Темная тема  -->
    <SolidColorBrush x:Key="CardBackgroundBrushDark" Color="#FF2D2D30" />

    <!--  Текстовые кисти  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF666666" />

    <!--  Темная тема для текста  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrushDark" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrushDark" Color="#FFAAAAAA" />

    <!--  Контрольные кисти  -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrushDark" Color="#FF404040" />

    <!--  Динамические ресурсы с поддержкой темной темы  -->
    <Style x:Key="DynamicCardBackground" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.GradientCaptions}}" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DynamicTextPrimary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DynamicTextSecondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Градиент для профиля  -->
    <LinearGradientBrush x:Key="ProfileHeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF6B73FF" />
        <GradientStop Offset="1" Color="#FF9854FF" />
    </LinearGradientBrush>

    <!--  Альтернативные градиенты  -->
    <LinearGradientBrush x:Key="ProfileHeaderGradientBlue" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF667EEA" />
        <GradientStop Offset="1" Color="#FF764BA2" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProfileHeaderGradientGreen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF11998E" />
        <GradientStop Offset="1" Color="#FF38EF7D" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProfileHeaderGradientOrange" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFA709A" />
        <GradientStop Offset="1" Color="#FFFEE140" />
    </LinearGradientBrush>

    <!--  Стиль для баджей  -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SystemAccentColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Стили для разных типов баджей  -->
    <Style
        x:Key="VipBadgeStyle"
        BasedOn="{StaticResource BadgeStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="Gold" />
    </Style>

    <Style
        x:Key="VerifiedBadgeStyle"
        BasedOn="{StaticResource BadgeStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="LightBlue" />
    </Style>

    <Style
        x:Key="PopularBadgeStyle"
        BasedOn="{StaticResource BadgeStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="Orange" />
    </Style>

    <!--  Стиль для информационных карточек  -->
    <Style x:Key="InfoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <!--  Hover эффект  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SystemAccentColorLightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Стиль для активной вкладки  -->
    <Style x:Key="ActiveTabButtonStyle" TargetType="ui:Button">
        <Setter Property="Background" Value="{StaticResource SystemAccentColorLightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SystemAccentColorDarkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SystemAccentColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
