    <Style x:Key="PinCodeTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource TextBackground}" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="MaxLength" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegraund}" />
        <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextCaretBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!--  Shadow effect layer  -->
                        <Border
                            x:Name="ShadowBorder"
                            Background="Transparent"
                            CornerRadius="14" />
                        <!--  Main content border  -->
                        <Border
                            x:Name="ContentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!--  Focus glow effect  -->
                        <Border
                            x:Name="FocusGlow"
                            Background="Transparent"
                            BorderBrush="{DynamicResource TextGlowBrush}"
                            BorderThickness="2"
                            CornerRadius="14"
                            Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextGlowBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextBackground}" />
                            <Setter TargetName="FocusGlow" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextBorderBrush}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextBackground}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="{x:Type ui:TextBox}">
        <!--  Основные цвета (можно вынести в ресурсы, но здесь для наглядности)  -->
        <Setter Property="Background" Value="{DynamicResource TextBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegraund}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextCaretBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="56" />

        <!--  Шрифты  -->
        <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />

        <!--  Выравнивание  -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="4" />

        <!--  Включаем возможность скролла, если текста много  -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:TextBox}">
                    <Border
                        x:Name="BorderElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                        <Grid>
                            <!--  Плейсхолдер (Текст-подсказка)  -->
                            <TextBlock
                                x:Name="PlaceholderTextElement"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{DynamicResource TextPlaceholder}"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding PlaceholderText}"
                                Visibility="Collapsed" />

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="0"
                                Padding="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsTabStop="False" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  Логика показа Плейсхолдера: Если текста нет - показываем  -->
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PlaceholderTextElement" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderTextElement" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Смена цвета рамки при фокусе  -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{DynamicResource TextGlowBrush}" />
                            <Setter TargetName="BorderElement" Property="Background" Value="{DynamicResource TextBackground}" />
                            <!--  Или другой цвет  -->
                        </Trigger>

                        <!--  Смена цвета при наведении мыши  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{DynamicResource TextGlowBrush}" />
                        </Trigger>

                        <!--  Состояние Disabled (неактивен)  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

