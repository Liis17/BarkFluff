<ui:FluentWindow
    x:Class="BarkFluff.Client.WPF.Debugs.DebugWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Debugs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:usercontrols="clr-namespace:BarkFluff.Client.WPF.UserControls"
    Title="DebugWindow"
    Width="1280"
    Height="720"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <ui:TitleBar
            Margin="80,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Panel.ZIndex="500"
            Cursor="" />
        <StackPanel
            Width="250"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="AliceBlue"
            Orientation="Vertical">
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="GetQrCodeToOtp"
                Content="Получить qr код для 2fa"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="ShowCompletionRegistrationWindow"
                Content="показать окно завершения регистарции"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <Separator Height="2" Background="Black" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="SimpleNotification"
                Content="Простое уведомление"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="AdvancedNotification"
                Content="Расширенное уведомление"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="ImageNotification"
                Content="Уведомление с картинкой"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <Separator Height="2" Background="Black" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="OpenCropper"
                Content="Открыть кропер"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="Openotp"
                Content="Открыть 2fa"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <Separator Height="2" Background="Black" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="CompressVideo"
                Content="Сжать видео"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="VoiceRecord"
                Content="Кнопка голосовухи"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="viewVoice"
                Content="Показать голосовуху"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />

            <Separator Height="2" Background="Black" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="OpenSendMessage"
                Content="Отправка сообщения"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="5"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="GetChats"
                Content="Получить чаты"
                CornerRadius="22"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00" />
        </StackPanel>
        <Grid
            x:Name="HolaBolaGrid"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="AliceBlue" />

    </Grid>
</ui:FluentWindow>
