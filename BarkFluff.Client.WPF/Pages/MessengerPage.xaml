<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.MessengerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Tag="MessengerPage - Главная страница мессенджера"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="SlideDownAndFadeIn">
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="-350"
                To="0"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ExpandAnimation">
            <DoubleAnimation
                Storyboard.TargetName="SearchResultList"
                Storyboard.TargetProperty="Height"
                To="550"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CollapseAnimation">
            <DoubleAnimation
                Storyboard.TargetName="SearchResultList"
                Storyboard.TargetProperty="Height"
                To="0"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="MessageAppearAnimation">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="Width"
                From="500"
                To="200"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Universe">
        <!--  Грид затенения боковой панели  -->
        <Grid
            x:Name="OverlayPanel"
            Margin="-30"
            Panel.ZIndex="999"
            Background="{DynamicResource OverlayColor}"
            MouseDown="OverlayPanel_MouseDown"
            Visibility="Collapsed" />

        <!--  Грид затенения центрального блока  -->
        <Grid
            x:Name="OverlayCenter"
            Margin="-30"
            Panel.ZIndex="999"
            Background="{DynamicResource OverlayColor}"
            MouseDown="OverlayCenter_MouseDown"
            Visibility="Collapsed" />

        <!--  Attachment Preview Overlay  -->
        <Grid
            x:Name="AttachmentOverlay"
            Margin="-30"
            Panel.ZIndex="1001"
            Background="{DynamicResource OverlayColor}"
            Visibility="Collapsed">
            <uc:AttachmentPreviewOverlay
                x:Name="AttachmentPreview"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!--  Image Viewer Overlay  -->
        <Grid
            x:Name="ImageViewerOverlay"
            Margin="-30"
            Panel.ZIndex="1002"
            Visibility="Collapsed">
            <uc:ImageViewer x:Name="ImageViewer" Closed="OnImageViewerClosed" />
        </Grid>

        <!--  Video Player Overlay  -->
        <Grid
            x:Name="VideoPlayerOverlay"
            Margin="-30"
            Panel.ZIndex="1003"
            Visibility="Collapsed">
            <uc:VideoPlayer x:Name="VideoPlayer" Closed="OnVideoPlayerClosed" />
        </Grid>

        <!--  Боковая панель  -->
        <Grid
            x:Name="SidePanel"
            Width="300"
            Margin="-300,0,0,0"
            HorizontalAlignment="Left"
            Panel.ZIndex="1000"
            Background="Transparent"
            Loaded="SidePanel_Loaded" />

        <!--  Центральный блок для оверлеев  -->
        <Border
            x:Name="CenterPanel"
            Width="550"
            MaxHeight="1200"
            Margin="30,50,30,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="1000"
            CornerRadius="16"
            Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="30"
                    Direction="270"
                    Opacity="0.5"
                    ShadowDepth="10"
                    Color="#000000" />
            </Border.Effect>
            <!--  Динамический контент будет добавляться программно  -->
        </Border>

        <!--  Основной грид  -->
        <Grid
            x:Name="MainGrid"
            Margin="0,0,0,0"
            Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Grid.RenderTransform>

            <Border Grid.Row="0" BorderThickness="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="300"
                        Opacity="0.2"
                        ShadowDepth="2"
                        Color="Black" />
                </Border.Effect>

                <Grid Margin="12,-2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Кнопка бокового меню  -->
                    <Button
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OpenPanelClick"
                        Cursor="Hand"
                        ToolTip="Открыть боковое меню">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{DynamicResource TitleText}"
                            Symbol="Navigation20" />
                    </Button>

                    <!--  Заголовок приложения  -->

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="25"
                            Height="25"
                            Margin="0,0,5,0"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush ImageSource="https://image.barkfluff.com/apogeeavatar.png" Stretch="UniformToFill" />
                            </Border.Background>

                        </Border>

                    </StackPanel>

                    <StackPanel Margin="30,0,0,0" Orientation="Horizontal">
                        <!--  Аватар пользователя  -->
                        <Border
                            x:Name="AvatarTitleWindowButton"
                            Grid.Column="0"
                            Width="23"
                            Height="23"
                            Margin="2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            Cursor="Hand"
                            MouseLeftButtonUp="OpenCenterBlock"
                            Tag="UserProfile"
                            ToolTip="Открыть мой профиль">
                            <Border.Background>
                                <ImageBrush
                                    x:Name="AvatarTitleWindow"
                                    ImageSource="pack://application:,,,/BarkFluff;component/Resources/Placeholders/userplaceholder.png"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!--  Иконка обновления  -->
                        <Border
                            x:Name="UpdateIconBorder"
                            Grid.Column="0"
                            Width="25"
                            Height="25"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            Cursor="Hand"
                            MouseLeftButtonUp="OpenCenterBlock"
                            Tag="UpdateBlock"
                            ToolTip="Доступно обновление"
                            Visibility="Collapsed">
                            <ui:SymbolIcon
                                FontSize="23"
                                Foreground="#f8a644"
                                Symbol="ArrowCircleUp16"
                                ToolTip="Доступно обновление" />
                        </Border>
                        <!--  Иконка проблем с сетью  -->
                        <Border
                            x:Name="ErrorConnection"
                            Grid.Column="0"
                            Width="25"
                            Height="25"
                            Margin="2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            ToolTip="Проблемы с соединением"
                            Visibility="Collapsed">
                            <ui:SymbolIcon
                                FontSize="23"
                                Foreground="#fd354a"
                                Symbol="CloudError32"
                                ToolTip="Проблемы с соединением" />
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!--  Основная область с чатами и диалогом  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="350"
                        MinWidth="250"
                        MaxWidth="500" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!--  Панель списка чатов  -->

                <Border
                    Grid.Column="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource ChatListBackgroundColor}"
                    CornerRadius="0 15 0 0"
                    Style="{DynamicResource MainStyleBorder}">
                    <Grid Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Панель поиска  -->
                        <Border Grid.Row="0">
                            <Border
                                Margin="10,8"
                                Background="Transparent"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>



                                    <ui:TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="White"
                                        GotFocus="SearchTextBox_GotFocus"
                                        Icon="{ui:SymbolIcon ui:Symbol=Search48}"
                                        LostFocus="SearchTextBox_LostFocus"
                                        PlaceholderText="Поиск"
                                        TextChanged="SearchTextBox_TextChanged" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="#FF9E9E9E"
                                        IsHitTestVisible="False"
                                        Text="Поиск чатов...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                        </Border>

                        <!--  Список чатов  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Panel.ZIndex="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatList" Orientation="Vertical">
                                <!--  Тут будут появляться чаты  -->
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>
                <Grid
                    x:Name="SearchResultList"
                    Height="0"
                    Margin="10,45,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="200">
                    <Border Background="#2d2d30" CornerRadius="15" />
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock
                                x:Name="SearchResultsHeader"
                                Margin="8,0"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Результаты поиска" />
                            <StackPanel x:Name="SearchCollection" Orientation="Vertical" />
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                <!--  Разделитель с возможностью изменения размера  -->
                <GridSplitter
                    Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Cursor="SizeWE"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" Cursor="SizeWE">
                                <Border
                                    Width="1"
                                    Margin="0,45,0,55"
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5"
                                    Cursor="SizeWE"
                                    Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF6B73FF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!--  Область открытого диалога  -->
                <Border Grid.Column="2" Background="Transparent">

                    <Grid>

                        <Grid
                            x:Name="OpenedChat"
                            HorizontalAlignment="Stretch"
                            AllowDrop="True"
                            DragEnter="OpenedChat_DragEnter"
                            DragLeave="OpenedChat_DragLeave"
                            DragOver="OpenedChat_DragOver"
                            Drop="OpenedChat_Drop"
                            Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Заголовок диалога  -->
                            <Border Grid.Row="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        Padding="10,0,0,0"
                                        Background="#171717"
                                        CornerRadius="10,0,0,10"
                                        Opacity="0.8" />


                                    <!--  Информация о собеседнике  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Width="35"
                                            Height="35"
                                            Padding="-5"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="CloseChatButton"
                                            CornerRadius="30"
                                            Focusable="False">
                                            <ui:SymbolIcon
                                                FontSize="19"
                                                Foreground="Wheat"
                                                Symbol="ChevronLeft12" />
                                        </ui:Button>
                                        <Border
                                            x:Name="ChatAvatarButton"
                                            Width="35"
                                            Height="35"
                                            BorderBrush="Transparent"
                                            CornerRadius="30"
                                            Cursor="Hand"
                                            Focusable="False"
                                            MouseLeftButtonUp="OpenCenterBlock"
                                            Tag="UserProfile"
                                            ToolTip="Открыть профиль">
                                            <Border.Background>
                                                <ImageBrush
                                                    x:Name="ChatAvatar"
                                                    ImageSource="pack://application:,,,/BarkFluff;component/Resources/Placeholders/userplaceholder.png"
                                                    Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                x:Name="ChatTitleUsername"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor=""
                                                FontFamily="{DynamicResource AdwaitaSans}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="" />
                                            <TextBlock
                                                x:Name="UserOnlineTime"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource AdwaitaSans}"
                                                FontSize="12"
                                                Foreground="#b95d2c"
                                                Text="Неизвестно" />
                                        </StackPanel>

                                    </StackPanel>

                                    <!--  Кнопки действий  -->
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal" />
                                </Grid>
                            </Border>

                            <!--  Область сообщений  -->
                            <ScrollViewer
                                x:Name="MessageScrollViewer"
                                Grid.Row="1"
                                Padding="5,-45,15,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="-1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel
                                    x:Name="MessageArea"
                                    HorizontalAlignment="Stretch"
                                    Orientation="Vertical">
                                    <!--  Здесь будут добавляться элементы динамически  -->
                                </StackPanel>
                            </ScrollViewer>

                            <!--  Drag and Drop area  -->
                            <Grid
                                x:Name="DragDropOverlay"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Panel.ZIndex="2"
                                Visibility="Collapsed">

                                <!--  Центральный блок с информацией  -->
                                <Border
                                    MaxWidth="450"
                                    MaxHeight="300"
                                    Padding="40,30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#FF2A2A2A"
                                    BorderBrush="#FFCE6432"
                                    BorderThickness="2"
                                    CornerRadius="20">


                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <!--  Иконка с анимацией  -->
                                        <Border
                                            Width="120"
                                            Height="120"
                                            Background="#FF3C3C3C"
                                            CornerRadius="60">
                                            <ui:SymbolIcon
                                                FontSize="72"
                                                Foreground="#FFCE6432"
                                                Symbol="ArrowDownload24">
                                                <ui:SymbolIcon.RenderTransform>
                                                    <TranslateTransform x:Name="IconTransform" Y="0" />
                                                </ui:SymbolIcon.RenderTransform>
                                                <ui:SymbolIcon.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="IconTransform"
                                                                    Storyboard.TargetProperty="Y"
                                                                    From="-10"
                                                                    To="10"
                                                                    Duration="0:0:1">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ui:SymbolIcon.Triggers>
                                            </ui:SymbolIcon>
                                        </Border>

                                        <!--  Основной текст  -->
                                        <TextBlock
                                            Margin="0,25,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Отпустите для добавления" />

                                        <!--  Дополнительный текст  -->
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="14"
                                            Foreground="#FFAAAAAA"
                                            Text="Файлы будут добавлены к сообщению"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  Панель ввода сообщения  -->
                            <Border
                                x:Name="TFMBackground"
                                Grid.Row="2"
                                Margin="10,0,10,10"
                                Background="#171717"
                                CornerRadius="15"
                                Opacity="0.8">


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <VisualBrush Visual="{Binding ElementName=BackgroundChatImage}" />
                                        </Rectangle.Fill>
                                        <Rectangle.Effect>
                                            <BlurEffect Radius="10" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <!--  Кнопка прикрепления  -->
                                    <Button
                                        x:Name="AttachFileButton"
                                        Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        Margin="5,0,12,0"
                                        Padding="5"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="AttachFileButton_Click">
                                        <ui:SymbolIcon
                                            FontSize="40"
                                            Foreground="#FF9E9E9E"
                                            Symbol="Attach16" />
                                    </Button>

                                    <!--  Поле ввода  -->
                                    <ui:TextBox
                                        x:Name="TextForMessage"
                                        Grid.Column="1"
                                        MinHeight="45"
                                        VerticalAlignment="Center"
                                        AcceptsReturn="False"
                                        AcceptsTab="True"
                                        ClearButtonEnabled="False"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="15"
                                        IsTabStop="True"
                                        IsUndoEnabled="True"
                                        KeyDown="TextBox_KeyDown"
                                        KeyUp="TextForMessage_KeyUp"
                                        LostFocus="TextForMessage_LostFocus"
                                        PlaceholderEnabled="True"
                                        PlaceholderText="Сообщение"
                                        Style="{StaticResource MessageInputTextBox}"
                                        VerticalScrollBarVisibility="Auto" />

                                    <!--  Кнопка отправки  -->
                                    <Button
                                        Grid.Column="2"
                                        Width="40"
                                        Height="40"
                                        Margin="12,0,15,0"
                                        Background="#FFCE6432"
                                        BorderThickness="0"
                                        Click="SendMessage"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF5A64E6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <ui:SymbolIcon
                                            FontSize="20"
                                            Foreground="White"
                                            Symbol="Send16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border
                            x:Name="NoDialogMessage"
                            Width="400"
                            Height="200"
                            Style="{DynamicResource MainStyleBorder}">
                            <StackPanel
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical">
                                <ui:SymbolIcon
                                    Margin="30,0,30,10"
                                    Filled="True"
                                    FontSize="85"
                                    Foreground="{DynamicResource DescriptionText}"
                                    Symbol="ChatMultiple32" />
                                <ui:TextBlock
                                    Margin="30,0,30,0"
                                    Style="{DynamicResource DescriptionTextStyle}"
                                    Text="Чтобы начать диалог выберите чат из списка слева"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</UserControl>