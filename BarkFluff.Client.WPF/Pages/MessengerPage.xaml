<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.MessengerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Tag="MessengerPage - Главная страница мессенджера"
    mc:Ignorable="d">
    <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource AdwaitaSans}"
            FontSize="24"
            FontWeight="SemiBold"
            Foreground="White"
            Text="Добро пожаловать в мессенджер BarkFluff!"
            TextAlignment="Center" />
    </Grid>
</UserControl>
