<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.MessengerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Tag="MessengerPage - Главная страница мессенджера"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="SlideDownAndFadeIn">
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="-350"
                To="0"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ExpandAnimation">
            <DoubleAnimation
                Storyboard.TargetName="SearchResultList"
                Storyboard.TargetProperty="Height"
                To="550"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CollapseAnimation">
            <DoubleAnimation
                Storyboard.TargetName="SearchResultList"
                Storyboard.TargetProperty="Height"
                To="0"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="MessageAppearAnimation">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetProperty="Width"
                From="500"
                To="200"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Universe">
        <!--  Грид затенения боковой панели  -->
        <Grid
            x:Name="OverlayPanel"
            Margin="-30"
            Panel.ZIndex="999"
            Background="#80000000"
            MouseDown="OverlayPanel_MouseDown"
            Visibility="Collapsed" />

        <!--  Грид затенения центрального блока  -->
        <Grid
            x:Name="OverlayCenter"
            Margin="-30"
            Panel.ZIndex="999"
            Background="#80000000"
            MouseDown="OverlayCenter_MouseDown"
            Visibility="Collapsed" />

        <!--  Attachment Preview Overlay  -->
        <Grid
            x:Name="AttachmentOverlay"
            Margin="-30"
            Panel.ZIndex="1001"
            Background="#80000000"
            Visibility="Collapsed">
            <uc:AttachmentPreviewOverlay
                x:Name="AttachmentPreview"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!--  Боковая панель  -->
        <Grid
            x:Name="SidePanel"
            Width="300"
            Margin="-300,0,0,0"
            HorizontalAlignment="Left"
            Panel.ZIndex="1000"
            Background="Transparent"
            Loaded="SidePanel_Loaded" />

        <Border
            x:Name="CenterPanel"
            Width="550"
            MaxHeight="700"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="1000"
            CornerRadius="16"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="30"
                    Direction="270"
                    Opacity="0.5"
                    ShadowDepth="10"
                    Color="#000000" />
            </Border.Effect>
            <!--  Динамический контент будет добавляться программно  -->
        </Border>

        <!--  Основной грид  -->
        <Grid
            x:Name="MainGrid"
            Margin="0,0,0,0"
            Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <TranslateTransform X="0" Y="0" />
            </Grid.RenderTransform>

            <Border Grid.Row="0" BorderThickness="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="300"
                        Opacity="0.2"
                        ShadowDepth="2"
                        Color="Black" />
                </Border.Effect>

                <Grid Margin="12,-2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Кнопка бокового меню  -->
                    <Button
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OpenPanelClick"
                        Cursor="Hand"
                        ToolTip="Открыть боковое меню">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="White"
                            Symbol="Navigation20" />
                    </Button>

                    <!--  Заголовок приложения  -->

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="25"
                            Height="25"
                            Margin="0,0,5,0"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush ImageSource="https://image.barkfluff.com/apogeeavatar.png" Stretch="UniformToFill" />
                            </Border.Background>

                        </Border>
                        <TextBlock
                            x:Name="TitleWindow"
                            VerticalAlignment="Center"
                            Cursor=""
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="AppName" />
                    </StackPanel>

                    <StackPanel Margin="30,0,0,0" Orientation="Horizontal">
                        <!--  Аватар пользователя  -->
                        <Border
                            x:Name="AvatarTitleWindowButton"
                            Grid.Column="0"
                            Width="23"
                            Height="23"
                            Margin="2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            Cursor="Hand"
                            MouseLeftButtonUp="OpenCenterBlock"
                            Tag="UserProfile"
                            ToolTip="Открыть мой профиль">
                            <Border.Background>
                                <ImageBrush
                                    x:Name="AvatarTitleWindow"
                                    ImageSource="pack://application:,,,/BarkFluff;component/Resources/Placeholders/userplaceholder.png"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!--  Иконка обновления  -->
                        <Border
                            Grid.Column="0"
                            Width="25"
                            Height="25"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            Cursor="Hand"
                            MouseLeftButtonUp="OpenCenterBlock"
                            Tag="UpdateBlock"
                            ToolTip="Открыть мой профиль">
                            <ui:SymbolIcon
                                FontSize="23"
                                Foreground="#f8a644"
                                Symbol="ArrowCircleUp16"
                                ToolTip="Доступно обновление" />
                        </Border>
                        <!--  Иконка проблем с сетью  -->
                        <Border
                            x:Name="ErrorConnection"
                            Grid.Column="0"
                            Width="25"
                            Height="25"
                            Margin="2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            Visibility="Collapsed"
                            ToolTip="Проблемы с соединением">
                            <ui:SymbolIcon
                                FontSize="23"
                                Foreground="#fd354a"
                                Symbol="CloudError32"
                                ToolTip="Проблемы с соединением" />
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!--  Основная область с чатами и диалогом  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="350"
                        MinWidth="250"
                        MaxWidth="500" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!--  Панель списка чатов  -->

                <Border Grid.Column="0" BorderThickness="0,0,1,0">
                    <Grid Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Панель поиска  -->
                        <Border Grid.Row="0">
                            <Border
                                Margin="10,8"
                                Background="Transparent"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>



                                    <ui:TextBox
                                        x:Name="SearchTextBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="White"
                                        GotFocus="SearchTextBox_GotFocus"
                                        Icon="{ui:SymbolIcon ui:Symbol=Search48}"
                                        LostFocus="SearchTextBox_LostFocus"
                                        PlaceholderText="Поиск"
                                        TextChanged="SearchTextBox_TextChanged" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="#FF9E9E9E"
                                        IsHitTestVisible="False"
                                        Text="Поиск чатов...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                        </Border>

                        <!--  Список чатов  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Panel.ZIndex="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatList" Orientation="Vertical">
                                <!--  Тут будут появляться чаты  -->
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>
                <Border
                    x:Name="EmptyChatListBlock"
                    Margin="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent">

                    <StackPanel
                        MaxWidth="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!--  Заголовок  -->
                        <TextBlock
                            Margin="0,0,0,180"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="White"
                            Opacity="0.4"
                            Text="Пока что здесь пусто"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid
                    x:Name="SearchResultList"
                    Height="0"
                    Margin="10,45,2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="200">
                    <Border Background="#2d2d30" CornerRadius="15" />
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock
                                x:Name="SearchResultsHeader"
                                Margin="8,0"
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Результаты поиска" />
                            <StackPanel x:Name="SearchCollection" Orientation="Vertical" />
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                <!--  Разделитель с возможностью изменения размера  -->
                <GridSplitter
                    Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Cursor="SizeWE"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" Cursor="SizeWE">
                                <Border
                                    Width="1"
                                    Margin="0,45,0,55"
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    CornerRadius="5"
                                    Cursor="SizeWE"
                                    Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF6B73FF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!--  Область открытого диалога  -->
                <Border Grid.Column="2" Background="Transparent">

                    <Grid>
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="15 0 0 15">
                            <Border.Background>
                                <ImageBrush
                                    x:Name="BackgroundChatImage"
                                    AlignmentX="Center"
                                    AlignmentY="Top"
                                    ImageSource="https://image.barkfluff.com/background.jpg"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Grid
                            x:Name="OpenedChat"
                            HorizontalAlignment="Stretch"
                            Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Заголовок диалога  -->
                            <Border Grid.Row="0">


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        Padding="10,0,0,0"
                                        Background="#171717"
                                        CornerRadius="10,0,0,10"
                                        Opacity="0.8" />


                                    <!--  Информация о собеседнике  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Width="35"
                                            Height="35"
                                            Padding="-5"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="CloseChatButton"
                                            CornerRadius="30"
                                            Focusable="False">
                                            <ui:SymbolIcon
                                                FontSize="19"
                                                Foreground="Wheat"
                                                Symbol="ChevronLeft12" />
                                        </ui:Button>
                                        <Border
                                            x:Name="ChatAvatarButton"
                                            Width="35"
                                            Height="35"
                                            BorderBrush="Transparent"
                                            CornerRadius="30"
                                            Cursor="Hand"
                                            Focusable="False"
                                            MouseLeftButtonUp="OpenCenterBlock"
                                            Tag="UserProfile"
                                            ToolTip="Открыть профиль">
                                            <Border.Background>
                                                <ImageBrush
                                                    x:Name="ChatAvatar"
                                                    ImageSource="pack://application:,,,/BarkFluff;component/Resources/Placeholders/userplaceholder.png"
                                                    Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                x:Name="ChatTitleUsername"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor=""
                                                FontFamily="{DynamicResource AdwaitaSans}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="" />
                                            <TextBlock
                                                x:Name="UserOnlineTime"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource AdwaitaSans}"
                                                FontSize="12"
                                                Foreground="#b95d2c"
                                                Text="Неизвестно" />
                                        </StackPanel>

                                    </StackPanel>

                                    <!--  Кнопки действий  -->
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal" />
                                </Grid>
                            </Border>

                            <!--  Область сообщений  -->
                            <ScrollViewer
                                x:Name="MessageScrollViewer"
                                Grid.Row="1"
                                Padding="5,-45,15,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="-1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel
                                    x:Name="MessageArea"
                                    HorizontalAlignment="Stretch"
                                    Orientation="Vertical">
                                    <!--  Здесь будут добавляться элементы динамически  -->
                                </StackPanel>
                            </ScrollViewer>

                            <!--  Панель ввода сообщения  -->
                            <Border
                                x:Name="TFMBackground"
                                Grid.Row="2"
                                Margin="10,0,10,10"
                                Background="#171717"
                                CornerRadius="15"
                                Opacity="0.8">


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <VisualBrush Visual="{Binding ElementName=BackgroundChatImage}" />
                                        </Rectangle.Fill>
                                        <Rectangle.Effect>
                                            <BlurEffect Radius="10" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <!--  Кнопка прикрепления  -->
                                    <Button
                                        x:Name="AttachFileButton"
                                        Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        Margin="5,0,12,0"
                                        Padding="5"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="AttachFileButton_Click">
                                        <ui:SymbolIcon
                                            FontSize="40"
                                            Foreground="#FF9E9E9E"
                                            Symbol="Attach16" />
                                    </Button>

                                    <!--  Attachment Menu Popup  -->
                                    <Popup
                                        x:Name="AttachmentMenuPopup"
                                        Grid.Column="0"
                                        AllowsTransparency="True"
                                        Placement="Top"
                                        PlacementTarget="{Binding ElementName=AttachFileButton}"
                                        StaysOpen="False">
                                        <Border
                                            Padding="4"
                                            Background="#FF3C3C3C"
                                            BorderBrush="#FF505050"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <Button
                                                    x:Name="AttachMediaButton"
                                                    Padding="12,10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="AttachMediaButton_Click"
                                                    FontFamily="{DynamicResource AdwaitaSans}"
                                                    FontSize="13"
                                                    Foreground="White">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon
                                                            Margin="0,0,8,0"
                                                            FontSize="18"
                                                            Symbol="Image20" />
                                                        <TextBlock VerticalAlignment="Center" Text="фото или видео" />
                                                    </StackPanel>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FF505050" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button
                                                    x:Name="AttachDocumentButton"
                                                    Padding="12,10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="AttachDocumentButton_Click"
                                                    FontFamily="{DynamicResource AdwaitaSans}"
                                                    FontSize="13"
                                                    Foreground="White">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon
                                                            Margin="0,0,8,0"
                                                            FontSize="18"
                                                            Symbol="Document20" />
                                                        <TextBlock VerticalAlignment="Center" Text="файл" />
                                                    </StackPanel>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FF505050" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <!--  Поле ввода  -->
                                    <ui:TextBox
                                        x:Name="TextForMessage"
                                        Grid.Column="1"
                                        MinHeight="45"
                                        VerticalAlignment="Center"
                                        AcceptsReturn="False"
                                        AcceptsTab="True"
                                        ClearButtonEnabled="False"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="15"
                                        IsTabStop="True"
                                        IsUndoEnabled="True"
                                        KeyDown="TextBox_KeyDown"
                                        KeyUp="TextForMessage_KeyUp"
                                        LostFocus="TextForMessage_LostFocus"
                                        PlaceholderEnabled="True"
                                        PlaceholderText="Сообщение"
                                        Style="{StaticResource MessageInputTextBox}"
                                        VerticalScrollBarVisibility="Auto" />

                                    <!--  Кнопка отправки  -->
                                    <Button
                                        Grid.Column="2"
                                        Width="40"
                                        Height="40"
                                        Margin="12,0,15,0"
                                        Background="#FFCE6432"
                                        BorderThickness="0"
                                        Click="SendMessage"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF5A64E6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <ui:SymbolIcon
                                            FontSize="20"
                                            Foreground="White"
                                            Symbol="Send16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</UserControl>