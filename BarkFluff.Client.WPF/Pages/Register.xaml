<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crop="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1980"
    d:DesignWidth="720"
    mc:Ignorable="d">



    <Grid>

        <StackPanel
            x:Name="TitleServerNameBar"
            Margin="25,-250,25,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="32"
                FontWeight="Black"
                Foreground="White"
                Loaded="TextBlock_Loaded"
                Opacity="1"
                Text="servername"
                TextAlignment="Center"
                TextWrapping="WrapWithOverflow" />
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="15"
                FontWeight="Medium"
                Foreground="White"
                Opacity="0.8"
                Text="Регистрация" />
        </StackPanel>
        <Grid
            x:Name="MainGrid"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        <StackPanel
            x:Name="MainContainer"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Loaded="MainContainer_Loaded"
            Orientation="Vertical">

            <StackPanel
                x:Name="Step1"
                MinWidth="300"
                MaxWidth="300"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    MaxWidth="300"
                    Margin="5,0,5,0"
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.8"
                    Text="Имя*" />
                <ui:TextBox
                    x:Name="FirstNameEnter"
                    KeyDown="TextBox_KeyDown"
                    PlaceholderText="Апогея"
                    Tag="Names"
                    TextChanged="Enter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
                <TextBlock
                    Margin="5,0,5,0"
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.8"
                    Text="Фамилия" />
                <ui:TextBox
                    x:Name="LastNameEnter"
                    KeyDown="TextBox_KeyDown"
                    PlaceholderText="Тайнигейпиратовна"
                    TextChanged="Enter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
                <StackPanel Margin="5,0,5,0" Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="FontFamily" Value="AdwaitaSans" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Light" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="● Имя может содержать любые символы" />
                    <TextBlock Text="● Минимально может быть 3 символа" />
                    <TextBlock Text="● Длинна имени и фамилии ограничена 40 символами" />
                    <TextBlock Text="● Фамилия может отсутствовать" />
                </StackPanel>


            </StackPanel>
            <StackPanel
                x:Name="Step2"
                MinWidth="300"
                MaxWidth="300"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    Margin="5,0,5,0"
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.8"
                    Text="Логин*" />
                <ui:TextBox
                    x:Name="LoginEnter"
                    MaxWidth="300"
                    KeyDown="TextBox_KeyDown"
                    PlaceholderText="Apogee"
                    TextChanged="Enter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
                <StackPanel Margin="5,7,5,0" Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="FontFamily" Value="AdwaitaSans" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Light" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="● Логин может содержать:" />
                    <TextBlock Margin="10,0,0,0" Text="- Символы латинского алфавита" />
                    <TextBlock Margin="10,0,0,0" Text="- Цифры" />
                    <TextBlock Margin="10,0,0,0" Text="- Нижнее подчеркивание ( _ ) и тире ( - )" />
                    <TextBlock Text="● Логин ограничен 30 символами" />
                    <TextBlock Text="● Логин будет преобразован в нижний регистр" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                x:Name="Step3"
                MinWidth="300"
                MaxWidth="300"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="#FFC3C3C3"
                    Text="Почта*" />
                <ui:TextBox
                    x:Name="EmailEnter"
                    MaxWidth="300"
                    KeyDown="TextBox_KeyDown"
                    PlaceholderText="apogee@barkfluff.ru"
                    TextChanged="Enter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
                <StackPanel Margin="5,7,5,0" Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="FontFamily" Value="AdwaitaSans" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Light" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="● Почта может использоваться для 2FA" />
                    <TextBlock Text="● Почта будет использоваться для сброса пароля" />
                    <TextBlock Text="● На почту будут отправляться уведомления о входе" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                x:Name="Step4"
                MinWidth="300 "
                MaxWidth="300"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="#FFC3C3C3"
                    Text="Код подтверждения*" />
                <ui:TextBox
                    x:Name="VerificationCodeEnter"
                    MaxWidth="300"
                    KeyDown="TextBox_KeyDown"
                    PlaceholderText="123456"
                    TextChanged="Enter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
                <StackPanel Margin="5,7,5,0" Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="FontFamily" Value="AdwaitaSans" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Light" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock x:Name="EmailHelperText" Text="● Сообщение отправлено на ''твою почту''" />
                    <TextBlock Text="● Проверьте папку со спамом" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                x:Name="Step5"
                MinWidth="300"
                MaxWidth="300"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,10,0,0"
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="#FFC3C3C3"
                    Text="Пароль*" />
                <ui:PasswordBox
                    x:Name="PasswordEnter"
                    KeyDown="TextBox_KeyDown"
                    PasswordChanged="PasspowrEnter_TextChanged"
                    PlaceholderText="password"
                    TextChanged="PasspowrEnter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />
                <ProgressBar
                    x:Name="PasswordStrengthBar"
                    Height="7"
                    Margin="0,2,0,0"
                    Background="#FF2A2A2A"
                    Foreground="Red"
                    Maximum="100"
                    Minimum="0"
                    Value="2" />
                <TextBlock
                    x:Name="PasswordDifficultyIndicator"
                    Margin="0,0,0,0"
                    FontFamily="AdwaitaSans"
                    FontSize="11"
                    FontWeight="Normal"
                    Foreground="#FFC3C3C3"
                    Text="Начните вводить пароль" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="#FFC3C3C3"
                    Text="Подтвердите пароль*" />
                <ui:PasswordBox
                    x:Name="PasswordRepeatedEnter"
                    MaxWidth="300"
                    KeyDown="TextBox_KeyDown"
                    PlaceholderText="password again"
                    TextChanged="Enter_TextChanged"
                    VerticalScrollBarVisibility="Auto" />

                <StackPanel Margin="5,7,5,0" Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="{x:Null}" />
                            <Setter Property="FontFamily" Value="AdwaitaSans" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="Light" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="● Сообщение отправлено на ''твою почту''" />
                    <TextBlock Text="● Проверьте папку со спамом" />
                </StackPanel>

            </StackPanel>
            <StackPanel
                x:Name="Step6"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <crop:CropImage
                    Width="500"
                    Height="600"
                    Panel.ZIndex="100" />
            </StackPanel>
        </StackPanel>
        <StackPanel
            x:Name="ButtonBottomBar"
            Margin="0,0,0,-260"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="ErrorMessageTextBlock"
                Background="{x:Null}"
                FontFamily="AdwaitaSans"
                FontSize="15"
                FontWeight="Medium"
                Foreground="#FFFF4646"
                Opacity="0.8"
                Text="Текст ошибки"
                TextAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button
                    x:Name="BackButtonx"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    Click="BackButton_Click"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            FontSize="20"
                            Foreground="White"
                            Symbol="ArrowLeft12" />
                        <TextBlock
                            Margin="0,0,5,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            FontFamily="AdwaitaSans"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Назад" />

                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="NextButton"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    Click="NextButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            FontFamily="AdwaitaSans"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Далее" />
                        <ui:SymbolIcon
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            FontSize="20"
                            Foreground="White"
                            Symbol="ArrowRight12" />
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="CreateButton"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    Click="Registration">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            FontFamily="AdwaitaSans"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Создать аккаунт" />
                        <ui:SymbolIcon
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            FontSize="20"
                            Foreground="White"
                            Symbol="Add12" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
