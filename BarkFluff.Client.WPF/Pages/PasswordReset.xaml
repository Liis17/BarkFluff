<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PasswordReset"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="2280"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="MinimalTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerificationTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6D90F3" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#5A7AE6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepIndicator" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="#404040" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style
            x:Key="ActiveStepIndicator"
            BasedOn="{StaticResource StepIndicator}"
            TargetType="Border">
            <Setter Property="Background" Value="#6D90F3" />
            <Setter Property="BorderBrush" Value="#6D90F3" />
        </Style>

        <Style
            x:Key="CompletedStepIndicator"
            BasedOn="{StaticResource StepIndicator}"
            TargetType="Border">
            <Setter Property="Background" Value="#28a745" />
            <Setter Property="BorderBrush" Value="#28a745" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="32"
                Height="32"
                Source="/Resources/Images/barkfluff_logo.png" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#FFF39E6D"
                Text="BarkFluff" />
        </StackPanel>

        <!--  Main Content  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,40,0,40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
                <StackPanel
                    MaxWidth="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Восстановление пароля" />

                    <TextBlock
                        Margin="0,0,0,40"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="Normal"
                        Foreground="#B0B0B0"
                        Text="Следуйте инструкциям для сброса пароля"
                        TextAlignment="Center" />

                    <!--  Progress Indicator  -->
                    <StackPanel
                        Margin="0,0,0,40"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Border x:Name="Step1Indicator" Style="{StaticResource ActiveStepIndicator}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                            <Rectangle
                                x:Name="StepLine1"
                                Width="30"
                                Height="2"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Fill="#404040" />
                            <Border x:Name="Step2Indicator" Style="{StaticResource StepIndicator}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                            <Rectangle
                                x:Name="StepLine2"
                                Width="30"
                                Height="2"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Fill="#404040" />
                            <Border x:Name="Step3Indicator" Style="{StaticResource StepIndicator}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="3" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 1: Email Input  -->
                    <StackPanel x:Name="Step1Panel" Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="18"
                            FontWeight="Medium"
                            Foreground="White"
                            Text="Введите email или имя пользователя"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,0,0,8"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            Foreground="#E0E0E0"
                            Text="@username или email" />
                        <TextBox
                            x:Name="EmailTextBox"
                            Margin="0,0,0,25"
                            Style="{StaticResource MinimalTextBox}" />

                        <ui:Button
                            x:Name="SendCodeButton"
                            Height="45"
                            Margin="0,0,0,20"
                            Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Background="#df5000"
                            BorderThickness="0"
                            Click="SendCodeButton_Click"
                            CornerRadius="22"
                            MouseOverBackground="#FFC54700"
                            PressedBackground="#FFAB3D00">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Отправить код" />
                                    <ui:SymbolIcon
                                        Margin="10,0,0,0"
                                        FontSize="16"
                                        Foreground="White"
                                        Symbol="Mail24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>

                    <!--  Step 2: Verification Code  -->
                    <StackPanel
                        x:Name="Step2Panel"
                        Orientation="Vertical"
                        Visibility="Visible">
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="18"
                            FontWeight="Medium"
                            Foreground="White"
                            Text="Введите код подтверждения"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,0,0,25"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            Foreground="#B0B0B0"
                            Text="Мы отправили 6-значный код на ваш email"
                            TextAlignment="Center" />

                        <!--  Verification Code Input  -->
                        <StackPanel
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="VerifyBox0"
                                Width="45"
                                Height="45"
                                Margin="4"
                                GotFocus="VerifyBox_GotFocus"
                                MaxLength="1"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource VerificationTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox1"
                                Width="45"
                                Height="45"
                                Margin="4"
                                GotFocus="VerifyBox_GotFocus"
                                MaxLength="1"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource VerificationTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox2"
                                Width="45"
                                Height="45"
                                Margin="4"
                                GotFocus="VerifyBox_GotFocus"
                                MaxLength="1"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource VerificationTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox3"
                                Width="45"
                                Height="45"
                                Margin="4"
                                GotFocus="VerifyBox_GotFocus"
                                MaxLength="1"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource VerificationTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox4"
                                Width="45"
                                Height="45"
                                Margin="4"
                                GotFocus="VerifyBox_GotFocus"
                                MaxLength="1"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource VerificationTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox5"
                                Width="45"
                                Height="45"
                                Margin="4"
                                GotFocus="VerifyBox_GotFocus"
                                MaxLength="1"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource VerificationTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                        </StackPanel>

                        <ui:Button
                            x:Name="VerifyCodeButton"
                            Height="45"
                            Margin="0,0,0,15"
                            Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Background="#df5000"
                            BorderThickness="0"
                            Click="VerifyCodeButton_Click"
                            CornerRadius="22"
                            MouseOverBackground="#FFC54700"
                            PressedBackground="#FFAB3D00">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Подтвердить код" />
                                    <ui:SymbolIcon
                                        Margin="10,0,0,0"
                                        FontSize="16"
                                        Foreground="White"
                                        Symbol="CheckmarkCircle24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="#FFF39E6D"
                            MouseLeftButtonDown="ResendCode_Click"
                            Style="{StaticResource LinkTextBlock}"
                            Text="Отправить код повторно" />
                    </StackPanel>

                    <!--  Step 3: New Password  -->
                    <StackPanel
                        x:Name="Step3Panel"
                        Orientation="Vertical"
                        Visibility="Visible">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="18"
                            FontWeight="Medium"
                            Foreground="White"
                            Text="Создайте новый пароль"
                            TextAlignment="Center" />

                        <TextBlock
                            Margin="0,0,0,8"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            Foreground="#E0E0E0"
                            Text="Новый пароль" />
                        <ui:PasswordBox
                            x:Name="PasswordEnter"
                            Margin="0,0,0,0"
                            PasswordChanged="NewPasswordBox_PasswordChanged"
                            TextChanged="NewPasswordBox_TextChanged" />
                        <ProgressBar
                            x:Name="PasswordStrengthBar"
                            Height="4"
                            Margin="0,0,0,5"
                            Background="#333333"
                            BorderThickness="0"
                            Foreground="#FF4646"
                            Maximum="100"
                            Minimum="0"
                            Value="2" />

                        <TextBlock
                            x:Name="PasswordDifficultyIndicator"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="#B0B0B0"
                            Text="Начните вводить пароль" />

                        <TextBlock
                            Margin="0,0,0,8"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            Foreground="#E0E0E0"
                            Text="Подтвердите пароль" />
                        <ui:PasswordBox x:Name="PasswordRepeatedEnter" Margin="0,0,0,25" />

                        <!--  Password Requirements  -->
                        <Border
                            Margin="0,0,0,25"
                            Padding="15"
                            Background="#1F1F1F"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Требования к паролю:" />
                                <TextBlock
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#B0B0B0"
                                    Text="• Минимум 8 символов" />
                                <TextBlock
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#B0B0B0"
                                    Text="• Содержит заглавные и строчные буквы" />
                                <TextBlock
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#B0B0B0"
                                    Text="• Содержит цифры" />
                            </StackPanel>
                        </Border>

                        <ui:Button
                            x:Name="ResetPasswordButton"
                            Height="45"
                            Margin="0,0,0,20"
                            Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Background="#df5000"
                            BorderThickness="0"
                            Click="ResetPasswordButton_Click"
                            CornerRadius="22"
                            MouseOverBackground="#FFC54700"
                            PressedBackground="#FFAB3D00">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Сохранить новый пароль" />
                                    <ui:SymbolIcon
                                        Margin="10,0,0,0"
                                        FontSize="16"
                                        Foreground="White"
                                        Symbol="Save24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>

                    <!--  Success Message  -->
                    <StackPanel
                        x:Name="SuccessPanel"
                        Orientation="Vertical"
                        Visibility="Visible">
                        <Border
                            Margin="0,0,0,25"
                            Padding="20"
                            Background="#1A332A"
                            BorderBrush="#28a745"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="32"
                                    Foreground="#28a745"
                                    Symbol="CheckmarkCircle24" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Пароль успешно изменен!"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#B0B0B0"
                                    Text="Теперь вы можете войти с новым паролем"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ui:Button
                            x:Name="BackToLoginButton"
                            Height="45"
                            Margin="0,0,0,20"
                            Padding="0,12"
                            HorizontalAlignment="Stretch"
                            Background="#df5000"
                            BorderThickness="0"
                            Click="BackToLoginButton_Click"
                            CornerRadius="22"
                            MouseOverBackground="#FFC54700"
                            PressedBackground="#FFAB3D00">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        FontSize="16"
                                        Foreground="White"
                                        Symbol="ArrowLeft24" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Вернуться к входу" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Foreground="#FFF39E6D"
                        MouseLeftButtonDown="BackToLogin_Click"
                        Style="{StaticResource LinkTextBlock}"
                        Text="Вернуться к входу" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Footer  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                Foreground="#666666"
                Text="2025 BarkFluff. Никакие права не защищены." />
        </StackPanel>
    </Grid>
</UserControl>
