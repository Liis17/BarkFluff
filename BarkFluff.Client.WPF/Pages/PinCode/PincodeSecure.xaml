<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.PincodeSecure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                Margin="40"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="32"
                FontWeight="Black"
                Foreground="White"
                Text="Введите код приложения" />
            <StackPanel
                x:Name="PinContainer"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBox
                    x:Name="Box0"
                    Width="40"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#282828"
                    BorderThickness="0"
                    CaretBrush="White"
                    FontSize="24"
                    FontWeight="Medium"
                    Foreground="White"
                    GotFocus="PinBox_GotFocus"
                    Loaded="FocusBoxZero"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box1"
                    Width="40"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#282828"
                    BorderThickness="0"
                    CaretBrush="White"
                    FontSize="24"
                    FontWeight="Medium"
                    Foreground="White"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box2"
                    Width="40"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#282828"
                    BorderThickness="0"
                    CaretBrush="White"
                    FontSize="24"
                    FontWeight="Medium"
                    Foreground="White"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box3"
                    Width="40"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#282828"
                    BorderThickness="0"
                    CaretBrush="White"
                    FontSize="24"
                    FontWeight="Medium"
                    Foreground="White"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                Opacity="0.7"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="key3"
                    Filled="True"
                    FontSize="17"
                    Foreground="Orange"
                    Symbol="Key16" />
                <ui:SymbolIcon
                    x:Name="key2"
                    Filled="True"
                    FontSize="17"
                    Foreground="Orange"
                    Symbol="Key16" />
                <ui:SymbolIcon
                    x:Name="key1"
                    Filled="True"
                    FontSize="17"
                    Foreground="Orange"
                    Symbol="Key16" />
            </StackPanel>
            <TextBlock
                x:Name="helper"
                Margin="10"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="15"
                FontWeight="Medium"
                Foreground="White"
                Opacity="0.8"
                Text="Текст предупреждения будет отображаться тут"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FF9A9A9A"
                Text="Проблемы со входом? Попробуйте сбросить приложение." />
            <StackPanel
                x:Name="ButtonStack"
                Loaded="ButtonStack_Loaded"
                Orientation="Vertical">
                <ui:Button
                    Width="200"
                    Height="45"
                    Margin="0,7,0,7"
                    HorizontalAlignment="Center"
                    Background="#FFD20505"
                    Click="RemoveSettings"
                    CornerRadius="22"
                    MouseOverBackground="#FFC54700"
                    Opacity="0.6"
                    PressedBackground="#FFAB3D00">
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontWeight="Medium"
                                Foreground="#ffffff"
                                Text="Сбросить приложение" />
                            <ui:SymbolIcon
                                Margin="5,0,0,0"
                                FontSize="17"
                                Foreground="#ffffff"
                                Symbol="Delete28" />
                        </StackPanel>

                    </ui:Button.Content>
                </ui:Button>
            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
