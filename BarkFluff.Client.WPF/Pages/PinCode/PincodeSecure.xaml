<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.PincodeSecure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="SlideDownAndFadeOut">
            <!--  Анимация перемещения вниз  -->
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0"
                To="100"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!--  Анимация исчезновения  -->
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                Margin="40"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="32"
                FontWeight="Black"
                Foreground="White"
                Text="Введите код приложения" />
            <StackPanel
                x:Name="PinContainer"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBox
                    x:Name="Box0"
                    GotFocus="PinBox_GotFocus"
                    Loaded="FocusBoxZero"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box1"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box2"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box3"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="PinBox_TextChanged" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                Opacity="0.7"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    x:Name="key3"
                    Filled="True"
                    FontSize="17"
                    Foreground="Orange"
                    Symbol="Key16" />
                <ui:SymbolIcon
                    x:Name="key2"
                    Filled="True"
                    FontSize="17"
                    Foreground="Orange"
                    Symbol="Key16" />
                <ui:SymbolIcon
                    x:Name="key1"
                    Filled="True"
                    FontSize="17"
                    Foreground="Orange"
                    Symbol="Key16" />
            </StackPanel>
            <TextBlock
                x:Name="helper"
                Margin="10"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="15"
                FontWeight="Medium"
                Foreground="White"
                Opacity="0.8"
                Text="Текст предупреждения будет отображаться тут"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FF9A9A9A"
                Text="Проблемы со входом? Попробуйте сбросить приложение." />
            <StackPanel
                x:Name="ButtonStack"
                Loaded="ButtonStack_Loaded"
                Orientation="Vertical">
                <ui:Button
                    Background="#FFD20505"
                    Click="RemoveSettings"
                    MouseOverBackground="#FFC54700"
                    Opacity="0.6"
                    PressedBackground="#FFAB3D00"
                    Style="{StaticResource MainButton}">
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Сбросить приложение" />
                            <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="Delete28" />
                        </StackPanel>

                    </ui:Button.Content>
                </ui:Button>
            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>