<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.PincodeSecure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="SlideDownAndFadeOut">
            <!--  Анимация перемещения вниз  -->
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0"
                To="100"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!--  Анимация исчезновения  -->
            <DoubleAnimation
                Storyboard.TargetName="MainGrid"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  Анимация тряски при неправильном вводе  -->
        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PinContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок (Стилистика регистрации)  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="28"
                    Height="28"
                    SnapsToDevicePixels="True"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="BarkFluff" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Normal"
                Foreground="#B0B0B0"
                Text="Вход в приложение" />
        </StackPanel>

        <!--  Основной контент с пинкодом  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <TextBlock
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Код доступа" />

            <!--  Карточка в стиле SetupPages  -->
            <Border
                Padding="40,35"
                Background="#1F1F1F"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Orientation="Vertical">

                    <!--  Контейнер PIN (С RenderTransform для анимации тряски)  -->
                    <StackPanel
                        x:Name="PinContainer"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel.RenderTransform>
                            <TranslateTransform />
                        </StackPanel.RenderTransform>

                        <!--  Поля ввода  -->
                        <TextBox
                            x:Name="Box0"
                            GotFocus="PinBox_GotFocus"
                            Loaded="FocusBoxZero"
                            PreviewKeyDown="PinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="PinBox_TextChanged" />
                        <TextBox
                            x:Name="Box1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="PinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="PinBox_TextChanged" />
                        <TextBox
                            x:Name="Box2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="PinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="PinBox_TextChanged" />
                        <TextBox
                            x:Name="Box3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="PinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="PinBox_TextChanged" />
                    </StackPanel>

                    <!--  Индикатор попыток  -->
                    <StackPanel
                        Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="13"
                            FontWeight="Normal"
                            Foreground="#888888"
                            Text="Попытки:" />

                        <!--  Индикаторы (Borders используются в коде для смены цвета)  -->
                        <Border
                            x:Name="key3"
                            Width="10"
                            Height="10"
                            Margin="4,0"
                            Background="#2D4A20"
                            CornerRadius="5" />
                        <Border
                            x:Name="key2"
                            Width="10"
                            Height="10"
                            Margin="4,0"
                            Background="#2D4A20"
                            CornerRadius="5" />
                        <Border
                            x:Name="key1"
                            Width="10"
                            Height="10"
                            Margin="4,0"
                            Background="#2D4A20"
                            CornerRadius="5" />
                    </StackPanel>

                    <!--  Текст подсказки  -->
                    <TextBlock
                        x:Name="helper"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        FontWeight="Normal"
                        Foreground="#FF9800"
                        Text=""
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Нижняя панель (Сброс)  -->
        <StackPanel
            x:Name="ButtonStack"
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Loaded="ButtonStack_Loaded"
            Orientation="Vertical">

            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                Foreground="#666666"
                Text="Забыли код доступа?" />

            <!--  Кнопка в стиле регистрации (используем ui:Button для единства стиля)  -->
            <ui:Button
                HorizontalAlignment="Center"
                Appearance="Danger"
                Click="RemoveSettings">
                <StackPanel Orientation="Horizontal" >
                    <ui:SymbolIcon Symbol="Delete24" />
                    <TextBlock Text="Сбросить настройки и войти" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>