<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.CreatePinCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.PinCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Основной контент (создание пин-кода)  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <!--  Заголовок  -->
            <TextBlock
                Margin="0,0,0,5"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Создание кода доступа" />
            <!--  Текст подсказки / статуса  -->
            <TextBlock
                x:Name="statusText"
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="Normal"
                Foreground="#E0E0E0"
                Opacity="0.8"
                Text="Введите четырехзначный пин-код и подтвердите его"
                TextAlignment="Center" />


            <!--  Первый блок - Придумайте пин-код  -->
            <TextBlock
                Margin="0,5,0,10"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="18"
                FontWeight="Normal"
                Foreground="#E0E0E0"
                Text="Придумайте код" />

            <!--  Первые поля для ввода  -->
            <StackPanel
                x:Name="FirstPinContainer"
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBox
                    x:Name="FirstBox0"
                    GotFocus="PinBox_GotFocus"
                    Loaded="FocusFirstBoxZero"
                    PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="FirstPinBox_TextChanged" />

                <TextBox
                    x:Name="FirstBox1"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="FirstPinBox_TextChanged" />

                <TextBox
                    x:Name="FirstBox2"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="FirstPinBox_TextChanged" />

                <TextBox
                    x:Name="FirstBox3"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="FirstPinBox_TextChanged" />
            </StackPanel>

            <!--  Второй блок - Подтверждение пин-кода  -->
            <TextBlock
                Margin="0,5,0,10"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="18"
                FontWeight="Normal"
                Foreground="#E0E0E0"
                Text="Подтвердите код" />

            <!--  Вторые поля для ввода (подтверждение)  -->
            <StackPanel
                x:Name="SecondPinContainer"
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBox
                    x:Name="SecondBox0"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="SecondPinBox_TextChanged" />

                <TextBox
                    x:Name="SecondBox1"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="SecondPinBox_TextChanged" />

                <TextBox
                    x:Name="SecondBox2"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="SecondPinBox_TextChanged" />

                <TextBox
                    x:Name="SecondBox3"
                    GotFocus="PinBox_GotFocus"
                    PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    Style="{StaticResource VerificationTextBox}"
                    TextChanged="SecondPinBox_TextChanged" />
            </StackPanel>


            <!--  Кнопка продолжить  -->
            <ui:Button
                x:Name="ContinueButton"
                Click="ContinueButton_Click"
                Style="{StaticResource MainButton}">
                <ui:Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Продолжить" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="ArrowRight24" />
                    </StackPanel>
                </ui:Button.Content>

            </ui:Button>
        </StackPanel>

        <!--  Нижняя информационная панель  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <TextBlock
                MaxWidth="600"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Light"
                Foreground="#9E9E9E"
                Text="Пин-код обеспечивает безопасность этого приложения и Ваших данных в нем. Постарайтесь использовать комбинацию, которую легко запомнить, но сложно угадать."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
