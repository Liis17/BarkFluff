<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.CreatePinCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.PinCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Background="{DynamicResource BackgroundWindow}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок (Стиль BarkFluff)  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="28"
                    Height="28"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    Margin="12,0,0,0"
                    Style="{DynamicResource LittleTitleTextStyle}"
                    Text="BarkFluff" />
            </StackPanel>

        </StackPanel>

        <!--  Основной контент  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <TextBlock
                Margin="0,0,0,10"
                Style="{DynamicResource TitleTextStyle}"
                Text="Создание кода доступа" />

            <!--  Статус текст  -->
            <TextBlock
                x:Name="statusText"
                Margin="0,0,0,25"
                Style="{DynamicResource DescriptionTextStyle}"
                Text="Введите четырехзначный пин-код и подтвердите его" />

            <!--  Индикатор шагов  -->
            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <!--  Шаг 1  -->
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step1Circle" Style="{DynamicResource StepCircle}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="1" />
                    </Border>
                    <TextBlock
                        x:Name="Step1Text"
                        Margin="10,0,0,0"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Придумайте" />
                </StackPanel>

                <!--  Линия  -->
                <Border
                    Width="40"
                    Height="1"
                    Margin="15,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SeparatorBackground}" />

                <!--  Шаг 2  -->
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step2Circle" Style="{DynamicResource StepCircle}">
                        <TextBlock
                            x:Name="Step2CircleText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#888888"
                            Text="2" />
                    </Border>
                    <TextBlock
                        x:Name="Step2Text"
                        Margin="10,0,0,0"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Подтвердите" />
                </StackPanel>
            </StackPanel>

            <!--  Карточка ввода  -->
            <Border Style="{DynamicResource MainStyleBorder}">
                <StackPanel Orientation="Vertical">

                    <!--  Блок 1: Ввод нового PIN  -->
                    <TextBlock
                        Margin="0,0,0,15"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Введите комбинацию" />

                    <StackPanel
                        x:Name="FirstPinContainer"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="FirstBox0"
                            GotFocus="PinBox_GotFocus"
                            Loaded="FocusFirstBoxZero"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="FirstPinBox_TextChanged" />
                        <TextBox
                            x:Name="FirstBox1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="FirstPinBox_TextChanged" />
                        <TextBox
                            x:Name="FirstBox2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="FirstPinBox_TextChanged" />
                        <TextBox
                            x:Name="FirstBox3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="FirstPinBox_TextChanged" />
                    </StackPanel>

                    <!--  Разделитель  -->
                    <Border
                        Height="1"
                        Margin="10,0,10,25"
                        Background="{DynamicResource SeparatorBackground}" />

                    <!--  Блок 2: Подтверждение  -->
                    <TextBlock
                        Margin="0,0,0,15"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Повторите комбинацию" />

                    <StackPanel
                        x:Name="SecondPinContainer"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="SecondBox0"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="SecondPinBox_TextChanged" />
                        <TextBox
                            x:Name="SecondBox1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="SecondPinBox_TextChanged" />
                        <TextBox
                            x:Name="SecondBox2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="SecondPinBox_TextChanged" />
                        <TextBox
                            x:Name="SecondBox3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBox}"
                            TextChanged="SecondPinBox_TextChanged" />
                    </StackPanel>

                    <!--  Информационная сноска внутри карточки  -->
                    <StackPanel Margin="0,30,0,0" Orientation="Vertical">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="14"
                                Foreground="#888888"
                                Symbol="Info16" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{DynamicResource TipsStyle}"
                                Text="Советы по безопасности:" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{DynamicResource TipsStyle}"
                            Text="• Не используйте простые комбинации (1111, 1234)" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{DynamicResource TipsStyle}"
                            Text="• Используйте комбинацию, которую легко запомнить" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Нижняя панель с кнопкой  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <ui:Button
                x:Name="ContinueButton"
                Margin="10"
                Click="ContinueButton_Click"
                IsEnabled="False"
                Style="{DynamicResource RequiredButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource RequiredButtonTextStyle}" Text="Продолжить" />
                    <ui:SymbolIcon Style="{DynamicResource RequiredButtonIconStyle}" Symbol="ArrowRight24" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>