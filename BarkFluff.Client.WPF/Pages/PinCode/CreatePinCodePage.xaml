<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.CreatePinCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.PinCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="#1C1C1C">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Основной контент (создание пин-кода)  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <!--  Иконка безопасности  -->
            <Border
                Width="80"
                Height="80"
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                Background="#2D2D2D"
                CornerRadius="40">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Direction="270"
                        Opacity="0.3"
                        ShadowDepth="4"
                        Color="Black" />
                </Border.Effect>
                <ui:SymbolIcon
                    FontSize="36"
                    Foreground="#df5000"
                    Symbol="ShieldLock24" />
            </Border>

            <!--  Заголовок  -->
            <TextBlock
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Создание кода доступа" />

            <!--  Текст подсказки / статуса  -->
            <TextBlock
                x:Name="statusText"
                Margin="0,0,0,32"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="15"
                FontWeight="Normal"
                Foreground="#9E9E9E"
                Text="Введите четырехзначный пин-код и подтвердите его"
                TextAlignment="Center" />

            <!--  Прогресс индикатор  -->
            <StackPanel
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <!--  Шаг 1: Придумайте код  -->
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="32"
                        Height="32"
                        Background="#df5000"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="1" />
                    </Border>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        Foreground="#E0E0E0"
                        Text="Придумайте" />
                </StackPanel>

                <!--  Соединительная линия  -->
                <Border
                    Width="40"
                    Height="2"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Background="#3D3D3D"
                    CornerRadius="1" />

                <!--  Шаг 2: Подтвердите код  -->
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="32"
                        Height="32"
                        Background="#3D3D3D"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#9E9E9E"
                            Text="2" />
                    </Border>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Text="Подтвердите" />
                </StackPanel>
            </StackPanel>

            <!--  Карточка с полями ввода  -->
            <Border Style="{StaticResource Win11CardStyle}">
                <StackPanel Orientation="Vertical">
                    <!--  Первый блок - Придумайте пин-код  -->
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="#E0E0E0"
                        Text="Придумайте код" />

                    <!--  Первые поля для ввода  -->
                    <StackPanel
                        x:Name="FirstPinContainer"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="FirstBox0"
                            GotFocus="PinBox_GotFocus"
                            Loaded="FocusFirstBoxZero"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />

                        <TextBox
                            x:Name="FirstBox1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />

                        <TextBox
                            x:Name="FirstBox2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />

                        <TextBox
                            x:Name="FirstBox3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />
                    </StackPanel>

                    <!--  Разделитель  -->
                    <Border
                        Height="1"
                        Margin="20,0,20,24"
                        Background="#3D3D3D" />

                    <!--  Второй блок - Подтверждение пин-кода  -->
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="#E0E0E0"
                        Text="Подтвердите код" />

                    <!--  Вторые поля для ввода (подтверждение)  -->
                    <StackPanel
                        x:Name="SecondPinContainer"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="SecondBox0"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />

                        <TextBox
                            x:Name="SecondBox1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />

                        <TextBox
                            x:Name="SecondBox2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />

                        <TextBox
                            x:Name="SecondBox3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Кнопка продолжить  -->
            <ui:Button
                x:Name="ContinueButton"
                Click="ContinueButton_Click"
                Style="{StaticResource Win11AccentButton}">
                <ui:Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Продолжить" />
                        <ui:SymbolIcon
                            FontSize="18"
                            Foreground="White"
                            Symbol="ArrowRight24" />
                    </StackPanel>
                </ui:Button.Content>
            </ui:Button>
        </StackPanel>

        <!--  Нижняя информационная панель  -->
        <Border
            Grid.Row="1"
            Margin="40,0,40,24"
            Padding="20,16"
            HorizontalAlignment="Center"
            Background="#242424"
            CornerRadius="10">
            <StackPanel
                MaxWidth="500"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,12,0"
                    FontSize="20"
                    Foreground="#9E9E9E"
                    Symbol="Info24" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="13"
                    FontWeight="Normal"
                    Foreground="#9E9E9E"
                    Text="Пин-код обеспечивает безопасность этого приложения и Ваших данных в нем. Постарайтесь использовать комбинацию, которую легко запомнить, но сложно угадать."
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
