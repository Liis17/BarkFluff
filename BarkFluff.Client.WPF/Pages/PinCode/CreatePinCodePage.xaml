<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.CreatePinCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.PinCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок (Стиль BarkFluff)  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="28"
                    Height="28"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="BarkFluff" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Normal"
                Foreground="#B0B0B0"
                Text="Настройка безопасности" />
        </StackPanel>

        <!--  Основной контент  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#E8E8E8"
                Text="Создание кода доступа" />

            <!--  Статус текст  -->
            <TextBlock
                x:Name="statusText"
                Margin="0,0,0,25"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Normal"
                Foreground="#A0A0A0"
                Text="Введите четырехзначный пин-код и подтвердите его"
                TextAlignment="Center" />

            <!--  Индикатор шагов  -->
            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <!--  Шаг 1  -->
                <StackPanel Orientation="Horizontal">
                    <Border
                        x:Name="Step1Circle"
                        Width="32"
                        Height="32"
                        Background="#df5000"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="1" />
                    </Border>
                    <TextBlock
                        x:Name="Step1Text"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#E8E8E8"
                        Text="Придумайте" />
                </StackPanel>

                <!--  Линия  -->
                <Border
                    Width="40"
                    Height="1"
                    Margin="15,0"
                    VerticalAlignment="Center"
                    Background="#333333" />

                <!--  Шаг 2  -->
                <StackPanel Orientation="Horizontal">
                    <Border
                        x:Name="Step2Circle"
                        Width="32"
                        Height="32"
                        Background="#333333"
                        CornerRadius="16">
                        <TextBlock
                            x:Name="Step2CircleText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#888888"
                            Text="2" />
                    </Border>
                    <TextBlock
                        x:Name="Step2Text"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        Foreground="#888888"
                        Text="Подтвердите" />
                </StackPanel>
            </StackPanel>

            <!--  Карточка ввода  -->
            <Border
                Padding="40,30"
                Background="#1F1F1F"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Orientation="Vertical">

                    <!--  Блок 1: Ввод нового PIN  -->
                    <TextBlock
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#D0D0D0"
                        Text="Введите комбинацию" />

                    <StackPanel
                        x:Name="FirstPinContainer"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="FirstBox0"
                            GotFocus="PinBox_GotFocus"
                            Loaded="FocusFirstBoxZero"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />
                        <TextBox
                            x:Name="FirstBox1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />
                        <TextBox
                            x:Name="FirstBox2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />
                        <TextBox
                            x:Name="FirstBox3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="FirstPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="FirstPinBox_TextChanged" />
                    </StackPanel>

                    <!--  Разделитель  -->
                    <Border
                        Height="1"
                        Margin="10,0,10,25"
                        Background="#333333" />

                    <!--  Блок 2: Подтверждение  -->
                    <TextBlock
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#D0D0D0"
                        Text="Повторите комбинацию" />

                    <StackPanel
                        x:Name="SecondPinContainer"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBox
                            x:Name="SecondBox0"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />
                        <TextBox
                            x:Name="SecondBox1"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />
                        <TextBox
                            x:Name="SecondBox2"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />
                        <TextBox
                            x:Name="SecondBox3"
                            GotFocus="PinBox_GotFocus"
                            PreviewKeyDown="SecondPinBox_PreviewKeyDown"
                            PreviewTextInput="PinBox_PreviewTextInput"
                            Style="{StaticResource PinCodeTextBoxWin11}"
                            TextChanged="SecondPinBox_TextChanged" />
                    </StackPanel>

                    <!--  Информационная сноска внутри карточки  -->
                    <StackPanel Margin="0,30,0,0" Orientation="Vertical">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="14"
                                Foreground="#888888"
                                Symbol="Info16" />
                            <TextBlock
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#888888"
                                Text="Советы по безопасности:" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            Foreground="#666666"
                            Text="• Не используйте простые комбинации (1111, 1234)" />
                        <TextBlock
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            Foreground="#666666"
                            Text="• Используйте комбинацию, которую легко запомнить" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Нижняя панель с кнопкой  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <ui:Button
                x:Name="ContinueButton"
                MinWidth="200"
                Appearance="Caution"
                Click="ContinueButton_Click"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Продолжить" />
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>