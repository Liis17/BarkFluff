<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PinCode.PinCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.PinCode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Основной контент (пин-код)  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <!--  Заголовок  -->
            <TextBlock
                Margin="0,0,0,50"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Введите код доступа" />

            <!--  Поля для ввода  -->
            <StackPanel
                x:Name="PinContainer"
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Width="60"
                    Height="70"
                    Margin="8"
                    Background="#282828"
                    CornerRadius="10">
                    <TextBox
                        x:Name="Box0"
                        Width="40"
                        Height="40"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="White"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="White"
                        GotFocus="PinBox_GotFocus"
                        Loaded="FocusBoxZero"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                </Border>

                <Border
                    Width="60"
                    Height="70"
                    Margin="8"
                    Background="#282828"
                    CornerRadius="10">
                    <TextBox
                        x:Name="Box1"
                        Width="40"
                        Height="40"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="White"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="White"
                        GotFocus="PinBox_GotFocus"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                </Border>

                <Border
                    Width="60"
                    Height="70"
                    Margin="8"
                    Background="#282828"
                    CornerRadius="10">
                    <TextBox
                        x:Name="Box2"
                        Width="40"
                        Height="40"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="White"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="White"
                        GotFocus="PinBox_GotFocus"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                </Border>

                <Border
                    Width="60"
                    Height="70"
                    Margin="8"
                    Background="#282828"
                    CornerRadius="10">
                    <TextBox
                        x:Name="Box3"
                        Width="40"
                        Height="40"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="White"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="White"
                        GotFocus="PinBox_GotFocus"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                </Border>
            </StackPanel>

            <!--  Индикаторы попыток  -->
            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="key1"
                    Margin="5,0"
                    FontSize="20"
                    Text="🔑" />
                <TextBlock
                    x:Name="key2"
                    Margin="5,0"
                    FontSize="20"
                    Text="🔑" />
                <TextBlock
                    x:Name="key3"
                    Margin="5,0"
                    FontSize="20"
                    Text="🔑" />
            </StackPanel>

            <!--  Текст подсказки  -->
            <TextBlock
                x:Name="helper"
                Margin="10"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="16"
                FontWeight="Normal"
                Foreground="#E0E0E0"
                Opacity="0.8"
                Text="Введите 4-значный пин-код для входа в приложение"
                TextAlignment="Center" />
        </StackPanel>

        <!--  Кнопка сброса  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="14"
                FontWeight="Light"
                Foreground="#9E9E9E"
                Text="Проблемы со входом? Попробуйте сбросить приложение." />

            <ui:Button
                Padding="15,10"
                HorizontalAlignment="Center"
                Background="#3D3D3D"
                BorderThickness="0"
                Click="RemoveSettings"
                CornerRadius="8"
                Cursor="Hand">
                <ui:Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="White"
                            Text="Сбросить настройки" />
                        <ui:SymbolIcon
                            Margin="8,0,0,0"
                            FontSize="16"
                            Foreground="White"
                            Symbol="Delete28" />
                    </StackPanel>
                </ui:Button.Content>
                <ui:Button.Style>
                    <Style TargetType="ui:Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
