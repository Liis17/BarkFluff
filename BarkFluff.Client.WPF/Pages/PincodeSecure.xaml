<Page
    x:Class="BarkFluff.Client.WPF.Pages.PincodeSecure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PincodeSecure"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="#212121">
        <TextBlock
            Margin="10"
            HorizontalAlignment="Center"
            FontFamily="AdwaitaSans"
            FontSize="25"
            FontWeight="Black"
            Foreground="#FF828282"
            Text="BarkFluff" />
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                Margin="40"
                HorizontalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="32"
                FontWeight="Black"
                Foreground="White"
                Text="Введите код приложения" />
            <StackPanel
                x:Name="PinContainer"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBox
                    x:Name="Box0"
                    Width="40"
                    Margin="3"
                    HorizontalContentAlignment="Center"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box1"
                    Width="40"
                    Margin="3"
                    HorizontalContentAlignment="Center"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box2"
                    Width="40"
                    Margin="3"
                    HorizontalContentAlignment="Center"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
                <TextBox
                    x:Name="Box3"
                    Width="40"
                    Margin="3"
                    HorizontalContentAlignment="Center"
                    GotFocus="PinBox_GotFocus"
                    MaxLength="1"
                    PreviewKeyDown="PinBox_PreviewKeyDown"
                    PreviewTextInput="PinBox_PreviewTextInput"
                    TextChanged="PinBox_TextChanged" />
            </StackPanel>
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FF9A9A9A"
                Text="Проблемы со входом? Попробуйте сбросить приложение." />
            <ui:Button Margin="0,5,0,10" HorizontalAlignment="Center">
                <ui:Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="AdwaitaSans"
                            FontWeight="Medium"
                            Foreground="#FFD20505"
                            Text="Сбросить приложение" />
                        <ui:SymbolIcon
                            Margin="5,0,0,0"
                            FontSize="17"
                            Foreground="#FFD20505"
                            Symbol="Delete28" />
                    </StackPanel>

                </ui:Button.Content>
            </ui:Button>
        </StackPanel>

    </Grid>
</Page>
