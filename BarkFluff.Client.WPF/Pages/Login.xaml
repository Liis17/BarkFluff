<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="#212121">
        <StackPanel
            MaxWidth="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="AdwaitaSans"
                    FontSize="32"
                    FontWeight="Black"
                    Foreground="White"
                    Opacity="1"
                    Text="Авторизация" />
                <TextBlock
                    Loaded="TextBlock_Loaded"
                    HorizontalAlignment="Center"
                    FontFamily="AdwaitaSans"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.8"
                    Text="192.168.1.1" />
            </StackPanel>

            <TextBlock
                FontFamily="AdwaitaSans"
                FontSize="15"
                FontWeight="Medium"
                Foreground="White"
                Opacity="0.8"
                Text="Логин" />
            <ui:TextBox
                x:Name="LoginEnter"
                KeyDown="TextBox_KeyDown"
                PlaceholderText="username или email"
                VerticalScrollBarVisibility="Auto" />
            <TextBlock
                Margin="0,10,0,0"
                FontFamily="AdwaitaSans"
                FontSize="15"
                FontWeight="Medium"
                Foreground="#FFC3C3C3"
                Text="Пароль" />
            <ui:PasswordBox
                x:Name="PasswordEnter"
                KeyDown="TextBox_KeyDown"
                PlaceholderText="Нажми для ввода пароля"
                VerticalScrollBarVisibility="Auto" />
            <ui:Button
                Margin="0,5,0,5"
                HorizontalAlignment="Stretch"
                Click="LogIn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontFamily="AdwaitaSans"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Войти" />
                    <ui:SymbolIcon
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="20"
                        Foreground="White"
                        Symbol="ArrowRight12" />
                </StackPanel>
            </ui:Button>
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="10"
                FontWeight="Medium"
                Foreground="#FFC3C3C3"
                Text="или" />
            <ui:Button
                Margin="0,5,0,5"
                HorizontalAlignment="Stretch"
                Click="OpenNewProfilePage">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontFamily="AdwaitaSans"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Регистрация" />
                    <ui:SymbolIcon
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="20"
                        Foreground="White"
                        Symbol="ArrowRight12" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
