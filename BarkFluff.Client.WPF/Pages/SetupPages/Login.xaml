<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1280"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MinimalTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TwoFATextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="checkBoxBorder"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="#282828"
                                BorderBrush="#404040"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Path
                                    x:Name="checkMark"
                                    Data="M3,8 L7,12 L15,4"
                                    Stroke="#6D90F3"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#1A2332" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6D90F3" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#5A7AE6" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Логотип сверху  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="32"
                Height="32"
                Source="/Resources/Images/barkfluff_logo.png" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="White"
                Text="BarkFluff" />
        </StackPanel>

        <!--  Основное содержимое  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,40,0,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <!--  Заголовок  -->
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontFamily="AdwaitaSans"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Добро пожаловать" />

                <TextBlock
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center"
                    FontFamily="AdwaitaSans"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#B0B0B0"
                    Text="Войдите в свой аккаунт" />

                <!--  Поля ввода  -->
                <StackPanel Width="320" Orientation="Vertical">

                    <!--  Имя пользователя  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontFamily="AdwaitaSans"
                        FontSize="14"
                        Foreground="#E0E0E0"
                        Text="Имя пользователя" />
                    <TextBox
                        x:Name="UsernameTextBox"
                        Margin="0,0,0,20"
                        Style="{StaticResource MinimalTextBox}" />

                    <!--  Пароль  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontFamily="AdwaitaSans"
                        FontSize="14"
                        Foreground="#E0E0E0"
                        Text="Пароль" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Margin="0,0,0,8"
                        Style="{StaticResource MinimalPasswordBox}" />

                    <TextBlock
                        Margin="0,0,0,25"
                        HorizontalAlignment="Right"
                        Style="{StaticResource LinkTextBlock}"
                        Text="Забыли пароль?" />

                    <!--  2FA секция  -->
                    <Border
                        Margin="0,0,0,25"
                        Padding="20"
                        Background="#1F1F1F"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,5"
                                FontFamily="AdwaitaSans"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Двухфакторная аутентификация" />

                            <TextBlock
                                Margin="0,0,0,15"
                                FontFamily="AdwaitaSans"
                                FontSize="14"
                                Foreground="#B0B0B0"
                                Text="Введите 6-значный код из приложения-аутентификатора"
                                TextWrapping="WrapWithOverflow" />

                            <!--  2FA поля  -->
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBox
                                    x:Name="TwoFABox0"
                                    Width="40"
                                    Height="40"
                                    Margin="3"
                                    MaxLength="1"
                                    PreviewTextInput="TwoFABox_PreviewTextInput"
                                    Style="{StaticResource TwoFATextBox}"
                                    TextChanged="TwoFABox_TextChanged" />
                                <TextBox
                                    x:Name="TwoFABox1"
                                    Width="40"
                                    Height="40"
                                    Margin="3"
                                    MaxLength="1"
                                    PreviewTextInput="TwoFABox_PreviewTextInput"
                                    Style="{StaticResource TwoFATextBox}"
                                    TextChanged="TwoFABox_TextChanged" />
                                <TextBox
                                    x:Name="TwoFABox2"
                                    Width="40"
                                    Height="40"
                                    Margin="3"
                                    MaxLength="1"
                                    PreviewTextInput="TwoFABox_PreviewTextInput"
                                    Style="{StaticResource TwoFATextBox}"
                                    TextChanged="TwoFABox_TextChanged" />
                                <TextBox
                                    x:Name="TwoFABox3"
                                    Width="40"
                                    Height="40"
                                    Margin="3"
                                    MaxLength="1"
                                    PreviewTextInput="TwoFABox_PreviewTextInput"
                                    Style="{StaticResource TwoFATextBox}"
                                    TextChanged="TwoFABox_TextChanged" />
                                <TextBox
                                    x:Name="TwoFABox4"
                                    Width="40"
                                    Height="40"
                                    Margin="3"
                                    MaxLength="1"
                                    PreviewTextInput="TwoFABox_PreviewTextInput"
                                    Style="{StaticResource TwoFATextBox}"
                                    TextChanged="TwoFABox_TextChanged" />
                                <TextBox
                                    x:Name="TwoFABox5"
                                    Width="40"
                                    Height="40"
                                    Margin="3"
                                    MaxLength="1"
                                    PreviewTextInput="TwoFABox_PreviewTextInput"
                                    Style="{StaticResource TwoFATextBox}"
                                    TextChanged="TwoFABox_TextChanged" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,15,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LinkTextBlock}"
                                Text="Проблемы с 2FA? Обратитесь в поддержку" />
                        </StackPanel>
                    </Border>

                    <!--  Запомнить меня  -->
                    <CheckBox
                        Margin="0,0,0,30"
                        Content="Оставаться в системе"
                        Style="{StaticResource MinimalCheckBox}" />

                    <!--  Кнопка входа  -->
                    <ui:Button
                        x:Name="SignInButton"
                        Margin="0,0,0,15"
                        Padding="0,12"
                        HorizontalAlignment="Stretch"
                        Background="#6D90F3"
                        BorderThickness="0"
                        Click="SignInButton_Click"
                        CornerRadius="8">
                        <ui:Button.Content>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="AdwaitaSans"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Войти" />
                                <ui:SymbolIcon
                                    Margin="10,0,0,0"
                                    FontSize="16"
                                    Foreground="White"
                                    Symbol="ArrowRight24" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>

                    <!--  Смена сервера  -->
                    <TextBlock
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource LinkTextBlock}"
                        Text="Изменить подключение к серверу" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!--  Нижняя секция  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <Border
                Padding="0,20,0,0"
                BorderBrush="#333333"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        FontFamily="AdwaitaSans"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Text="Еще нет аккаунта?" />

                    <ui:Button
                        x:Name="CreateAccountButton"
                        Padding="25,10"
                        HorizontalAlignment="Center"
                        Appearance="Secondary"
                        BorderThickness="1"
                        Click="CreateAccountPageOpen"
                        CornerRadius="8">
                        <ui:Button.Content>
                            <TextBlock
                                FontFamily="AdwaitaSans"
                                FontSize="14"
                                FontWeight="Medium"
                                Text="Создать новый аккаунт" />
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>
            </Border>

            <!--  Копирайт  -->
            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontFamily="AdwaitaSans"
                FontSize="12"
                Foreground="#666666"
                Text="© 2025 BarkFluff Inc. Все права защищены." />
        </StackPanel>
    </Grid>
</UserControl>