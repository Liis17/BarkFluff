<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6D90F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A7AE6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4863C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#6D90F3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E0E6EC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F4FF" />
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E9EEF9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#424B5A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderBrush" Value="#E0E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#424B5A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderBrush" Value="#E0E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckboxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#424B5A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="checkBoxBorder"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="#E0E6EC"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Path
                                    x:Name="checkMark"
                                    Data="M4,10 L8,14 L16,6"
                                    Stroke="#6D90F3"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#F0F4FF" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#6D90F3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="450" />
        </Grid.ColumnDefinitions>

        <!--  Left Side - Image/Brand  -->
        <Grid Grid.Column="0" Background="#6D90F3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Logo  -->
            <StackPanel
                Grid.Row="0"
                Margin="40,30"
                Orientation="Horizontal">
                <Image
                    Width="40"
                    Height="40"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="BarkFluff" />
            </StackPanel>

            <!--  Center Image  -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Image
                    MaxWidth="300"
                    MaxHeight="300"
                    Source="/Resources/Placeholders/Placeholder_1.jpg" />
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Connect with your pack!"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="16"
                    Foreground="White"
                    Opacity="0.85"
                    Text="Share moments, exchange barks, and stay in touch"
                    TextAlignment="Center" />
            </StackPanel>

            <!--  Bottom Text  -->
            <TextBlock
                Grid.Row="2"
                Margin="40,30"
                HorizontalAlignment="Center"
                Foreground="White"
                Opacity="0.7"
                Text="© 2025 BarkFluff Inc. All rights reserved." />
        </Grid>

        <!--  Right Side - Login Form  -->
        <Border Grid.Column="1" Background="White">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#424B5A"
                        Text="Welcome Back" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="16"
                        Foreground="#6B7280"
                        Text="Sign in to your account to continue" />
                </StackPanel>

                <!--  Login Form  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,20"
                    VerticalAlignment="Center">
                    <!--  Username  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        Foreground="#424B5A"
                        Text="Username" />
                    <TextBox Margin="0,0,0,20" Style="{StaticResource CustomTextBox}" />

                    <!--  Password  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        Foreground="#424B5A"
                        Text="Password" />
                    <Grid Margin="0,0,0,20">
                        <PasswordBox Style="{StaticResource PasswordBoxStyle}" />
                        <TextBlock
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontSize="12"
                            Foreground="#6D90F3"
                            Text="Forgot Password?" />
                    </Grid>

                    <!--  Two-Factor Authentication  -->
                    <Border
                        Margin="0,0,0,20"
                        Padding="15"
                        Background="#F9FAFC"
                        BorderBrush="#E0E6EC"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#424B5A"
                                Text="2FA" />
                            <TextBlock
                                Margin="0,5,0,10"
                                FontSize="12"
                                Foreground="#6B7280"
                                Text="Enter the 6-digit code from your authenticator app" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    MaxLength="1"
                                    Style="{StaticResource CustomTextBox}"
                                    TextAlignment="Center" />
                                <TextBox
                                    Grid.Column="1"
                                    Margin="2,0,3,0"
                                    MaxLength="1"
                                    Style="{StaticResource CustomTextBox}"
                                    TextAlignment="Center" />
                                <TextBox
                                    Grid.Column="2"
                                    Margin="2,0,3,0"
                                    MaxLength="1"
                                    Style="{StaticResource CustomTextBox}"
                                    TextAlignment="Center" />
                                <TextBox
                                    Grid.Column="3"
                                    Margin="2,0,3,0"
                                    MaxLength="1"
                                    Style="{StaticResource CustomTextBox}"
                                    TextAlignment="Center" />
                                <TextBox
                                    Grid.Column="4"
                                    Margin="2,0,3,0"
                                    MaxLength="1"
                                    Style="{StaticResource CustomTextBox}"
                                    TextAlignment="Center" />
                                <TextBox
                                    Grid.Column="5"
                                    Margin="5,0,0,0"
                                    MaxLength="1"
                                    Style="{StaticResource CustomTextBox}"
                                    TextAlignment="Center" />
                            </Grid>

                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                FontSize="12"
                                Foreground="#6D90F3"
                                Text="Trouble with 2FA? Contact support" />
                        </StackPanel>
                    </Border>

                    <!--  Remember Me  -->
                    <CheckBox
                        Margin="0,0,0,20"
                        Content="Keep me signed in"
                        Style="{StaticResource CheckboxStyle}" />

                    <!--  Login Button  -->
                    <Button
                        Margin="0,0,0,15"
                        Content="Sign In"
                        Style="{StaticResource PrimaryButton}" />

                    <!--  Server Selection Link  -->
                    <TextBlock Margin="0,0,0,0" TextAlignment="Center">
                        <Hyperlink Foreground="#6D90F3" TextDecorations="None">
                            <TextBlock Foreground="#6D90F3" Text="Change server connection" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!--  Register Link  -->
                <Border
                    Grid.Row="2"
                    Padding="0,20,0,0"
                    BorderBrush="#E0E6EC"
                    BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,15"
                            FontSize="14"
                            Foreground="#6B7280"
                            Text="Don't have an account yet?"
                            TextAlignment="Center" />
                        <Button Content="Create a New Account" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
