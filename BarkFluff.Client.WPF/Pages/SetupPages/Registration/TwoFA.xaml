<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.Registration.TwoFA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages.Registration"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Windows 11 inspired color palette  -->
        <SolidColorBrush x:Key="Win11CardBackground" Color="#1F1F1F" />
        <SolidColorBrush x:Key="Win11CardBorder" Color="#2D2D2D" />
        <SolidColorBrush x:Key="Win11SurfaceBackground" Color="#141414" />
        <SolidColorBrush x:Key="Win11AccentBlue" Color="#60CDFF" />
        <SolidColorBrush x:Key="Win11AccentGreen" Color="#6CCB5F" />
        <SolidColorBrush x:Key="Win11TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Win11TextSecondary" Color="#C5C5C5" />
        <SolidColorBrush x:Key="Win11TextTertiary" Color="#9D9D9D" />
        <SolidColorBrush x:Key="Win11Subtle" Color="#2A2A2A" />

        <!--  Modern card style with subtle shadow effect  -->
        <Style x:Key="Win11CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Win11CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Win11CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="20"
                        Direction="270"
                        Opacity="0.25"
                        ShadowDepth="4"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Modern Section Header Style  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Win11TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--  Modern Subtitle Style  -->
        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource Win11TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!--  Modern Label Style  -->
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Win11TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--  Modern Secret Key TextBox Style  -->
        <Style x:Key="SecretKeyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Win11Subtle}" />
            <Setter Property="Foreground" Value="{StaticResource Win11TextPrimary}" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#505050" />
                                <Setter TargetName="border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Win11AccentBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer
        Padding="30,0,30,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <Grid>
            <!--  Initial Prompt Panel - Ask user if they want to enable 2FA  -->
            <Grid x:Name="InitialPromptPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <!--  Header Section with Shield Icon  -->
                    <StackPanel
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#2563EB" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="White"
                                Symbol="ShieldCheckmark24" />
                        </Border>
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Win11TextPrimary}"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Двухфакторная аутентификация" />
                    </StackPanel>

                    <TextBlock
                        MaxWidth="500"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        FontWeight="Normal"
                        Foreground="{StaticResource Win11TextSecondary}"
                        Style="{StaticResource SubtitleStyle}"
                        Text="Повысьте безопасность своего аккаунта с помощью Google Authenticator. Хотите включить двухфакторную аутентификацию?"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <!--  Action Buttons  -->
                    <StackPanel
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <ui:Button
                            x:Name="DisableTwoFAButton"
                            Height="48"
                            Margin="0,0,12,0"
                            Padding="0"
                            Background="#2A2A2A"
                            Click="DisableTwoFAButton_Click"
                            CornerRadius="10"
                            MouseOverBackground="#3A3A3A"
                            PressedBackground="#252525">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{StaticResource Win11TextSecondary}"
                                        Symbol="Dismiss24" />
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Win11TextSecondary}"
                                        Text="Нет, спасибо" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>

                        <ui:Button
                            x:Name="EnableTwoFAButton"
                            Height="48"
                            Padding="0"
                            Background="#df5000"
                            Click="EnableTwoFAButton_Click"
                            CornerRadius="10"
                            MouseOverBackground="#FFC54700"
                            PressedBackground="#FFAB3D00">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="White"
                                        Symbol="ShieldCheckmark24" />
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Да, включить" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!--  Bottom Info Section  -->
                <Border
                    Grid.Row="1"
                    MaxWidth="600"
                    Margin="24,24,24,24"
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    Background="#141414"
                    BorderBrush="#252525"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,14,0"
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{StaticResource Win11AccentBlue}"
                            Symbol="Info24" />
                        <TextBlock
                            MaxWidth="400"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="13"
                            FontWeight="Normal"
                            Foreground="{StaticResource Win11TextTertiary}"
                            LineHeight="20"
                            Text="Двухфакторная аутентификация значительно повышает безопасность Вашего аккаунта. Для настройки установите приложение Google Authenticator на свой телефон и отсканируйте QR-код."
                            TextAlignment="Left"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  QR Code Panel - Setup 2FA with QR code  -->
            <Grid x:Name="QrCodePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">

                    <!--  Header Section with Shield Icon  -->
                    <StackPanel
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#2563EB" />
                                    <GradientStop Offset="1" Color="#7C3AED" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="White"
                                Symbol="ShieldCheckmark24" />
                        </Border>
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Win11TextPrimary}"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Двухфакторная аутентификация" />
                    </StackPanel>

                    <TextBlock
                        x:Name="statusText"
                        MaxWidth="450"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleStyle}"
                        Text="Повысьте безопасность своего аккаунта с помощью Google Authenticator"
                        TextWrapping="Wrap" />

                    <!--  QR Code Card Section  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="20,10,20,15"
                        Style="{StaticResource Win11CardStyle}">
                        <StackPanel Orientation="Vertical">

                            <!--  Card Header  -->
                            <StackPanel
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{StaticResource Win11AccentBlue}"
                                    Symbol="QrCode24" />
                                <TextBlock Style="{StaticResource CardLabelStyle}" Text="Отсканируйте QR-код" />
                            </StackPanel>

                            <!--  QR Code Container with modern styling  -->
                            <Border
                                x:Name="QrCodeContainer"
                                Width="160"
                                Height="160"
                                Margin="0,0,0,8"
                                Padding="10"
                                HorizontalAlignment="Center"
                                Background="White"
                                CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.2"
                                        ShadowDepth="3"
                                        Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="#888888"
                                        Text="QR КОД"
                                        TextAlignment="Center" />
                                    <Image x:Name="QrCodeImage" Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <!--  Separator with "or" text  -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Height="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Background="#3A3A3A" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="{StaticResource Win11TextTertiary}"
                                    Text="или введите ключ вручную" />
                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#3A3A3A" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="SecretKeyText"
                                    Grid.Column="0"
                                    Height="40"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecretKeyTextBoxStyle}"
                                    Text="ABCD EFGH IJKL MNOP QRST UVWX" />
                                <ui:Button
                                    x:Name="CopySecretButton"
                                    Grid.Column="1"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    Background="#2A2A2A"
                                    Click="CopySecretButton_Click"
                                    CornerRadius="8"
                                    MouseOverBackground="#3A3A3A"
                                    PressedBackground="#252525">
                                    <ui:Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Foreground="{StaticResource Win11TextSecondary}"
                                                Symbol="Copy24" />

                                        </StackPanel>
                                    </ui:Button.Content>
                                </ui:Button>
                            </Grid>


                        </StackPanel>
                    </Border>

                    <!--  Code Entry Section  -->
                    <Border
                        Margin="0,0,0,8"
                        Padding="10,10,10,5"
                        Style="{StaticResource Win11CardStyle}">
                        <StackPanel Orientation="Vertical">

                            <!--  Section Header  -->
                            <StackPanel
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{StaticResource Win11AccentGreen}"
                                    Symbol="Key24" />
                                <TextBlock Style="{StaticResource CardLabelStyle}" Text="Введите код из приложения" />
                            </StackPanel>

                            <!--  Code Input Boxes  -->
                            <StackPanel
                                x:Name="CodeContainer"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBox
                                    x:Name="CodeBox0"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource VerificationTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox1"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource VerificationTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox2"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource VerificationTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <!--  Visual separator between code groups  -->
                                <Border
                                    Width="12"
                                    Height="3"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Background="#404040"
                                    CornerRadius="2" />

                                <TextBox
                                    x:Name="CodeBox3"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource VerificationTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox4"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource VerificationTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox5"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource VerificationTextBox}"
                                    TextChanged="CodeBox_TextChanged" />
                            </StackPanel>

                            <!--  Error Message  -->
                            <TextBlock
                                x:Name="ErrorTextBlockMessage"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Background="{x:Null}"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#FF6B6B"
                                Text=""
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!--  Action Buttons  -->
                    <StackPanel
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <ui:Button
                            x:Name="SkipButton"
                            Height="48"
                            Margin="0,0,12,0"
                            Padding="0"
                            Background="#2A2A2A"
                            Click="SkipButton_Click"
                            CornerRadius="10"
                            MouseOverBackground="#3A3A3A"
                            PressedBackground="#252525">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{StaticResource Win11TextSecondary}"
                                        Symbol="ArrowRight24" />
                                    <ui:TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Win11TextSecondary}"
                                        Text="Пропустить" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>

                        <ui:Button
                            x:Name="ConnectButton"
                            Height="48"
                            Padding="0"
                            Background="#df5000"
                            Click="ConnectButton_Click"
                            CornerRadius="10"
                            MouseOverBackground="#FFC54700"
                            PressedBackground="#FFAB3D00">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="White"
                                        Symbol="Shield24" />
                                    <ui:TextBlock
                                        x:Name="ConnectionText"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Подключить" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!--  Bottom Info Section  -->
                <Border
                    Grid.Row="1"
                    MaxWidth="600"
                    Margin="24,10,24,20"
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    Background="#141414"
                    BorderBrush="#252525"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,14,0"
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{StaticResource Win11AccentBlue}"
                            Symbol="Info24" />
                        <TextBlock
                            MaxWidth="400"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="13"
                            FontWeight="Normal"
                            Foreground="{StaticResource Win11TextTertiary}"
                            LineHeight="20"
                            Text="Двухфакторная аутентификация значительно повышает безопасность Вашего аккаунта. Для настройки установите приложение Google Authenticator на свой телефон и отсканируйте QR-код."
                            TextAlignment="Left"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
