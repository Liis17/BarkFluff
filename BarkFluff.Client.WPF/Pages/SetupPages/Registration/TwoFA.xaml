<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.Registration.TwoFA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages.Registration"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer 
        Padding="30,0,30,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <!--  Initial Prompt Panel - Ask user if they want to enable 2FA  -->
            <Grid x:Name="InitialPromptPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <!--  Header Section with Shield Icon  -->
                    <StackPanel
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            Margin="0"
                            Style="{DynamicResource TitleTextStyle}"
                            Text="Двухфакторная аутентификация" />
                    </StackPanel>

                    <TextBlock
                        MaxWidth="500"
                        Margin="0,0,0,24"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Повысьте безопасность своего аккаунта с помощью Google Authenticator. Хотите включить двухфакторную аутентификацию?" />

                    <!--  Action Buttons  -->
                    <StackPanel
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <ui:Button
                            x:Name="DisableTwoFAButton"
                            Click="DisableTwoFAButton_Click"
                            Style="{DynamicResource AdaptiveButton}">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon Style="{DynamicResource AdaptiveButtonIconStyle}" Symbol="Dismiss24" />
                                    <ui:TextBlock Style="{DynamicResource AdaptiveButtonTextStyle}" Text="Нет, спасибо" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>

                        <ui:Button
                            x:Name="EnableTwoFAButton"
                            Click="EnableTwoFAButton_Click"
                            Style="{DynamicResource RequiredButton}">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon Style="{DynamicResource RequiredButtonIconStyle}" Symbol="ShieldCheckmark24" />
                                    <ui:TextBlock Style="{DynamicResource RequiredButtonTextStyle}" Text="Да, включить" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!--  Bottom Info Section  -->
                <Border
                    Grid.Row="1"
                    MaxWidth="600"
                    Margin="0,10,0,10"
                    Padding="15"
                    Style="{DynamicResource MainStyleBorder}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{StaticResource TitleText}"
                            Symbol="Info24" />
                        <TextBlock
                            MaxWidth="400"
                            Style="{DynamicResource TipsStyle}"
                            Text="Двухфакторная аутентификация значительно повышает безопасность Вашего аккаунта. Для настройки установите приложение Google Authenticator на свой телефон и отсканируйте QR-код."
                            TextAlignment="Left"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  QR Code Panel - Setup 2FA with QR code  -->
            <Grid x:Name="QrCodePanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">

                    <!--  Header Section with Shield Icon  -->
                    <StackPanel
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock Style="{DynamicResource TitleTextStyle}" Text="Двухфакторная аутентификация" />
                    </StackPanel>

                    <TextBlock
                        x:Name="statusText"
                        MaxWidth="450"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Повысьте безопасность своего аккаунта с помощью Google Authenticator"
                        TextWrapping="Wrap" />

                    <!--  QR Code Card Section  -->
                    <Border Margin="0,0,0,10" Style="{DynamicResource MainStyleBorder}">
                        <StackPanel Orientation="Vertical">

                            <!--  Card Header  -->
                            <StackPanel
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{DynamicResource TitleText}"
                                    Symbol="QrCode24" />
                                <TextBlock Style="{DynamicResource LittleTitleTextStyle}" Text="Отсканируйте QR-код" />
                            </StackPanel>

                            <!--  QR Code Container with modern styling  -->
                            <Border
                                x:Name="QrCodeContainer"
                                Width="160"
                                Height="160"
                                Margin="0,0,0,8"
                                Padding="10"
                                HorizontalAlignment="Center"
                                Background="White"
                                CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.2"
                                        ShadowDepth="3"
                                        Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="#888888"
                                        Text="QR КОД"
                                        TextAlignment="Center" />
                                    <Image x:Name="QrCodeImage" Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <!--  Separator with "or" text  -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Height="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SeparatorBackground}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{DynamicResource DescriptionTextStyle}"
                                    Text="или введите ключ вручную" />
                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SeparatorBackground}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    x:Name="SecretKeyText"
                                    Grid.Column="0"
                                    Style="{DynamicResource InputTextBoxStyle}"
                                    Text="ABCD EFGH IJKL MNOP QRST UVWX" />
                                <ui:Button
                                    x:Name="CopySecretButton"
                                    Grid.Column="1"
                                    Height="56"
                                    Padding="0"
                                    Click="CopySecretButton_Click"
                                    Style="{DynamicResource AdaptiveButton}">
                                    <ui:Button.Content>
                                        <ui:SymbolIcon
                                            Margin="0"
                                            Filled="False"
                                            Style="{DynamicResource AdaptiveButtonIconStyle}"
                                            Symbol="Copy24" />
                                    </ui:Button.Content>
                                </ui:Button>
                            </Grid>


                        </StackPanel>
                    </Border>

                    <!--  Code Entry Section  -->
                    <Border Margin="0,0,0,8" Style="{DynamicResource MainStyleBorder}">
                        <StackPanel Orientation="Vertical">

                            <!--  Section Header  -->
                            <StackPanel
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{DynamicResource TitleText}"
                                    Symbol="Key24" />
                                <TextBlock Style="{DynamicResource LittleTitleTextStyle}" Text="Введите код из приложения" />
                            </StackPanel>

                            <!--  Code Input Boxes  -->
                            <StackPanel
                                x:Name="CodeContainer"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBox
                                    x:Name="CodeBox0"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource PinCodeTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox1"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource PinCodeTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox2"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource PinCodeTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <!--  Visual separator between code groups  -->
                                <Border
                                    Width="12"
                                    Height="3"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SeparatorBackground}"
                                    CornerRadius="2" />

                                <TextBox
                                    x:Name="CodeBox3"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource PinCodeTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox4"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource PinCodeTextBox}"
                                    TextChanged="CodeBox_TextChanged" />

                                <TextBox
                                    x:Name="CodeBox5"
                                    GotFocus="CodeBox_GotFocus"
                                    PreviewKeyDown="CodeBox_PreviewKeyDown"
                                    PreviewTextInput="CodeBox_PreviewTextInput"
                                    Style="{StaticResource PinCodeTextBox}"
                                    TextChanged="CodeBox_TextChanged" />
                            </StackPanel>

                            <!--  Error Message  -->
                            <TextBlock
                                x:Name="ErrorTextBlockMessage"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Background="{x:Null}"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#FF6B6B"
                                Text=""
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!--  Action Buttons  -->
                    <StackPanel
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <ui:Button
                            x:Name="SkipButton"
                            Margin="5"
                            Click="SkipButton_Click"
                            Style="{DynamicResource AdaptiveButton}">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">

                                    <ui:TextBlock Style="{DynamicResource AdaptiveButtonTextStyle}" Text="Пропустить" />
                                    <ui:SymbolIcon Style="{DynamicResource AdaptiveButtonIconStyle}" Symbol="ArrowRight24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>

                        <ui:Button
                            x:Name="ConnectButton"
                            Margin="5"
                            Click="ConnectButton_Click"
                            Style="{DynamicResource RequiredButton}">
                            <ui:Button.Content>
                                <StackPanel Margin="24,0" Orientation="Horizontal">
                                    <ui:SymbolIcon Style="{DynamicResource RequiredButtonIconStyle}" Symbol="Shield24" />
                                    <ui:TextBlock
                                        x:Name="ConnectionText"
                                        Style="{DynamicResource RequiredButtonTextStyle}"
                                        Text="Подключить" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!--  Bottom Info Section  -->
                <Border
                    Grid.Row="1"
                    MaxWidth="600"
                    Margin="0,10,0,10"
                    Padding="15"
                    Style="{DynamicResource MainStyleBorder}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{StaticResource TitleText}"
                            Symbol="Info24" />
                        <TextBlock
                            MaxWidth="400"
                            LineHeight="20"
                            Style="{DynamicResource TipsStyle}"
                            Text="Двухфакторная аутентификация значительно повышает безопасность Вашего аккаунта. Для настройки установите приложение Google Authenticator на свой телефон и отсканируйте QR-код."
                            TextAlignment="Left"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
