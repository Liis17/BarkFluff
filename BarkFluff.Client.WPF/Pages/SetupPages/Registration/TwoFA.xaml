<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.Registration.TwoFA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages.Registration"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,30" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid Background="#1A1A1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Двухфакторная аутентификация" />

                <TextBlock
                    x:Name="statusText"
                    Margin="0,0,0,25"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Opacity="0.8"
                    Text="Повысьте безопасность своего аккаунта с помощью Google Authenticator"
                    TextAlignment="Center" />

                <Border
                    Margin="0,0,0,10"
                    Background="#282828"
                    BorderThickness="0"
                    CornerRadius="12">
                    <StackPanel Margin="10 10 10 0" Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="18"
                            FontWeight="Normal"
                            Foreground="#E0E0E0"
                            Text="Отсканируйте QR-код" />

                        <Border
                            x:Name="QrCodeContainer"
                            Width="250"
                            Height="250"
                            Margin="0,0,0,15"
                            Padding="10"
                            HorizontalAlignment="Center"
                            Background="White"
                            CornerRadius="16">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="#666666"
                                    Text="QR КОД"
                                    TextAlignment="Center" />
                                <Image x:Name="QrCodeImage" Stretch="Uniform" />
                            </Grid>

                        </Border>

                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#B0B0B0"
                            Text="Или введите ключ вручную:" />

                        <Border>
                            <TextBox
                                x:Name="SecretKeyText"
                                Margin="0,0,0,10"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                Background="#1A1A1A"
                                BorderBrush="#404040"
                                BorderThickness="1"
                                FontFamily="Consolas"
                                FontSize="12"
                                FontWeight="Normal"
                                Foreground="#E0E0E0"
                                IsReadOnly="True"
                                Text="ABCD EFGH IJKL MNOP QRST UVWX"
                                TextAlignment="Center" />
                        </Border>

                        <ui:Button
                            x:Name="CopySecretButton"
                            Background="#404040"
                            Click="CopySecretButton_Click"
                            MouseOverBackground="#505050"
                            PressedBackground="#353535"
                            Style="{DynamicResource MainButton}">
                            <ui:Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolLeft}" Symbol="Copy24" />
                                    <ui:TextBlock Style="{DynamicResource MainButtonTextRight}" Text="Копировать" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Text="Введите код из приложения" />

                <StackPanel
                    x:Name="CodeContainer"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="CodeBox0"
                        GotFocus="CodeBox_GotFocus"
                        PreviewKeyDown="CodeBox_PreviewKeyDown"
                        PreviewTextInput="CodeBox_PreviewTextInput"
                        Style="{StaticResource VerificationTextBox}"
                        TextChanged="CodeBox_TextChanged" />

                    <TextBox
                        x:Name="CodeBox1"
                        GotFocus="CodeBox_GotFocus"
                        PreviewKeyDown="CodeBox_PreviewKeyDown"
                        PreviewTextInput="CodeBox_PreviewTextInput"
                        Style="{StaticResource VerificationTextBox}"
                        TextChanged="CodeBox_TextChanged" />

                    <TextBox
                        x:Name="CodeBox2"
                        GotFocus="CodeBox_GotFocus"
                        PreviewKeyDown="CodeBox_PreviewKeyDown"
                        PreviewTextInput="CodeBox_PreviewTextInput"
                        Style="{StaticResource VerificationTextBox}"
                        TextChanged="CodeBox_TextChanged" />

                    <TextBox
                        x:Name="CodeBox3"
                        GotFocus="CodeBox_GotFocus"
                        PreviewKeyDown="CodeBox_PreviewKeyDown"
                        PreviewTextInput="CodeBox_PreviewTextInput"
                        Style="{StaticResource VerificationTextBox}"
                        TextChanged="CodeBox_TextChanged" />

                    <TextBox
                        x:Name="CodeBox4"
                        GotFocus="CodeBox_GotFocus"
                        PreviewKeyDown="CodeBox_PreviewKeyDown"
                        PreviewTextInput="CodeBox_PreviewTextInput"
                        Style="{StaticResource VerificationTextBox}"
                        TextChanged="CodeBox_TextChanged" />

                    <TextBox
                        x:Name="CodeBox5"
                        GotFocus="CodeBox_GotFocus"
                        PreviewKeyDown="CodeBox_PreviewKeyDown"
                        PreviewTextInput="CodeBox_PreviewTextInput"
                        Style="{StaticResource VerificationTextBox}"
                        TextChanged="CodeBox_TextChanged" />
                </StackPanel>

                <TextBlock
                    x:Name="ErrorTextBlockMessage"
                    Margin="0,5,0,10"
                    HorizontalAlignment="Center"
                    Background="{x:Null}"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#FFE62F2F"
                    Text=""
                    Visibility="Collapsed" />

                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <ui:Button
                        x:Name="SkipButton"
                        Background="#404040"
                        Click="SkipButton_Click"
                        MouseOverBackground="#505050"
                        PressedBackground="#353535"
                        Style="{StaticResource MainButton}">
                        <ui:Button.Content>
                            <ui:TextBlock Style="{DynamicResource MainButtonTextSingle}" Text="Пропустить" />
                        </ui:Button.Content>
                    </ui:Button>

                    <ui:Button
                        x:Name="ConnectButton"
                        Click="ConnectButton_Click"
                        Style="{StaticResource MainButton}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolLeft}" Symbol="Shield24" />
                                <ui:TextBlock
                                    x:Name="ConnectionText"
                                    Style="{DynamicResource MainButtonTextRight}"
                                    Text="Подключить" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Vertical">
                <TextBlock
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="14"
                    FontWeight="Light"
                    Foreground="#9E9E9E"
                    Text="Двухфакторная аутентификация значительно повышает безопасность Вашего аккаунта. Для настройки установите приложение Google Authenticator на свой телефон и отсканируйте QR-код."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
