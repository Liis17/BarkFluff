<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.CreateAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Common text style  -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!--  Button styles  -->
        <Style x:Key="NavigationButton" TargetType="ui:Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#4C72F4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="15,8" />
        </Style>

        <!--  Animation related resources  -->
        <CubicEase x:Key="EasingFunction" EasingMode="EaseInOut" />
    </UserControl.Resources>

    <Grid>
        <!--  Background with gradient  -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#1A1A1A" />
                <GradientStop Offset="1" Color="#212121" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  Main container  -->
        <Border
            Width="420"
            Margin="0"
            Background="#262626"
            BorderBrush="#383838"
            BorderThickness="1"
            CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Logo could go here  -->
                <Border
                    Grid.Row="0"
                    Padding="20"
                    Background="#303030"
                    CornerRadius="12,12,0,0">
                    <StackPanel Margin="0,10" Orientation="Vertical">
                        <TextBlock
                            Foreground="#4C72F4"
                            Style="{StaticResource HeaderStyle}"
                            Text="BarkFluff" />
                        <TextBlock
                            Loaded="TextBlock_Loaded"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="servername" />
                    </StackPanel>
                </Border>

                <!--  Registration steps container  -->
                <Grid Grid.Row="1" Margin="30,20">
                    <!--  Step 1 - Name and Surname  -->
                    <StackPanel x:Name="Step1" Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="20"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Регистрация" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Имя*" />
                        <ui:TextBox
                            x:Name="FirstNameEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Апогея"
                            Tag="Names"
                            TextChanged="Enter_TextChanged" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Фамилия" />
                        <ui:TextBox
                            x:Name="LastNameEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Тайнигейпиратовна"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Имя может содержать любые символы" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Минимально может быть 3 символа" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Длинна имени и фамилии ограничена 40 символами" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Фамилия может отсутствовать" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 2 - Username  -->
                    <StackPanel
                        x:Name="Step2"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="20"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Регистрация" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Логин*" />
                        <ui:TextBox
                            x:Name="LoginEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Apogee"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Логин может содержать:" />
                            <TextBlock
                                Margin="10,0,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="- Символы латинского алфавита" />
                            <TextBlock
                                Margin="10,0,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="- Цифры" />
                            <TextBlock
                                Margin="10,0,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="- Нижнее подчеркивание ( _ ) и тире ( - )" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Логин ограничен 30 символами" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Логин будет преобразован в нижний регистр" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 3 - Email  -->
                    <StackPanel
                        x:Name="Step3"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="20"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Регистрация" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Почта*" />
                        <ui:TextBox
                            x:Name="EmailEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="apogee@barkfluff.ru"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Почта может использоваться для 2FA" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Почта будет использоваться для сброса пароля" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● На почту будут отправляться уведомления о входе" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 4 - Verification Code  -->
                    <StackPanel
                        x:Name="Step4"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="20"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Регистрация" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Код подтверждения*" />
                        <ui:TextBox
                            x:Name="VerificationCodeEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="123456"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock
                                x:Name="EmailHelperText"
                                Style="{StaticResource HintStyle}"
                                Text="● Сообщение отправлено на ''твою почту''" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Проверьте папку со спамом" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 5 - Password  -->
                    <StackPanel
                        x:Name="Step5"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="20"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Регистрация" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Пароль*" />
                        <ui:PasswordBox
                            x:Name="PasswordEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Введите надежный пароль"
                            TextChanged="PasspowrEnter_TextChanged" />

                        <Grid Margin="0,5,0,15">
                            <ProgressBar
                                x:Name="PasswordStrengthBar"
                                Height="5"
                                Background="#FF2A2A2A"
                                Foreground="#FF00FF00"
                                Maximum="100"
                                Minimum="0"
                                Value="50" />
                        </Grid>

                        <TextBlock
                            x:Name="PasswordDifficultyIndicator"
                            Margin="0,0,0,15"
                            FontFamily="AdwaitaSans"
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="#FFC3C3C3"
                            Text="Пароль достаточно надежный" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Подтвердите пароль*" />
                        <ui:PasswordBox
                            x:Name="PasswordRepeatedEnter"
                            Height="40"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Повторите пароль"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Пароль должен содержать не менее 8 символов" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="● Используйте комбинацию букв, цифр и специальных символов" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 6 - Completion  -->
                    <StackPanel
                        x:Name="Step6"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="20"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Регистрация завершена" />

                        <Border
                            Width="80"
                            Height="80"
                            Margin="0,20"
                            Background="#4C72F4"
                            CornerRadius="50">
                            <ui:SymbolIcon
                                FontSize="40"
                                Foreground="White"
                                Symbol="Checkmark24" />
                        </Border>

                        <TextBlock
                            Margin="0,10"
                            FontSize="18"
                            Style="{StaticResource SubHeaderStyle}"
                            Text="Ваш аккаунт успешно создан!" />

                        <TextBlock
                            Margin="0,0,0,20"
                            Style="{StaticResource HintStyle}"
                            Text="Теперь вы можете войти, используя свой логин и пароль."
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!--  Footer with error message and buttons  -->
                <StackPanel Grid.Row="2" Margin="20,0,20,20">
                    <TextBlock
                        x:Name="ErrorMessageTextBlock"
                        MinHeight="20"
                        Margin="0,0,0,15"
                        FontFamily="AdwaitaSans"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#FFFF4646"
                        Opacity="0.9"
                        Text=""
                        TextAlignment="Center" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Back Button  -->
                        <ui:Button
                            x:Name="BackButton"
                            Grid.Column="0"
                            Click="BackButton_Click"
                            Style="{StaticResource NavigationButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="White"
                                    Symbol="ArrowLeft12" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontFamily="AdwaitaSans"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Назад" />
                            </StackPanel>
                        </ui:Button>

                        <!--  Next Button  -->
                        <ui:Button
                            x:Name="NextButton"
                            Grid.Column="2"
                            Click="NextButton_Click"
                            Style="{StaticResource NavigationButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontFamily="AdwaitaSans"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Далее" />
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="White"
                                    Symbol="ArrowRight12" />
                            </StackPanel>
                        </ui:Button>

                        <!--  Create Account Button  -->
                        <ui:Button
                            x:Name="CreateButton"
                            Grid.Column="2"
                            Background="#4CAF50"
                            Click="Registration"
                            Style="{StaticResource NavigationButton}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontFamily="AdwaitaSans"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Создать аккаунт" />
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="White"
                                    Symbol="Add12" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
