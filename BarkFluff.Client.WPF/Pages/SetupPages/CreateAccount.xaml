<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.CreateAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crop="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preview="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:setupPages="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:twofa="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages.Registration"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="3980"
    d:DesignWidth="720"
    mc:Ignorable="d">

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок и название сервера  -->
        <StackPanel
            x:Name="TitleServerNameBar"
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="28"
                    Height="28"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    x:Name="ServerNameBlock"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Loaded="TextBlock_Loaded"
                    Text="servername" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Normal"
                Foreground="#B0B0B0"
                Text="Создание нового аккаунта" />
        </StackPanel>

        <!--  Основная область контента  -->
        <Grid
            x:Name="MainGrid"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <StackPanel
            x:Name="MainContainer"
            Grid.Row="1"
            Margin="0,40,0,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Loaded="MainContainer_Loaded"
            Orientation="Vertical">

            <!--  Step 1: Имя и фамилия  -->
            <StackPanel
                x:Name="Step1"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Личная информация" />

                <Border
                    Padding="30,25"
                    Background="#1F1F1F"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <!--  Имя  -->
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Имя *" />
                        <ui:TextBox
                            x:Name="FirstNameEnter"
                            Margin="0,0,0,20"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Апогея"
                            Tag="Names"
                            TextChanged="Enter_TextChanged" />

                        <!--  Фамилия  -->
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Фамилия" />
                        <ui:TextBox
                            x:Name="LastNameEnter"
                            Margin="0,0,0,25"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Тайнигейпиратовна"
                            TextChanged="Enter_TextChanged" />

                        <!--  Информация  -->
                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Имя может содержать любые символы" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Минимально может быть 3 символа" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Длина имени и фамилии ограничена 40 символами" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Фамилия может отсутствовать" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 2: Логин  -->
            <StackPanel
                x:Name="Step2"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Имя пользователя" />

                <Border
                    Padding="30,25"
                    Background="#1F1F1F"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Логин *" />
                        <ui:TextBox
                            x:Name="LoginEnter"
                            Margin="0,0,0,25"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Apogee"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Логин может содержать:" />
                            <TextBlock
                                Margin="15,2,0,0"
                                Style="{StaticResource InfoTextStyle}"
                                Text="- Символы латинского алфавита" />
                            <TextBlock
                                Margin="15,2,0,0"
                                Style="{StaticResource InfoTextStyle}"
                                Text="- Цифры" />
                            <TextBlock
                                Margin="15,2,0,0"
                                Style="{StaticResource InfoTextStyle}"
                                Text="- Нижнее подчеркивание ( _ ) и тире ( - )" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Логин ограничен 30 символами" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Логин будет преобразован в нижний регистр" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 3: Email  -->
            <StackPanel
                x:Name="Step3"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Электронная почта" />

                <Border
                    Padding="30,25"
                    Background="#1F1F1F"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Почта *" />
                        <ui:TextBox
                            x:Name="EmailEnter"
                            Margin="0,0,0,25"
                            KeyDown="TextBox_KeyDown"
                            Loaded="EmailEnter_Loaded"
                            PlaceholderText="apogee@barkfluff.ru"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel>
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Почта может использоваться для 2FA" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Почта будет использоваться для сброса пароля" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• На почту будут отправляться уведомления о входе" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 4: Код подтверждения  -->
            <StackPanel
                x:Name="Step4"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Подтверждение почты" />

                <Border
                    Padding="30,25"
                    Background="#1F1F1F"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Код подтверждения *" />
                        <ui:TextBox
                            x:Name="VerificationCodeEnter"
                            Margin="0,0,0,25"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="123456"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel>
                            <TextBlock
                                x:Name="EmailHelperText"
                                Style="{StaticResource InfoTextStyle}"
                                Text="• Сообщение отправлено на вашу почту" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Проверьте папку со спамом" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 5: Пароль  -->
            <StackPanel
                x:Name="Step5"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Создание пароля" />

                <Border
                    Padding="30,25"
                    Background="#1F1F1F"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <!--  Пароль  -->
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Пароль *" />
                        <ui:PasswordBox
                            x:Name="PasswordEnter"
                            Margin="0,0,0,8"
                            KeyDown="TextBox_KeyDown"
                            PasswordChanged="PasswordEnter_TextChanged"
                            PlaceholderText="Введите пароль"
                            TextChanged="PasswordEnter_TextChanged" />

                        <!--  Индикатор силы пароля  -->
                        <ProgressBar
                            x:Name="PasswordStrengthBar"
                            Height="4"
                            Margin="0,0,0,5"
                            Background="#333333"
                            BorderThickness="0"
                            Foreground="#FF4646"
                            Maximum="100"
                            Minimum="0"
                            Value="2" />

                        <TextBlock
                            x:Name="PasswordDifficultyIndicator"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="#B0B0B0"
                            Text="Начните вводить пароль" />

                        <!--  Подтверждение пароля  -->
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Подтвердите пароль *" />
                        <ui:PasswordBox
                            x:Name="PasswordRepeatedEnter"
                            Margin="0,0,0,25"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Повторите пароль"
                            TextChanged="Enter_TextChanged" />

                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource InfoTextStyle}"
                                Text="• Используйте комбинацию букв разного регистра"
                                TextWrapping="WrapWithOverflow" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Добавьте цифры и специальные символы" />
                            <TextBlock Style="{StaticResource InfoTextStyle}" Text="• Минимальная длина пароля 8 символов" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 6: Загрузка изображения  -->
            <StackPanel
                x:Name="Step6"
                Width="600"
                Height="800"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Фото профиля" />

                <Border
                    Padding="30,25"
                    Background="#1F1F1F"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center">
                        <crop:CropImage
                            x:Name="Cropper"
                            Width="600"
                            Height="700"
                            Panel.ZIndex="100"
                            DataContext="CreateAccount"
                            Loaded="CropperLoaded" />
                        <TextBlock
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource InfoTextStyle}"
                            Text="Загрузите фото профиля" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 7: Добавление описания  -->
            <StackPanel
                x:Name="Step7"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <preview:PreviewUser x:Name="PreviewUserElement" Loaded="PreviewUserElement_Loaded" />
            </StackPanel>
            <!--  Step 8: подключение 2fa  -->
            <StackPanel
                x:Name="Step8"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Двухфакторная аутентификация (2FA)"
                    Visibility="Collapsed" />
                <twofa:TwoFA x:Name="OtpSuggestion" Loaded="OtpSuggestion_Loaded" />
            </StackPanel>
            <!--  Step 9: Завершение регистрации  -->
            <StackPanel
                x:Name="Step9"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Двухфакторная аутентификация (2FA)"
                    Visibility="Collapsed" />
                <setupPages:CompletionRegistration x:Name="CompletionRegistrationElement" />
            </StackPanel>

        </StackPanel>

        <!--  Нижняя панель с кнопками  -->
        <StackPanel
            x:Name="ButtonBottomBar"
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <!--  Кнопки навигации  -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <ui:Button
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Style="{StaticResource MainButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Далее" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="ArrowRight12" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="CreateButton"
                    Click="Registration"
                    Style="{StaticResource MainButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Создать аккаунт" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="Add12" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>