<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.CreateAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crop="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preview="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:setupPages="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:twofa="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages.Registration"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="4600"
    d:DesignWidth="720"
    mc:Ignorable="d">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок и название сервера  -->
        <StackPanel
            x:Name="TitleServerNameBar"
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="28"
                    Height="28"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    x:Name="ServerNameBlock"
                    Margin="12,0,0,0"
                    Loaded="TextBlock_Loaded"
                    Style="{DynamicResource LittleTitleTextStyle}"
                    Text="servername" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource DescriptionTextStyle}"
                Text="Создание нового аккаунта" />

            <!--  Progress indicator  -->
            <StackPanel
                x:Name="ProgressIndicatorPanel"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    x:Name="StepIndicatorText"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="Шаг 1 из 9" />
                <ProgressBar
                    x:Name="StepProgressBar"
                    Width="200"
                    Height="4"
                    Margin="0,8,0,0"
                    Background="#333333"
                    BorderThickness="0"
                    Foreground="#df5000"
                    Maximum="9"
                    Minimum="0"
                    Value="1" />
            </StackPanel>
        </StackPanel>

        <!--  Основная область контента  -->
        <Grid
            x:Name="MainGrid"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch" />

        <StackPanel
            x:Name="MainContainer"
            Grid.Row="0"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Loaded="MainContainer_Loaded"
            Orientation="Vertical">

            <!--  Step 1: Имя и фамилия  -->
            <StackPanel
                x:Name="Step1"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="Личная информация" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <!--  Имя  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Имя *" />
                        <ui:TextBox
                            x:Name="FirstNameEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Апогея"
                            Style="{DynamicResource InputTextBoxStyle}"
                            Tag="Names"
                            TextChanged="FirstNameEnter_TextChanged" />
                        <TextBlock
                            x:Name="FirstNameValidationText"
                            Margin="0,0,0,15"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <!--  Фамилия  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Фамилия" />
                        <ui:TextBox
                            x:Name="LastNameEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Тайнигейпиратовна"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="LastNameEnter_TextChanged" />
                        <TextBlock
                            x:Name="LastNameValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <!--  Информация  -->
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Имя может содержать любые символы" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Минимально может быть 3 символа" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Длина имени и фамилии ограничена 40 символами" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Фамилия может отсутствовать" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 2: Логин  -->
            <StackPanel
                x:Name="Step2"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="Имя пользователя" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Логин *" />
                        <ui:TextBox
                            x:Name="LoginEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Apogee"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="LoginEnter_TextChanged" />
                        <TextBlock
                            x:Name="LoginValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Логин может содержать:" />
                            <TextBlock
                                Margin="15,2,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="- Символы латинского алфавита" />
                            <TextBlock
                                Margin="15,2,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="- Цифры" />
                            <TextBlock
                                Margin="15,2,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="- Нижнее подчеркивание ( _ ) и тире ( - )" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Логин ограничен 30 символами" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Логин будет преобразован в нижний регистр" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 3: Email  -->
            <StackPanel
                x:Name="Step3"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="Электронная почта" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Почта *" />
                        <ui:TextBox
                            x:Name="EmailEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="apogee@barkfluff.ru"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="EmailEnter_TextChanged" />
                        <TextBlock
                            x:Name="EmailValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Почта может использоваться для 2FA" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Почта будет использоваться для сброса пароля" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• На почту будут отправляться уведомления о входе" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 4: Код подтверждения  -->
            <StackPanel
                x:Name="Step4"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="Подтверждение почты" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Код подтверждения *" />
                        <ui:TextBox
                            x:Name="VerificationCodeEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            MaxLength="6"
                            PlaceholderText="123456"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="VerificationCodeEnter_TextChanged" />
                        <TextBlock
                            x:Name="VerificationCodeValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                x:Name="EmailHelperText"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Сообщение отправлено на вашу почту" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Проверьте папку со спамом" />
                            <TextBlock
                                x:Name="RemainingAttemptsText"
                                HorizontalAlignment="Left"
                                Foreground="#FF9800"
                                Style="{StaticResource TipsStyle}"
                                Text=""
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 5: Пароль  -->
            <StackPanel
                x:Name="Step5"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="Создание пароля" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <!--  Пароль  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Пароль *" />
                        <ui:PasswordBox
                            x:Name="PasswordEnter"
                            Margin="0,0,0,8"
                            KeyDown="TextBox_KeyDown"
                            PasswordChanged="PasswordEnter_TextChanged"
                            PlaceholderText="Введите пароль"
                            Style="{DynamicResource InputTextBoxStyle}" />

                        <!--  Индикатор силы пароля  -->
                        <ProgressBar
                            x:Name="PasswordStrengthBar"
                            Height="4"
                            Margin="0,0,0,5"
                            Background="#333333"
                            BorderThickness="0"
                            Foreground="#FF4646"
                            Maximum="100"
                            Minimum="0"
                            Value="2" />

                        <TextBlock
                            x:Name="PasswordDifficultyIndicator"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DescriptionTextStyle}"
                            Text="Начните вводить пароль" />

                        <!--  Password requirements checklist  -->
                        <StackPanel x:Name="PasswordRequirementsPanel" Margin="0,0,0,15">
                            <TextBlock
                                x:Name="ReqMinLength"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="○ Минимум 8 символов" />
                            <TextBlock
                                x:Name="ReqUpperCase"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="○ Заглавные буквы" />
                            <TextBlock
                                x:Name="ReqLowerCase"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="○ Строчные буквы" />
                            <TextBlock
                                x:Name="ReqDigit"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="○ Цифры" />
                            <TextBlock
                                x:Name="ReqSpecialChar"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="○ Специальные символы" />
                        </StackPanel>

                        <!--  Подтверждение пароля  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="Подтвердите пароль *" />
                        <ui:PasswordBox
                            x:Name="PasswordRepeatedEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PasswordChanged="PasswordRepeatedEnter_TextChanged"
                            PlaceholderText="Повторите пароль"
                            Style="{DynamicResource InputTextBoxStyle}" />
                        <TextBlock
                            x:Name="PasswordMatchText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Используйте комбинацию букв разного регистра"
                                TextWrapping="WrapWithOverflow" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Добавьте цифры и специальные символы" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="• Минимальная длина пароля 8 символов" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 6: Загрузка изображения  -->
            <StackPanel
                x:Name="Step6"
                Width="600"
                Height="800"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="Фото профиля" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel HorizontalAlignment="Center">
                        <crop:CropImage
                            x:Name="Cropper"
                            Width="600"
                            Height="700"
                            Panel.ZIndex="100"
                            DataContext="CreateAccount"
                            Loaded="CropperLoaded" />
                        <TextBlock
                            Margin="0,15,0,0"
                            Style="{StaticResource DescriptionTextStyle}"
                            Text="Загрузите фото профиля" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 7: Добавление описания  -->
            <StackPanel
                x:Name="Step7"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource TitleTextStyle}"
                        Text="Настройка профиля" />
                    <preview:PreviewUser x:Name="PreviewUserElement" Loaded="PreviewUserElement_Loaded" />
                </StackPanel>

            </StackPanel>
            <!--  Step 8: подключение 2fa  -->
            <ScrollViewer
                x:Name="Step8" Width="800"
                Margin="-30,-30,-30,-30"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
                <twofa:TwoFA
                    x:Name="OtpSuggestion"
                    VerticalAlignment="Stretch"
                    Loaded="OtpSuggestion_Loaded" />
            </ScrollViewer>
            <!--  Step 9: Завершение регистрации  -->
            <StackPanel
                x:Name="Step9"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <setupPages:CompletionRegistration x:Name="CompletionRegistrationElement" />
            </StackPanel>

        </StackPanel>

        <!--  Нижняя панель с кнопками  -->
        <StackPanel
            x:Name="ButtonBottomBar"
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <!--  Кнопки навигации  -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <ui:Button
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Style="{StaticResource MainButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Далее" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="ArrowRight12" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="CreateButton"
                    Click="NextButton_Click"
                    Style="{StaticResource MainButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Создать аккаунт" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="Add12" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>