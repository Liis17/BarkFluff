<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.SelectServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1280"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ServerButton" TargetType="Button">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#484848" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="#383838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="ui:Button">
            <Setter Property="Padding" Value="25,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Margin="0,32,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Основной контент  -->
            <StackPanel
                Grid.Row="0"
                MaxWidth="600"
                Margin="0,50,0,30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <!--  Заголовок  -->
                <TextBlock
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Подключение к серверу" />

                <!--  Подзаголовок  -->
                <TextBlock
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Opacity="0.8"
                    Text="Выберите публичный сервер"
                    TextAlignment="Center" />

                <!--  Публичные серверы  -->
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Text="Публичные серверы" />

                <StackPanel x:Name="ServerList" Margin="0,0,0,30">

                    <Border
                        x:Name="NoServer"
                        Margin="14,14,14,0"
                        Padding="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1a1a1a"
                        CornerRadius="22">

                        <StackPanel
                            MaxWidth="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!--  Удивленная иконка сервера  -->
                            <Border
                                Width="72"
                                Height="72"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Center"
                                Background="#FF3C3C3C"
                                CornerRadius="36">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Opacity="0.3"
                                        ShadowDepth="4"
                                        Color="Black" />
                                </Border.Effect>

                                <Grid>
                                    <!--  Основная иконка сервера  -->
                                    <ui:SymbolIcon
                                        Margin="0,-4,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="#FFFF9800"
                                        Symbol="Server20" />

                                    <!--  Знак вопроса для удивления  -->
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Margin="0,-6,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#FFFF5722"
                                        CornerRadius="12">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Opacity="0.4"
                                                ShadowDepth="0"
                                                Color="#FFFF5722" />
                                        </Border.Effect>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="?" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  Удивленный заголовок  -->
                            <TextBlock
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="А где же серверы? 🤔"
                                TextAlignment="Center" />

                            <!--  Описание с удивлением  -->
                            <TextBlock
                                Margin="0,0,0,20"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                Foreground="#FF9E9E9E"
                                LineHeight="18"
                                TextAlignment="Center"
                                TextWrapping="Wrap">
                                <Run Text="Странно... Тут должны были быть серверы," />
                                <LineBreak />
                                <Run Text="но их почему-то нет. Может быть," />
                                <LineBreak />
                                <Run Text="пора создать свой собственный?" />
                            </TextBlock>

                            <!--  Главная кнопка  -->
                            <ui:Button
                                Margin="0,0,0,12"
                                Padding="20,10"
                                HorizontalAlignment="Center"
                                Background="#df5000"
                                BorderThickness="0"
                                CornerRadius="22"
                                Cursor="Hand"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="White"
                                MouseOverBackground="#FFC54700"
                                PressedBackground="#FFAB3D00">


                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Symbol="Add16" />
                                    <TextBlock VerticalAlignment="Center" Text="Поднять свой сервер" />
                                </StackPanel>
                            </ui:Button>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <!--  Разделитель  -->
                <Rectangle
                    Height="1"
                    Margin="0,10,0,30"
                    Fill="#383838" />

                <!--  Свой сервер  -->
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Text="Подключиться к другому серверу" />

                <TextBox
                    x:Name="ServerAddressTextBox"
                    Margin="0,0,0,10"
                    GotFocus="ServerAddressTextBox_GotFocus"
                    Loaded="ServerAddressTextBox_Loaded"
                    Style="{StaticResource CustomTextBox}"
                    Text="" />

                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="12"
                    Foreground="#9E9E9E"
                    Text="Формат: домен/IP:порт (например: myserver.com:8080)" />



                <!--  Кнопки действий  -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                    <ui:Button
                        x:Name="ConnectButton"
                        Width="200"
                        Height="45"
                        Background="#df5000"
                        Click="ConnectButton_Click"
                        CornerRadius="22"
                        MouseOverBackground="#FFC54700"
                        PressedBackground="#FFAB3D00">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Подключиться" />
                                <ui:SymbolIcon
                                    Margin="10,0,0,0"
                                    FontSize="18"
                                    Foreground="White"
                                    Symbol="ArrowRight24" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <!--  Нижняя информационная панель  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Vertical">
                <TextBlock
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="14"
                    FontWeight="Light"
                    Foreground="#9E9E9E"
                    Text="Возникли проблемы с подключением? Ознакомьтесь с нашим руководством по настройке сервера."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>