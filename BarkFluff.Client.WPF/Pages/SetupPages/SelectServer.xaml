<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.SelectServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1280"
    d:DesignWidth="1280"
    Background="{DynamicResource BackgroundWindow}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="ui:Button">
            <Setter Property="Padding" Value="25,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Margin="0,32,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Основной контент  -->
            <StackPanel
                Grid.Row="0"
                MaxWidth="600"
                Margin="0,50,0,30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <!--  Заголовок  -->
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{DynamicResource TitleTextStyle}"
                    Text="Подключение к серверу" />

                <!--  Подзаголовок  -->
                <TextBlock
                    Margin="0,0,0,40"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="Выберите публичный сервер" />

                <!--  Публичные серверы  -->
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource TitleText}"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="Публичные серверы" />

                <StackPanel x:Name="ServerList" Margin="0,0,0,30" />

                <!--  Разделитель  -->
                <Border
                    Height="1"
                    Margin="0,10,0,10"
                    Background="{DynamicResource SeparatorBackground}" />

                <!--  Свой сервер  -->
                <TextBlock
                    Margin="0,0,0,15"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="Подключиться к другому серверу" />

                <ui:TextBox
                    x:Name="ServerAddressTextBox"
                    Margin="0,0,0,10"
                    PlaceholderText="https://myserver.com:443"
                    Style="{DynamicResource InputTextBoxStyle}" />

                <!--  Кнопки действий  -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                    <ui:Button
                        x:Name="ConnectButton"
                        Click="ConnectButton_Click"
                        Style="{DynamicResource RequiredButton}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="Подключиться" />
                                <ui:SymbolIcon Style="{StaticResource RequiredButtonIconStyle}" Symbol="ArrowRight24" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <!--  Нижняя информационная панель  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Vertical">

                <!--  Информация о self-hosted  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Style="{DynamicResource MainStyleBorder}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Foreground="{DynamicResource TextIcon}"
                            Symbol="Server20" />
                        <TextBlock Style="{DynamicResource DescriptionTextStyle}" Text="Хотите развернуть собственный сервер? " />
                        <TextBlock
                            Foreground="{DynamicResource TextHyperlink}"
                            MouseUp="TextBlock_MouseUp"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="Узнайте больше" />

                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="100,0,100,0"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="Возникли проблемы с подключением? Ознакомьтесь с нашим руководством по настройке сервера." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>