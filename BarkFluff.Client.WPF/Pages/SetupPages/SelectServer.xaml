<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.SelectServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1280"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="ui:Button">
            <Setter Property="Padding" Value="25,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Margin="0,32,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Основной контент  -->
            <StackPanel
                Grid.Row="0"
                MaxWidth="600"
                Margin="0,50,0,30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <!--  Заголовок  -->
                <TextBlock
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Подключение к серверу" />

                <!--  Подзаголовок  -->
                <TextBlock
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="16"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Opacity="0.8"
                    Text="Выберите публичный сервер"
                    TextAlignment="Center" />

                <!--  Публичные серверы  -->
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Text="Публичные серверы" />

                <StackPanel x:Name="ServerList" Margin="0,0,0,30">

                    <Border
                        x:Name="NoServer"
                        Margin="14,14,14,0"
                        Padding="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1a1a1a"
                        CornerRadius="22">

                        <StackPanel
                            MaxWidth="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!--  Удивленная иконка сервера  -->
                            <Border
                                Width="72"
                                Height="72"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Center"
                                Background="#FF3C3C3C"
                                CornerRadius="36">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Opacity="0.3"
                                        ShadowDepth="4"
                                        Color="Black" />
                                </Border.Effect>

                                <Grid>
                                    <!--  Основная иконка сервера  -->
                                    <ui:SymbolIcon
                                        Margin="0,-4,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="#FFFF9800"
                                        Symbol="Server20" />
                                </Grid>
                            </Border>

                            <!--  Удивленный заголовок  -->
                            <TextBlock
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="А где же серверы?"
                                TextAlignment="Center" />

                            <!--  Описание с удивлением  -->
                            <TextBlock
                                Margin="0,0,0,20"
                                HorizontalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                Foreground="#FF9E9E9E"
                                LineHeight="18"
                                TextAlignment="Center"
                                TextWrapping="Wrap">
                                <Run Text="Странно... Тут должны были быть серверы..." />

                            </TextBlock>

                            <!--  Главная кнопка  -->
                            <ui:Button Style="{StaticResource MainButton}">


                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolLeft}" Symbol="Add16" />
                                    <ui:TextBlock Style="{StaticResource MainButtonTextRight}" Text="Поднять свой сервер" />
                                </StackPanel>
                            </ui:Button>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <!--  Разделитель  -->
                <Rectangle
                    Height="1"
                    Margin="0,10,0,30"
                    Fill="#383838" />

                <!--  Свой сервер  -->
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="Normal"
                    Foreground="#E0E0E0"
                    Text="Подключиться к другому серверу" />

                <ui:TextBox
                    x:Name="ServerAddressTextBox"
                    Margin="0,0,0,10"
                    Padding="12,10"
                    GotFocus="ServerAddressTextBox_GotFocus"
                    Loaded="ServerAddressTextBox_Loaded"
                    PlaceholderEnabled="True"
                    PlaceholderText="myserver.com:8080" />

                <!--  Кнопки действий  -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                    <ui:Button
                        x:Name="ConnectButton"
                        Click="ConnectButton_Click"
                        Style="{StaticResource MainButton}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="Подключиться" />
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="ArrowRight24" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <!--  Нижняя информационная панель  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Vertical">
                <TextBlock
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="14"
                    FontWeight="Light"
                    Foreground="#9E9E9E"
                    Text="Возникли проблемы с подключением? Ознакомьтесь с нашим руководством по настройке сервера."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>