<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.WelcomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <Image
                Width="80"
                Height="80"
                Margin="0,0,0,30"
                Source="/BarkFluff.Client.WPF;component/Resources/Images/barkfluff_logo.png" />
            <TextBlock
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="36"
                FontWeight="Black"
                Foreground="White"
                Text="BarkFluff" />
            <TextBlock
                Margin="0,0,0,40"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="Medium"
                Foreground="White"
                Opacity="0.8"
                Text="Мессенджер для твоей стаи"
                TextAlignment="Center" />
            <TextBlock
                MaxWidth="400"
                Margin="0,0,0,50"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Light"
                Foreground="White"
                Opacity="0.7"
                Text="Общайтесь с друзьями, делитесь моментами и оставайтесь на связи с теми, кто важен, гаф"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ui:Button
                Width="200"
                Height="45"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Background="#df5000"
                Click="Button_Click"
                CornerRadius="22"
                MouseOverBackground="#FFC54700"
                PressedBackground="#FFAB3D00">
                <ui:Button.Content>
                    <TextBlock
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Начать" />
                </ui:Button.Content>
            </ui:Button>


        </StackPanel>
        <StackPanel
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,15,0"
                Cursor="Hand"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                MouseLeftButtonDown="ClickFooter"
                Text="О проекте" />
            <TextBlock
                Margin="0,0,15,0"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                Text="•" />
            <TextBlock
                Margin="0,0,15,0"
                Cursor="Hand"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                MouseLeftButtonDown="ClickFooter"
                Text="Политика конфиденциальности и условия использования" />
            <TextBlock
                Margin="0,0,15,0"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                Text="•" />
            <TextBlock
                Cursor="Hand"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                MouseLeftButtonDown="ClickFooter"
                Text="Справка" />
        </StackPanel>
    </Grid>
</UserControl>