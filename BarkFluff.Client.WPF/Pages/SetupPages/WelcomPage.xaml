<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="#df5000" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="MouseOverBackground" Value="#FFC54700" />
            <Setter Property="PressedBackground" Value="#FFAB3D00" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <Image
                Width="80"
                Height="80"
                Margin="0,0,0,30"
                Source="/BarkFluff.Client.WPF;component/Resources/Images/barkfluff_logo.png" />
            <TextBlock
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="36"
                FontWeight="Black"
                Foreground="White"
                Text="BarkFluff" />
            <TextBlock
                Margin="0,0,0,40"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="Medium"
                Foreground="White"
                Opacity="0.8"
                Text="Мессенджер для твоей стаи"
                TextAlignment="Center" />
            <TextBlock
                MaxWidth="400"
                Margin="0,0,0,50"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="14"
                FontWeight="Light"
                Foreground="White"
                Opacity="0.7"
                Text="Общайтесь с друзьями, делитесь моментами и оставайтесь на связи с теми, кто важен, гаф"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ui:Button Click="Button_Click">
                <ui:Button.Content>
                    <TextBlock
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Начать" />
                </ui:Button.Content>
            </ui:Button>


        </StackPanel>
        <StackPanel
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,15,0"
                Cursor="Hand"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                MouseLeftButtonDown="ClickFooter"
                Text="О проекте" />
            <TextBlock
                Margin="0,0,15,0"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                Text="•" />
            <TextBlock
                Margin="0,0,15,0"
                Cursor="Hand"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                MouseLeftButtonDown="ClickPrivacyPolicyAndTermsOfUse"
                Text="Политика конфиденциальности и условия использования" />
            <TextBlock
                Margin="0,0,15,0"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                Text="•" />
            <TextBlock
                Cursor="Hand"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                FontWeight="Light"
                Foreground="#FFF39E6D"
                MouseLeftButtonDown="ClickFooter"
                Text="Справка" />
        </StackPanel>
    </Grid>
</UserControl>