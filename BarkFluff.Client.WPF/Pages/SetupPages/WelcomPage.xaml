<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.WelcomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Background" Value="#6D90F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A7AE6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4863C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="30,15"
            Background="White"
            BorderBrush="#E0E6EC"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="40"
                    Height="40"
                    Source="/BarkFluff.Client.WPF;component/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#424B5A"
                    Text="BarkFluff" />
            </StackPanel>
        </Border>

        <!--  Main Content  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Welcome Message  -->
            <StackPanel
                Grid.Column="0"
                Margin="60,40"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="22"
                    Foreground="#8B95A5"
                    Text="Добро пожаловать в" />
                <TextBlock
                    Margin="0,10,0,20"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="#424B5A"
                    Text="BarkFluff Мессенджер " />
                <TextBlock
                    Margin="0,0,0,30"
                    FontSize="16"
                    Foreground="#6B7280"
                    LineHeight="24"
                    TextWrapping="Wrap">
                    Общайтесь с друзьями, родными и другими любителями животных. Делитесь моментами, обменивайтесь лаем и оставайтесь на связи с вашей стаей!
                </TextBlock>

                <Button
                    Width="180"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="Button_Click"
                    Content="Начать"
                    Style="{StaticResource RoundButton}" />

                <TextBlock
                    Margin="0,30,0,0"
                    FontSize="14"
                    Foreground="#8B95A5">
                    Уже есть аккаунт?<Hyperlink Foreground="#6D90F3" TextDecorations="None">Войти</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!--  Image Section  -->
            <Border
                Grid.Column="1"
                Margin="20,40"
                Background="#E9EEF9"
                CornerRadius="20">
                <Grid>
                    <Image
                        Margin="30,30,30,100"
                        Source="/Resources/Placeholders/Placeholder_1.jpg"
                        Stretch="UniformToFill" />
                    <Border
                        Margin="0,0,0,30"
                        Padding="20,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#6D90F3"
                        CornerRadius="15">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Стань частью стаи!" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Padding="30,15"
            Background="White"
            BorderBrush="#E0E6EC"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#8B95A5"
                        Text="© 2025 BarkFluff Inc." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,20,0"
                        Cursor="Hand"
                        Foreground="#6D90F3"
                        Text="Privacy Policy" />
                    <TextBlock
                        Margin="0,0,20,0"
                        Cursor="Hand"
                        Foreground="#6D90F3"
                        Text="Terms of Service" />
                    <TextBlock
                        Cursor="Hand"
                        Foreground="#6D90F3"
                        Text="Help Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
