<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Background="{DynamicResource BackgroundWindow}"
    mc:Ignorable="d">

    <UserControl.Resources />

    <Grid>
        <!--  Main content card with subtle shadow  -->
        <Border
            x:Name="ContentCard"
            Margin="40"
            Padding="60,50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource BorderBlock}"
            CornerRadius="16"
            Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="20" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="40"
                    Direction="270"
                    Opacity="0.25"
                    ShadowDepth="8"
                    Color="Black" />
            </Border.Effect>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <!--  Logo with fade-in animation  -->
                <Image
                    x:Name="LogoImage"
                    Width="120"
                    Height="120"
                    Margin="0,0,0,32"
                    Panel.ZIndex="10"
                    SnapsToDevicePixels="True"
                    Source="/Resources/Images/barkfluff_logo.png">
                    <Image.RenderTransform>
                        <TranslateTransform Y="20" />
                    </Image.RenderTransform>
                </Image>

                <!--  Main title with larger font  -->
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TitleText}"
                    Opacity="0"
                    Text="BarkFluff">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="20" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!--  Subtitle with accent color  -->
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="18"
                    FontWeight="Medium"
                    Foreground="{DynamicResource SubtitleText}"
                    Opacity="0"
                    Text="Мессенджер для твоей стаи"
                    TextAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="20" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!--  Description text  -->
                <TextBlock
                    x:Name="DescriptionText"
                    MaxWidth="420"
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="14"
                    FontWeight="Normal"
                    Foreground="{DynamicResource DescriptionText}"
                    LineHeight="22"
                    Opacity="0"
                    Text="Общайтесь с друзьями, делитесь моментами и оставайтесь на связи с теми, кто важен"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="20" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!--  Modern Windows 11 style button  -->
                <ui:Button
                    x:Name="StartButton"
                    Click="Button_Click"
                    Opacity="0"
                    Style="{StaticResource RequiredButton}">
                    <ui:Button.RenderTransform>
                        <TranslateTransform Y="20" />
                    </ui:Button.RenderTransform>
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource RequiredButtonText}"
                                Text="Начать" />
                            <ui:SymbolIcon
                                Margin="12,0,0,0"
                                FontSize="16"
                                Foreground="{DynamicResource RequiredButtonText}"
                                Symbol="ArrowRight24" />
                        </StackPanel>
                    </ui:Button.Content>
                </ui:Button>
            </StackPanel>
        </Border>

        <!--  Footer with interactive links  -->
        <StackPanel
            x:Name="FooterPanel"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Opacity="0"
            Orientation="Horizontal">
            <TextBlock
                MouseLeftButtonDown="ClickFooter"
                Style="{StaticResource FooterLinkStyle}"
                Text="О проекте" />
            <TextBlock Style="{StaticResource FooterSeparatorStyle}" Text="•" />
            <TextBlock
                MouseLeftButtonDown="ClickPrivacyPolicyAndTermsOfUse"
                Style="{StaticResource FooterLinkStyle}"
                Text="Политика конфиденциальности" />
            <TextBlock Style="{StaticResource FooterSeparatorStyle}" Text="•" />
            <TextBlock
                MouseLeftButtonDown="ClickFooter"
                Style="{StaticResource FooterLinkStyle}"
                Text="Справка" />
        </StackPanel>
    </Grid>
</UserControl>