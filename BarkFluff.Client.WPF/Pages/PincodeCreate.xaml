<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PincodeCreate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="#212121">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    Margin="10"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="32"
                    FontWeight="Black"
                    Foreground="White"
                    Text="Придумайте PIN-код приложения" />
                <TextBlock
                    Margin="10"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.8"
                    Text="Этот код необходимо для сохранения в безопасности ваших данных" />
                <StackPanel
                    x:Name="PinContainer"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="Box0"
                        Width="40"
                        Margin="3"
                        HorizontalContentAlignment="Center"
                        GotFocus="PinBox_GotFocus"
                        Loaded="FocusBoxZero"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                    <TextBox
                        x:Name="Box1"
                        Width="40"
                        Margin="3"
                        HorizontalContentAlignment="Center"
                        GotFocus="PinBox_GotFocus"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                    <TextBox
                        x:Name="Box2"
                        Width="40"
                        Margin="3"
                        HorizontalContentAlignment="Center"
                        GotFocus="PinBox_GotFocus"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                    <TextBox
                        x:Name="Box3"
                        Width="40"
                        Margin="3"
                        HorizontalContentAlignment="Center"
                        GotFocus="PinBox_GotFocus"
                        MaxLength="1"
                        PreviewKeyDown="PinBox_PreviewKeyDown"
                        PreviewTextInput="PinBox_PreviewTextInput"
                        TextChanged="PinBox_TextChanged" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
