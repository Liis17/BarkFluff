<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.MessageContent.AudioMessageContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="50"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Grid x:Name="AudioPanel" MinWidth="250">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Play/Pause or Download button  -->
        <Border
            x:Name="ActionButton"
            Grid.Column="0"
            Width="36"
            Height="36"
            Margin="0,0,10,0"
            Background="#40FFFFFF"
            CornerRadius="18"
            Cursor="Hand">
            <!--  Play icon (default)  -->
            <ui:SymbolIcon
                x:Name="ActionIcon"
                FontSize="18"
                Foreground="White"
                Symbol="ArrowDownload24" />
        </Border>

        <!--  Timeline / Progress area  -->
        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Download progress bar (shown when downloading)  -->
            <ProgressBar
                x:Name="DownloadProgressBar"
                Grid.Row="0"
                Height="4"
                Margin="0,0,0,4"
                Background="#40FFFFFF"
                Foreground="#FFFFC1A4"
                Maximum="100"
                Visibility="Collapsed" />

            <!--  Audio timeline slider (shown when cached)  -->
            <Slider
                x:Name="TimelineSlider"
                Grid.Row="0"
                Margin="0,0,0,2"
                IsEnabled="False"
                Maximum="100"
                Minimum="0"
                Style="{DynamicResource AudioSliderStyle}"
                Visibility="Collapsed" />

            <!--  Time display  -->
            <TextBlock
                x:Name="TimeDisplay"
                Grid.Row="1"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="11"
                Foreground="#AAFFFFFF"
                Text="--:--" />
        </Grid>

        <!--  Download progress text (shown during download)  -->
        <TextBlock
            x:Name="ProgressPercentText"
            Grid.Column="2"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource AdwaitaSans}"
            FontSize="11"
            Foreground="#AAFFFFFF"
            Text=""
            Visibility="Collapsed" />
    </Grid>
</UserControl>
