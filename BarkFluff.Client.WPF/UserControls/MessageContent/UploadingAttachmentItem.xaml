<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.MessageContent.UploadingAttachmentItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="70"
    d:DesignWidth="350"
    mc:Ignorable="d">
    <Border
        Padding="8"
        Background="#33FFFFFF"
        CornerRadius="8"
        Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Preview (thumbnail for images, icon for documents)  -->
            <Border
                Grid.Column="0"
                Width="60"
                Height="60"
                CornerRadius="6"
                ClipToBounds="True">
                <Grid>
                    <Image
                        x:Name="PreviewImage"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <ui:SymbolIcon
                        x:Name="DocumentIcon"
                        Width="32"
                        Height="32"
                        FontSize="32"
                        Foreground="#FFAAAAAA"
                        Symbol="Document24"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!--  File name and size  -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,8,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="FileNameText"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="White"
                    Text="filename.jpg"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="FileSizeText"
                    Margin="0,2,0,0"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="11"
                    Foreground="#FFAAAAAA"
                    Text="2.3 MB" />
            </StackPanel>

            <!--  Progress or status  -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <!--  Progress bar (when Uploading)  -->
                <StackPanel
                    x:Name="UploadingPanel"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ProgressBar
                        x:Name="UploadProgressBar"
                        Width="80"
                        Height="6"
                        Background="#33FFFFFF"
                        BorderThickness="0"
                        Foreground="#FFFFC1A4"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
                    <TextBlock
                        x:Name="ProgressText"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="10"
                        Foreground="#FFAAAAAA"
                        Text="0%" />
                </StackPanel>

                <!--  Checkmark (when Uploaded)  -->
                <ui:SymbolIcon
                    x:Name="UploadedIcon"
                    Width="24"
                    Height="24"
                    FontSize="24"
                    Foreground="#FF4CAF50"
                    Symbol="Checkmark12"
                    Visibility="Collapsed">
                    <ui:SymbolIcon.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FF4CAF50" />
                    </ui:SymbolIcon.Effect>
                </ui:SymbolIcon>

                <!--  Error icon (when Failed)  -->
                <ui:SymbolIcon
                    x:Name="FailedIcon"
                    Width="24"
                    Height="24"
                    FontSize="24"
                    Foreground="#FFEF5350"
                    Symbol="ErrorCircle12"
                    Visibility="Collapsed"
                    ToolTip="Ошибка загрузки. Нажмите для повтора">
                    <ui:SymbolIcon.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FFEF5350" />
                    </ui:SymbolIcon.Effect>
                </ui:SymbolIcon>

                <!--  Pending icon (when Pending)  -->
                <ui:SymbolIcon
                    x:Name="PendingIcon"
                    Width="24"
                    Height="24"
                    FontSize="24"
                    Foreground="#FFAAAAAA"
                    Symbol="Clock12"
                    Visibility="Visible" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
