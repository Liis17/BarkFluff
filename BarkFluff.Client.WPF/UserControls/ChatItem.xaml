<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ChatItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:autocolor="clr-namespace:BarkFluff.Client.WPF.Services.App.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinHeight="70"
    MaxHeight="70"
    Margin="0,0,16,0"
    HorizontalAlignment="Stretch"
    d:DesignHeight="150"
    d:DesignWidth="400"
    AllowDrop="True"
    Background="#00ffffff"
    Cursor="Hand"
    DragEnter="UserControl_DragEnter"
    DragLeave="UserControl_DragLeave"
    DragOver="UserControl_DragOver"
    Drop="UserControl_Drop"
    MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
    mc:Ignorable="d">

    <Border
        x:Name="MainBackground"
        Margin="2,0,0,0"
        Padding="8"
        CornerRadius="0 12 12 0">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="8"
                Opacity="0.1"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0" Color="#252526" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#373737"
                                        Duration="0:0:0.1" />
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                        To="1"
                                        Duration="0:0:0.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#252526"
                                        Duration="0:0:0.1" />
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                        To="0"
                                        Duration="0:0:0.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid
                x:Name="BaseChatGrid"
                HorizontalAlignment="Stretch"
                Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Аватар с индикатором онлайна  -->
                <Grid
                    Grid.Column="0"
                    Width="50"
                    Height="50"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center">

                    <local:CachedAvatar
                        x:Name="AvatarControl"
                        Width="50"
                        Height="50"
                        Panel.ZIndex="1"
                        AvatarSize="Normal"
                        AvatarType="Image"
                        CornerRadius="23"
                        EnableDynamicShadow="False"
                        ShadowBlurRadius="12"
                        ShadowOpacity="0.9" />
                    <!--  Индикатор онлайна  -->
                    <Ellipse
                        x:Name="OnlineIndicator"
                        Width="14"
                        Height="14"
                        Margin="0,0,-2,-2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="4"
                        Fill="#44D62C"
                        Stroke="#1E1E1E"
                        StrokeThickness="2"
                        Visibility="Visible" />
                </Grid>

                <!--  Контент сообщения  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,8"
                    VerticalAlignment="Center">

                    <!--  Имя пользователя  -->
                    <TextBlock
                        x:Name="Title"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontWeight="Bold"
                        Opacity="0.9"
                        TextWrapping="NoWrap"
                        Style="{DynamicResource LittleTitleTextStyle}"
                        Text="#publicusername" />

                    <!--  Последнее сообщение  -->
                    <TextBlock
                        x:Name="LastMessage"
                        MaxWidth="280"
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource Neucha}"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="#sample message"
                        TextWrapping="NoWrap" />

                </StackPanel>

                <!--  Статус прочтения и время  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,8,0,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Vertical">

                    <!--  Unread Badge  -->
                    <Border
                        x:Name="UnreadBadge"
                        MinWidth="20"
                        MinHeight="20"
                        Margin="0,0,0,4"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        Background="#f8a947"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="6"
                                Opacity="0.5"
                                ShadowDepth="0"
                                Color="#f8a947" />
                        </Border.Effect>
                        <TextBlock
                            x:Name="UnreadCountText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="1" />
                    </Border>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <!--  Read Status Checkmarks  -->
                        <Grid
                            x:Name="ReadStatusPanel"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            Visibility="Visible">
                            <ui:SymbolIcon
                                x:Name="FirstCheckmark"
                                Width="20"
                                Height="20"
                                Margin="0,0,-5,0"
                                FontSize="16"
                                Foreground="#f8a947"
                                Symbol="Checkmark12">
                                <ui:SymbolIcon.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Opacity="0.4"
                                        ShadowDepth="0"
                                        Color="#f8a947" />
                                </ui:SymbolIcon.Effect>
                            </ui:SymbolIcon>
                            <ui:SymbolIcon
                                x:Name="SecondCheckmark"
                                Width="20"
                                Height="20"
                                FontSize="16"
                                Foreground="#f8a947"
                                Symbol="Checkmark12">
                                <ui:SymbolIcon.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Opacity="0.4"
                                        ShadowDepth="0"
                                        Color="#f8a947" />
                                </ui:SymbolIcon.Effect>
                            </ui:SymbolIcon>
                        </Grid>

                        <!--  Время  -->
                        <TextBlock
                            x:Name="TimeMessage"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="14:30" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  Drag & Drop визуальный overlay  -->
            <Grid
                x:Name="DragDropVisualOverlay"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="10"
                Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Аватар с индикатором онлайна  -->
                <Grid
                    Grid.Column="0"
                    Width="50"
                    Height="50"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center">

                    <local:CachedAvatar
                        x:Name="DragDropAvatar"
                        Width="50"
                        Height="50"
                        Panel.ZIndex="1"
                        AvatarSize="Normal"
                        AvatarType="Image"
                        CornerRadius="23"
                        EnableDynamicShadow="False"
                        ShadowBlurRadius="12"
                        ShadowOpacity="0.9" />

                    <Border
                        Width="50"
                        Height="50"
                        Panel.ZIndex="2"
                        Background="#508fd6"
                        CornerRadius="23"
                        Visibility="Collapsed">
                        <ui:SymbolIcon
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Filled="True"
                            FontSize="30"
                            Foreground="White"
                            Symbol="Bookmark32" />
                    </Border>
                    <Border
                        Width="50"
                        Height="50"
                        Panel.ZIndex="3"
                        Background="#508fd6"
                        CornerRadius="23"
                        Visibility="Collapsed">
                        <ui:SymbolIcon
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Filled="True"
                            FontSize="30"
                            Foreground="White"
                            Symbol="Person32" />
                    </Border>
                </Grid>

                <!--  Контент сообщения  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,8"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <!--  Имя пользователя  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontWeight="Bold"
                        Opacity="0.9"
                        Style="{DynamicResource LittleTitleTextStyle}"
                        Text="Отправить в этот чат" />

                    <!--  Последнее сообщение  -->
                    <TextBlock
                        MaxWidth="280"
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource Neucha}"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Отпустите файл чтобы отправить его в этот чат"
                        TextAlignment="Left"
                        TextWrapping="NoWrap" />

                </StackPanel>
                <ui:SymbolIcon
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Foreground="{DynamicResource TitleText}"
                    Symbol="ArrowCurveDownRight20" />
            </Grid>
        </Grid>
    </Border>



</UserControl>