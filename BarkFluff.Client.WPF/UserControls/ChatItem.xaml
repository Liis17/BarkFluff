<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ChatItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:autocolor="clr-namespace:BarkFluff.Client.WPF.Services.App.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinHeight="70"
    MaxHeight="160"
    Margin="0,0,16,0"
    HorizontalAlignment="Stretch"
    d:DesignHeight="150"
    d:DesignWidth="400"
    AllowDrop="True"
    Background="#00ffffff"
    Cursor="Hand"
    DragEnter="UserControl_DragEnter"
    DragLeave="UserControl_DragLeave"
    DragOver="UserControl_DragOver"
    Drop="UserControl_Drop"
    MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
    mc:Ignorable="d">

    <Border
        x:Name="MainBackground"
        Margin="2,0,0,0"
        Padding="8"
        CornerRadius="0 12 12 0">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="8"
                Opacity="0.1"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0" Color="#252526" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#373737"
                                        Duration="0:0:0.1" />
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                        To="1"
                                        Duration="0:0:0.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#252526"
                                        Duration="0:0:0.1" />
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                        To="0"
                                        Duration="0:0:0.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid x:Name="BaseChatGrid" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Аватар с индикатором онлайна  -->
                <Grid
                    Grid.Column="0"
                    Width="50"
                    Height="50"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center">
                    <local:CachedAvatar
                        x:Name="AvatarControl"
                        Width="50"
                        Height="50"
                        CornerRadius="23"
                        EnableDynamicShadow="False"
                        ShadowBlurRadius="12"
                        ShadowOpacity="0.9" />

                    <!--  Индикатор онлайна  -->
                    <Ellipse
                        x:Name="OnlineIndicator"
                        Width="14"
                        Height="14"
                        Margin="0,0,-2,-2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="#44D62C"
                        Stroke="#1E1E1E"
                        StrokeThickness="2"
                        Visibility="Collapsed" />
                </Grid>

                <!--  Контент сообщения  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,8"
                    VerticalAlignment="Center">

                    <!--  Имя пользователя  -->
                    <TextBlock
                        x:Name="Title"
                        Margin="0,0,0,4"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="#publicusername" />

                    <!--  Последнее сообщение  -->
                    <TextBlock
                        x:Name="LastMessage"
                        MaxWidth="280"
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource Neucha}"
                        FontSize="12"
                        FontStretch="Medium"
                        FontStyle="Normal"
                        FontWeight="Normal"
                        Foreground="#9e9e9e"
                        Opacity="0.7"
                        Text="#sample message"
                        TextWrapping="Wrap" />

                </StackPanel>

                <!--  Статус прочтения и время  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,8,0,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Vertical">

                    <!--  Unread Badge  -->
                    <Border
                        x:Name="UnreadBadge"
                        MinWidth="20"
                        MinHeight="20"
                        Margin="0,0,0,4"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        Background="#f8a947"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="6"
                                Opacity="0.5"
                                ShadowDepth="0"
                                Color="#f8a947" />
                        </Border.Effect>
                        <TextBlock
                            x:Name="UnreadCountText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="1" />
                    </Border>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <!--  Read Status Checkmarks  -->
                        <Grid
                            x:Name="ReadStatusPanel"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed">
                            <ui:SymbolIcon
                                x:Name="FirstCheckmark"
                                Width="20"
                                Height="20"
                                Margin="0,0,-5,0"
                                FontSize="16"
                                Foreground="#f8a947"
                                Symbol="Checkmark12">
                                <ui:SymbolIcon.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Opacity="0.4"
                                        ShadowDepth="0"
                                        Color="#f8a947" />
                                </ui:SymbolIcon.Effect>
                            </ui:SymbolIcon>
                            <ui:SymbolIcon
                                x:Name="SecondCheckmark"
                                Width="20"
                                Height="20"
                                FontSize="16"
                                Foreground="#f8a947"
                                Symbol="Checkmark12">
                                <ui:SymbolIcon.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Opacity="0.4"
                                        ShadowDepth="0"
                                        Color="#f8a947" />
                                </ui:SymbolIcon.Effect>
                            </ui:SymbolIcon>
                        </Grid>

                        <!--  Время  -->
                        <TextBlock
                            x:Name="TimeMessage"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#FF808080"
                            Text="14:30" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  Drag & Drop визуальный overlay  -->
            <Grid
                x:Name="DragDropVisualOverlay"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="10"
                Visibility="Collapsed">

                <!--  Полупрозрачный фон с оранжевой обводкой  -->
                <Border
                    Background="#DD1E1E1E"
                    BorderBrush="#FFCE6432"
                    BorderThickness="3"
                    CornerRadius="0 12 12 0">

                    <!--  Контент: Аватар + Название чата + Текст действия  -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Аватар  -->
                        <local:CachedAvatar
                            x:Name="DragDropAvatar"
                            Grid.Row="0"
                            Width="60"
                            Height="60"
                            Margin="0,20,0,10"
                            HorizontalAlignment="Center"
                            CornerRadius="30"
                            EnableDynamicShadow="False" />

                        <!--  Название чата  -->
                        <TextBlock
                            x:Name="DragDropTitle"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="" />

                        <!--  Текст действия  -->
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="#FFCE6432"
                            Text="Отправить в этот чат" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>



</UserControl>