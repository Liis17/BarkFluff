<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ChatItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    HorizontalAlignment="Stretch"
    d:DesignHeight="150"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
            <Border
                Width="130"
                Height="130"
                Margin="0,0,30,0"
                Background="#FFDA9A9A"
                CornerRadius="90" />

            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="Title"
                        HorizontalAlignment="Left"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="15"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="Apogee" />
                    <ui:SymbolIcon
                        Margin="0,2,4,0"
                        HorizontalAlignment="Right"
                        Foreground="#d48e41"
                        Symbol="Checkmark12" />
                    <ui:SymbolIcon
                        HorizontalAlignment="Right"
                        Foreground="#d48e41"
                        Symbol="Checkmark12" />
                </Grid>
                <TextBlock
                    x:Name="LastMessage"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="13"
                    Foreground="#FF9E9E9E"
                    Text="хвост слишком пушистый (" />

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
