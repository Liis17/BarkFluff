<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingsControls="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="#1f1f1f"
        CornerRadius="12">
        <StackPanel VerticalAlignment="Top" Orientation="Vertical">
            <Border
                x:Name="Avatar"
                Height="120"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top" />
            <!--<settingsControls:UsedSpaceProgressBar HorizontalAlignment="Stretch" />-->
            <Separator />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="5"
                    Padding="5,0,5,0"
                    Background="#1f1f1f"
                    Style="{DynamicResource Win11CardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <settingsControls:SettingsMenuBlock />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    Padding="5,0,5,0"
                    Background="#1f1f1f"
                    Style="{DynamicResource Win11CardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <settingsControls:SettingsMenuBlock />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    Padding="5,0,5,0"
                    Background="#1f1f1f"
                    Style="{DynamicResource Win11CardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <settingsControls:SettingsMenuBlock />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    Padding="5,0,5,0"
                    Background="#1f1f1f"
                    Style="{DynamicResource Win11CardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <settingsControls:SettingsMenuBlock />
                    </StackPanel>
                </Border>
            </Grid>


        </StackPanel>
    </Border>
</UserControl>
