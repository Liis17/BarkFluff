<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MaxWidth="600"
    HorizontalAlignment="Left"
    VerticalAlignment="Bottom"
    d:DesignHeight="130"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Стиль для входящих сообщений (более скруглённый и мягкий)  -->
        <Style x:Key="IncomingMessageStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF3A3A3D" />
                        <GradientStop Offset="1" Color="#FF2D2D30" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MaxWidth" Value="600" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="CornerRadius" Value="18,18,18,6" />
        </Style>

        <!--  Стиль для исходящих сообщений (более скруглённый и мягкий)  -->
        <Style x:Key="OutgoingMessageStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#D49A7A" />
                        <GradientStop Offset="1" Color="#C87E5B" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MaxWidth" Value="600" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="CornerRadius" Value="18,18,6,18" />
        </Style>

        <!--  Контекстное меню  -->
        <ContextMenu
            x:Key="MessageContextMenu"
            Background="#FF3C3C3C"
            BorderBrush="#FF505050"
            BorderThickness="1">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontFamily" Value="{DynamicResource AdwaitaSans}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border
                                    Margin="3"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}" />

                                        <ContentPresenter
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Header}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#FF8A8A8A"
                                            Text="{TemplateBinding InputGestureText}" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#FF505050" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>

            <MenuItem Click="OnReplyClick" Header="Ответить">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowReply16" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Click="OnForwardClick" Header="Переслать">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowForward16" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem
                Click="OnCopyClick"
                Header="Копировать"
                InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="Copy16" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem
                Click="OnSelectAllTextClick"
                Header="Выделить текст"
                InputGestureText="Ctrl+A">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="SelectAllOff16" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator Margin="6,4" Background="#FF505050" />

            <MenuItem Click="OnPinClick" Header="Закрепить">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="Pin16" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Click="OnAddToFavoritesClick" Header="Добавить в избранное">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="14" Symbol="Star16" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator Margin="6,4" Background="#FF505050" />

            <MenuItem
                Click="OnEditClick"
                Foreground="#FFFFB74D"
                Header="Изменить">
                <MenuItem.Icon>
                    <ui:SymbolIcon
                        FontSize="14"
                        Foreground="#FFFFB74D"
                        Symbol="Edit16" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem
                Click="OnDeleteClick"
                Foreground="#FFEF5350"
                Header="Удалить">
                <MenuItem.Icon>
                    <ui:SymbolIcon
                        FontSize="14"
                        Foreground="#FFEF5350"
                        Symbol="Delete16" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Grid x:Name="MainGrid" HorizontalAlignment="Left">
        <!--  Основное облачко сообщения  -->
        <Border
            x:Name="MessageBorder"
            Padding="0,0,0,0"
            ContextMenu="{StaticResource MessageContextMenu}"
            Style="{StaticResource IncomingMessageStyle}">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="12"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Имя отправителя (для входящих сообщений)  -->
                <TextBlock
                    x:Name="SenderName"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="14,10,14,4"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FF8B5A3C"
                    Text="Apogee"
                    Visibility="Visible" />

                <!--  Динамический контент сообщения (Image, Video, Document)  -->
                <ContentPresenter
                    x:Name="MediaContentPresenter"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,5"
                    Content="{x:Null}" />

                <!--  Текстовое содержимое сообщения  -->
                <ContentPresenter
                    x:Name="TextContentPresenter"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="14,0,14,0"
                    Content="{x:Null}" />

                <!--  Время и статус  -->
                <Grid
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Время отправки  -->
                    <TextBlock
                        x:Name="MessageTime"
                        Grid.Column="0"
                        Margin="0,0,4,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="11"
                        Foreground="#E0FFFFFF"
                        Text="placeholder"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.ToolTip>
                            <ToolTip x:Name="MessageTimeToolTip">
                                <TextBlock Text="placeholder" />
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <!--  Статус прочтения (только для исходящих)  -->
                    <StackPanel
                        x:Name="ReadStatus"
                        Grid.Column="1"
                        Margin="0,-5,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Visibility="Visible">

                        <!--  Pending/Loading icon (clock)  -->
                        <ui:SymbolIcon
                            x:Name="PendingIcon"
                            Width="16"
                            Height="16"
                            FontSize="16"
                            Foreground="#FFFFC1A4"
                            Symbol="Clock12"
                            Visibility="Collapsed">
                            <ui:SymbolIcon.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.8"
                                    ShadowDepth="0"
                                    Color="#FF353535" />
                            </ui:SymbolIcon.Effect>
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform x:Name="PendingRotation" CenterX="8" CenterY="8" />
                            </ui:SymbolIcon.RenderTransform>
                            <ui:SymbolIcon.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="PendingRotation"
                                                Storyboard.TargetProperty="Angle"
                                                From="0"
                                                To="360"
                                                Duration="0:0:2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ui:SymbolIcon.Triggers>
                        </ui:SymbolIcon>

                        <!--  First checkmark (always shown when message is sent)  -->
                        <ui:SymbolIcon
                            x:Name="SingleCheckmark"
                            Width="20"
                            Height="20"
                            Margin="0,0,0,0"
                            FontSize="20"
                            Foreground="#FFFFC1A4"
                            Symbol="Checkmark12"
                            Visibility="Collapsed">
                            <ui:SymbolIcon.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.8"
                                    ShadowDepth="0"
                                    Color="#FF353535" />
                            </ui:SymbolIcon.Effect>
                        </ui:SymbolIcon>

                        <!--  Second checkmark (shown when message is read)  -->
                        <ui:SymbolIcon
                            x:Name="DoubleCheckmark"
                            Width="20"
                            Height="20"
                            Margin="-15,0,0,0"
                            Panel.ZIndex="-1"
                            FontSize="20"
                            Foreground="#FFFFC1A4"
                            Symbol="Checkmark12"
                            Visibility="Collapsed">
                            <ui:SymbolIcon.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.8"
                                    ShadowDepth="0"
                                    Color="#FF353535" />
                            </ui:SymbolIcon.Effect>
                        </ui:SymbolIcon>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Индикатор редактирования  -->
        <Border
            x:Name="EditIndicator"
            Margin="10,-8,0,0"
            Padding="8,3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="10"
            Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FFFFB74D" />
                    <GradientStop Offset="1" Color="#FFFF9800" />
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="9"
                FontWeight="Medium"
                Foreground="White"
                Text="изменено" />
        </Border>
    </Grid>
</UserControl>
