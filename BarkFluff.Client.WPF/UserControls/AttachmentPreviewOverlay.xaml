<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.AttachmentPreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Border
        MaxWidth="600"
        MaxHeight="700"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#FF2D2D30"
        CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="30"
                Direction="270"
                Opacity="0.5"
                ShadowDepth="10"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Предпросмотр вложений" />

            <!--  Preview Area  -->
            <ScrollViewer
                Grid.Row="1"
                MaxHeight="450"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PreviewItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!--  Footer with buttons  -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Cancel Button  -->
                <ui:Button
                    x:Name="CancelButton"
                    Grid.Column="0"
                    Width="120"
                    HorizontalAlignment="Left"
                    Background="#FF6B6B6B"
                    Click="CancelButton_Click"
                    Content="отмена"
                    CornerRadius="8"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="14"
                    Foreground="White" />

                <!--  Send Button with Dropdown  -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        x:Name="SendButton"
                        Grid.Column="0"
                        Width="120"
                        Background="#FFCE6432"
                        Click="SendButton_Click"
                        Content="отправить"
                        CornerRadius="8,0,0,8"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        Foreground="White" />

                    <ui:Button
                        x:Name="SendOptionsButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="#FFCE6432"
                        Click="SendOptionsButton_Click"
                        CornerRadius="0,8,8,0"
                        FontSize="12">
                        <ui:SymbolIcon FontSize="16" Symbol="ChevronDown12" />
                    </ui:Button>

                    <!--  Dropdown Popup  -->
                    <Popup
                        x:Name="SendOptionsPopup"
                        AllowsTransparency="True"
                        Placement="Top"
                        PlacementTarget="{Binding ElementName=SendOptionsButton}"
                        StaysOpen="False">
                        <Border
                            Background="#FF3C3C3C"
                            BorderBrush="#FF505050"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <Button
                                    x:Name="SendSeparatelyButton"
                                    Padding="12,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="SendSeparatelyButton_Click"
                                    Content="отправить отдельно"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="13"
                                    Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF505050" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
