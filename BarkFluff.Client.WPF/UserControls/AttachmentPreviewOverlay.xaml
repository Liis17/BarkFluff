<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.AttachmentPreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="500"
    AllowDrop="True"
    DragEnter="UserControl_DragEnter"
    DragLeave="UserControl_DragLeave"
    DragOver="UserControl_DragOver"
    Drop="UserControl_Drop"
    mc:Ignorable="d">
    <Border
        x:Name="MainBorder"
        MaxWidth="800"
        MaxHeight="700"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#FF202020"
        BorderBrush="#30FFFFFF"
        BorderThickness="1"
        CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="50"
                Direction="270"
                Opacity="0.5"
                ShadowDepth="15"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Заголовок  -->
                <TextBlock
                    x:Name="HeaderTextBlock"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Предпросмотр вложений" />

                <!--  Кнопка добавления вложений  -->
                <ui:Button
                    x:Name="AddAttachmentButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Margin="8,0"
                    Padding="0"
                    Background="#FF3C3C3C"
                    Click="AddAttachmentButton_Click"
                    CornerRadius="8">
                    <ui:SymbolIcon
                        FontSize="16"
                        Foreground="White"
                        Symbol="Add24" />
                </ui:Button>

                <!--  Кнопка закрытия  -->
                <ui:Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    Click="CancelButton_Click"
                    CornerRadius="8">
                    <ui:SymbolIcon
                        FontSize="16"
                        Foreground="White"
                        Symbol="Dismiss24" />
                </ui:Button>
            </Grid>

            <!--  Preview Area  -->
            <Border Grid.Row="1" Padding="8" Background="#1a1a1a">
                <ScrollViewer
                    MaxHeight="400"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PreviewItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>


            <!--  Message Text Input  -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Строка с текстовым полем и кнопкой отправки  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        x:Name="MessageTextBox"
                        Grid.Column="0"
                        MinHeight="40"
                        MaxHeight="80"
                        Margin="0,0,8,0"
                        Padding="0,5"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        BorderThickness="0"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        Foreground="White"
                        PlaceholderEnabled="True"
                        PlaceholderText="Сообщение"
                        Style="{StaticResource MessageInputTextBox}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <ui:Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Width="50"
                        Height="40"
                        Background="#FFCE6432"
                        Click="SendButton_Click"
                        CornerRadius="8"
                        ToolTip="Отправить">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="White"
                            Symbol="Send24" />
                    </ui:Button>
                </Grid>

                <!--  Галочки с опциями  -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <CheckBox
                        x:Name="SendAsFileCheckBox"
                        Checked="SendAsFileCheckBox_Changed"
                        Content="Отправить без сжатия"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        Foreground="#FFAAAAAA"
                        Unchecked="SendAsFileCheckBox_Changed"
                        Visibility="Collapsed" />
                    <CheckBox
                        x:Name="SendSeparatelyCheckBox"
                        Margin="0,4,0,0"
                        Content="Отправить без группировки"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        Foreground="#FFAAAAAA" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
