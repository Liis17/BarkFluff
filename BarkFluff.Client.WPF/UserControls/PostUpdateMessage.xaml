<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.PostUpdateMessage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Border
            Height="100"
            
            Padding="0"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#1f1f1f"
            CornerRadius="12"
            Style="{DynamicResource Win11CardStyle}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock x:Name="TitleText" Style="{DynamicResource PostUpdateStyleText}" Text="Приложение обновлено " />
                <TextBlock
                    x:Name="VersionText"
                    FontSize="20"
                    Style="{DynamicResource PostUpdateStyleText}"
                    Text="N" />
            </StackPanel>

        </Border>
    </Grid>
</UserControl>
