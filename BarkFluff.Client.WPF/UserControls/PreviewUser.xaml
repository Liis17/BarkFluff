<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.PreviewUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,-520,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource AdwaitaSans}"
            FontSize="34"
            FontWeight="SemiBold"
            Foreground="White"
            Text="Настройка профиля" />
        <Border
            Padding="30,25"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1F1F1F"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">



                    <StackPanel
                        Margin="0,0,0,30"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <Border
                            Width="100"
                            Height="100"
                            Margin="0,0,25,0"
                            Background="#282828"
                            CornerRadius="50">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    Opacity="0.3"
                                    ShadowDepth="2"
                                    Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Ellipse
                                    x:Name="AvatarImage"
                                    Width="100"
                                    Height="100">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ui:SymbolIcon
                                    x:Name="AvatarPlaceholder"
                                    Panel.ZIndex="-1"
                                    FontSize="40"
                                    Foreground="#FF505050"
                                    Symbol="Person24" />
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">

                            <TextBlock
                                x:Name="FullNameText"
                                Margin="0,0,0,5"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Имя Фамилия" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="16"
                                    FontWeight="Normal"
                                    Foreground="#9E9E9E"
                                    Text="@" />
                                <TextBlock
                                    x:Name="UsernameText"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="16"
                                    FontWeight="Normal"
                                    Foreground="#9E9E9E"
                                    Text="username" />
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="15"
                        FontWeight="Normal"
                        Foreground="#E0E0E0"
                        Text="Расскажите немного о себе для других пользователей" />


                    <Border
                        Width="450"
                        Height="120"
                        Background="#282828"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="5"
                                Opacity="0.2"
                                ShadowDepth="1"
                                Color="Black" />
                        </Border.Effect>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ui:TextBox
                                x:Name="AboutTextBox"
                                Padding="15"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="White"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="15"
                                FontWeight="Normal"
                                Foreground="White"
                                PlaceholderText="О себе, работе, хобби... или оставьте пустым"
                                Text=""
                                TextChanged="AboutTextBox_TextChanged"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Disabled" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock
                        x:Name="ErrorTextBlockMessage"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="Normal"
                        Foreground="#FFE62F2F"
                        Text=""
                        Visibility="Collapsed" />

                    <ui:Button
                        x:Name="SaveButton"
                        Width="200"
                        Height="45"
                        Margin="0,25,0,20"
                        HorizontalAlignment="Center"
                        Background="#df5000"
                        BorderThickness="0"
                        Click="SaveButton_Click"
                        CornerRadius="22"
                        MouseOverBackground="#FFC54700"
                        PressedBackground="#FFAB3D00">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Сохранить" />
                                <ui:SymbolIcon
                                    Margin="10,0,0,0"
                                    FontSize="18"
                                    Foreground="White"
                                    Symbol="Checkmark24" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Vertical">
                    <TextBlock
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="14"
                        FontWeight="Light"
                        Foreground="#9E9E9E"
                        Text="Информация о себе будет видна другим пользователям. Вы можете изменить её в любое время в настройках."
                        TextAlignment="Center"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </Grid>

        </Border>

    </Grid>
</UserControl>
