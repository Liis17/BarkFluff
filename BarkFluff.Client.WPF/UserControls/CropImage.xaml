<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.CropImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="500"
    Height="600"
    MaxWidth="500"
    MaxHeight="600"
    d:DesignHeight="600"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="#1e1e1e">
        <Grid x:Name="ButtonGrid">
            <ui:Button
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="LoadButton_Click"
                ToolTip="Выбрать картинку для аватара в проводнике">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Выбрать аватар" />
                    <ui:SymbolIcon FontSize="21" Symbol="ArrowDownload20" />
                </StackPanel>
            </ui:Button>
        </Grid>
        <Grid x:Name="CropGrid">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="100"
                Orientation="Vertical">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Height="36"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Center"
                        Click="Button_Click"
                        Content="Обрезать"
                        ToolTip="Выбрать текущий вариант аварата и применить его для профиля" />
                    <Button
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        Click="ResetPosition"
                        ToolTip="Вернуть картинку в исходное состояние">
                        <ui:SymbolIcon FontSize="21" Symbol="ArrowMoveInward20" />
                    </Button>
                    <Button
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        Click="LoadButton_Click"
                        ToolTip="Выбрать другую картинку">
                        <ui:SymbolIcon FontSize="21" Symbol="ArrowDownload20" />
                    </Button>
                </StackPanel>
                <Slider
                    x:Name="ZoomSlider"
                    Width="300"
                    Margin="10"
                    HorizontalAlignment="Center"
                    Maximum="2.5"
                    Minimum="0.5"
                    Value="1.0" />
            </StackPanel>

            <Canvas x:Name="MainCanvas" ClipToBounds="True">

                <Image x:Name="ImageControl" RenderTransformOrigin="0.5,0.5" />
                <Canvas
                    x:Name="MaskCanvas"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    IsHitTestVisible="False">
                    <Path Fill="#99000000">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,500,600" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry
                                        Center="250,250"
                                        RadiusX="200"
                                        RadiusY="200" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                </Canvas>
                <Rectangle
                    x:Name="CropBorder"
                    Canvas.Left="50"
                    Canvas.Top="50"
                    Width="400"
                    Height="400"
                    IsHitTestVisible="False"
                    Stroke="Transparent"
                    StrokeThickness="2"
                    Tag="Эта та самая рамка по которой идет обрезание хихихи" />
            </Canvas>
        </Grid>

    </Grid>
</UserControl>
