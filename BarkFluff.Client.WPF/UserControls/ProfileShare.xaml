<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ProfileShare"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="350"
    d:DesignWidth="350"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Стиль для текста  -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--  Основной контейнер с тенью  -->
    <Grid Margin="10">
        <Border
            x:Name="CardBackground"
            Background="#1f1f1f"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Direction="270"
                    Opacity="0.4"
                    ShadowDepth="5"
                    Color="Black" />
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  QR Code  -->
                    <RowDefinition Height="*" />
                    <!--  User Info  -->
                </Grid.RowDefinitions>

                <!--  1. Область QR Кода  -->
                <!--  Белый фон обязателен для контраста QR кода, даже в темной теме  -->
                <Border
                    Grid.Row="0"
                    Width="220"
                    Height="220"
                    Padding="10"
                    Background="White"
                    CornerRadius="18">
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding QrCodeSource, RelativeSource={RelativeSource AncestorType=local:ProfileShare}}"
                        Stretch="Uniform" />
                </Border>



                <!--  2. Информация о пользователе  -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top">


                    <!--  Username  -->
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Opacity="0.8"
                        Text="{Binding Username, RelativeSource={RelativeSource AncestorType=local:ProfileShare}, FallbackValue='@username'}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>