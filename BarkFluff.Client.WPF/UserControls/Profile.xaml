<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.Profile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Стиль для баджей  -->
        <Style x:Key="ProfileBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <!--  Стиль для информационных карточек в стиле Windows 11  -->
        <Style x:Key="FluentInfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="BorderBrush" Value="#15FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Border
        Background="#1A1A2E"
        CornerRadius="12">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Верхняя секция с аватаром и основной информацией  -->
                <Border
                    Grid.Row="0"
                    Padding="24,32,24,24"
                    Background="#252540"
                    CornerRadius="12,12,0,0">

                    <StackPanel HorizontalAlignment="Center">
                        <!--  Аватар с тенью  -->
                        <Border
                            Width="110"
                            Height="110"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            CornerRadius="55">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="0.4"
                                    ShadowDepth="4"
                                    Color="#000000" />
                            </Border.Effect>
                            <Border
                                Width="110"
                                Height="110"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="3"
                                CornerRadius="55">
                                <Border CornerRadius="52">
                                    <Border.Background>
                                        <ImageBrush
                                            x:Name="AvatarBrush"
                                            ImageSource="pack://application:,,,/Barkfluff.Client.WPF;component/Resources/Placeholders/userplaceholder.png"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Border>

                        <!--  Публичное имя (FirstName + LastName)  -->
                        <TextBlock
                            x:Name="PublicNameTextBlock"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Имя пользователя"
                            TextAlignment="Center" />

                        <!--  Username  -->
                        <TextBlock
                            x:Name="UsernameTextBlock"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            Foreground="#80FFFFFF"
                            Text="@username" />

                        <!--  Статус онлайн  -->
                        <Border
                            Padding="12,6"
                            HorizontalAlignment="Center"
                            Background="#20FFFFFF"
                            CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    x:Name="OnlineStatusIndicator"
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,8,0"
                                    Fill="#4CAF50" />
                                <TextBlock
                                    x:Name="LastSeenTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#B0FFFFFF"
                                    Text="В сети" />
                            </StackPanel>
                        </Border>

                        <!--  Баджи  -->
                        <StackPanel
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                x:Name="Badge1"
                                Style="{StaticResource ProfileBadgeStyle}"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="Gold"
                                    Symbol="Crown24" />
                            </Border>
                            <Border
                                x:Name="Badge2"
                                Style="{StaticResource ProfileBadgeStyle}"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="LightBlue"
                                    Symbol="Shield24" />
                            </Border>
                            <Border
                                x:Name="Badge3"
                                Style="{StaticResource ProfileBadgeStyle}"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="Orange"
                                    Symbol="Star24" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Информационные карточки  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="20,20,20,0">

                    <!--  Описание пользователя  -->
                    <Border
                        x:Name="DescriptionCard"
                        Style="{StaticResource FluentInfoCardStyle}"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top"
                                FontSize="18"
                                Foreground="#80FFFFFF"
                                Symbol="TextDescription24" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#60FFFFFF"
                                    Text="О себе" />
                                <TextBlock
                                    x:Name="DescriptionTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#E0FFFFFF"
                                    Text=""
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  User ID  -->
                    <Border Style="{StaticResource FluentInfoCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                FontSize="18"
                                Foreground="#80FFFFFF"
                                Symbol="Person24" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#60FFFFFF"
                                    Text="ID пользователя" />
                                <TextBlock
                                    x:Name="UserIdTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#E0FFFFFF"
                                    Text="" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Email (только для своего профиля)  -->
                    <Border
                        x:Name="EmailCard"
                        Style="{StaticResource FluentInfoCardStyle}"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                FontSize="18"
                                Foreground="#80FFFFFF"
                                Symbol="Mail24" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#60FFFFFF"
                                    Text="Email" />
                                <TextBlock
                                    x:Name="EmailTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#E0FFFFFF"
                                    Text="" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Дата регистрации  -->
                    <Border
                        x:Name="RegistrationCard"
                        Style="{StaticResource FluentInfoCardStyle}"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                FontSize="18"
                                Foreground="#80FFFFFF"
                                Symbol="Calendar24" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#60FFFFFF"
                                    Text="Дата регистрации" />
                                <TextBlock
                                    x:Name="RegistrationDateTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#E0FFFFFF"
                                    Text="" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>