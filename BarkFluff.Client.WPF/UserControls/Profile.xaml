<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.Profile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Стиль для баджей  -->
        <Style x:Key="ProfileBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <!--  Стиль для разделителя  -->
        <Style x:Key="InfoDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <!--  Стиль для кнопки вкладки  -->
        <Style x:Key="AttachmentTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  Триггер: выбранная вкладка  -->
                            <Trigger Property="IsChecked" Value="True">
                                <!--  ВАЖНО: Используем ключ из библиотеки Wpf.Ui  -->
                                <!--  Он автоматически подтянет цвет из настроек Windows 11  -->
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />

                                <!--  Если SystemAccentColorPrimaryBrush не сработает (зависит от версии библиотеки), попробуйте:  -->
                                <!--  Value="{DynamicResource SystemAccentBrush}"  -->

                                <Setter Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  Остальной код без изменений, так как фоны #1A1A2E и #252540 являются частью темной темы приложения,  -->
    <!--  а не системными акцентами. Если нужно изменить и их на системные, они станут прозрачными/светлыми, что может сломать дизайн.  -->

    <Border Background="#1f1f1f" CornerRadius="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Верхняя секция с аватаром и основной информацией  -->
                <Border
                    Grid.Row="0"
                    Padding="24,32,24,24"
                    CornerRadius="12,12,0,0">

                    <StackPanel HorizontalAlignment="Center">
                        <!--  Аватар с тенью  -->
                        <local:CachedAvatar
                            x:Name="AvatarCachedImage"
                            Width="110"
                            Height="110"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            CornerRadius="55"
                            EnableDynamicShadow="False"
                            ShadowBlurRadius="25"
                            ShadowOpacity="0.5" />

                        <!--  Публичное имя  -->
                        <TextBlock
                            x:Name="PublicNameTextBlock"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Имя пользователя"
                            TextAlignment="Center" />

                        <!--  Онлайн статус  -->
                        <StackPanel
                            x:Name="OnlineStatusSection"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Visible">
                            <Ellipse
                                x:Name="OnlineIndicator"
                                Width="8"
                                Height="8"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="#44D62C"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="OnlineStatusText"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                Foreground="#80FFFFFF"
                                Text="Был(а) недавно" />
                        </StackPanel>

                        <!--  Баджи  -->
                        <StackPanel
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                x:Name="Badge1"
                                Style="{StaticResource ProfileBadgeStyle}"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="Gold"
                                    Symbol="Crown24" />
                            </Border>
                            <Border
                                x:Name="Badge2"
                                Style="{StaticResource ProfileBadgeStyle}"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="LightBlue"
                                    Symbol="Shield24" />
                            </Border>
                            <Border
                                x:Name="Badge3"
                                Style="{StaticResource ProfileBadgeStyle}"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="Orange"
                                    Symbol="Star24" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Блок информации  -->
                <Border
                    Grid.Row="1"
                    Margin="20,16,20,0"
                    Padding="16"
                    Background="#20FFFFFF"
                    BorderBrush="#15FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <!--  Описание  -->
                        <StackPanel x:Name="DescriptionSection" Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Top"
                                    FontSize="18"
                                    Foreground="#80FFFFFF"
                                    Symbol="TextDescription24" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="12"
                                        Foreground="#60FFFFFF"
                                        Text="О себе" />
                                    <TextBlock
                                        x:Name="DescriptionTextBlock"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="#E0FFFFFF"
                                        Text=""
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="DescriptionDivider" Style="{StaticResource InfoDividerStyle}" />
                        </StackPanel>

                        <!--  Username  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                FontSize="18"
                                Foreground="#80FFFFFF"
                                Symbol="NumberSymbolSquare20"
                                ToolTip="Заменить потом тут иконку" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#60FFFFFF"
                                    Text="Имя пользователя" />
                                <TextBlock
                                    x:Name="UsernameInfoTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#E0FFFFFF"
                                    Text="" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource InfoDividerStyle}" />

                        <!--  User ID  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                FontSize="18"
                                Foreground="#80FFFFFF"
                                Symbol="NumberSymbolSquare20"
                                ToolTip="Заменить потом тут иконку" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="12"
                                    Foreground="#60FFFFFF"
                                    Text="ID пользователя" />
                                <TextBlock
                                    x:Name="UserIdTextBlock"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    Foreground="#E0FFFFFF"
                                    Text="" />
                            </StackPanel>
                        </Grid>

                        <!--  Email  -->
                        <StackPanel x:Name="EmailSection" Visibility="Visible">
                            <Border Style="{StaticResource InfoDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,0,14,0"
                                    FontSize="18"
                                    Foreground="#80FFFFFF"
                                    Symbol="Mail24" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="12"
                                        Foreground="#60FFFFFF"
                                        Text="Email" />
                                    <TextBlock
                                        x:Name="EmailTextBlock"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="#E0FFFFFF"
                                        Text="" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!--  Дата регистрации  -->
                        <StackPanel x:Name="RegistrationSection">
                            <Border Style="{StaticResource InfoDividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,0,15,0"
                                    FontSize="18"
                                    Foreground="#80FFFFFF"
                                    Symbol="CalendarLtr28" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="12"
                                        Foreground="#60FFFFFF"
                                        Text="Дата регистрации" />
                                    <TextBlock
                                        x:Name="RegistrationDateTextBlock"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="14"
                                        Foreground="#E0FFFFFF"
                                        Text="" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Вкладки вложений  -->
                <Border
                    Grid.Row="2"
                    Margin="20,16,20,0"
                    Background="#20FFFFFF"
                    BorderBrush="#15FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Табы  -->
                        <Border
                            Grid.Row="0"
                            BorderBrush="#15FFFFFF"
                            BorderThickness="0,0,0,1">
                            <StackPanel
                                x:Name="AttachmentTabs"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <RadioButton
                                    x:Name="ImagesTab"
                                    Checked="OnAttachmentTabChecked"
                                    GroupName="AttachmentTabs"
                                    IsChecked="True"
                                    Style="{StaticResource AttachmentTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,6,0"
                                            FontSize="16"
                                            Symbol="Image24" />
                                        <TextBlock
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="13"
                                            Text="Фото" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="VideosTab"
                                    Checked="OnAttachmentTabChecked"
                                    GroupName="AttachmentTabs"
                                    Style="{StaticResource AttachmentTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,6,0"
                                            FontSize="16"
                                            Symbol="Video24" />
                                        <TextBlock
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="13"
                                            Text="Видео" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="FilesTab"
                                    Checked="OnAttachmentTabChecked"
                                    GroupName="AttachmentTabs"
                                    Style="{StaticResource AttachmentTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,6,0"
                                            FontSize="16"
                                            Symbol="Document24" />
                                        <TextBlock
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="13"
                                            Text="Файлы" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="VoiceTab"
                                    Checked="OnAttachmentTabChecked"
                                    GroupName="AttachmentTabs"
                                    Style="{StaticResource AttachmentTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,6,0"
                                            FontSize="16"
                                            Symbol="Mic24" />
                                        <TextBlock
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="13"
                                            Text="Голос" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!--  Контент вкладок  -->
                        <Grid
                            x:Name="AttachmentContent"
                            Grid.Row="1"
                            MinHeight="150">
                            <!--  Images  -->
                            <StackPanel
                                x:Name="ImagesContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Visible">
                                <ui:SymbolIcon
                                    Margin="0,0,0,12"
                                    FontSize="40"
                                    Foreground="#40FFFFFF"
                                    Symbol="Image24" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="13"
                                    Foreground="#60FFFFFF"
                                    Text="Нет изображений" />
                            </StackPanel>

                            <!--  Videos  -->
                            <StackPanel
                                x:Name="VideosContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    Margin="0,0,0,12"
                                    FontSize="40"
                                    Foreground="#40FFFFFF"
                                    Symbol="Video24" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="13"
                                    Foreground="#60FFFFFF"
                                    Text="Нет видео" />
                            </StackPanel>

                            <!--  Files  -->
                            <StackPanel
                                x:Name="FilesContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    Margin="0,0,0,12"
                                    FontSize="40"
                                    Foreground="#40FFFFFF"
                                    Symbol="Document24" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="13"
                                    Foreground="#60FFFFFF"
                                    Text="Нет файлов" />
                            </StackPanel>

                            <!--  Voice  -->
                            <StackPanel
                                x:Name="VoiceContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    Margin="0,0,0,12"
                                    FontSize="40"
                                    Foreground="#40FFFFFF"
                                    Symbol="Mic24" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="13"
                                    Foreground="#60FFFFFF"
                                    Text="Нет голосовых сообщений" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>