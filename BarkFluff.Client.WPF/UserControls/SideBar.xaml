<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.SideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Grid>
        <Border Background="#1e1e1e" CornerRadius="0 15 15 0" />
        <StackPanel Orientation="Vertical">
            <Grid>
                <Border
                    Width="Auto"
                    Height="150"
                    Margin="0,5,5,5"
                    Background="#FF313131"
                    CornerRadius="5 10 10 0" />
                <Border
                    Width="75"
                    Height="75"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="AliceBlue"
                    CornerRadius="64" />
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
