<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ServerItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ServerButton" TargetType="Button">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#484848" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button
            Click="PublicServer_Click"
            Style="{StaticResource ServerButton}"
            Tag="tailrunners.dogpack.io:9090">
            <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                <TextBlock
                    x:Name="ServerTitle"
                    FontWeight="Medium"
                    Text="Tail Runners" />
                <TextBlock
                    x:Name="ServerDescription"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="#9E9E9E"
                    Text="Tail Runners" />
                <TextBlock
                    x:Name="ServerInfo"
                    FontSize="10"
                    Foreground="#9E9E9E"
                    Text="tailrunners.dogpack.io:9090 • 765 пользователей" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
