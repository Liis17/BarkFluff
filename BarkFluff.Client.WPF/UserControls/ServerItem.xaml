<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ServerItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="100"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ServerButton" TargetType="Button">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#484848" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button
            Click="PublicServer_Click"
            Style="{StaticResource ServerButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Цветовой индикатор сервера  -->
                <Border
                    x:Name="ServerColorIndicator"
                    Grid.Column="0"
                    Width="4"
                    Margin="0,0,12,0"
                    Background="#df5000"
                    CornerRadius="2" />

                <!--  Информация о сервере  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    
                    <!--  Название сервера  -->
                    <TextBlock
                        x:Name="ServerTitle"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Название сервера" />
                    
                    <!--  Публичное имя @servername  -->
                    <TextBlock
                        x:Name="ServerPublicName"
                        Margin="0,2,0,0"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        Foreground="#FFF39E6D"
                        Text="@servername" />
                    
                    <!--  Описание  -->
                    <TextBlock
                        x:Name="ServerDescription"
                        Margin="0,4,0,0"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="12"
                        Foreground="#9E9E9E"
                        Text="Описание сервера"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <!--  Количество пользователей  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,4,0"
                        FontSize="14"
                        Foreground="#9E9E9E"
                        Symbol="People20" />
                    <TextBlock
                        x:Name="ServerUserCount"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="12"
                        Foreground="#9E9E9E"
                        Text="0" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
