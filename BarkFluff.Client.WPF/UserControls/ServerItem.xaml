<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ServerItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="100"
    d:DesignWidth="400"
    Cursor="Hand"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ServerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BorderBlock}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleText}" />
            <Setter Property="FontFamily" Value="AdwaitaSans" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBlockBrush}" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonMouseOverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
            BlurRadius="40"
            Direction="270"
            Opacity="0.25"
            ShadowDepth="8"
            Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button Click="PublicServer_Click" Style="{StaticResource ServerButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Цветовой индикатор сервера  -->
                <Border
                    x:Name="ServerColorIndicator"
                    Grid.Column="0"
                    Width="4"
                    Margin="0,0,12,0"
                    Background="#ffffff"
                    CornerRadius="2" />

                <!--  Информация о сервере  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <!--  Название сервера  -->
                    <TextBlock
                        x:Name="ServerTitle"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource LittleTitleTextStyle}"
                        Text="Название сервера" />

                    <!--  Описание  -->
                    <TextBlock
                        x:Name="ServerDescription"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Описание сервера"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Локация и публичное имя  -->
                    <TextBlock
                        x:Name="ServerLocationAndPublicName"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Локация и публичное имя"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
