<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.SearchElement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Margin="0,6,0,2"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    d:DesignHeight="120"
    d:DesignWidth="280"
    Cursor="Hand"
    MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
    mc:Ignorable="d">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#242424" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <!--  Основной контейнер с фоном и эффектами  -->
    <Border
        Padding="16,8,16,8"
        Background="Transparent"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="8"
                Direction="270"
                Opacity="0.1"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Контейнер для аватара  -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <local:CachedAvatar
                    x:Name="AvatarCached"
                    Width="48"
                    Height="48"
                    CornerRadius="24"
                    EnableDynamicShadow="False"
                    ShadowBlurRadius="6"
                    ShadowOpacity="0.15" />

                <!--  Тонкая рамка вокруг аватара  -->
                <Border
                    Width="48"
                    Height="48"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="24"
                    IsHitTestVisible="False" />
            </Grid>

            <!--  Контейнер для текстовой информации  -->
            <StackPanel
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    x:Name="PublicName"
                    FontFamily="Segoe UI"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#ffffff"
                    Text="PublicName"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="4"
                            Direction="270"
                            Opacity="0.3"
                            ShadowDepth="1"
                            Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock
                    x:Name="UserName"
                    Margin="0,4,0,0"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    FontWeight="Normal"
                    Foreground="#9ca3af"
                    Text="@Username"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>