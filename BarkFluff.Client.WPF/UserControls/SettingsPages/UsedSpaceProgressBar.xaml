<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.UsedSpaceProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingsControls="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    Height="60"
    Margin="5"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border Background="#FF2B2B2B" CornerRadius="10">
        <StackPanel Margin="10" Orientation="Vertical">
            <local:ProgressUserControl Value="50" MaxValue="100" IsCyclic="False" ProgressBrush="Red" EmptyBrush="red"/>
        </StackPanel>
    </Border>
</UserControl>
