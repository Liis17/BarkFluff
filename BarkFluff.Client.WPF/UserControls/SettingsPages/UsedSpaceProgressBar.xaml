<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.UsedSpaceProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingsControls="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Height="120"
    Margin="5"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Padding="5,0,5,0"
        Background="#1f1f1f"
        CornerRadius="10"
        Style="{DynamicResource Win11CardStyle}">
        <StackPanel Margin="10" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Использованно места в облаке " />
                <TextBlock
                    x:Name="UsedSpaceText"
                    Style="{DynamicResource FieldLabelStyle}"
                    Text="N" />
                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text=" из " />
                <TextBlock
                    x:Name="LimitSpaceText"
                    Style="{DynamicResource FieldLabelStyle}"
                    Text="N" />
            </StackPanel>

            <local:ProgressUserControl
                x:Name="UsedSpaceProgress"
                Margin="5"
                EmptyBrush="#8078422e"
                IsCyclic="False"
                MaxValue="100"
                ProgressBrush="#FFCE8F69"
                Value="0" />
            <local:MultiSegmentProgressUserControl x:Name="UsedTypeSpace" Margin="2" />
            <StackPanel Orientation="Horizontal">
                <Border
                    x:Name="UnknownBorder"
                    Height="25"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Style="{DynamicResource Win11CardStyle}">
                    <Grid>
                        <Border
                            x:Name="UnknownColor"
                            Width="10"
                            Height="10"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FFE20101"
                            CornerRadius="2" />
                        <TextBlock
                            x:Name="UnknownText"
                            Margin="20,0,5,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource InfoTextStyle}"
                            Text="Неизвестно" />
                    </Grid>
                </Border>
                <Border
                    x:Name="ImageBorder"
                    Height="25"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Style="{DynamicResource Win11CardStyle}">
                    <Grid>
                        <Border
                            x:Name="ImageColor"
                            Width="10"
                            Height="10"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FF57BB62"
                            CornerRadius="2" />
                        <TextBlock
                            x:Name="ImageText"
                            Margin="20,0,5,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource InfoTextStyle}"
                            Text="Картинки" />
                    </Grid>
                </Border>
                <Border
                    x:Name="VideoBorder"
                    Height="25"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Style="{DynamicResource Win11CardStyle}">
                    <Grid>
                        <Border
                            x:Name="VideoColor"
                            Width="10"
                            Height="10"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FF3D50B7"
                            CornerRadius="2" />
                        <TextBlock
                            x:Name="VideoText"
                            Margin="20,0,5,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource InfoTextStyle}"
                            Text="Видео" />
                    </Grid>
                </Border>
                <Border
                    x:Name="DocumentBorder"
                    Height="25"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Style="{DynamicResource Win11CardStyle}">
                    <Grid>
                        <Border
                            x:Name="DocumentColor"
                            Width="10"
                            Height="10"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FFCA6D34"
                            CornerRadius="2" />
                        <TextBlock
                            x:Name="DocumentText"
                            Margin="20,0,5,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource InfoTextStyle}"
                            Text="Документы" />
                    </Grid>
                </Border>
                <Border
                    x:Name="VoiceBorder"
                    Height="25"
                    Margin="5"
                    Padding="0"
                    HorizontalAlignment="Left"
                    CornerRadius="8"
                    Style="{DynamicResource Win11CardStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Border
                            x:Name="VoiceColor"
                            Width="10"
                            Height="10"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FF5BA1CE"
                            CornerRadius="2" />
                        <TextBlock
                            x:Name="VoiceText"
                            Margin="20,0,5,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource InfoTextStyle}"
                            Text="Голосовые" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
