<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.SettingsMenuBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Height="70"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <ui:SymbolIcon
                Foreground="{Binding IconColor, ElementName=Root}"
                Style="{StaticResource SettingsSymbolIcon}"
                Symbol="{Binding IconSymbol, ElementName=Root}" />
            <TextBlock 
                Style="{StaticResource SettingsMenuBlockText}" 
                Text="{Binding Text, ElementName=Root}" />
        </StackPanel>
    </Grid>

</UserControl>
