<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.LanguageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Height="550"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="#1f1f1f">
        <StackPanel Margin="20">
            <!-- Кнопка "Назад" -->
            <Button
                HorizontalAlignment="Left"
                Click="GoBack_Click"
                Cursor="Hand"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        Foreground="#E0E0E0"
                        Symbol="ArrowLeft24" />
                    <TextBlock Foreground="#E0E0E0" Text="Назад" />
                </StackPanel>
            </Button>

            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="Язык" />

            <!-- Настройки языка -->
            <StackPanel Margin="0,10,0,0">
                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Язык интерфейса" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Русский" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF8E469A"
                            Symbol="Globe24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Регион" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Россия" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF8E469A"
                            Symbol="Location24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Формат времени" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="24-часовой формат" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF8E469A"
                            Symbol="Clock24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Формат даты" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="ДД.ММ.ГГГГ" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF8E469A"
                            Symbol="Calendar24" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
