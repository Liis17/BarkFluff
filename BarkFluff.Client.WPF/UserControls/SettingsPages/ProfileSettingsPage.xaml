<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.ProfileSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Height="550"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="#1f1f1f">
        <StackPanel Margin="20">
            <!-- Кнопка "Назад" -->
            <ui:Button
                HorizontalAlignment="Left"
                Click="GoBack_Click"
                Cursor="Hand"
                Style="{DynamicResource Win11Default}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        Foreground="#E0E0E0"
                        Symbol="ArrowLeft24" />
                    <TextBlock Foreground="#E0E0E0" Text="Назад" />
                </StackPanel>
            </ui:Button>

            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="Профиль" />

            <!-- Настройки профиля -->
            <StackPanel Margin="0,10,0,0">
                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Имя" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Изменить отображаемое имя" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FFDA5151"
                            Symbol="Person24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Статус" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Установить статус профиля" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FFDA5151"
                            Symbol="Emoji24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Описание" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Добавить описание профиля" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FFDA5151"
                            Symbol="Textbox24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Аватар" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Изменить фото профиля" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FFDA5151"
                            Symbol="Image24" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
