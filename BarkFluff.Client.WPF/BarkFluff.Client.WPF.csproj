<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWinRT>true</UseWinRT>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
    <ApplicationIcon>Resources\Icons\barkfluff_logo.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <StartupObject>BarkFluff.Client.WPF.App</StartupObject>
    
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Fonts\AdwaitaSans-Regular.ttf" />
    <None Remove="Resources\Images\barkfluff_logo.png" />
    <None Remove="Resources\Placeholders\Placeholder_1.jpg" />
    <None Remove="Resources\Placeholders\Placeholder_2.jpg" />
    <None Remove="Resources\Placeholders\Placeholder_3.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fonts\AdwaitaSans-Regular.ttf" />
    <Content Include="Resources\Icons\barkfluff_logo.ico" />
    <Resource Include="Resources\Images\barkfluff_logo.png" />
    <Resource Include="Resources\Placeholders\Placeholder_1.jpg" />
    <Resource Include="Resources\Placeholders\Placeholder_2.jpg" />
    <Resource Include="Resources\Placeholders\Placeholder_3.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.7" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <PackageReference Include="Microsoft.WindowsAPICodePack.Shell" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientComponents\BarkFluff.WebApi.Core\BarkFluff.WebApi.Core.csproj" />
    <ProjectReference Include="..\BarkFluff.Shared.Exceptions\BarkFluff.Shared.Exceptions.csproj" />
    <ProjectReference Include="..\Shared\BarkFluff.Shared.SecurityUtilities\BarkFluff.Shared.SecurityUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\SetupPages\Login.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Classes\" />
  </ItemGroup>

</Project>
