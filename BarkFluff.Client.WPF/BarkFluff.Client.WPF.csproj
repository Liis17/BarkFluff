<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWinRT>true</UseWinRT>
    <NuGetAuditLevel>critical</NuGetAuditLevel>
    <ApplicationIcon>Resources\Icons\barkfluff.icon.black.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <StartupObject>BarkFluff.Client.WPF.App</StartupObject>
    
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <AssemblyName>BarkFluff</AssemblyName>
    <ErrorReport>false</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Classes\**" />
    <EmbeddedResource Remove="Classes\**" />
    <None Remove="Classes\**" />
    <Page Remove="Classes\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Fonts\AdwaitaSans-Regular.ttf" />
    <None Remove="Fonts\Neucha-Regular.ttf" />
    <None Remove="Fonts\NotoSansDisplay-VariableFont_wdth,wght.ttf" />
    <None Remove="Fonts\OpenSans-Italic-VariableFont_wdth,wght.ttf" />
    <None Remove="Fonts\OpenSans-VariableFont_wdth,wght.ttf" />
    <None Remove="Resources\Images\barkfluff_logo.png" />
    <None Remove="Resources\Placeholders\audio.png" />
    <None Remove="Resources\Placeholders\document.png" />
    <None Remove="Resources\Placeholders\gif.png" />
    <None Remove="Resources\Placeholders\image.png" />
    <None Remove="Resources\Placeholders\userplaceholder.png" />
    <None Remove="Resources\Placeholders\video.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fonts\AdwaitaSans-Regular.ttf" />
    <Content Include="Fonts\Neucha-Regular.ttf" />
    <Content Include="Fonts\NotoSansDisplay-VariableFont_wdth,wght.ttf" />
    <Content Include="Fonts\OpenSans-Italic-VariableFont_wdth,wght.ttf" />
    <Content Include="Fonts\OpenSans-VariableFont_wdth,wght.ttf" />
    <Content Include="Resources\Icons\barkfluff.icon.black.ico" />
    <Resource Include="Resources\Images\barkfluff_logo.png" />
    <Resource Include="Resources\Images\barkfluff_logo_old.png" />
    <Resource Include="Resources\Placeholders\audio.png" />
    <Resource Include="Resources\Placeholders\document.png" />
    <Resource Include="Resources\Placeholders\gif.png" />
    <Resource Include="Resources\Placeholders\image.png" />
    <Resource Include="Resources\Placeholders\savedplaceholder.png" />
    <Resource Include="Resources\Placeholders\userplaceholder.png" />
    <Resource Include="Resources\Placeholders\video.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.1.0" />
    <PackageReference Include="Microsoft.WindowsAPICodePack.Shell" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientComponents\BarkFluff.WebApi.Core\BarkFluff.WebApi.Core.csproj" />
    <ProjectReference Include="..\BarkFluff.Shared.Exceptions\BarkFluff.Shared.Exceptions.csproj" />
    <ProjectReference Include="..\Shared\BarkFluff.Shared.SecurityUtilities\BarkFluff.Shared.SecurityUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\SetupPages\Login.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
