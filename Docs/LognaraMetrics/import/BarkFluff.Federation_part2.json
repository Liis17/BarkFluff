{"format":"lognara-metrics","version":1,"metrics":[{"name":"manual_peer_refresh.skipped","title":"Пропущенных обновлений ручных пиров","description":"Недоступен well-known, приватный или нет цепочки доверия.","unit":"серверов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"manual_peer_refresh.skipped\": ","pattern":"\\(\"manual_peer_refresh\\.skipped\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"wellknown_signature_failures","title":"Ошибок подписи well-known","description":"","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"wellknown_signature_failures\": ","pattern":"\\(\"wellknown_signature_failures\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"s2s_requests_out","title":"Исходящих S2S-вызовов","description":"XFedClientInterceptor.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"s2s_requests_out\": ","pattern":"\\(\"s2s_requests_out\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"service_started_unix","title":"Время старта сервиса","description":"Датчик, фиксируется один раз при старте процесса; перезапуски видны по скачкам.","unit":"unix-с","kind":"gauge","aggregation":"last","enabled":true,"rule":{"contains":"(\"service_started_unix\": ","pattern":"\\(\"service_started_unix\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_total","title":"Обработанных gRPC-вызовов","description":"Входящий unary-вызов до обработки, общий интерсептор ServerExceptionInterceptor.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_total\": ","pattern":"\\(\"grpc_requests_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_request_duration_ms_total","title":"Суммарная длительность gRPC-вызовов","description":"Время обработки вызовов (в т.ч. ошибочных), мс.","unit":"мс","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_request_duration_ms_total\": ","pattern":"\\(\"grpc_request_duration_ms_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_failed","title":"Неудачных gRPC-вызовов (бизнес-ошибка)","description":"BaseGrpcException - осмысленный доменный отказ.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_failed\": ","pattern":"\\(\"grpc_requests_failed\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_errors","title":"Ошибок gRPC-вызовов (неожиданная ошибка)","description":"Иное исключение (сбойный баг/инфраструктура).","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_errors\": ","pattern":"\\(\"grpc_requests_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}}]}
