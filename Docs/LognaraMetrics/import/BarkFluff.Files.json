{"format":"lognara-metrics","version":1,"metrics":[{"name":"fed_download_total","title":"Итоги федеративных скачиваний файлов","description":"Итоги: ok, aborted, origin_unavailable, denied.","unit":"","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_download_total.","pattern":"\\(\"fed_download_total\\.(?P<result>ok|aborted|origin_unavailable|denied)\"?: (?P<value>-?\\d+)\\)","value_group":"value","label_groups":["result"]}},{"name":"fed_download_size_exceeded","title":"Превышений лимита размера федеративного файла","description":"","unit":"файлов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_download_size_exceeded\": ","pattern":"\\(\"fed_download_size_exceeded\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fed_downloads","title":"Федеративных скачиваний успешно","description":"","unit":"файлов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_downloads\": ","pattern":"\\(\"fed_downloads\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fed_download_bytes_total","title":"Получено байт федеративных файлов","description":"","unit":"байт","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_download_bytes_total\": ","pattern":"\\(\"fed_download_bytes_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fed_avatar_rejected","title":"Отклонённых seeking актив","description":"Актив федер-аватар не проходит проверку доверия/гигиены.","unit":"файлов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_avatar_rejected\": ","pattern":"\\(\"fed_avatar_rejected\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fed_avatars_served","title":"Отданных федеративных аватаров","description":"","unit":"файлов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_avatars_served\": ","pattern":"\\(\"fed_avatars_served\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fed_avatar_errors","title":"Ошибок федеративных аватаров","description":"","unit":"ошибок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fed_avatar_errors\": ","pattern":"\\(\"fed_avatar_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_download_errors","title":"Ошибок скачивания файлов","description":"","unit":"ошибок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"files_download_errors\": ","pattern":"\\(\"files_download_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_downloaded","title":"Скачанных файлов","description":"HTTP контроллер отдал файл.","unit":"файлов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"files_downloaded\": ","pattern":"\\(\"files_downloaded\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"download_bytes_total","title":"Отданных байт файлов","description":"","unit":"байт","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"download_bytes_total\": ","pattern":"\\(\"download_bytes_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"file_traffic_bytes_total","title":"Суммарный трафик файлов","description":"Все отданные/принятые файловые байты.","unit":"байт","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"file_traffic_bytes_total\": ","pattern":"\\(\"file_traffic_bytes_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_uploaded","title":"Загруженных файлов","description":"Успешные загрузки.","unit":"файлов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"files_uploaded\": ","pattern":"\\(\"files_uploaded\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"upload_bytes_total","title":"Принято байт загрузок","description":"","unit":"байт","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"upload_bytes_total\": ","pattern":"\\(\"upload_bytes_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_upload_errors","title":"Ошибок загрузки файлов","description":"","unit":"ошибок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"files_upload_errors\": ","pattern":"\\(\"files_upload_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_last_upload_total_ms","title":"Длительность последней загрузки","description":"Датчик: прошедшая загрузка полностью, мс (avg на дашборде).","unit":"мс","kind":"gauge","aggregation":"avg","enabled":true,"rule":{"contains":"(\"files_last_upload_total_ms\": ","pattern":"\\(\"files_last_upload_total_ms\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_last_upload_buffering_ms","title":"Буферизация последней загрузки","description":"Сегмент буферизации потока, мс.","unit":"мс","kind":"gauge","aggregation":"avg","enabled":true,"rule":{"contains":"(\"files_last_upload_buffering_ms\": ","pattern":"\\(\"files_last_upload_buffering_ms\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_last_upload_hashing_ms","title":"Хеширование последней загрузки","description":"Сегмент вычисления хеша, мс.","unit":"мс","kind":"gauge","aggregation":"avg","enabled":true,"rule":{"contains":"(\"files_last_upload_hashing_ms\": ","pattern":"\\(\"files_last_upload_hashing_ms\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_last_upload_processing_ms","title":"Обработка последней загрузки","description":"Сегмент обработки/изображения, мс.","unit":"мс","kind":"gauge","aggregation":"avg","enabled":true,"rule":{"contains":"(\"files_last_upload_processing_ms\": ","pattern":"\\(\"files_last_upload_processing_ms\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"files_last_upload_s3_ms","title":"Запись в S3 последней загрузки","description":"Сегмент upload в S3, мс.","unit":"мс","kind":"gauge","aggregation":"avg","enabled":true,"rule":{"contains":"(\"files_last_upload_s3_ms\": ","pattern":"\\(\"files_last_upload_s3_ms\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_total","title":"Обработанных gRPC-вызовов","description":"Входящий unary-вызов до обработки, общий интерсептор ServerExceptionInterceptor.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_total\": ","pattern":"\\(\"grpc_requests_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_request_duration_ms_total","title":"Суммарная длительность gRPC-вызовов","description":"Время обработки вызовов (в т.ч. ошибочных), мс.","unit":"мс","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_request_duration_ms_total\": ","pattern":"\\(\"grpc_request_duration_ms_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_failed","title":"Неудачных gRPC-вызовов (бизнес-ошибка)","description":"BaseGrpcException - осмысленный доменный отказ.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_failed\": ","pattern":"\\(\"grpc_requests_failed\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_errors","title":"Ошибок gRPC-вызовов (неожиданная ошибка)","description":"Иное исключение (сбойный баг/инфраструктура).","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_errors\": ","pattern":"\\(\"grpc_requests_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}}]}
