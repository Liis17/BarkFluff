{"format":"lognara-metrics","version":1,"metrics":[{"name":"navigator_registrations","title":"Успешных регистраций на Navigator","description":"Фоновый ServerRegistrationService зарегистрировал Beacon на Navigator.","unit":"регистраций","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"navigator_registrations\": ","pattern":"\\(\"navigator_registrations\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"navigator_registration_duration_ms_total","title":"Суммарная длительность регистраций на Navigator","description":"Суммарное время вызова регистрации, мс.","unit":"мс","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"navigator_registration_duration_ms_total\": ","pattern":"\\(\"navigator_registration_duration_ms_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"last_navigator_registration_unix","title":"Последняя успешная регистрация на Navigator","description":"Unix-время успешной регистрации.","unit":"unix-с","kind":"gauge","aggregation":"last","enabled":true,"rule":{"contains":"(\"last_navigator_registration_unix\": ","pattern":"\\(\"last_navigator_registration_unix\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"navigator_registration_healthy","title":"Исправность регистрации на Navigator","description":"1 - последняя регистрация успешна, 0 - сбой; ставится также в 0 на старте.","unit":"","kind":"gauge","aggregation":"last","enabled":true,"rule":{"contains":"(\"navigator_registration_healthy\": ","pattern":"\\(\"navigator_registration_healthy\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"navigator_registration_errors","title":"Ошибок регистрации на Navigator","description":"Ошибка фонового цикла регистрации.","unit":"ошибок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"navigator_registration_errors\": ","pattern":"\\(\"navigator_registration_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"configuration_fetch_success","title":"Успешных загрузок конфигураций (по 10 на запрос)","description":"Batch из 10 GetConfigurationAsync на другие сервисы: +10 при полном успехе, +10-failed иначе (failed - число неудачных задач).","unit":"загрузок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"configuration_fetch_success\": ","pattern":"\\(\"configuration_fetch_success\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"configuration_fetch_errors","title":"Ошибок загрузки конфигураций","description":"Число неудачных параллельных загрузок конфигураций (0..10 за запрос).","unit":"загрузок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"configuration_fetch_errors\": ","pattern":"\\(\"configuration_fetch_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"server_info_requests","title":"Запросов GetServerInfo","description":"Входящие gRPC запросы server info.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"server_info_requests\": ","pattern":"\\(\"server_info_requests\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"server_info_success","title":"Успешных GetServerInfo","description":"Завершённые без ошибки запросы.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"server_info_success\": ","pattern":"\\(\"server_info_success\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"server_info_duration_ms_total","title":"Суммарная длительность GetServerInfo","description":"Время обработки запросов, мс.","unit":"мс","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"server_info_duration_ms_total\": ","pattern":"\\(\"server_info_duration_ms_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"last_server_info_request_unix","title":"Последний GetServerInfo","description":"Unix-время последнего запроса.","unit":"unix-с","kind":"gauge","aggregation":"last","enabled":true,"rule":{"contains":"(\"last_server_info_request_unix\": ","pattern":"\\(\"last_server_info_request_unix\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"server_info_errors","title":"Ошибок GetServerInfo","description":"Запросы, завершившиеся исключением.","unit":"ошибок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"server_info_errors\": ","pattern":"\\(\"server_info_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"service_started_unix","title":"Время старта сервиса","description":"Датчик, фиксируется один раз при старте процесса; перезапуски видны по скачкам.","unit":"unix-с","kind":"gauge","aggregation":"last","enabled":true,"rule":{"contains":"(\"service_started_unix\": ","pattern":"\\(\"service_started_unix\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_total","title":"Обработанных gRPC-вызовов","description":"Входящий unary-вызов до обработки, общий интерсептор ServerExceptionInterceptor.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_total\": ","pattern":"\\(\"grpc_requests_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_request_duration_ms_total","title":"Суммарная длительность gRPC-вызовов","description":"Время обработки вызовов (в т.ч. ошибочных), мс.","unit":"мс","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_request_duration_ms_total\": ","pattern":"\\(\"grpc_request_duration_ms_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_failed","title":"Неудачных gRPC-вызовов (бизнес-ошибка)","description":"BaseGrpcException - осмысленный доменный отказ.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_failed\": ","pattern":"\\(\"grpc_requests_failed\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_errors","title":"Ошибок gRPC-вызовов (неожиданная ошибка)","description":"Иное исключение (сбойный баг/инфраструктура).","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_errors\": ","pattern":"\\(\"grpc_requests_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}}]}
