{"format":"lognara-metrics","version":1,"metrics":[{"name":"sessions_generated","title":"Сгенерированных fast-auth сессий","description":"Issued QR-code сессии.","unit":"сессий","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"sessions_generated\": ","pattern":"\\(\"sessions_generated\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"sessions_expired","title":"Истёкших fast-auth сессий","description":"TTL-фоновые/при обращениях истечения.","unit":"сессий","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"sessions_expired\": ","pattern":"\\(\"sessions_expired\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"sessions_rejected","title":"Отклонённых fast-auth сессий","description":"","unit":"сессий","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"sessions_rejected\": ","pattern":"\\(\"sessions_rejected\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"sessions_scanned","title":"Сессий, отсканированных устройством","description":"Второе устройство просканировало QR.","unit":"сессий","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"sessions_scanned\": ","pattern":"\\(\"sessions_scanned\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"active_subscriptions","title":"Открытых подписок на результат fast-auth","description":"Increment при SubscribeFastAuthResult (не датчик).","unit":"подписок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"active_subscriptions\": ","pattern":"\\(\"active_subscriptions\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"active_subscriptions_closed","title":"Закрытых подписок на результат fast-auth","description":"/stream закрыт или ответ выдан.","unit":"подписок","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"active_subscriptions_closed\": ","pattern":"\\(\"active_subscriptions_closed\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"sessions_accepted","title":"Подтверждённых fast-auth сессий","description":"Первичное устройство приняло вход.","unit":"сессий","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"sessions_accepted\": ","pattern":"\\(\"sessions_accepted\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_total","title":"Обработанных gRPC-вызовов","description":"Входящий unary-вызов до обработки, общий интерсептор ServerExceptionInterceptor.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_total\": ","pattern":"\\(\"grpc_requests_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_request_duration_ms_total","title":"Суммарная длительность gRPC-вызовов","description":"Время обработки вызовов (в т.ч. ошибочных), мс.","unit":"мс","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_request_duration_ms_total\": ","pattern":"\\(\"grpc_request_duration_ms_total\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_failed","title":"Неудачных gRPC-вызовов (бизнес-ошибка)","description":"BaseGrpcException - осмысленный доменный отказ.","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_failed\": ","pattern":"\\(\"grpc_requests_failed\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"grpc_requests_errors","title":"Ошибок gRPC-вызовов (неожиданная ошибка)","description":"Иное исключение (сбойный баг/инфраструктура).","unit":"запросов","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"grpc_requests_errors\": ","pattern":"\\(\"grpc_requests_errors\": (?P<value>-?\\d+)\\)","value_group":"value"}}]}
