{"format":"lognara-metrics","version":1,"metrics":[{"name":"push_jobs_received","title":"Полученных push-задач","description":"FirebaseService принял задачу на рассылку пушей.","unit":"задач","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"push_jobs_received\": ","pattern":"\\(\"push_jobs_received\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"push_target_devices","title":"Целевых устройств push-задачи","description":"Fcm-токенов в задаче.","unit":"устройств","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"push_target_devices\": ","pattern":"\\(\"push_target_devices\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fcm_pushes_sent","title":"Доставленных FCM-push (успешно)","description":"SuccessCount ответов FCM.","unit":"push","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fcm_pushes_sent\": ","pattern":"\\(\"fcm_pushes_sent\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"fcm_pushes_failed","title":"Неудачных FCM-push","description":"FailureCount (в т.ч. все токены при неисправимой ошибке).","unit":"push","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"fcm_pushes_failed\": ","pattern":"\\(\"fcm_pushes_failed\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"web_pushes_sent","title":"Доставленных web-push","description":"SuccessCount Web Push.","unit":"push","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"web_pushes_sent\": ","pattern":"\\(\"web_pushes_sent\": (?P<value>-?\\d+)\\)","value_group":"value"}},{"name":"web_pushes_failed","title":"Неудачных web-push","description":"FailureCount.","unit":"push","kind":"delta","aggregation":"sum","enabled":true,"rule":{"contains":"(\"web_pushes_failed\": ","pattern":"\\(\"web_pushes_failed\": (?P<value>-?\\d+)\\)","value_group":"value"}}]}
