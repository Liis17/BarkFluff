CLIENTSTORAGE_PORT=7050

S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_SERVICE_URL=http://minio:9000
S3_BUCKET_NAME=client-storage

# Регион для SigV4-подписи. Для Cloudflare R2 = auto. Для MinIO/dev можно не задавать.
S3_REGION=auto
# Размер части multipart-заливки в байтах. Для R2 рекомендуется 100 MB. По умолчанию 16 MB.
REGISTRY_STORAGE_S3_CHUNKSIZE=104857600

UPLOAD_TOKEN=your-upload-token

# Локальный кеш дистрибутивов внутри контейнера.
# Очищается при перезапуске, прогревается автоматически при старте.
CACHE_DIR=/app/cache

# Публичный базовый URL сервиса (используется в ответе /bitsurl для формирования download URL).
# Указывать без слеша на конце. Если не задан — берётся из заголовка Host запроса.
PUBLIC_BASE_URL=https://storage.barkfluff.com
