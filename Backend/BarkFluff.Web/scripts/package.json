{
  "name": "barkfluff-proto-bundle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:app": "node build-app.js",
    "build:shell-version": "node build-shell-version.js",
    "test:chat-background-refresh": "node test-chat-background-refresh.js",
    "test:markdown-preview": "node test-markdown-preview.js",
    "test:network": "node test-network.js",
    "test:refresh-session": "node test-refresh-session.js",
    "test:legal-network": "node test-legal-network.js",
    "test:drafts": "node test-drafts.js",
    "test:files-upload": "node test-files-upload.js",
    "test:pending-sends": "node test-pending-sends.js",
    "test:sticker-picker": "node test-sticker-picker.js",
    "test:chat-list": "node test-chat-list.js",
    "test:context-menu": "node test-context-menu.js",
    "test:feed": "node test-feed.js",
    "test:mark-read": "node test-mark-read.js",
    "test:composer": "node test-composer.js",
    "test:attention": "node test-attention.js",
    "test:deep-link": "node test-deep-link.js",
    "test:search": "node test-search.js",
    "test:chat-media": "node test-chat-media.js",
    "test:chat-calls": "node test-chat-calls.js",
    "format": "prettier --write ../wwwroot/js/app/**/*.js *.js",
    "format:check": "prettier --check --config prettier.config.cjs ../wwwroot/js/app/app-loader.js ../wwwroot/js/app/media-viewer.js ../wwwroot/js/app/group-info.js ../wwwroot/js/app/private-chat-ui.js ../wwwroot/js/app/sticker-picker.js ../wwwroot/js/app/chat-list.js ../wwwroot/js/app/composer.js ../wwwroot/js/app/feed.js ../wwwroot/js/app/message-menu.js ../wwwroot/js/app/mark-read.js ../wwwroot/js/app/attention.js ../wwwroot/js/app/deep-link.js ../wwwroot/js/app/search.js ../wwwroot/js/app/chat-media.js ../wwwroot/js/app/chat-calls.js app-bundle-entry.js build-app.js",
    "lint": "cd .. && scripts/node_modules/.bin/eslint --config scripts/eslint.config.cjs wwwroot/js/app/**/*.js scripts/build-app.js scripts/build-shell-version.js scripts/app-bundle-entry.js"
  },
  "dependencies": {
    "esbuild": "0.24.0",
    "firebase": "12.17.0",
    "google-protobuf": "3.21.2",
    "grpc-web": "1.5.0",
    "livekit-client": "2.19.2"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "globals": "17.10.0",
    "prettier": "3.9.6"
  }
}
