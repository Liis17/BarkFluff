<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\barkfluff.icon.white.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="scripts\generate-proto.ps1" />
    <None Remove="scripts\generate-proto.sh" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="scripts\generate-proto.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts\generate-proto.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.7.4" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarkFluff.GrpcServer\BarkFluff.GrpcServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Общий пакет иконок платформы используется веб-клиентом напрямую из /icons. -->
  <ItemGroup>
    <Content Include="..\..\icons\**\*.svg"
             Link="wwwroot\icons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- wwwroot\legal наполняется таргетом ниже, поэтому убираем каталог из дефолтных
       глоб-шаблонов SDK: иначе на втором сборке файлы попали бы в Content дважды. -->
  <ItemGroup>
    <Content Remove="wwwroot\legal\**" />
  </ItemGroup>

  <!-- Юридические документы живут в одном месте — Barkfluff.WebServer\html\legal.
       Модалка согласия на странице входа читает их с своего origin (web.barkfluff.com),
       поэтому markdown копируется в wwwroot. Зеркало gradle-таска copyLegalDocs у Android.
       AssignTargetPaths — последний момент, когда добавленные Content ещё попадут в вывод. -->
  <Target Name="CopyLegalDocs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <LegalDoc Include="..\Barkfluff.WebServer\html\legal\TERMS_OF_SERVICE.*.md" />
      <LegalDoc Include="..\Barkfluff.WebServer\html\legal\PRIVACY_POLICY.*.md" />
    </ItemGroup>
    <Copy SourceFiles="@(LegalDoc)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\legal"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot\legal\*.md" CopyToOutputDirectory="Always" />
    </ItemGroup>
  </Target>

  <!-- App bundle is fingerprinted and ignored by Git. Keep ordinary dotnet run/publish
       usable from a clean checkout without requiring a separate manual npm command. -->
  <Target Name="RestoreWebTooling"
          BeforeTargets="Build;Publish"
          Condition="'$(DesignTimeBuild)' != 'true' And !Exists('scripts/node_modules/esbuild/package.json')">
    <Exec Command="npm --prefix scripts install --no-package-lock --ignore-scripts" />
  </Target>

  <Target Name="BuildMessengerApp"
          BeforeTargets="Build;Publish"
          DependsOnTargets="RestoreWebTooling"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm --prefix scripts run build:app" />
  </Target>

  <!-- Бампит CACHE_NAME в service-worker.js хешем от файлов APP_SHELL, чтобы
       любое изменение шелл-ассетов автоматически инвалидировало SW-кэш.
       Идемпотентен: при отсутствии изменений файл не переписывается. -->
  <Target Name="BuildShellVersion"
          BeforeTargets="Build;Publish"
          DependsOnTargets="RestoreWebTooling"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm --prefix scripts run build:shell-version" />
  </Target>

</Project>
