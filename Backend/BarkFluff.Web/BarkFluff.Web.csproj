<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\barkfluff.icon.white.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="scripts\generate-proto.ps1" />
    <None Remove="scripts\generate-proto.sh" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="scripts\generate-proto.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts\generate-proto.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.7.4" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarkFluff.GrpcServer\BarkFluff.GrpcServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- wwwroot\legal наполняется таргетом ниже, поэтому убираем каталог из дефолтных
       глоб-шаблонов SDK: иначе на втором сборке файлы попали бы в Content дважды. -->
  <ItemGroup>
    <Content Remove="wwwroot\legal\**" />
  </ItemGroup>

  <!-- Юридические документы живут в одном месте — Barkfluff.WebServer\html\legal.
       Модалка согласия на странице входа читает их с своего origin (web.barkfluff.com),
       поэтому markdown копируется в wwwroot. Зеркало gradle-таска copyLegalDocs у Android.
       AssignTargetPaths — последний момент, когда добавленные Content ещё попадут в вывод. -->
  <Target Name="CopyLegalDocs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <LegalDoc Include="..\Barkfluff.WebServer\html\legal\TERMS_OF_SERVICE.*.md" />
      <LegalDoc Include="..\Barkfluff.WebServer\html\legal\PRIVACY_POLICY.*.md" />
    </ItemGroup>
    <Copy SourceFiles="@(LegalDoc)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\legal"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot\legal\*.md" CopyToOutputDirectory="Always" />
    </ItemGroup>
  </Target>

</Project>
