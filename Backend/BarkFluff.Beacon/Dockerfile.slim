FROM alpine:3.22 AS lognara-agent
ARG TARGETARCH
RUN apk add --no-cache ca-certificates coreutils curl
COPY Docker/Lognara/agent/install-agent.sh /tmp/install-agent.sh
COPY Docker/Lognara/agent/SHA256SUMS /tmp/SHA256SUMS
RUN /bin/sh /tmp/install-agent.sh "$TARGETARCH"
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled
WORKDIR /app
COPY --chown=1654:1654 publish/ .
COPY --from=lognara-agent --chown=1654:1654 --chmod=0755 /usr/local/bin/lognara-agent /usr/local/bin/lognara-agent
COPY --chown=1654:1654 Docker/Lognara/runtime/application-buffer/ /app/logs/
COPY --chown=1654:1654 Docker/Lognara/runtime/agent-spool/ /var/lib/lognara-agent/spool/
USER $APP_UID
ENTRYPOINT ["dotnet", "BarkFluff.Beacon.dll"]
