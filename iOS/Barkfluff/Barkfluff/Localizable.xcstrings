    "settings.cache.clear_confirm.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle lokalen Medienkopien, die lokale Nachrichten- und Chatdatenbank werden entfernt. Nachrichten auf dem Server bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All local media copies, the local messages and chats database will be removed. Messages on the server will not be affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las copias locales de medios y la base de datos local de mensajes y chats. Los mensajes en el servidor no se verán afectados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены все локальные копии медиа, локальная БД сообщений и чатов. Сами сообщения на сервере не пострадают."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除所有本地媒体副本以及本地消息和聊天数据库。服务器上的消息不会受到影响。"
          }
        }
      }
    },
