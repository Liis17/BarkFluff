    "profile.edit.logout_failure.message %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nWenn du das Abmelden erzwingst, bleibt die Sitzung auf dem Server aktiv, bis sie abläuft. Du kannst sie später über «Aktive Sitzungen» beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nIf you force log out, the session on the server will remain active until it expires. You can end it later via \"Active sessions\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSi fuerzas el cierre de sesión, la sesión en el servidor seguirá activa hasta que expire. Puedes finalizarla más tarde en «Sesiones activas»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nЕсли выйти принудительно — сессия на сервере останется активной до истечения срока действия. Завершить её можно позже через «Активные сессии»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n如果强制退出，服务器上的会话将保持活动状态直到过期。您可以稍后通过「活动会话」将其结束。"
          }
        }
      }
    },
    "profile.edit.logout_failure.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abmelden auf dem Server fehlgeschlagen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to log out on the server"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al cerrar sesión en el servidor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось разлогиниться на сервере"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
