{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%lld": {
      "comment": "A badge that shows the number of unread messages in a chat. The argument is the number of unread messages.",
      "isCommentAutoGenerated": true
    },
    "%lld pt": {
      "comment": "A label displaying the current value of the bubble corner radius slider.",
      "isCommentAutoGenerated": true
    },
    "%lld%%": {
      "comment": "A label showing the percentage of the upload progress. The argument is the percentage of the upload.",
      "isCommentAutoGenerated": true
    },
    "%lld/200": {},
    "+%lld": {
      "comment": "A badge icon with a number indicating the number of additional badges that are not shown.",
      "isCommentAutoGenerated": true
    },
    "99+": {
      "comment": "A string that can be used to represent 99+ in a localized fashion.",
      "isCommentAutoGenerated": true
    },
    "@": {},
    "@%@": {
      "comment": "A username displayed in a smaller font below the user's name. The username is preceded by an @ symbol.",
      "isCommentAutoGenerated": true
    },
    "BarkFluff": {
      "comment": "The name of the app.",
      "isCommentAutoGenerated": true
    },
