<ui:FluentWindow
    x:Class="BarkFluff.DBEditor.Views.AccountSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.DBEditor.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Database Accounts"
    Width="600"
    Height="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <ui:TitleBar Title="Database Accounts" HorizontalAlignment="Stretch" VerticalAlignment="Top" />

        <ScrollViewer Margin="20,60,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Quick Login Button (for last used account) -->
                <ui:Button
                    x:Name="QuickLoginButton"
                    Padding="20"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Appearance="Primary"
                    Click="QuickLoginButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon
                            Symbol="ArrowCircleRight24"
                            FontSize="32"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="Quick Login"
                                FontSize="12"
                                Opacity="0.8" />
                            <TextBlock
                                x:Name="QuickLoginDisplayName"
                                Text="{Binding ViewModel.LastUsedAccount.DisplayName}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0" />
                            <TextBlock
                                x:Name="QuickLoginDisplayInfo"
                                Text="{Binding ViewModel.LastUsedAccount.DisplayInfo}"
                                FontSize="12"
                                Opacity="0.8"
                                Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </ui:Button>

                <!-- All Accounts Header -->
                <TextBlock
                    Text="All Accounts"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,0,0,15"
                    Visibility="{Binding ViewModel.HasAccounts, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Accounts List -->
                <ItemsControl ItemsSource="{Binding ViewModel.Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,10"
                                Padding="15"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Account Info (clickable) -->
                                    <ui:Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Click="AccountSelectButton_Click"
                                        Tag="{Binding Id}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="16"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding DisplayInfo}"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Margin="0,3,0,0" />
                                        </StackPanel>
                                    </ui:Button>

                                    <!-- Action Buttons -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                        <ui:Button
                                            Appearance="Secondary"
                                            Icon="Edit24"
                                            ToolTip="Edit Account"
                                            Padding="10"
                                            Click="EditButton_Click"
                                            Tag="{Binding Id}" />
                                        <ui:Button
                                            Appearance="Danger"
                                            Icon="Delete24"
                                            ToolTip="Delete Account"
                                            Padding="10"
                                            Margin="5,0,0,0"
                                            Click="DeleteButton_Click"
                                            Tag="{Binding Id}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add New Account Button -->
                <ui:Button
                    Margin="0,10,0,0"
                    Height="60"
                    HorizontalAlignment="Stretch"
                    Appearance="Secondary"
                    Click="AddNewAccountButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Add24"
                            FontSize="24"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="Add New Account"
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
