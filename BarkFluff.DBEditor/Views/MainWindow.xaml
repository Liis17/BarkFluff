<ui:FluentWindow
    x:Class="BarkFluff.DBEditor.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.DBEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Configuration Manager"
    Width="1200"
    Height="700"
    ExtendsContentIntoTitleBar="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="System Configuration" Grid.Row="0" />

        <ui:DataGrid
            Grid.Row="1"
            Margin="10"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Configs}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Id}"
                    Header="ID"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Section}"
                    Header="Section"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Key}"
                    Header="Key"
                    IsReadOnly="True" />
                <DataGridTemplateColumn Width="*" Header="Value">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox
                                Background="Transparent"
                                BorderThickness="0"
                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding EditedAt}"
                    Header="Edited At"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding EditedBy}"
                    Header="Edited By"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding ServiceId}"
                    Header="Service ID"
                    IsReadOnly="True" />
            </DataGrid.Columns>
        </ui:DataGrid>

        <ProgressBar
            Grid.Row="1"
            Width="200"
            Height="5"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border
            Grid.Row="2"
            Padding="15"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="You have unsaved changes" />
                    <ui:Button
                        Appearance="Secondary"
                        Command="{Binding RevertCommand}"
                        Content="Revert"
                        Icon="ArrowUndo24" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Content="Save Changes"
                        Icon="Save24" />

                </StackPanel>
                <ui:Button
                    HorizontalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding LoadDataCommand}"
                    Content="Refresh Data"
                    Icon="ArrowSync24" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
