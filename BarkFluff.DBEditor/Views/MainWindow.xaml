<ui:FluentWindow
    x:Class="BarkFluff.DBEditor.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.DBEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Configuration Manager"
    Width="1200"
    Height="700"
    ExtendsContentIntoTitleBar="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="System Configuration" />

        <ui:DataGrid Grid.Row="1" ItemsSource="{Binding Configs}" AutoGenerateColumns="False" 
                     CanUserAddRows="False" CanUserDeleteRows="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Section" Binding="{Binding Section}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="200"/>
                <DataGridTemplateColumn Header="Value" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                        BorderThickness="0" Background="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Edited At" Binding="{Binding EditedAt}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="Edited By" Binding="{Binding EditedBy}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}" IsReadOnly="True" Width="80"/>
            </DataGrid.Columns>
        </ui:DataGrid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Width="200" Height="5" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="15"
                Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="You have unsaved changes" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <ui:Button Content="Revert" Icon="ArrowUndo24" Command="{Binding RevertCommand}" Appearance="Secondary"/>
                <ui:Button Content="Save Changes" Icon="Save24" Command="{Binding SaveCommand}" Appearance="Primary"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
