# ═══════════════════════════════════════════════════════════════
#  GitHub Actions Secrets — необходимые переменные окружения
#  Все значения нужно добавить в Settings → Secrets and variables → Actions
# ═══════════════════════════════════════════════════════════════

# ── Docker Registry ──────────────────────────────────────────
# Логин и пароль для приватного Docker-реестра docker.barkfluff.com:5000
REGISTRY_USERNAME=              # Имя пользователя Docker-реестра
REGISTRY_PASSWORD=              # Пароль Docker-реестра

# ── Telegram: запрос подтверждения сборки (ЛС администратору) ─
# Бот и чат для отправки запросов на одобрение/отклонение сборки
# Сообщения приходят в личные сообщения администратору
TELEGRAM_APPROVAL_BOT_TOKEN=    # Токен Telegram-бота для запросов подтверждения
TELEGRAM_APPROVAL_CHAT_ID=      # Chat ID администратора (личные сообщения)

# ── Telegram: уведомления о сборке (публичный канал) ─────────
# Бот и канал для публикации результатов сборки (успех/ошибка)
# Сообщения приходят в публичный канал
TELEGRAM_BOT_TOKEN=             # Токен Telegram-бота для уведомлений
TELEGRAM_CHANNEL_ID=            # Chat ID публичного канала для уведомлений

# ── GitHub Releases (WPF Client) ────────────────────────────
# Для публикации WPF-клиента в GitHub Releases другого репозитория
PUBLIC_REPO_TOKEN=              # Personal Access Token (PAT) с правами на целевой репозиторий релизов
OWNER_RELEASE_REPO=             # Владелец репозитория релизов (username или org)
RELEASE_REPO_NAME=              # Название репозитория релизов (например: BarkFluff.Releases)
