# ═══════════════════════════════════════════════════════════════
#  GitHub Actions Secrets — справочник, которые секреты читает ci.yml
#  Этот файл workflow не читают: значения берутся только из
#  Settings → Secrets and variables → Actions. Реальные значения сюда не вписывать.
# ═══════════════════════════════════════════════════════════════

# ── Docker Registry ──────────────────────────────────────────
# Логин и пароль для приватного Docker-реестра docker.barkfluff.com
REGISTRY_USERNAME=              # Имя пользователя Docker-реестра
REGISTRY_PASSWORD=              # Пароль Docker-реестра

# ── Telegram: уведомления о проверках и сборках (канал) ──────
TELEGRAM_BOT_TOKEN=             # Токен Telegram-бота для уведомлений
TELEGRAM_CHANNEL_ID=            # Chat ID канала для уведомлений

# ── ClientStorage (сервер обновлений) ────────────────────────
# Для загрузки сборок Android, macOS и WinUI клиентов на сервер обновлений
CLIENT_STORAGE_URL=             # Базовый URL сервера обновлений (например: https://storage.barkfluff.com)
CLIENT_STORAGE_TOKEN=           # Токен авторизации (UPLOAD_TOKEN) для загрузки файлов
CLOUDFLARE_ORIGIN_CA_BUNDLE_B64= # CA-бандл Cloudflare Origin CA в base64 (Android/macOS: загрузка и fallback CA в APK)

# ── Android Signing ──────────────────────────────────────────
# Параметры подписи APK для релизной сборки Android-клиента
ANDROID_RELEASE_STORE_B64=      # Содержимое .jks в base64 (сгенерировать: Android/Barkfluff.Client.Android/keystore-to-base64.cmd)
ANDROID_RELEASE_STORE_PASSWORD= # Пароль keystore
ANDROID_RELEASE_KEY_ALIAS=      # Alias ключа подписи
ANDROID_RELEASE_KEY_PASSWORD=   # Пароль ключа подписи

# ── WinUI MSIX Signing ───────────────────────────────────────
WINUI_MSIX_CERTIFICATE_B64=     # PFX самоподписанного сертификата MSIX в base64
WINUI_MSIX_CERTIFICATE_PASSWORD= # Пароль PFX
