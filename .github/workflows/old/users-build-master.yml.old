name: Сборка и отправка в регистр Users

on:
  push:
    branches:
      - master
    paths:
      - 'Backend/BarkFluff.Users/**'
      - 'BarkFluff.Shared.Queue/**'
      - 'BarkFluff.Shared.Exceptions/**'
      - 'Backend/BarkFluff.GrpcServer/**'
      - '.github/workflows/users-build-master.yml'
      - 'rebuild.trigger'

jobs:
  build-users:
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v3
      
      - name: Login to Private Registry
        uses: docker/login-action@v2
        with:
          registry: docker.barkfluff.com:5000
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}
      
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2
      
      - name: Build and Push
        uses: docker/build-push-action@v4
        with:
          context: .
          file: ./Backend/BarkFluff.Users/Dockerfile
          push: true
          tags: docker.barkfluff.com:5000/barkfluff-users:latest,docker.barkfluff.com:5000/barkfluff-users:${{ github.sha }}