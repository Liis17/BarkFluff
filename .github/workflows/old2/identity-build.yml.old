name: 🐋 Сборка образа BarkFluff.Identity
on:
  push:
    branches:
      - dev
      - master
    paths:
      - 'Backend/BarkFluff.Identity/**'
      - 'Shared/BarkFluff.Shared.Queue/**'
      - 'Shared/BarkFluff.Shared.Identity/**'
      - 'Shared/BarkFluff.Shared.Exceptions/**'
      - 'Backend/BarkFluff.GrpcServer/**'
      - '.github/workflows/identity-build.yml'
      - 'Backend/rebuild.trigger'
jobs:
  build-identity:
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v3
      
      - name: Login to Private Registry
        uses: docker/login-action@v2
        with:
          registry: docker.barkfluff.com:5000
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}
      
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2
      
      - name: Set tags
        id: vars
        shell: pwsh
        run: |
          if ("${{ github.ref_name }}" -eq "dev") {
            echo "tags=docker.barkfluff.com:5000/barkfluff-identity-dev:latest,docker.barkfluff.com:5000/barkfluff-identity-dev:${{ github.sha }}" >> $env:GITHUB_OUTPUT
          } else {
            echo "tags=docker.barkfluff.com:5000/barkfluff-identity:latest,docker.barkfluff.com:5000/barkfluff-identity:${{ github.sha }}" >> $env:GITHUB_OUTPUT
          }
      
      - name: Build and Push
        uses: docker/build-push-action@v4
        with:
          context: .
          file: ./Backend/BarkFluff.Identity/Dockerfile
          push: true
          tags: ${{ steps.vars.outputs.tags }}