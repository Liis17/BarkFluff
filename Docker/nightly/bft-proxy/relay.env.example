# Relay runs on the Russia server. The DNS record must point directly here.
BFT_MODE=Relay
BFT_LISTEN=0.0.0.0:8443
BFT_NEXT_HOP=exit-lv.barkfluff.com:7443
BFT_RELAY_ID=ru-1
# Use the exact same generated value as BFT_RELAY_KEY in exit.env.
BFT_RELAY_KEY=REPLACE_WITH_SHARED_32_BYTE_BASE64URL_KEY

# Relay limits; these are the defaults in ProxyConfiguration.cs.
BFT_RELAY_MAX_CONNECTIONS_PER_IP=64
BFT_RELAY_MAX_CONNECTIONS=4096
BFT_RELAY_CONNECT_TIMEOUT_SECONDS=15
