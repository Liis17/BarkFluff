# Exit runs on the Latvia server. All addresses below are examples.
BFT_MODE=Exit
BFT_LISTEN=0.0.0.0:8443

# Generate with: docker compose -f docker-compose.exit.yml run --rm --no-deps exit genkey
BFT_STATIC_PRIVATE_KEY=REPLACE_WITH_BFT_STATIC_PRIVATE_KEY
BFT_CLIENT_KEYS_FILE=/var/lib/bft-proxy/client-keys/clients.txt
BFT_PROXY_ID=exit-lv-01
# Generate with: openssl rand -hex 32; copy the same value to the Nginx secret map.
BFT_ORIGIN_SECRET=REPLACE_WITH_64_HEX_CHAR_ORIGIN_SECRET

# Optional comma-separated client tokens. Leave empty to disable token checks.
BFT_ACCESS_TOKENS=

# Optional listener used only by the Relay server; host firewall should allow
# this port only from the Relay's public egress IP.
BFT_RELAY_LISTEN=0.0.0.0:7443
BFT_TRUSTED_RELAYS=203.0.113.20
# Generate once with openssl rand -base64 32 and base64url-encode without padding;
# use exactly the same 43-character value in relay.env.
BFT_RELAY_KEY=REPLACE_WITH_SHARED_32_BYTE_BASE64URL_KEY

# Optional HTTPS service origins. Replace example hostnames with the real
# public origin names covered by the main server's TLS certificate.
BFT_UPSTREAM_BEACON=https://beacon.example.barkfluff.com
BFT_UPSTREAM_IDENTITY=https://identity.example.barkfluff.com
BFT_UPSTREAM_USERS=https://users.example.barkfluff.com
BFT_UPSTREAM_MESSAGES=https://messages.example.barkfluff.com
BFT_UPSTREAM_FILES=https://files.example.barkfluff.com
BFT_UPSTREAM_FILES_MEDIA=https://files-media.example.barkfluff.com
BFT_UPSTREAM_UPDATES=https://updates.example.barkfluff.com
BFT_UPSTREAM_ONLINER=https://onliner.example.barkfluff.com
BFT_UPSTREAM_FASTAUTH=https://fastauth.example.barkfluff.com
BFT_UPSTREAM_CALLS=https://calls.example.barkfluff.com
BFT_UPSTREAM_BOTS=https://bots.example.barkfluff.com
BFT_UPSTREAM_STORAGE=https://storage.example.barkfluff.com

# Exit limits; these are the defaults in ProxyConfiguration.cs.
BFT_MAX_TUNNELS_PER_KEY=16
BFT_MAX_TUNNELS=4096
