# TLS-фронт страницы статуса. Сертификат и ключ кладёт оператор в STATUS_CERTS_DIR.
# Наружу — только GET/HEAD; внутрь уходит только status:8080. Входных параметров публичный API не принимает.
server {
    listen 443 ssl;
    http2 on;
    server_name ${STATUS_SERVER_NAME};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 1k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Имя status резолвится при запросе через Docker DNS, а не один раз при старте nginx:
    # пересоздание контейнера status не оставляет фронт с устаревшим IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $status_upstream http://status:8080;

    location / {
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass $status_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}
