# Скопируйте в .env и заполните. Значения — примеры; реальные ключи и адреса в Git не коммитятся.

# Публичное DNS-имя ноды (без схемы и порта). Статус проверяет https://<сервис>.<NODE_DOMAIN>/health/ready.
NODE_DOMAIN=node.example.com

# Имя, по которому открывается страница статуса, и порт на хосте.
STATUS_SERVER_NAME=status.example.com
STATUS_HTTPS_PORT=443

# Каталог с fullchain.pem и privkey.pem, которые кладёт оператор.
STATUS_CERTS_DIR=./certs

# Необязательно: Base64(SHA256(SubjectPublicKeyInfo)) TLS-ключа Federation, если федерационный сертификат самоподписанный.
# Пин заменяет проверку цепочки только для Federation; для остальных сервисов сертификат проверяется обычно.
FEDERATION_SPKI_PIN=

# Необязательно: через запятую публичные компоненты, которые намеренно не работают на ноде
# (beacon, bots, calls, developers, fast-auth, federation, files, identity, messages, onliner, updates, users, web).
STATUS_DISABLED_SERVICES=

# Необязательно: HTTPS origin одного сервиса вместо <сервис>.<NODE_DOMAIN> (только схема, хост и порт). Пример:
# Status__ServiceOrigins__messages=https://msg.example.org

# Образ статуса. По умолчанию nightly-канал; образ master без суффикса: docker.barkfluff.com/barkfluff-status:latest.
STATUS_IMAGE=docker.barkfluff.com/barkfluff-status-nightly:latest
