    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarkFluff.WebApi.Core\BarkFluff.WebApi.Core.csproj" />
  </ItemGroup>

