<UserControl x:Class="BarkFluff.ClientV2.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BarkFluff.ClientV2.WPF.Infrastructure.Behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.RenderTransform>
        <TranslateTransform Y="12" />
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.22" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid Margin="40,24,40,40">
        <ui:Card Width="820"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{StaticResource OnboardingCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,32,0">
                    <TextBlock Style="{StaticResource OnboardingTitle}"
                               Text="{DynamicResource Login_Title}" />
                    <TextBlock Margin="0,10,0,24"
                               Style="{StaticResource OnboardingDescription}"
                               Text="{DynamicResource Login_Subtitle}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Login_Identifier}" />
                    <ui:TextBox Margin="0,8,0,16"
                                PlaceholderText="{DynamicResource Login_IdentifierPlaceholder}"
                                Text="{Binding LoginOrEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Login_Password}" />
                    <ui:PasswordBox Margin="0,8,0,18"
                                    Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{DynamicResource Login_PasswordPlaceholder}"
                                    RevealButtonEnabled="True" />

                    <StackPanel Visibility="{Binding RequiresTwoFactor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Login_TwoFactor}" />
                        <TextBlock Margin="0,6,0,12"
                                   Style="{StaticResource MutedText}"
                                   Text="{DynamicResource Login_TwoFactorHint}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="42" Height="44" Margin="0,0,8,0" HorizontalContentAlignment="Center" FontSize="18" MaxLength="1"
                                        Text="{Binding OtpDigit1, UpdateSourceTrigger=PropertyChanged}"
                                        behaviors:OtpInputBehavior.EnableAutoAdvance="True"
                                        behaviors:OtpInputBehavior.PasteCommand="{Binding PasteOtpCodeCommand}" />
                            <ui:TextBox Width="42" Height="44" Margin="0,0,8,0" HorizontalContentAlignment="Center" FontSize="18" MaxLength="1" Text="{Binding OtpDigit2, UpdateSourceTrigger=PropertyChanged}" behaviors:OtpInputBehavior.EnableAutoAdvance="True" />
                            <ui:TextBox Width="42" Height="44" Margin="0,0,8,0" HorizontalContentAlignment="Center" FontSize="18" MaxLength="1" Text="{Binding OtpDigit3, UpdateSourceTrigger=PropertyChanged}" behaviors:OtpInputBehavior.EnableAutoAdvance="True" />
                            <ui:TextBox Width="42" Height="44" Margin="0,0,8,0" HorizontalContentAlignment="Center" FontSize="18" MaxLength="1" Text="{Binding OtpDigit4, UpdateSourceTrigger=PropertyChanged}" behaviors:OtpInputBehavior.EnableAutoAdvance="True" />
                            <ui:TextBox Width="42" Height="44" Margin="0,0,8,0" HorizontalContentAlignment="Center" FontSize="18" MaxLength="1" Text="{Binding OtpDigit5, UpdateSourceTrigger=PropertyChanged}" behaviors:OtpInputBehavior.EnableAutoAdvance="True" />
                            <ui:TextBox Width="42" Height="44" HorizontalContentAlignment="Center" FontSize="18" MaxLength="1" Text="{Binding OtpDigit6, UpdateSourceTrigger=PropertyChanged}" behaviors:OtpInputBehavior.EnableAutoAdvance="True" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,14,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding LoginCommand}" Content="{DynamicResource Login_Submit}" />
                        <ui:ProgressRing Width="22" Height="22" Margin="14,0,0,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsAuthenticating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <ui:HyperlinkButton Content="{DynamicResource Login_ForgotPassword}" />
                        <ui:HyperlinkButton Margin="14,0,0,0" Content="{DynamicResource Login_Register}" />
                        <ui:HyperlinkButton Margin="14,0,0,0" Command="{Binding ChooseAnotherNodeCommand}" Content="{DynamicResource Login_ChooseAnotherNode}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                <StackPanel Grid.Column="2" Margin="32,0,0,0" HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{DynamicResource Login_FastAuthTitle}" />
                    <TextBlock Margin="0,8,0,18" HorizontalAlignment="Center" Style="{StaticResource MutedText}" TextAlignment="Center" Text="{DynamicResource Login_FastAuthHint}" />
                    <Border Width="188" Height="188" Padding="10" Background="White" CornerRadius="12">
                        <Grid>
                            <Image Stretch="Uniform" Source="{Binding FastAuthQrCode}" />
                            <ui:ProgressRing Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsFastAuthLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
