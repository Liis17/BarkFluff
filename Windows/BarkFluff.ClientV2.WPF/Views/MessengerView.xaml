<UserControl x:Class="BarkFluff.ClientV2.WPF.Views.MessengerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:BarkFluff.ClientV2.WPF.Infrastructure.Behaviors">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <ui:TextBox PlaceholderText="{DynamicResource Messenger_Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Opacity=".7" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding UnreadCount}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Grid Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,16,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="20,16" Visibility="{Binding SelectedChat, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedChat.Title}" /><TextBlock Opacity=".7" Text="{DynamicResource Messenger_StatusOffline}" /></StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="12,4" Padding="10" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <Grid Grid.Row="2" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBox AcceptsReturn="True" MinHeight="42" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" behaviors:SendOnEnterBehavior.Command="{Binding SendCommand}" /><ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SendCommand}" Content="{DynamicResource Messenger_Send}" /></Grid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Opacity=".6" Text="{DynamicResource Messenger_Empty}" Visibility="{Binding SelectedChat, Converter={StaticResource StringToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
