<UserControl x:Class="BarkFluff.ClientV2.WPF.Views.Controls.ChatListSkeletonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8" MinHeight="60" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="44" Height="44" Fill="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Margin="0,3,8,0">
            <Border Height="14" Width="140" HorizontalAlignment="Left" CornerRadius="7" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Border Height="12" Width="190" Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="2" Height="10" Width="32" Margin="0,4,0,0" HorizontalAlignment="Right" CornerRadius="5" Background="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
