<UserControl x:Class="BarkFluff.ClientV2.WPF.Views.Controls.MessageQuoteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding HasForwarded, Converter={StaticResource BooleanToVisibilityConverter}}">
    <!--  Цитата ответа кликабельна и уводит к оригиналу; блок пересылки — просто превью.  -->
    <Border Margin="0,0,0,6"
            Padding="8,5"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="6">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReplyQuote}" Value="True">
                        <Setter Property="Cursor" Value="Hand" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding Owner.ScrollToOriginalCommand}"
                          CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="2"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="1" />
            <StackPanel Grid.Column="1">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding Forwarded.AuthorName}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12"
                           Opacity=".8"
                           Text="{Binding Forwarded.Preview}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
