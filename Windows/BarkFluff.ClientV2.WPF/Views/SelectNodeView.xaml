<UserControl x:Class="BarkFluff.ClientV2.WPF.Views.SelectNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="48">
        <ui:Card Width="620"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{StaticResource OnboardingCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource OnboardingTitle}"
                           Text="{DynamicResource SelectNode_Title}" />
                <TextBlock Grid.Row="1"
                           Margin="0,12,0,24"
                           Style="{StaticResource OnboardingDescription}"
                           Text="{DynamicResource SelectNode_Subtitle}" />

                <TextBlock Grid.Row="2"
                           Style="{StaticResource SectionTitle}"
                           Text="{DynamicResource SelectNode_PublicNodes}" />
                <Grid Grid.Row="3" Margin="0,12,0,24">
                    <ListBox MinHeight="110"
                             MaxHeight="180"
                             ItemsSource="{Binding PublicNodes}"
                             SelectedItem="{Binding SelectedPublicNode}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Description}" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Address}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ProgressBar Height="4"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoadingPublicNodes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Row="4">
                    <Button Command="{Binding ConnectSelectedNodeCommand}"
                            Content="{DynamicResource SelectNode_ConnectSelected}"
                            Style="{StaticResource SecondaryButton}" />
                    <TextBlock Margin="0,24,0,8"
                               Style="{StaticResource SectionTitle}"
                               Text="{DynamicResource SelectNode_ManualNode}" />
                    <ui:TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource SelectNode_AddressPlaceholder}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,20,0,0" Orientation="Horizontal">
                    <ui:Button Appearance="Primary"
                               Command="{Binding ConnectManualCommand}"
                               Content="{DynamicResource Common_Connect}" />
                    <ProgressBar Width="100"
                                 Height="4"
                                 Margin="16,0,0,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
