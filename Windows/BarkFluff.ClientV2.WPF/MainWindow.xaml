<ui:FluentWindow
    x:Class="BarkFluff.ClientV2.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    xmlns:views="clr-namespace:BarkFluff.ClientV2.WPF.Views"
    Title="{DynamicResource App_Title}"
    Width="1000"
    Height="720"
    MinWidth="780"
    MinHeight="600"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource OnboardingWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top">
            <ui:TitleBar.TrailingContent>
                <ui:Button Margin="0,6,4,0"
                           Padding="8,4"
                           Appearance="Transparent"
                           Command="{Binding ToggleSettingsCommand}"
                           ToolTip="{DynamicResource Settings_Title}">
                    <ui:SymbolIcon FontSize="16" Symbol="Settings24" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

        <Border Grid.Row="1"
                Panel.ZIndex="20"
                Background="{DynamicResource MessengerModalScrimBrush}"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card Width="420"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <StackPanel>
                    <views:SettingsView DataContext="{Binding Settings}" />
                    <ui:Button Margin="0,20,0,0"
                               HorizontalAlignment="Right"
                               Command="{Binding CloseSettingsCommand}"
                               Content="{DynamicResource Settings_Close}" />
                </StackPanel>
            </ui:Card>
        </Border>

        <tray:NotifyIcon Icon="pack://application:,,,/Resources/Icons/barkfluff.ico"
                         MenuOnRightClick="True"
                         TooltipText="{DynamicResource App_Title}"
                         LeftDoubleClick="OnTrayShowRequested">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Click="OnTrayShowRequested" Header="{DynamicResource Tray_Open}" />
                    <Separator />
                    <MenuItem Click="OnTrayExitRequested" Header="{DynamicResource Tray_Exit}" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
