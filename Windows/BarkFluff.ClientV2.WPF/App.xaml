<Application x:Class="BarkFluff.ClientV2.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:BarkFluff.ClientV2.WPF.ViewModels"
             xmlns:views="clr-namespace:BarkFluff.ClientV2.WPF.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Colors/Light.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
                <ResourceDictionary Source="Resources/Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:WelcomeViewModel}">
                <views:WelcomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SelectNodeViewModel}">
                <views:SelectNodeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ConnectedNodeViewModel}">
                <views:ConnectedNodeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:RegistrationViewModel}">
                <views:RegistrationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PasswordRecoveryViewModel}">
                <views:PasswordRecoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MessengerViewModel}">
                <views:MessengerView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
