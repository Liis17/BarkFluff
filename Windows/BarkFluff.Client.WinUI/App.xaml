<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BarkFluff.Client.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BarkFluff.Client.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Colors/Brushes.xaml" />
                <!--  Язык по умолчанию; LocalizationService подменяет словарь до создания окна.  -->
                <ResourceDictionary Source="ms-appx:///Resources/Localization/Strings.en.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
