<Page
    x:Class="BarkFluff.Client.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="40,24,40,40"
                    MaxWidth="640"
                    HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource OnboardingTitle}" Text="{StaticResource Settings_Title}" />
            <Border Margin="0,24,0,0" Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Settings_OnWindowClose}" />
                    <RadioButton Margin="0,10,0,0"
                                 Content="{StaticResource Settings_OnWindowCloseExit}"
                                 GroupName="WindowClosingBehavior"
                                 IsChecked="{x:Bind ViewModel.ExitsOnClose, Mode=TwoWay}" />
                    <RadioButton Margin="0,6,0,0"
                                 Content="{StaticResource Settings_OnWindowCloseTray}"
                                 GroupName="WindowClosingBehavior"
                                 IsChecked="{x:Bind ViewModel.MinimizesToTray, Mode=TwoWay}" />
                    <TextBlock Margin="0,8,0,0"
                               Opacity=".7"
                               Style="{StaticResource MutedText}"
                               Text="{StaticResource Settings_OnWindowCloseTrayHint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
