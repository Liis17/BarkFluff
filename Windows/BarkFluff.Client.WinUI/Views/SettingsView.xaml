<UserControl
    x:Class="BarkFluff.Client.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="360">
        <TextBlock FontWeight="SemiBold" Text="{StaticResource Settings_OnWindowClose}" />
        <RadioButton Margin="0,10,0,0"
                     Content="{StaticResource Settings_OnWindowCloseExit}"
                     GroupName="WindowClosingBehavior"
                     IsChecked="{Binding ExitsOnClose, Mode=TwoWay}" />
        <RadioButton Margin="0,6,0,0"
                     Content="{StaticResource Settings_OnWindowCloseTray}"
                     GroupName="WindowClosingBehavior"
                     IsChecked="{Binding MinimizesToTray, Mode=TwoWay}" />
        <TextBlock Margin="0,8,0,0"
                   Opacity=".7"
                   Style="{StaticResource MutedText}"
                   Text="{StaticResource Settings_OnWindowCloseTrayHint}" />
    </StackPanel>
</UserControl>
