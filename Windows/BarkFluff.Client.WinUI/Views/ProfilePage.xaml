<Page
    x:Class="BarkFluff.Client.WinUI.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="40,24,40,40"
                    MaxWidth="640"
                    HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource OnboardingTitle}" Text="{StaticResource Profile_Title}" />

            <ProgressRing Margin="0,24,0,0"
                          HorizontalAlignment="Left"
                          IsActive="True"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Margin="0,16,0,0"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

            <Border Margin="0,24,0,0" Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <PersonPicture Width="96"
                                   Height="96"
                                   HorizontalAlignment="Left"
                                   DisplayName="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                   ProfilePicture="{x:Bind ViewModel.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                    <TextBlock Margin="0,18,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{x:Bind ViewModel.Username, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.Username, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{x:Bind ViewModel.PresenceLabel, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.PresenceLabel, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!--  Почту сервер отдаёт только для собственного профиля — пустая строка прячет блок целиком.  -->
                    <StackPanel Margin="0,24,0,0" Visibility="{x:Bind ViewModel.Email, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Profile_Email}" />
                        <TextBlock Margin="0,4,0,0" Text="{x:Bind ViewModel.Email, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0" Visibility="{x:Bind ViewModel.Description, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Profile_About}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0" Visibility="{x:Bind ViewModel.RegisteredAtLabel, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Profile_RegisteredAt}" />
                        <TextBlock Margin="0,4,0,0" Text="{x:Bind ViewModel.RegisteredAtLabel, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
