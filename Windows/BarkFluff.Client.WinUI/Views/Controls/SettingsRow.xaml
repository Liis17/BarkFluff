<UserControl
    x:Class="BarkFluff.Client.WinUI.Views.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="56"
          Padding="16,12"
          ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon FontSize="16"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Glyph="{x:Bind Glyph, Mode=OneWay}"
                  VerticalAlignment="Center"
                  Visibility="{x:Bind Glyph, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="12"
                       Style="{StaticResource MutedText}"
                       Text="{x:Bind Description, Mode=OneWay}"
                       Visibility="{x:Bind Description, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
        </StackPanel>

        <!--  Бейдж объясняет, почему пункт недоступен: «Скоро» или «Только на Android».  -->
        <Border Grid.Column="2"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="10"
                Padding="8,3"
                VerticalAlignment="Center"
                Visibility="{x:Bind BadgeText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind BadgeText, Mode=OneWay}" />
        </Border>

        <ContentPresenter Grid.Column="3"
                          Content="{x:Bind ActionContent, Mode=OneWay}"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>
