<ContentDialog
    x:Class="BarkFluff.Client.WinUI.Views.Controls.ImagePickDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{StaticResource Settings_Account_PickImageTitle}"
    CloseButtonText="{StaticResource Common_Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="{StaticResource Common_Next}">
    <StackPanel MinWidth="320" Spacing="16">
        <TextBlock Style="{StaticResource MutedText}" Text="{StaticResource Settings_Account_PickImageHint}" />
        <Button x:Name="ChooseFileButton"
                Click="OnChooseFileClick"
                Content="{StaticResource Settings_Account_ChooseFile}"
                Style="{StaticResource SecondaryButton}" />
        <Image x:Name="Preview"
               MaxHeight="240"
               HorizontalAlignment="Left"
               Stretch="Uniform"
               Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
