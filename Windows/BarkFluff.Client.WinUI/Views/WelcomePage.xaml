<Page
    x:Class="BarkFluff.Client.WinUI.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,24,40,40">
        <Border Width="760"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource OnboardingCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <Border Padding="36"
                        Background="{StaticResource OnboardingAccentSurfaceBrush}"
                        CornerRadius="14">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="52"
                                Height="52"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="16">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="BF" />
                        </Border>
                        <TextBlock Margin="0,24,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="BarkFluff" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource OnboardingDescription}"
                                   Text="{StaticResource Welcome_BrandDescription}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Width="300"
                            Margin="44,28"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Style="{StaticResource SectionTitle}"
                               Text="{StaticResource Welcome_Eyebrow}" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource OnboardingTitle}"
                               Text="{StaticResource Welcome_Title}" />
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource OnboardingDescription}"
                               Text="{StaticResource Welcome_Subtitle}" />
                    <Button Margin="0,28,0,0"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.StartCommand}"
                            Content="{StaticResource Welcome_Start}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
