<Page
    x:Class="BarkFluff.Client.WinUI.Views.Settings.SettingsNotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BarkFluff.Client.WinUI.Views.Controls">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40"
                    MaxWidth="720"
                    HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,20"
                       Style="{StaticResource OnboardingTitle}"
                       Text="{StaticResource Settings_Notifications_Title}" />

            <Border Style="{StaticResource SettingsGroupCard}">
                <controls:SettingsRow Glyph="&#xE7ED;"
                                      Description="{StaticResource Settings_Notifications_ReceivePush}"
                                      Header="{StaticResource Settings_Notifications_Title}">
                    <ToggleSwitch IsEnabled="False" OffContent="" OnContent="" />
                </controls:SettingsRow>
            </Border>

            <InfoBar IsClosable="False"
                     IsOpen="True"
                     Message="{StaticResource Settings_Notifications_Hint}"
                     Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
