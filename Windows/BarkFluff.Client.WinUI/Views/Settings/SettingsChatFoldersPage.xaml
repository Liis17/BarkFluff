<Page
    x:Class="BarkFluff.Client.WinUI.Views.Settings.SettingsChatFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BarkFluff.Client.WinUI.Views.Controls">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40"
                    MaxWidth="720"
                    HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,20"
                       Style="{StaticResource OnboardingTitle}"
                       Text="{StaticResource Settings_ChatFolders_Title}" />

            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{StaticResource Settings_ChatFolders_Section}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel>
                    <StackPanel Margin="16,20">
                        <TextBlock Text="{StaticResource Settings_ChatFolders_EmptyTitle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="{StaticResource Settings_ChatFolders_EmptySubtitle}" />
                    </StackPanel>
                    <Button IsEnabled="False" Style="{StaticResource SettingsRowButtonStyle}">
                        <controls:SettingsRow Glyph="&#xE710;" Header="{StaticResource Settings_ChatFolders_NewFolder}">
                            <FontIcon FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE76C;" />
                        </controls:SettingsRow>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Папки существуют на сервере, но списка чатов для выбора в настройках пока нет.  -->
            <Border Style="{StaticResource SettingsGroupCard}">
                <controls:SettingsRow BadgeText="{StaticResource Settings_BadgeComingSoon}"
                                      Glyph="&#xE8B7;"
                                      Header="{StaticResource Settings_ChatFolders_ManageChats}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
