<Page
    x:Class="BarkFluff.Client.WinUI.Views.Settings.SettingsGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BarkFluff.Client.WinUI.Views.Controls">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40"
                    MaxWidth="720"
                    HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,20"
                       Style="{StaticResource OnboardingTitle}"
                       Text="{StaticResource Settings_General_Title}" />

            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{StaticResource Settings_OnWindowClose}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel Margin="12">
                    <RadioButton Content="{StaticResource Settings_OnWindowCloseExit}"
                                 GroupName="WindowClosingBehavior"
                                 IsChecked="{x:Bind ViewModel.ExitsOnClose, Mode=TwoWay}" />
                    <RadioButton Margin="0,6,0,0"
                                 Content="{StaticResource Settings_OnWindowCloseTray}"
                                 GroupName="WindowClosingBehavior"
                                 IsChecked="{x:Bind ViewModel.MinimizesToTray, Mode=TwoWay}" />
                    <TextBlock Margin="0,8,0,0"
                               Opacity=".7"
                               Style="{StaticResource MutedText}"
                               Text="{StaticResource Settings_OnWindowCloseTrayHint}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,24,0,0"
                       Style="{StaticResource SettingsGroupTitle}"
                       Text="{StaticResource Settings_WindowSize_Title}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <StackPanel>
                    <controls:SettingsRow Header="{StaticResource Settings_WindowSize_Remember}"
                                          Description="{StaticResource Settings_WindowSize_RememberHint}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RememberWindowSize, Mode=OneWay}"
                                      Toggled="OnRememberWindowSizeToggled" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Header="{StaticResource Settings_WindowSize_Saved}"
                                          Description="{x:Bind ViewModel.WindowSizeDescription, Mode=OneWay}">
                        <Button Click="OnResetWindowSizeClick"
                                Content="{StaticResource Settings_WindowSize_Reset}"
                                Style="{StaticResource SecondaryButton}" />
                    </controls:SettingsRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
