<Page
    x:Class="BarkFluff.Client.WinUI.Views.Settings.SettingsDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BarkFluff.Client.WinUI.Views.Controls"
    xmlns:models="using:BarkFluff.Client.Core.ViewModels.Settings">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40"
                    MaxWidth="720"
                    HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,20"
                       Style="{StaticResource OnboardingTitle}"
                       Text="{StaticResource Settings_Devices_Title}" />

            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{StaticResource Settings_Devices_ThisDevice}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <controls:SettingsRow Glyph="&#xE770;"
                                      Description="{x:Bind ViewModel.CurrentDeviceDetails, Mode=OneWay}"
                                      Header="{x:Bind ViewModel.CurrentDeviceName, Mode=OneWay}" />
            </Border>

            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{StaticResource Settings_Devices_OtherDevices}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <ListView ItemsSource="{x:Bind ViewModel.OtherDevices, Mode=OneWay}"
                          MaxHeight="280"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceSessionItem">
                            <controls:SettingsRow Glyph="&#xE770;" Header="{x:Bind Name}" Description="{x:Bind Details}">
                                <Button Click="OnRemoveClick" CommandParameter="{x:Bind}" Content="{StaticResource Settings_Devices_Terminate}" Style="{StaticResource SecondaryButton}" />
                            </controls:SettingsRow>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Button Click="OnTerminateOthersClick"
                    Content="{StaticResource Settings_Devices_TerminateOthers}"
                    Visibility="{x:Bind ViewModel.HasOtherDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource DangerButton}" />
        </StackPanel>
    </ScrollViewer>
</Page>
