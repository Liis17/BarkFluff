<Page
    x:Class="BarkFluff.Client.WinUI.Views.Settings.SettingsDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BarkFluff.Client.WinUI.Views.Controls">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,40"
                    MaxWidth="720"
                    HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,20"
                       Style="{StaticResource OnboardingTitle}"
                       Text="{StaticResource Settings_Devices_Title}" />

            <Border Style="{StaticResource SettingsHeroCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{StaticResource Settings_Devices_Hint}" />
                    <Button Margin="0,16,0,0"
                            Content="{StaticResource Settings_Devices_Connect}"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{StaticResource Settings_Devices_ThisDevice}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <controls:SettingsRow Glyph="&#xE770;"
                                      Description="{StaticResource Settings_Devices_SectionOs}"
                                      Header="{StaticResource Settings_Devices_Id}" />
            </Border>

            <TextBlock Style="{StaticResource SettingsGroupTitle}" Text="{StaticResource Settings_Devices_OtherDevices}" />
            <Border Style="{StaticResource SettingsGroupCard}">
                <TextBlock Margin="16,20"
                           Style="{StaticResource MutedText}"
                           Text="{StaticResource Settings_Devices_Empty}" />
            </Border>

            <Button Content="{StaticResource Settings_Devices_TerminateOthers}"
                    IsEnabled="False"
                    Style="{StaticResource DangerButton}" />
        </StackPanel>
    </ScrollViewer>
</Page>
