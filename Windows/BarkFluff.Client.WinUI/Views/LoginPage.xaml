<Page
    x:Class="BarkFluff.Client.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BarkFluff.Client.WinUI.Infrastructure.Behaviors">
    <Page.Resources>
        <Style x:Key="OtpDigitBox" TargetType="TextBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MaxLength" Value="1" />
            <Setter Property="behaviors:OtpInputBehavior.EnableAutoAdvance" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Margin="40,24,40,40">
        <Border Width="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource OnboardingCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,32,0">
                    <TextBlock Style="{StaticResource OnboardingTitle}" Text="{StaticResource Login_Title}" />
                    <TextBlock Margin="0,10,0,24"
                               Style="{StaticResource OnboardingDescription}"
                               Text="{StaticResource Login_Subtitle}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Login_Identifier}" />
                    <TextBox Margin="0,8,0,16"
                             PlaceholderText="{StaticResource Login_IdentifierPlaceholder}"
                             Text="{x:Bind ViewModel.LoginOrEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Login_Password}" />
                    <PasswordBox Margin="0,8,0,18"
                                 Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                 PasswordRevealMode="Peek"
                                 PlaceholderText="{StaticResource Login_PasswordPlaceholder}" />

                    <StackPanel Visibility="{x:Bind ViewModel.RequiresTwoFactor, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Login_TwoFactor}" />
                        <TextBlock Margin="0,6,0,12"
                                   Style="{StaticResource MutedText}"
                                   Text="{StaticResource Login_TwoFactorHint}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox behaviors:OtpInputBehavior.PasteCommand="{x:Bind ViewModel.PasteOtpCodeCommand}"
                                     Style="{StaticResource OtpDigitBox}"
                                     Text="{x:Bind ViewModel.OtpDigit1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource OtpDigitBox}" Text="{x:Bind ViewModel.OtpDigit2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource OtpDigitBox}" Text="{x:Bind ViewModel.OtpDigit3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource OtpDigitBox}" Text="{x:Bind ViewModel.OtpDigit4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource OtpDigitBox}" Text="{x:Bind ViewModel.OtpDigit5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Margin="0"
                                     Style="{StaticResource OtpDigitBox}"
                                     Text="{x:Bind ViewModel.OtpDigit6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,14,0,0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <Button Command="{x:Bind ViewModel.LoginCommand}"
                                Content="{StaticResource Login_Submit}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing Width="22"
                                      Height="22"
                                      Margin="14,0,0,0"
                                      VerticalAlignment="Center"
                                      IsActive="True"
                                      Visibility="{x:Bind ViewModel.IsAuthenticating, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <HyperlinkButton Command="{x:Bind ViewModel.ShowPasswordRecoveryCommand}" Content="{StaticResource Login_ForgotPassword}" />
                        <HyperlinkButton Margin="14,0,0,0"
                                         Command="{x:Bind ViewModel.ShowRegistrationCommand}"
                                         Content="{StaticResource Login_Register}" />
                        <HyperlinkButton Margin="14,0,0,0"
                                         Command="{x:Bind ViewModel.ChooseAnotherNodeCommand}"
                                         Content="{StaticResource Login_ChooseAnotherNode}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                <StackPanel Grid.Column="2" Margin="32,0,0,0" HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="{StaticResource Login_FastAuthTitle}" />
                    <TextBlock Margin="0,8,0,18"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Text="{StaticResource Login_FastAuthHint}"
                               TextAlignment="Center" />
                    <Border Width="188"
                            Height="188"
                            Padding="10"
                            Background="White"
                            CornerRadius="12">
                        <Grid>
                            <Image Source="{x:Bind ViewModel.FastAuthQrCode, Mode=OneWay, Converter={StaticResource Base64ToImageSourceConverter}}" Stretch="Uniform" />
                            <ProgressRing Width="28"
                                          Height="28"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsActive="True"
                                          Visibility="{x:Bind ViewModel.IsFastAuthLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Text="{x:Bind ViewModel.FastAuthStatusMessage, Mode=OneWay}"
                               TextAlignment="Center" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Text="{x:Bind ViewModel.FastAuthCountdown, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
