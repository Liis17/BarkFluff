<Page
    x:Class="BarkFluff.Client.WinUI.Views.MessengerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BarkFluff.Client.WinUI.Infrastructure.Behaviors"
    xmlns:controls="using:BarkFluff.Client.WinUI.Controls"
    xmlns:local="using:BarkFluff.Client.WinUI.Views"
    xmlns:vm="using:BarkFluff.Client.Core.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <MenuFlyout x:Key="ChatListMenu" Closed="OnChatListMenuClosed">
            <MenuFlyoutItem />
            <MenuFlyoutSubItem Text="{StaticResource Messenger_ChatFolders}" />
        </MenuFlyout>

        <!--  Строка списка чатов.  -->
        <DataTemplate x:Key="ChatListItemTemplate" x:DataType="vm:ChatItemViewModel">
            <Grid Margin="0,4" MinHeight="56" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="44" Height="44" VerticalAlignment="Top">
                    <PersonPicture Width="44"
                                   Height="44"
                                   DisplayName="{x:Bind Title}"
                                   ProfilePicture="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" />
                    <Ellipse Width="12"
                             Height="12"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Fill="{StaticResource PresenceOnlineBrush}"
                             Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                             StrokeThickness="2"
                             Visibility="{x:Bind IsOnline, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="0,1,8,0">
                    <TextBlock FontWeight="SemiBold"
                               Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ListPreview, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Visibility="{x:Bind HasListPreview, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12"
                                  Glyph="&#xE74F;"
                                  AutomationProperties.Name="{StaticResource Messenger_ChatMuted}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind IsMuted, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind LastMessageAtLabel, Mode=OneWay}" />
                    </StackPanel>
                    <Border Margin="0,8,0,0"
                            Padding="6,1"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind HasUnmutedUnreadMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource ChatUnreadBadgeTextBrush}"
                                   Text="{x:Bind UnreadCount, Mode=OneWay}" />
                    </Border>
                    <Border Margin="0,8,0,0"
                            Padding="6,1"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind HasMutedUnreadMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind UnreadCount, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UserSearchResultTemplate" x:DataType="vm:UserSearchResultViewModel">
            <Grid Margin="0,4" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <PersonPicture Width="44"
                               Height="44"
                               DisplayName="{x:Bind DisplayName}"
                               ProfilePicture="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" />

                <StackPanel Grid.Column="1" Margin="0,1,0,0">
                    <TextBlock FontWeight="SemiBold"
                               Text="{x:Bind DisplayName}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind UsernameLabel}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Visibility="{x:Bind UsernameLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--
            Плитка медиа внутри пузыря: превью всегда, плеер раскрывается кнопкой. Адрес плееру
            передаёт Tag кнопки — без него PlayVideoBehavior молча ничего не сделает.
        -->
        <DataTemplate x:Key="MediaAttachmentTemplate" x:DataType="vm:MessageAttachmentItemViewModel">
            <Grid Margin="2">
                <Image Source="{x:Bind PreviewUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                <MediaPlayerElement AreTransportControlsEnabled="True"
                                    AutoPlay="False"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                <Button Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        behaviors:PlayVideoBehavior.Enable="True"
                        Content="&#x25B6;"
                        Tag="{x:Bind FileUrl}"
                        Visibility="{x:Bind IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FeedStickerTemplate" x:DataType="vm:MessageAttachmentItemViewModel">
            <controls:StickerImage SourceUrl="{x:Bind StickerUrl}" />
        </DataTemplate>

        <DataTemplate x:Key="FileAttachmentTemplate" x:DataType="vm:MessageAttachmentItemViewModel">
            <Border Margin="0,0,0,4"
                    Padding="8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Margin="0,0,8,0" FontSize="18" Glyph="&#xE8A5;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind SizeLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Лента и профиль используют общую карточку и один проигрыватель голосовых сообщений. -->
        <DataTemplate x:Key="VoiceAttachmentTemplate" x:DataType="vm:MessageAttachmentItemViewModel">
            <Border Margin="0,0,0,4"
                    Padding="8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            AutomationProperties.Name="{StaticResource Messenger_VoicePlayStop}"
                            Click="OnVoicePlaybackClick"
                            Content="{x:Bind VoicePlaybackSymbol, Mode=OneWay}"
                            Tag="{x:Bind}" />
                    <StackPanel Grid.Column="1" MinWidth="120" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind VoiceTime, Mode=OneWay}" />
                        <ProgressBar Value="{x:Bind VoiceProgress, Mode=OneWay}"
                                     AutomationProperties.Name="{StaticResource Messenger_VoiceProgress}" />
                        <TextBlock Text="{x:Bind VoiceError, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind VoiceError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <local:MessageFileTemplateSelector x:Key="MessageFileTemplateSelector"
                                           FileTemplate="{StaticResource FileAttachmentTemplate}"
                                           VoiceTemplate="{StaticResource VoiceAttachmentTemplate}" />

        <!--
            Пузырь лежит прямо в шаблоне, а не в UserControl: x:Bind внутри UserControl смотрит
            на сам контрол, и связь с элементом ленты пришлось бы тянуть через DependencyProperty.
        -->
        <DataTemplate x:Key="MessageBubbleTemplate" x:DataType="vm:MessageItemViewModel">
            <Grid Margin="12,4" HorizontalAlignment="{x:Bind IsMine, Converter={StaticResource MessageAlignmentConverter}}">
                <Border MaxWidth="520"
                        Padding="{x:Bind UseCompactBubblePadding, Mode=OneWay, Converter={StaticResource MessageBubblePaddingConverter}}"
                        Background="{x:Bind local:MessengerPage.MessageBackground(IsMine, IsStickerOnly), Mode=OneWay}"
                        ContextRequested="OnBubbleContextRequested"
                        CornerRadius="12">
                    <!--  Flyout наследует DataContext шаблона, поэтому хак WPF с PlacementTarget не нужен.  -->
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Command="{x:Bind Owner.StartReplyMessageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Text="{StaticResource Messenger_ReplyToMessage}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE97A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Owner.StartForwardMessageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Text="{StaticResource Messenger_Forward}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Owner.CopyMessageTextCommand}"
                                            CommandParameter="{x:Bind}"
                                            Text="{StaticResource Messenger_CopyText}"
                                            Visibility="{x:Bind CanCopyText, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Owner.CopyMessageImageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Text="{StaticResource Messenger_CopyImage}"
                                            Visibility="{x:Bind CanCopyImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEB9F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Owner.TogglePinMessageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Text="{x:Bind PinMenuHeader, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Owner.StartEditMessageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Text="{StaticResource Messenger_Edit}"
                                            Visibility="{x:Bind CanModify, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Owner.RequestDeleteMessageCommand}"
                                            CommandParameter="{x:Bind}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{StaticResource Messenger_Delete}"
                                            Visibility="{x:Bind CanModify, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <Grid>
                        <StackPanel>
                            <!--  Цитата ответа уводит к оригиналу; у удалённого прыгать некуда.  -->
                            <Button Margin="0,0,0,6"
                                    Padding="8,5"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderThickness="0"
                                    Command="{x:Bind Owner.ScrollToOriginalCommand}"
                                    CommandParameter="{x:Bind}"
                                    CornerRadius="6"
                                    Visibility="{x:Bind HasReply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="2"
                                            Margin="0,0,8,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="1" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Bind Reply.SenderName, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12"
                                                   Opacity=".8"
                                                   Text="{x:Bind Reply.Preview, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!--  Пересылок может быть несколько — каждая своим блоком.  -->
                            <ItemsRepeater ItemsSource="{x:Bind Forwards, Mode=OneWay}"
                                           Visibility="{x:Bind HasForwards, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForwardedContentViewModel">
                                        <Border Margin="0,0,0,6"
                                                Padding="8,5"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="2"
                                                        Margin="0,0,8,0"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="1" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{x:Bind AuthorName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12"
                                                               Opacity=".8"
                                                               Text="{x:Bind Preview}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <controls:MarkdownTextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                        TextForeground="{x:Bind UseOwnBubbleText, Mode=OneWay, Converter={StaticResource MessageBubbleTextConverter}}"
                                                        Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ItemsRepeater Width="{x:Bind MediaPanelWidth, Mode=OneWay}"
                                           Margin="0,8,0,0"
                                           ItemTemplate="{StaticResource MediaAttachmentTemplate}"
                                           ItemsSource="{x:Bind MediaAttachments, Mode=OneWay}"
                                           Visibility="{x:Bind HasMedia, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout ItemsStretch="Fill"
                                                       MaximumRowsOrColumns="{x:Bind MediaColumns, Mode=OneWay}"
                                                       MinItemHeight="{x:Bind MediaTileHeight, Mode=OneWay}"
                                                       Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                            <ItemsRepeater Width="{x:Bind Owner.StickerSize, Mode=OneWay}"
                                           HorizontalAlignment="Left"
                                           ItemTemplate="{StaticResource FeedStickerTemplate}"
                                           ItemsSource="{x:Bind StickerAttachments, Mode=OneWay}"
                                           Visibility="{x:Bind HasStickers, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="{x:Bind Owner.StickerSize, Mode=OneWay}"
                                                       MinItemHeight="{x:Bind Owner.StickerSize, Mode=OneWay}"
                                                       MaximumRowsOrColumns="1" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                            <ItemsControl Margin="0,8,0,0"
                                          ItemTemplateSelector="{StaticResource MessageFileTemplateSelector}"
                                          ItemsSource="{x:Bind FileAttachments, Mode=OneWay}"
                                          Visibility="{x:Bind HasFiles, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Visibility="{x:Bind HasMetadataBelowMedia, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,5,6,0"
                                           FontSize="11"
                                           Foreground="{x:Bind UseOwnBubbleText, Mode=OneWay, Converter={StaticResource MessageBubbleTextConverter}}"
                                           Opacity=".7"
                                           Text="{StaticResource Messenger_Edited}"
                                           Visibility="{x:Bind IsEdited, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{x:Bind UseOwnBubbleText, Mode=OneWay, Converter={StaticResource MessageBubbleTextConverter}}"
                                           Opacity=".7"
                                           Text="{x:Bind SentAtLabel}" />
                                <!--  Одна галочка — доставлено, вторая появляется при прочтении.  -->
                                <StackPanel Margin="6,4,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{x:Bind IsMine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <FontIcon FontSize="12"
                                              Foreground="{x:Bind UseOwnBubbleText, Mode=OneWay, Converter={StaticResource MessageBubbleTextConverter}}"
                                              Glyph="&#xE73E;"
                                              ToolTipService.ToolTip="{StaticResource Messenger_Delivered}" />
                                    <FontIcon Margin="-6,0,0,0"
                                              FontSize="12"
                                              Foreground="{x:Bind UseOwnBubbleText, Mode=OneWay, Converter={StaticResource MessageBubbleTextConverter}}"
                                              Glyph="&#xE73E;"
                                              ToolTipService.ToolTip="{StaticResource Messenger_Read}"
                                              Visibility="{x:Bind IsReadBySomeoneElse, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!--  У пузыря из одного медиа метки лежат поверх картинки.  -->
                        <Border Margin="0,0,8,8"
                                Padding="5,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource MessageMediaTimestampBrush}"
                                CornerRadius="6"
                                Visibility="{x:Bind HasOnlyMedia, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource MessageMediaTimestampTextBrush}"
                                       Text="{x:Bind SentAtLabel}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Пока чат не выбран, шапка с индикатором связи скрыта, и обрыв был бы невидим.  -->
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           Opacity=".7"
                           Style="{StaticResource MutedText}"
                           Text="{StaticResource Messenger_Reconnecting}"
                           Visibility="{x:Bind ViewModel.IsChatListReconnectingVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{x:Bind ViewModel.FolderActionError, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.FolderActionError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>

            <TextBox Grid.Row="1" PlaceholderText="{StaticResource Messenger_Search}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,4"
                           Style="{StaticResource MutedText}"
                           Text="{StaticResource Messenger_SearchResults}"
                           Visibility="{x:Bind ViewModel.IsSearchResultsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListView Grid.Row="1"
                          MaxHeight="220"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          IsItemClickEnabled="True"
                          ItemClick="OnSearchResultItemClick"
                          ItemTemplate="{StaticResource UserSearchResultTemplate}"
                          ItemsSource="{x:Bind ViewModel.SearchResults}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          Visibility="{x:Bind ViewModel.IsSearchResultsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Свойства списка заданы прямо на контроле: WinUI не публикует базовый стиль ListView.  -->
                <ListView Grid.Row="2"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          ContextRequested="OnChatListContextRequested"
                          ItemTemplate="{StaticResource ChatListItemTemplate}"
                          ItemsSource="{x:Bind ViewModel.VisibleChats}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItem="{x:Bind ViewModel.SelectedChat, Mode=TwoWay}">
                </ListView>

                <ProgressRing Grid.RowSpan="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              IsActive="True"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="0,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="12,12,12,8"
                  Visibility="{x:Bind ViewModel.HasSelectedChat, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Заголовок ведёт на профиль собеседника; borderless Button даёт фокус и клавиатуру даром.  -->
                <Button Padding="8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.OpenPeerProfileCommand}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.SelectedChat.Title, Mode=OneWay}" />
                        <TextBlock Opacity=".7"
                                   Style="{StaticResource MutedText}"
                                   Text="{x:Bind ViewModel.SelectedChat.PresenceLabel, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsPresenceLabelVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Opacity=".7"
                                   Style="{StaticResource MutedText}"
                                   Text="{x:Bind ViewModel.TypingLabel, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsTypingLabelVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Opacity=".7"
                                   Style="{StaticResource MutedText}"
                                   Text="{x:Bind ViewModel.SelectedChat.RestrictionMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.SelectedChat.IsRestricted, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!--  Пока связь восстанавливается, статус собеседника устарел и показывать его нельзя.  -->
                        <TextBlock Opacity=".7"
                                   Style="{StaticResource MutedText}"
                                   Text="{StaticResource Messenger_Reconnecting}"
                                   Visibility="{x:Bind ViewModel.IsChatHeaderReconnectingVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{StaticResource Messenger_ChatOptions}"
                        ToolTipService.ToolTip="{StaticResource Messenger_ChatOptions}">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.SelectedChat.MuteMenuHeader, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleChatMuteCommand}"
                                            CommandParameter="{x:Bind ViewModel.SelectedChat, Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--  Плашка закрепа: клик уводит к закрепу и перелистывает на следующий, крестик открепляет.  -->
            <Border Grid.Row="1"
                    Margin="12,0,12,8"
                    Padding="10,6"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasPinnedMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="2"
                            Margin="0,0,8,0"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1" />
                    <TextBlock Grid.Column="1"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.PinnedPreview.Counter, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.PinnedPreview.HasCounter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Grid.Column="2"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.CyclePinnedMessageCommand}">
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind ViewModel.PinnedPreview.Author, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12"
                                       Opacity=".8"
                                       Text="{x:Bind ViewModel.PinnedPreview.Preview, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            Command="{x:Bind ViewModel.UnpinFromBarCommand}"
                            ToolTipService.ToolTip="{StaticResource Messenger_Unpin}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer x:Name="FeedScroller"
                          Grid.Row="2"
                          AllowDrop="True"
                          DragOver="OnAttachmentDragOver"
                          DragLeave="OnAttachmentDragLeave"
                          Drop="OnAttachmentDrop"
                          HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnFeedScrollerSizeChanged"
                          VerticalAnchorRatio="0.01"
                          VerticalScrollBarVisibility="Auto">
                <!--
                    ScrollViewer и ItemsRepeater сохраняют положение ближайшего контейнера
                    при изменении коллекции и размеров строк. Ненулевой якорь у верхней
                    кромки позволяет удерживать контейнер даже при вставке в позиции 0.
                -->
                <!--
                    Контент не ниже вьюпорта: только тогда у VerticalAlignment появляется запас
                    и короткая переписка прижимается к нижней кромке, как в WPF-версии.
                    ScrollViewer меряет ребёнка бесконечной высотой, поэтому MinHeight
                    выставляется из code-behind по фактическому размеру вьюпорта.
                -->
                <Grid x:Name="FeedHost" Background="Transparent">
                    <StackPanel VerticalAlignment="Bottom">
                        <ItemsRepeater x:Name="MessageFeed"
                                       VerticalAlignment="Bottom"
                                       ItemTemplate="{StaticResource MessageBubbleTemplate}"
                                       ItemsSource="{x:Bind ViewModel.Messages}"
                                       behaviors:MessageFeedBehavior.FeedPositionCommand="{x:Bind ViewModel.FeedPositionChangedCommand}"
                                       behaviors:MessageFeedBehavior.HistoryUpdating="{x:Bind ViewModel.IsHistoryUpdating, Mode=OneWay}"
                                       behaviors:MessageFeedBehavior.OlderHistoryCommand="{x:Bind ViewModel.LoadOlderHistoryCommand}"
                                       behaviors:MessageFeedBehavior.NewerHistoryCommand="{x:Bind ViewModel.LoadNewerHistoryCommand}"
                                       behaviors:MessageFeedBehavior.ScrollRequest="{x:Bind ViewModel.ScrollRequest, Mode=OneWay}"
                                       behaviors:MessageFeedBehavior.Scroller="{x:Bind FeedScroller}"
                                       behaviors:MessageFeedBehavior.VisibleMessageCommand="{x:Bind ViewModel.MessageBecameVisibleCommand}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PendingMessages}"
                                       Visibility="{x:Bind ViewModel.IsOutgoingTailVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutgoingBubbleViewModel">
                                    <Border HorizontalAlignment="Right" Margin="12,3" Padding="12,8"
                                            MaxWidth="480" CornerRadius="12"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                       Visibility="{x:Bind Text, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap"
                                                       Visibility="{x:Bind Details, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Maximum="100" Value="{x:Bind Progress, Mode=OneWay}"
                                                         Visibility="{x:Bind IsUploading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{StaticResource Messenger_OutboxRetry}" Command="{x:Bind RetryCommand}"
                                                        AutomationProperties.Name="{x:Bind RetryName}"
                                                        Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button Content="{StaticResource Messenger_Cancel}" Command="{x:Bind CancelCommand}"
                                                        AutomationProperties.Name="{x:Bind CancelName}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!--  Заглушка лежит в строке ленты, чтобы центрироваться по всей свободной области.  -->
            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Opacity=".6"
                       Text="{StaticResource Messenger_Empty}"
                       Visibility="{x:Bind ViewModel.IsChatPlaceholderVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Одна панель на два режима: в правке кнопка отправки применяет правку,
                  в ответе — отправляет сообщение со ссылкой на оригинал.  -->
            <Border Grid.Row="3"
                    Margin="12,0,12,0"
                    Padding="10,8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsComposerHintVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{x:Bind ViewModel.ComposerHintTitle, Mode=OneWay}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Opacity=".75"
                                   Text="{x:Bind ViewModel.ComposerHintPreview, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{x:Bind ViewModel.CancelComposerHintCommand}"
                            ToolTipService.ToolTip="{StaticResource Messenger_Cancel}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Margin="12,6,12,0">
                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{x:Bind ViewModel.Voice.Error, Mode=OneWay}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.Voice.Error, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                <HyperlinkButton Content="{StaticResource Messenger_VoiceMicSettings}"
                                 NavigateUri="ms-settings:privacy-microphone"
                                 Visibility="{x:Bind ViewModel.Voice.ShowMicrophoneSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.Voice.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{StaticResource Messenger_VoiceRecording}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Voice.Elapsed, Mode=OneWay}" VerticalAlignment="Center" />
                    <Button Content="{StaticResource Messenger_VoiceFinish}" Command="{x:Bind ViewModel.StopVoiceRecordingCommand}"
                            IsEnabled="{x:Bind ViewModel.Voice.IsRecording, Mode=OneWay}" />
                    <Button Content="{StaticResource Messenger_Cancel}" Command="{x:Bind ViewModel.CancelVoiceRecordingCommand}" />
                </StackPanel>
                <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ShowOutgoingTailCommand}"
                        Visibility="{x:Bind ViewModel.OutgoingHistoryNotice, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.OutgoingHistoryNotice, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Button>
                <StackPanel Visibility="{x:Bind ViewModel.CanAttach, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind ViewModel.AttachmentComposer.Error, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.AttachmentComposer.Error, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind ViewModel.AttachmentComposer.HasFiles, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AttachmentComposer.Files, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PendingAttachment">
                                    <Border Width="238" Padding="8" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Width="44" Height="44" Stretch="UniformToFill" Loaded="OnAttachmentThumbnailLoaded"
                                                       Visibility="{x:Bind HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind Name}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" Style="{StaticResource MutedText}" />
                                                        <TextBlock Text="{x:Bind SizeLabel}" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="6" Command="{x:Bind RemoveCommand}"
                                                        IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                                        AutomationProperties.Name="{StaticResource Messenger_AttachmentRemove}"
                                                        ToolTipService.ToolTip="{StaticResource Messenger_AttachmentRemove}">
                                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>
                                            <CheckBox Content="{StaticResource Messenger_AttachmentAsFile}"
                                                      IsChecked="{x:Bind AsDocument, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind CanChangeType, Mode=OneWay}"
                                                      Visibility="{x:Bind SupportsAsDocument, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <TextBlock Text="{StaticResource Messenger_AttachmentPrivate}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasPrivateAttachmentRestriction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.ActionError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasHistoryError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock VerticalAlignment="Center" Text="{StaticResource Messenger_HistoryLoadFailed}" />
                    <Button Command="{x:Bind ViewModel.RetryHistoryCommand}"
                            Content="{StaticResource Messenger_HistoryRetry}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="5"
                  Margin="12,8,12,0"
                  Background="Transparent"
                  AllowDrop="True"
                  DragOver="OnAttachmentDragOver"
                  DragLeave="OnAttachmentDragLeave"
                  Drop="OnAttachmentDrop"
                  Visibility="{x:Bind ViewModel.HasSelectedChat, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Margin="0,0,8,0" VerticalAlignment="Bottom"
                            Click="OnAttachClick"
                            IsEnabled="{x:Bind CanBeginAttachmentInput(ViewModel.CanAddAttachments, ViewModel.AttachmentComposer.IsSending), Mode=OneWay}"
                            AutomationProperties.Name="{StaticResource Messenger_AttachmentAdd}"
                            ToolTipService.ToolTip="{StaticResource Messenger_AttachmentAdd}">
                        <FontIcon Glyph="&#xE723;" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            IsEnabled="{x:Bind CanPickSticker(ViewModel.CanAddAttachments, ViewModel.AttachmentComposer.IsSending, ViewModel.StickerPicker.IsSending), Mode=OneWay}"
                            AutomationProperties.Name="{StaticResource Messenger_Stickers}"
                            ToolTipService.ToolTip="{StaticResource Messenger_Stickers}">
                        <FontIcon Glyph="&#xE899;" />
                        <Button.Flyout>
                            <Flyout x:Name="StickerFlyout" Placement="Top"
                                    Opened="OnStickerFlyoutOpened" Closed="OnStickerFlyoutClosed">
                                <Grid Width="320" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="220" />
                                    </Grid.RowDefinitions>
                                    <ListView MaxWidth="320"
                                              AutomationProperties.Name="{StaticResource Messenger_Stickers}"
                                              ItemsSource="{x:Bind ViewModel.StickerPicker.Tabs, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.StickerPicker.SelectedTab, Mode=TwoWay}"
                                              ScrollViewer.HorizontalScrollMode="Enabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StickerTab">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Loaded="OnStickerCoverLoaded">
                                                    <controls:StickerImage Width="24" Height="24" SourceUrl="{x:Bind CoverUrl, Mode=OneWay}"
                                                        Visibility="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBox Grid.Row="1"
                                             PlaceholderText="{StaticResource Messenger_StickerSearch}"
                                             AutomationProperties.Name="{StaticResource Messenger_StickerSearch}"
                                             Text="{x:Bind ViewModel.StickerPicker.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <GridView Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None"
                                              ItemClick="OnStickerClick"
                                              AutomationProperties.Name="{StaticResource Messenger_Stickers}"
                                              ItemsSource="{x:Bind ViewModel.StickerPicker.Stickers, Mode=OneWay}">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Emoji}" />
                                                <Setter Property="ToolTipService.ToolTip" Value="{Binding Emoji}" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PickerSticker">
                                                <controls:StickerImage Width="64" Height="64"
                                                                       SourceUrl="{x:Bind PreviewUrl}" />
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                    <ProgressRing Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsActive="{x:Bind ViewModel.StickerPicker.IsLoading, Mode=OneWay}" />
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{StaticResource Messenger_StickerEmpty}"
                                               Visibility="{x:Bind ViewModel.StickerPicker.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                                Visibility="{x:Bind ViewModel.StickerPicker.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{StaticResource Messenger_StickerError}" />
                                        <Button Content="{StaticResource Messenger_AttachmentRetry}" Click="OnStickerRetryClick" />
                                    </StackPanel>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBox Grid.Column="1" MinHeight="42"
                         MaxHeight="120"
                         AcceptsReturn="True"
                         Paste="OnComposerPaste"
                         IsEnabled="{x:Bind ViewModel.CanEditComposerText, Mode=OneWay}"
                         Text="{x:Bind ViewModel.DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         behaviors:SendOnEnterBehavior.Command="{x:Bind ViewModel.SendCommand}" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SendCommand}"
                        Visibility="{x:Bind ViewModel.ShowComposerSend, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsEnabled="{x:Bind ViewModel.SelectedChat.CanSend, Mode=OneWay}"
                        Content="{StaticResource Messenger_Send}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RecordVoiceCommand}"
                        Visibility="{x:Bind ViewModel.ShowVoiceMicrophone, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="{StaticResource Messenger_VoiceRecord}"
                        ToolTipService.ToolTip="{StaticResource Messenger_VoiceRecord}"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon Glyph="&#xE720;" />
                </Button>
            </Grid>
            <Border x:Name="AttachmentDropHighlight" Grid.Row="2" Grid.RowSpan="4"
                    IsHitTestVisible="False" Visibility="Collapsed" BorderThickness="2" CornerRadius="8"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>

        <!--
            Пересылка, подтверждение удаления и разблокировка приватного чата остаются оверлеями,
            а не ContentDialog: вьюмодель уже управляет ими флагами и командами отмены, и перевод
            на диалоги потребовал бы абстракции диалогов в Core ради того же поведения.
        -->
        <Grid Grid.ColumnSpan="2"
              Background="{StaticResource MessengerModalScrimBrush}"
              Canvas.ZIndex="12"
              Visibility="{x:Bind ViewModel.IsForwardVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{StaticResource Messenger_ForwardTitle}" />
                    <ScrollViewer Margin="0,12,0,0" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ForwardTargets}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ForwardTargetViewModel">
                                    <Button Margin="0,0,0,4"
                                            Padding="8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderThickness="0"
                                            Command="{x:Bind Owner.ToggleForwardTargetCommand}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture Width="32"
                                                           Height="32"
                                                           Margin="0,0,10,0"
                                                           DisplayName="{x:Bind Title}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{x:Bind Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="2"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Glyph="&#xE73E;"
                                                      Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBox Margin="0,12,0,0"
                             PlaceholderText="{StaticResource Messenger_ForwardComment}"
                             Text="{x:Bind ViewModel.ForwardComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Opacity=".75"
                               Text="{x:Bind ViewModel.ForwardSelectionSummary, Mode=OneWay}" />
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Command="{x:Bind ViewModel.SubmitForwardCommand}"
                                Content="{StaticResource Messenger_ForwardSend}"
                                IsEnabled="{x:Bind ViewModel.CanSubmitForward, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.CancelForwardCommand}"
                                Content="{StaticResource Messenger_Cancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Background="{StaticResource MessengerModalScrimBrush}"
              Canvas.ZIndex="11"
              Visibility="{x:Bind ViewModel.IsDeleteConfirmVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{StaticResource Messenger_DeleteConfirmTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               Opacity=".75"
                               Text="{StaticResource Messenger_DeleteConfirmText}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Command="{x:Bind ViewModel.ConfirmDeleteMessageCommand}"
                                Content="{StaticResource Messenger_Delete}"
                                Style="{StaticResource DangerButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.CancelDeleteMessageCommand}"
                                Content="{StaticResource Messenger_Cancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Background="{StaticResource MessengerModalScrimBrush}"
              Canvas.ZIndex="10"
              Visibility="{x:Bind ViewModel.IsPrivateUnlockVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{StaticResource Messenger_PrivateUnlockTitle}" />
                    <TextBlock Margin="0,8,0,16"
                               Opacity=".75"
                               Text="{StaticResource Messenger_PrivateUnlockHint}"
                               TextWrapping="Wrap" />
                    <PasswordBox Password="{x:Bind ViewModel.PrivatePassphrase, Mode=TwoWay}"
                                 PasswordRevealMode="Peek"
                                 PlaceholderText="{StaticResource Messenger_PrivatePassphrase}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind ViewModel.PrivateUnlockError, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.PrivateUnlockError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Command="{x:Bind ViewModel.UnlockPrivateChatCommand}"
                                Content="{StaticResource Messenger_PrivateUnlock}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.CancelPrivateUnlockCommand}"
                                Content="{StaticResource Messenger_PrivateCancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Профиль — оверлей, а не отдельная страница (Frame): у него нет своего шага навигации,
            открывается из шапки чата и нав-панели, закрывается тем же CloseProfileCommand.
        -->
        <Grid Grid.ColumnSpan="2"
              Background="{StaticResource MessengerModalScrimBrush}"
              Canvas.ZIndex="13"
              Visibility="{x:Bind ViewModel.IsProfileVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Style="{StaticResource OnboardingCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="6"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.CloseProfileCommand}"
                            ToolTipService.ToolTip="{StaticResource Profile_Close}">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ProgressRing Margin="0,0,0,12"
                                          HorizontalAlignment="Left"
                                          IsActive="True"
                                          Visibility="{x:Bind ViewModel.Profile.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Margin="0,0,0,12"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Text="{x:Bind ViewModel.Profile.ErrorMessage, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Profile.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                            <PersonPicture Width="96"
                                           Height="96"
                                           HorizontalAlignment="Left"
                                           DisplayName="{x:Bind ViewModel.Profile.DisplayName, Mode=OneWay}"
                                           ProfilePicture="{x:Bind ViewModel.Profile.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                            <TextBlock Margin="0,18,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind ViewModel.Profile.DisplayName, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="{x:Bind ViewModel.Profile.Username, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Profile.Username, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="{x:Bind ViewModel.Profile.PresenceLabel, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Profile.PresenceLabel, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                            <!--  Почту сервер отдаёт только для собственного профиля — пустая строка прячет блок целиком.  -->
                            <StackPanel Margin="0,20,0,0" Visibility="{x:Bind ViewModel.Profile.Email, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Profile_Email}" />
                                <TextBlock Margin="0,4,0,0" Text="{x:Bind ViewModel.Profile.Email, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0" Visibility="{x:Bind ViewModel.Profile.Description, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Profile_About}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{x:Bind ViewModel.Profile.Description, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0" Visibility="{x:Bind ViewModel.Profile.RegisteredAtLabel, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{StaticResource Profile_RegisteredAt}" />
                                <TextBlock Margin="0,4,0,0" Text="{x:Bind ViewModel.Profile.RegisteredAtLabel, Mode=OneWay}" />
                            </StackPanel>

                            <!--  Вложения из переписки с этим пользователем (в т.ч. чат с самим собой); чата ещё нет — секции нет вовсе.  -->
                            <StackPanel Margin="0,24,0,0" Visibility="{x:Bind ViewModel.Profile.HasAttachments, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!--
                                    RadioButton, не ToggleButton: эксклюзивность держит сам контрол через
                                    GroupName, а не пересчёт IsChecked конвертером на каждую смену индекса
                                    (TwoWay+ConvertBack(UnsetValue) на ToggleButton ненадёжно взаимодействовал
                                    бы с автоматическим снятием отметки у соседей). Запись индекса — через
                                    Checked в code-behind, чтение — OneWay через конвертер.
                                -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton Content="{StaticResource Profile_TabPhotos}"
                                                 Checked="OnProfileAttachmentTabChecked"
                                                 GroupName="ProfileAttachmentTabs"
                                                 IsChecked="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=0}"
                                                 Tag="0" />
                                    <RadioButton Content="{StaticResource Profile_TabVideos}"
                                                 Checked="OnProfileAttachmentTabChecked"
                                                 GroupName="ProfileAttachmentTabs"
                                                 IsChecked="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=1}"
                                                 Tag="1" />
                                    <RadioButton Content="{StaticResource Profile_TabFiles}"
                                                 Checked="OnProfileAttachmentTabChecked"
                                                 GroupName="ProfileAttachmentTabs"
                                                 IsChecked="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=2}"
                                                 Tag="2" />
                                    <RadioButton Content="{StaticResource Profile_TabVoice}"
                                                 Checked="OnProfileAttachmentTabChecked"
                                                 GroupName="ProfileAttachmentTabs"
                                                 IsChecked="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToBoolConverter}, ConverterParameter=3}"
                                                 Tag="3" />
                                </StackPanel>

                                <!--  Фото  -->
                                <StackPanel Margin="0,12,0,0" Visibility="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                                    <ItemsRepeater ItemTemplate="{StaticResource MediaAttachmentTemplate}" ItemsSource="{x:Bind ViewModel.Profile.PhotosTab.Items}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout ItemsStretch="Fill"
                                                               MaximumRowsOrColumns="3"
                                                               MinItemHeight="110"
                                                               Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MutedText}"
                                               Text="{StaticResource Profile_AttachmentsEmpty}"
                                               Visibility="{x:Bind ViewModel.Profile.PhotosTab.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ProgressRing Margin="0,8,0,0"
                                                  HorizontalAlignment="Left"
                                                  IsActive="True"
                                                  Visibility="{x:Bind ViewModel.Profile.PhotosTab.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Margin="0,8,0,0"
                                            Command="{x:Bind ViewModel.Profile.PhotosTab.LoadMoreCommand}"
                                            Content="{StaticResource Profile_LoadMore}"
                                            Visibility="{x:Bind ViewModel.Profile.PhotosTab.HasMore, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <!--  Видео  -->
                                <StackPanel Margin="0,12,0,0" Visibility="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                                    <ItemsRepeater ItemTemplate="{StaticResource MediaAttachmentTemplate}" ItemsSource="{x:Bind ViewModel.Profile.VideosTab.Items}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout ItemsStretch="Fill"
                                                               MaximumRowsOrColumns="3"
                                                               MinItemHeight="110"
                                                               Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MutedText}"
                                               Text="{StaticResource Profile_AttachmentsEmpty}"
                                               Visibility="{x:Bind ViewModel.Profile.VideosTab.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ProgressRing Margin="0,8,0,0"
                                                  HorizontalAlignment="Left"
                                                  IsActive="True"
                                                  Visibility="{x:Bind ViewModel.Profile.VideosTab.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Margin="0,8,0,0"
                                            Command="{x:Bind ViewModel.Profile.VideosTab.LoadMoreCommand}"
                                            Content="{StaticResource Profile_LoadMore}"
                                            Visibility="{x:Bind ViewModel.Profile.VideosTab.HasMore, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <!--  Файлы  -->
                                <StackPanel Margin="0,12,0,0" Visibility="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                                    <ItemsRepeater ItemTemplate="{StaticResource FileAttachmentTemplate}" ItemsSource="{x:Bind ViewModel.Profile.FilesTab.Items}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MutedText}"
                                               Text="{StaticResource Profile_AttachmentsEmpty}"
                                               Visibility="{x:Bind ViewModel.Profile.FilesTab.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ProgressRing Margin="0,8,0,0"
                                                  HorizontalAlignment="Left"
                                                  IsActive="True"
                                                  Visibility="{x:Bind ViewModel.Profile.FilesTab.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Margin="0,8,0,0"
                                            Command="{x:Bind ViewModel.Profile.FilesTab.LoadMoreCommand}"
                                            Content="{StaticResource Profile_LoadMore}"
                                            Visibility="{x:Bind ViewModel.Profile.FilesTab.HasMore, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <!--  Голосовые  -->
                                <StackPanel Margin="0,12,0,0" Visibility="{x:Bind ViewModel.Profile.SelectedAttachmentTabIndex, Mode=OneWay, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                                    <ItemsRepeater ItemTemplate="{StaticResource VoiceAttachmentTemplate}" ItemsSource="{x:Bind ViewModel.Profile.VoiceTab.Items}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource MutedText}"
                                               Text="{StaticResource Profile_AttachmentsEmpty}"
                                               Visibility="{x:Bind ViewModel.Profile.VoiceTab.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ProgressRing Margin="0,8,0,0"
                                                  HorizontalAlignment="Left"
                                                  IsActive="True"
                                                  Visibility="{x:Bind ViewModel.Profile.VoiceTab.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Margin="0,8,0,0"
                                            Command="{x:Bind ViewModel.Profile.VoiceTab.LoadMoreCommand}"
                                            Content="{StaticResource Profile_LoadMore}"
                                            Visibility="{x:Bind ViewModel.Profile.VoiceTab.HasMore, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
