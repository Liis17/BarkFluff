<Page
    x:Class="BarkFluff.Client.WinUI.Views.SelectNodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BarkFluff.Client.Core.Models">
    <Grid Margin="40,24,40,40">
        <Border Width="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource OnboardingCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource OnboardingTitle}" Text="{StaticResource SelectNode_Title}" />
                <TextBlock Grid.Row="1"
                           Margin="0,10,0,20"
                           Style="{StaticResource OnboardingDescription}"
                           Text="{StaticResource SelectNode_Subtitle}" />

                <TextBlock Grid.Row="2"
                           Style="{StaticResource SectionTitle}"
                           Text="{StaticResource SelectNode_PublicNodes}" />
                <Grid Grid.Row="3" Margin="0,10,0,16">
                    <!--  Пять свойств заданы прямо на контроле: WinUI не публикует базовый стиль ListView.  -->
                    <ListView MinHeight="104"
                              MaxHeight="154"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{x:Bind ViewModel.PublicNodes}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItem="{x:Bind ViewModel.SelectedPublicNode, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PublicNode">
                                <Border Style="{StaticResource NodeItemCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedText}"
                                                       Text="{x:Bind Description}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedText}"
                                                       Text="{x:Bind Address}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Width="8"
                                                Height="8"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="True"
                                  Visibility="{x:Bind ViewModel.IsLoadingPublicNodes, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <StackPanel Grid.Row="4">
                    <Button Command="{x:Bind ViewModel.ConnectSelectedNodeCommand}"
                            Content="{StaticResource SelectNode_ConnectSelected}"
                            Style="{StaticResource SecondaryButton}" />
                    <TextBlock Margin="0,20,0,8"
                               Style="{StaticResource SectionTitle}"
                               Text="{StaticResource SelectNode_ManualNode}" />
                    <Border Padding="14"
                            Background="{StaticResource OnboardingSubtleSurfaceBrush}"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBox PlaceholderText="{StaticResource SelectNode_AddressPlaceholder}"
                                     Text="{x:Bind ViewModel.ManualAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="{StaticResource SelectNode_ManualHint}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,16,0,0" Orientation="Horizontal">
                    <Button Command="{x:Bind ViewModel.ConnectManualCommand}"
                            Content="{StaticResource Common_Connect}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing Width="22"
                                  Height="22"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  IsActive="True"
                                  Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
