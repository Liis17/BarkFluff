<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BarkFluff.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="{StaticResource App_Title}" />

        <!--
            LeftMinimal — единственный режим NavigationView, который даёт ровно кнопку-бургер
            сверху слева и панель поверх контента. Панель прячется целиком, пока пользователь
            не вошёл: на онбординге и логине идти из неё некуда.
        -->
        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        BackRequested="OnBackRequested"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="False"
                        IsPaneVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="OnNavigationItemInvoked"
                        PaneDisplayMode="LeftMinimal">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{StaticResource Nav_Profile}" Tag="profile">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{StaticResource Settings_Title}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnContentFrameNavigated" />
        </NavigationView>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ContextMenuMode="PopupMenu"
                        IconSource="ms-appx:///Resources/Icons/barkfluff.ico"
                        ToolTipText="{StaticResource App_Title}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="OnTrayShowRequested" Text="{StaticResource Tray_Open}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnTrayExitRequested" Text="{StaticResource Tray_Exit}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
