<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BarkFluff.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="{StaticResource App_Title}">
            <TitleBar.RightHeader>
                <Button Background="Transparent"
                        BorderThickness="0"
                        Click="OnSettingsRequested"
                        ToolTipService.ToolTip="{StaticResource Settings_Title}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Frame x:Name="ContentFrame" Grid.Row="1" />

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ContextMenuMode="PopupMenu"
                        IconSource="ms-appx:///Resources/Icons/barkfluff.ico"
                        ToolTipText="{StaticResource App_Title}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="OnTrayShowRequested" Text="{StaticResource Tray_Open}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnTrayExitRequested" Text="{StaticResource Tray_Exit}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
