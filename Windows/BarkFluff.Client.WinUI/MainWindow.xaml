<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BarkFluff.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="{StaticResource App_Title}"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="False"
                  IsPaneToggleButtonVisible="False"
                  BackRequested="OnTitleBarBackRequested"
                  PaneToggleRequested="OnTitleBarPaneToggleRequested" />

        <!--
            LeftMinimal — единственный режим NavigationView, который даёт ровно кнопку-бургер
            сверху слева и панель поверх контента. Панель прячется целиком, пока пользователь
            не вошёл: на онбординге и логине идти из неё некуда.
        -->
        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsBackEnabled="False"
                        IsPaneToggleButtonVisible="False"
                        IsPaneVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="OnNavigationItemInvoked"
                        PaneDisplayMode="LeftMinimal">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{StaticResource Nav_Profile}" Tag="profile">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{StaticResource Settings_Title}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnContentFrameNavigated" />
        </NavigationView>

        <Border x:Name="CallPanel" Grid.Row="2" Visibility="Collapsed" Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <Grid x:Name="CallMediaHost" Height="1" Visibility="Collapsed" />
                <TextBlock x:Name="CallPeer" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="CallStatus" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="CallDuration" />
                </StackPanel>
                <VariableSizedWrapGrid x:Name="CallControls" Orientation="Horizontal">
                    <ToggleButton x:Name="CallMute" Margin="0,0,8,4" Click="OnCallMute" />
                    <ComboBox x:Name="CallMicrophone" Margin="0,0,8,4" PlaceholderText="{StaticResource Calls_Microphone}"
                              AutomationProperties.Name="{StaticResource Calls_Microphone}" MaxWidth="220"
                              DisplayMemberPath="Label" SelectionChanged="OnCallDeviceChanged" />
                    <ToggleButton x:Name="CallCameraToggle" Margin="0,0,8,4" Click="OnCallCamera" />
                    <ComboBox x:Name="CallCamera" Margin="0,0,8,4" PlaceholderText="{StaticResource Calls_Camera}"
                              AutomationProperties.Name="{StaticResource Calls_Camera}" MaxWidth="220"
                              DisplayMemberPath="Label" SelectionChanged="OnCallDeviceChanged" />
                    <ComboBox x:Name="CallSpeaker" Margin="0,0,8,4" PlaceholderText="{StaticResource Calls_Speaker}"
                              AutomationProperties.Name="{StaticResource Calls_Speaker}" MaxWidth="220"
                              DisplayMemberPath="Label" SelectionChanged="OnCallDeviceChanged" />
                    <ComboBox x:Name="CallAudioQuality" Margin="0,0,8,4" Header="{StaticResource Calls_AudioQuality}"
                              AutomationProperties.Name="{StaticResource Calls_AudioQuality}" SelectionChanged="OnCallQualityChanged">
                        <ComboBoxItem Content="{StaticResource Calls_QualityAuto}" />
                        <ComboBoxItem Content="{StaticResource Calls_QualityLow}" />
                        <ComboBoxItem Content="{StaticResource Calls_QualityMedium}" />
                        <ComboBoxItem Content="{StaticResource Calls_QualityHigh}" />
                    </ComboBox>
                    <ComboBox x:Name="CallVideoQuality" Margin="0,0,8,4" Header="{StaticResource Calls_VideoQuality}"
                              AutomationProperties.Name="{StaticResource Calls_VideoQuality}" SelectionChanged="OnCallQualityChanged">
                        <ComboBoxItem Content="{StaticResource Calls_QualityAuto}" />
                        <ComboBoxItem Content="{StaticResource Calls_QualityLow}" />
                        <ComboBoxItem Content="{StaticResource Calls_QualityMedium}" />
                        <ComboBoxItem Content="{StaticResource Calls_QualityHigh}" />
                    </ComboBox>
                </VariableSizedWrapGrid>
                <TextBlock x:Name="CallParticipants" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="CallNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CallAccept" Content="{StaticResource Calls_Accept}" Click="OnCallAccept" />
                    <Button x:Name="CallEnd" Click="OnCallEnd" />
                    <Button x:Name="CallDismiss" Content="{StaticResource Calls_Dismiss}" Click="OnCallDismiss" />
                </StackPanel>
            </StackPanel>
        </Border>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ContextMenuMode="PopupMenu"
                        IconSource="ms-appx:///Resources/Icons/barkfluff.ico"
                        ToolTipText="{StaticResource App_Title}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="OnTrayShowRequested" Text="{StaticResource Tray_Open}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnTrayExitRequested" Text="{StaticResource Tray_Exit}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
