<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Кисти-синглтоны: ApplicationThemeService переписывает им Color при смене темы.
        Значения здесь — стартовые, из светлой палитры.
    -->
    <SolidColorBrush x:Key="OnboardingWindowBackgroundBrush" Color="#FFF6F7FB" />
    <SolidColorBrush x:Key="OnboardingAccentSurfaceBrush" Color="#E6F1FF" />
    <SolidColorBrush x:Key="OnboardingSubtleSurfaceBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="MessengerModalScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="MessageMediaTimestampBrush" Color="#99000000" />
    <SolidColorBrush x:Key="MessageMediaTimestampTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ChatUnreadBadgeTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MessageOwnBubbleBrush" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="MessageOwnBubbleTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MessageOtherBubbleBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MessageOtherBubbleTextBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="PresenceOnlineBrush" Color="#FF3FBF5F" />
</ResourceDictionary>
