<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:BarkFluff.Client.WinUI.Infrastructure.Converters">
    <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />

    <Style x:Key="OnboardingCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="36" />
    </Style>

    <Style x:Key="OnboardingTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OnboardingDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!--  Опасное действие: WinUI не даёт готового «danger»-стиля, красим по SystemFillColorCritical.  -->
    <Style x:Key="DangerButton"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!--
        Стиля NodeList здесь нет: WinUI не публикует базовый DefaultListViewStyle, а Style
        без BasedOn затёр бы ControlTemplate. Пять свойств списка задаются прямо на ListView.
    -->
    <Style x:Key="NodeItemCard" TargetType="Border" BasedOn="{StaticResource OnboardingCard}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OnboardingAccentSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
</ResourceDictionary>
