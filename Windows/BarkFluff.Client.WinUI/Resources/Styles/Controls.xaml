<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:BarkFluff.Client.WinUI.Infrastructure.Converters">
    <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />

    <!--
        Замена DataTrigger по IsMine и HasOnlyMedia. Кисти берутся синглтонами из Brushes.xaml,
        а не через ThemeResource: конвертер — не DependencyObject, тему он бы не отследил,
        а у синглтонов цвет переписывает ApplicationThemeService.
    -->
    <converters:BoolToHorizontalAlignmentConverter x:Key="MessageAlignmentConverter"
                                                   FalseValue="Left"
                                                   TrueValue="Right" />
    <converters:BoolToBrushConverter x:Key="MessageBubbleBrushConverter"
                                     FalseValue="{StaticResource MessageOtherBubbleBrush}"
                                     TrueValue="{StaticResource MessageOwnBubbleBrush}" />
    <converters:BoolToBrushConverter x:Key="MessageBubbleTextConverter"
                                     FalseValue="{StaticResource MessageOtherBubbleTextBrush}"
                                     TrueValue="{StaticResource MessageOwnBubbleTextBrush}" />
    <converters:BoolToThicknessConverter x:Key="MessageBubblePaddingConverter"
                                         FalseValue="12,8,12,8"
                                         TrueValue="0" />

    <Style x:Key="OnboardingCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="36" />
    </Style>

    <Style x:Key="OnboardingTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OnboardingDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!--  Опасное действие: WinUI не даёт готового «danger»-стиля, красим по SystemFillColorCritical.  -->
    <Style x:Key="DangerButton"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!--
        Стиля NodeList здесь нет: WinUI не публикует базовый DefaultListViewStyle, а Style
        без BasedOn затёр бы ControlTemplate. Пять свойств списка задаются прямо на ListView.
    -->
    <Style x:Key="NodeItemCard" TargetType="Border" BasedOn="{StaticResource OnboardingCard}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OnboardingAccentSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!--
        Группа настроек: карточка без собственных отступов, потому что каждая SettingsRow
        приносит свои. Padding 4 не даёт строкам упереться в скруглённые углы карточки.
    -->
    <Style x:Key="SettingsGroupCard" TargetType="Border" BasedOn="{StaticResource OnboardingCard}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

    <!--
        Кликабельная строка настроек: кнопка во всю ширину без собственного фона и рамки,
        внутри неё лежит SettingsRow. BasedOn обязателен — без него WinUI затирает ControlTemplate,
        а вместе с ним и состояния наведения, нажатия и фокуса.
    -->
    <Style x:Key="SettingsRowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SettingsHeroCard" TargetType="Border" BasedOn="{StaticResource OnboardingCard}">
        <Setter Property="Background" Value="{StaticResource OnboardingAccentSurfaceBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
</ResourceDictionary>
