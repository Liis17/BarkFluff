<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.PasswordReset"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="2720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource BackgroundWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="28"
                Height="28"
                Source="/Resources/Images/barkfluff_logo.png" />
            <ui:TextBlock
                Margin="12,0,0,0"
                Style="{DynamicResource LittleTitleTextStyle}"
                Text="BarkFluff" />
        </StackPanel>

        <!--  Main Content  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{DynamicResource TitleTextStyle}"
                        Text="Восстановление пароля" />

                    <TextBlock
                        Margin="0,0,0,15"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="Следуйте инструкциям для сброса пароля" />

                    <!--  Progress Indicator  -->
                    <StackPanel
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Border x:Name="Step1Indicator" Style="{StaticResource StepCircle}">
                                <TextBlock
                                    x:Name="Step1IndicatorText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StepCircleForeground}"
                                    Text="1" />
                            </Border>
                            <Border
                                x:Name="StepLine1"
                                Width="30"
                                Height="2"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SeparatorBackground}" />
                            <Border x:Name="Step2Indicator" Style="{StaticResource StepCircleDisable}">
                                <TextBlock
                                    x:Name="Step2IndicatorText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StepCircleDisableForeground}"
                                    Text="2" />
                            </Border>
                            <Border
                                x:Name="StepLine2"
                                Width="30"
                                Height="2"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SeparatorBackground}" />
                            <Border x:Name="Step3Indicator" Style="{StaticResource StepCircleDisable}">
                                <TextBlock
                                    x:Name="Step3IndicatorText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource AdwaitaSans}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StepCircleDisableForeground}"
                                    Text="3" />
                            </Border>
                            <Border
                                x:Name="StepLine3"
                                Width="30"
                                Height="2"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SeparatorBackground}" />
                            <Border x:Name="Step4Indicator" Style="{StaticResource StepCircleDisable}">
                                <ui:SymbolIcon
                                    x:Name="Step4IndicatorText"
                                    Foreground="{DynamicResource StepCircleDisableForeground}"
                                    Symbol="Checkmark12" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 1: Email Input  -->
                    <StackPanel x:Name="Step1Panel" Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="Введите email или имя пользователя" />
                        <ui:TextBox
                            x:Name="EmailTextBox"
                            Margin="0,0,0,10"
                            Style="{DynamicResource InputTextBoxStyle}" />

                        <ui:Button
                            x:Name="SendCodeButton"
                            Click="SendCodeButton_Click"
                            Style="{StaticResource RequiredButton}">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="Отправить код" />
                                    <ui:SymbolIcon Style="{DynamicResource RequiredButtonIconStyle}" Symbol="Mail24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>

                    <!--  Step 2: Verification Code  -->
                    <StackPanel
                        x:Name="Step2Panel"
                        Orientation="Vertical"
                        Visibility="Visible">
                        <TextBlock
                            Margin="0,0,0,10"
                            Style="{DynamicResource TitleTextStyle}"
                            Text="Введите код подтверждения" />

                        <TextBlock
                            Margin="0,0,0,25"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="Мы отправили 6-значный код на ваш email" />

                        <!--  Verification Code Input  -->
                        <StackPanel
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="VerifyBox0"
                                GotFocus="VerifyBox_GotFocus"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource PinCodeTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox1"
                                GotFocus="VerifyBox_GotFocus"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource PinCodeTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox2"
                                GotFocus="VerifyBox_GotFocus"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource PinCodeTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox3"
                                GotFocus="VerifyBox_GotFocus"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource PinCodeTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox4"
                                GotFocus="VerifyBox_GotFocus"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource PinCodeTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                            <TextBox
                                x:Name="VerifyBox5"
                                GotFocus="VerifyBox_GotFocus"
                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                Style="{StaticResource PinCodeTextBox}"
                                TextChanged="VerifyBox_TextChanged" />
                        </StackPanel>

                        <ui:Button
                            x:Name="VerifyCodeButton"
                            Click="VerifyCodeButton_Click"
                            Style="{DynamicResource RequiredButton}">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="Подтвердить код" />
                                    <ui:SymbolIcon
                                        Filled="False"
                                        Style="{StaticResource RequiredButtonIconStyle}"
                                        Symbol="CheckmarkCircle24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>

                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            MouseLeftButtonDown="ResendCode_Click"
                            Style="{StaticResource FooterLinkStyle}"
                            Text="Отправить код повторно" />
                    </StackPanel>

                    <!--  Step 3: New Password  -->
                    <StackPanel
                        x:Name="Step3Panel"
                        Orientation="Vertical"
                        Visibility="Visible">
                        <TextBlock
                            Margin="0,0,0,20"
                            Style="{DynamicResource TitleTextStyle}"
                            Text="Создайте новый пароль" />

                        <TextBlock
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="Новый пароль" />
                        <ui:PasswordBox
                            x:Name="PasswordEnter"
                            Margin="0,0,0,8"
                            PasswordChanged="NewPasswordBox_PasswordChanged"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="NewPasswordBox_TextChanged" />
                        <ProgressBar
                            x:Name="PasswordStrengthBar"
                            Height="4"
                            Margin="0,0,0,5"
                            Background="#333333"
                            BorderThickness="0"
                            Foreground="#FF4646"
                            Maximum="100"
                            Minimum="0"
                            Value="2" />

                        <TextBlock
                            x:Name="PasswordDifficultyIndicator"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource TipsStyle}"
                            Text="Начните вводить пароль" />

                        <!--  Password requirements checklist  -->
                        <Border
                            Margin="0,5,0,15"
                            Padding="15,10,15,10"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource MainStyleBorder}">
                            <StackPanel x:Name="PasswordRequirementsPanel">
                                <TextBlock
                                    x:Name="ReqMinLength"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TipsStyle}"
                                    Text="○ Минимум 8 символов" />
                                <TextBlock
                                    x:Name="ReqUpperCase"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TipsStyle}"
                                    Text="○ Заглавные буквы" />
                                <TextBlock
                                    x:Name="ReqLowerCase"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TipsStyle}"
                                    Text="○ Строчные буквы" />
                                <TextBlock
                                    x:Name="ReqDigit"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TipsStyle}"
                                    Text="○ Цифры" />
                                <TextBlock
                                    x:Name="ReqSpecialChar"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource TipsStyle}"
                                    Text="○ Специальные символы" />
                            </StackPanel>
                        </Border>


                        <TextBlock
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="Подтвердите пароль" />
                        <ui:PasswordBox
                            x:Name="PasswordRepeatedEnter"
                            Margin="0,0,0,5"
                            PasswordChanged="PasswordRepeatedEnter_PasswordChanged"
                            Style="{DynamicResource InputTextBoxStyle}" />
                        <TextBlock
                            x:Name="PasswordMatchText"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource DescriptionTextStyle}"
                            Text="" />
                        <ui:Button
                            x:Name="ResetPasswordButton"
                            Margin="0,5,0,15"
                            Click="ResetPasswordButton_Click"
                            Style="{StaticResource RequiredButton}">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="Сохранить новый пароль" />
                                    <ui:SymbolIcon
                                        Filled="False"
                                        Style="{StaticResource RequiredButtonIconStyle}"
                                        Symbol="Save24" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                        <!--  Password Requirements Info  -->
                        <Border
                            Margin="0,0,0,5"
                            Padding="15"
                            Style="{DynamicResource MainStyleBorder}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource LittleTitleTextStyle}"
                                    Text="Рекомендации к паролю:" />
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource TipsStyle}"
                                    Text="• Используйте комбинацию букв разного регистра"
                                    TextWrapping="WrapWithOverflow" />
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource TipsStyle}"
                                    Text="• Добавьте цифры и специальные символы" />
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource TipsStyle}"
                                    Text="• Не используйте личные данные в пароле" />
                            </StackPanel>
                        </Border>


                    </StackPanel>

                    <!--  Success Message  -->
                    <StackPanel
                        x:Name="SuccessPanel"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <Border
                            Margin="0,0,0,25"
                            Padding="20"
                            Style="{DynamicResource MainStyleBorder}">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="32"
                                    Foreground="#28a745"
                                    Symbol="CheckmarkCircle24" />
                                <TextBlock Style="{DynamicResource TitleTextStyle}" Text="Пароль успешно изменен!" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Style="{DynamicResource DescriptionTextStyle}"
                                    Text="Теперь вы можете войти с новым паролем" />
                            </StackPanel>
                        </Border>

                        <ui:Button
                            x:Name="BackToLoginButton"
                            Margin="0,0,0,15"
                            Click="BackToLoginButton_Click"
                            Style="{StaticResource RequiredButton}">
                            <ui:Button.Content>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:SymbolIcon Style="{StaticResource RequiredButtonIconStyle}" Symbol="ArrowLeft24" />
                                    <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="Вернуться к входу" />
                                </StackPanel>
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="BackToLoginTextBlock"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        MouseLeftButtonDown="BackToLogin_Click"
                        Style="{StaticResource FooterLinkStyle}"
                        Text="Вернуться к входу" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Footer  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,5,0,5"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                Foreground="#666666"
                Text="2025 BarkFluff. Никакие права не защищены." />
        </StackPanel>
    </Grid>
</UserControl>
