<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="1280"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource BackgroundWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Image
                Width="28"
                Height="28"
                Source="/Resources/Images/barkfluff_logo.png" />
            <TextBlock
                Margin="12,0,0,0"
                Style="{DynamicResource LittleTitleTextStyle}"
                Text="BarkFluff" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,8"
                    Style="{DynamicResource TitleTextStyle}"
                    Text="{DynamicResource L_Login_Title}" />

                <TextBlock
                    Margin="0,0,0,40"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="{DynamicResource L_Login_Subtitle}" />

                <WrapPanel VerticalAlignment="Center">
                    <Grid>
                        <Border Margin="10,20,40,40" Style="{DynamicResource MainStyleBorder}">
                            <StackPanel
                                MinWidth="300"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <StackPanel x:Name="LoginPasswordFields" Visibility="Visible">
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource DescriptionTextStyle}"
                                        Text="{DynamicResource L_Login_EmailOrUsername}" />
                                    <ui:TextBox
                                        x:Name="UsernameTextBox"
                                        LostFocus="UsernameTextBox_LostFocus"
                                        MaxLength="50"
                                        Style="{DynamicResource InputTextBoxStyle}" />
                                    <TextBlock
                                        x:Name="UsernameErrorText"
                                        Margin="0,4,0,8"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="12"
                                        Foreground="#E74856"
                                        Text=""
                                        Visibility="Collapsed" />

                                    <TextBlock
                                        Margin="0,8,0,8"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource DescriptionTextStyle}"
                                        Text="{DynamicResource L_Login_Password}" />
                                    <ui:PasswordBox
                                        x:Name="PasswordBox"
                                        LostFocus="PasswordBox_LostFocus"
                                        Style="{StaticResource InputTextBoxStyle}" />
                                    <TextBlock
                                        x:Name="PasswordErrorText"
                                        Margin="0,4,0,8"
                                        FontFamily="{DynamicResource AdwaitaSans}"
                                        FontSize="12"
                                        Foreground="#E74856"
                                        Text=""
                                        Visibility="Collapsed" />

                                    <TextBlock
                                        Margin="0,0,0,25"
                                        HorizontalAlignment="Right"
                                        Cursor="Hand"
                                        Foreground="{DynamicResource TextHyperlink}"
                                        MouseLeftButtonDown="ResetPasswordClick"
                                        Style="{DynamicResource DescriptionTextStyle}"
                                        Text="{DynamicResource L_Login_ForgotPassword}" />
                                </StackPanel>


                                <Border
                                    x:Name="OtpBlock"
                                    Margin="0,0,0,25"
                                    Padding="20"
                                    Visibility="Visible">
                                    <StackPanel
                                        x:Name="Step2Panel"
                                        Orientation="Vertical"
                                        Visibility="Visible">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            Style="{DynamicResource TitleTextStyle}"
                                            Text="{DynamicResource L_Login_OtpHeader}" />

                                        <TextBlock
                                            Margin="0,0,0,25"
                                            Style="{DynamicResource DescriptionTextStyle}"
                                            Text="{DynamicResource L_Login_OtpHint}" />

                                        <!--  Verification Code Input  -->
                                        <StackPanel
                                            Margin="0,0,0,20"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBox
                                                x:Name="VerifyBox0"
                                                GotFocus="VerifyBox_GotFocus"
                                                MaxLength="1"
                                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                                Style="{StaticResource PinCodeTextBox}"
                                                TextChanged="VerifyBox_TextChanged" />
                                            <TextBox
                                                x:Name="VerifyBox1"
                                                GotFocus="VerifyBox_GotFocus"
                                                MaxLength="1"
                                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                                Style="{StaticResource PinCodeTextBox}"
                                                TextChanged="VerifyBox_TextChanged" />
                                            <TextBox
                                                x:Name="VerifyBox2"
                                                GotFocus="VerifyBox_GotFocus"
                                                MaxLength="1"
                                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                                Style="{StaticResource PinCodeTextBox}"
                                                TextChanged="VerifyBox_TextChanged" />
                                            <TextBox
                                                x:Name="VerifyBox3"
                                                GotFocus="VerifyBox_GotFocus"
                                                MaxLength="1"
                                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                                Style="{StaticResource PinCodeTextBox}"
                                                TextChanged="VerifyBox_TextChanged" />
                                            <TextBox
                                                x:Name="VerifyBox4"
                                                GotFocus="VerifyBox_GotFocus"
                                                MaxLength="1"
                                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                                Style="{StaticResource PinCodeTextBox}"
                                                TextChanged="VerifyBox_TextChanged" />
                                            <TextBox
                                                x:Name="VerifyBox5"
                                                GotFocus="VerifyBox_GotFocus"
                                                MaxLength="1"
                                                PreviewKeyDown="VerifyBox_PreviewKeyDown"
                                                PreviewTextInput="VerifyBox_PreviewTextInput"
                                                Style="{StaticResource PinCodeTextBox}"
                                                TextChanged="VerifyBox_TextChanged" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="OtpErrorText"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            FontFamily="{DynamicResource AdwaitaSans}"
                                            FontSize="12"
                                            Foreground="#E74856"
                                            Text=""
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <ui:Button
                                    x:Name="SignInButton"
                                    Margin="0,0,0,15"
                                    Click="SignInButton_Click"
                                    Style="{DynamicResource RequiredButton}">
                                    <ui:Button.Content>
                                        <Grid>
                                            <StackPanel
                                                x:Name="SignInButtonContent"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource RequiredButtonTextStyle}" Text="{DynamicResource L_Login_SignInButton}" />
                                                <ui:SymbolIcon Style="{DynamicResource RequiredButtonIconStyle}" Symbol="ArrowRight24" />
                                            </StackPanel>
                                            <ui:ProgressRing
                                                x:Name="SignInLoadingIndicator"
                                                Width="24"
                                                Height="24"
                                                Foreground="{DynamicResource ProgressRingAlternativeColor}"
                                                IsIndeterminate="True"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </ui:Button.Content>
                                </ui:Button>


                            </StackPanel>
                        </Border>
                    </Grid>


                    <StackPanel
                        Margin="40"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Border
                            x:Name="QrCodeContainer"
                            Width="250"
                            Height="250"
                            Padding="10"
                            HorizontalAlignment="Center"
                            CornerRadius="16"
                            Style="{DynamicResource MainStyleBorder}">
                            <Grid>

                                <Image x:Name="QrCodeImage" Stretch="Uniform" />
                                <ui:ProgressRing
                                    x:Name="QrProgressRing"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource ProgressRingAlternativeColor}"
                                    IsIndeterminate="True"
                                    Visibility="Visible" />
                            </Grid>

                        </Border>
                    </StackPanel>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <Border Padding="0,20,0,0" BorderBrush="#333333">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,0"
                        VerticalAlignment="Bottom"
                        Cursor="Hand"
                        Foreground="{DynamicResource TextHyperlink}"
                        MouseLeftButtonDown="BackToServerList"
                        Style="{StaticResource DescriptionTextStyle}"
                        Text="{DynamicResource L_Login_ChangeServer}" />
                    <Separator Margin="-5,5,-5,5" />
                    <TextBlock
                        Margin="0,0,0,15"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="{DynamicResource L_Login_NoAccount}" />

                    <ui:Button
                        x:Name="CreateAccountButton"
                        Click="CreateAccountPageOpen"
                        Style="{DynamicResource AdaptiveButton}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource AdaptiveButtonTextStyle}" Text="{DynamicResource L_Login_CreateAccount}" />
                                <ui:SymbolIcon Style="{DynamicResource AdaptiveButtonIconStyle}" Symbol="ArrowRight24" />
                            </StackPanel>
                        </ui:Button.Content>


                    </ui:Button>
                </StackPanel>
            </Border>


            <TextBlock
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="12"
                Foreground="#666666"
                Text="{DynamicResource L_Common_Copyright}" />
        </StackPanel>
    </Grid>
</UserControl>