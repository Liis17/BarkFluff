<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.CompletionRegistration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Fade-in and slide-up animation for the content  -->
        <Storyboard x:Key="FadeInSlideUp">
            <DoubleAnimation
                Storyboard.TargetName="ContentPanel"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ContentTransform"
                Storyboard.TargetProperty="Y"
                From="30"
                To="0"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  Success icon pulse animation  -->
        <Storyboard x:Key="IconPulse" RepeatBehavior="Forever">
            <DoubleAnimation
                AutoReverse="True"
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleX"
                From="1"
                To="1.08"
                Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                AutoReverse="True"
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.08"
                Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  Success icon initial animation  -->
        <Storyboard x:Key="IconAppear">
            <DoubleAnimation
                BeginTime="0:0:0.2"
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleX"
                From="0"
                To="1"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                BeginTime="0:0:0.2"
                Storyboard.TargetName="SuccessIconScale"
                Storyboard.TargetProperty="ScaleY"
                From="0"
                To="1"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                BeginTime="0:0:0.2"
                Storyboard.TargetName="SuccessIconBorder"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!--  Main content panel with animations  -->
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="500"
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="1">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ContentTransform" Y="30" />
            </StackPanel.RenderTransform>

            <!--  Success Icon with gradient background  -->
            <Border
                x:Name="SuccessIconBorder"
                Width="100"
                Height="100"
                Margin="0,0,0,32"
                HorizontalAlignment="Center"
                CornerRadius="50"
                Opacity="0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SuccessIconScale" CenterX="50" CenterY="50" ScaleX="0" ScaleY="0" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#df5000" />
                        <GradientStop Offset="1" Color="#FF6B2D" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="30"
                        Opacity="0.4"
                        ShadowDepth="0"
                        Color="#df5000" />
                </Border.Effect>
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="48"
                    Foreground="White"
                    Symbol="Checkmark24" />
            </Border>

            <!--  Title  -->
            <TextBlock
                Margin="0,0,0,12"
                Style="{DynamicResource BigTitleTextStyle}"
                Text="Добро пожаловать!" />

            <!--  Subtitle  -->
            <TextBlock
                Margin="0,0,0,8"
                Style="{DynamicResource DescriptionTextStyle}"
                Text="Регистрация успешно завершена" />

            <!--  Description in card style  -->
            <Border Margin="0,24,0,32" Style="{DynamicResource MainStyleBorder}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{DynamicResource DescriptionText}"
                        Symbol="Settings24" />
                    <TextBlock Style="{DynamicResource DescriptionTextStyle}" Text="Настраиваем ваш аккаунт..." />
                </StackPanel>
            </Border>

            <!--  Progress indicator  -->
            <ui:ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource ProgressRingColor}"
                IsIndeterminate="True" />

            <!--  Additional info text  -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{DynamicResource DescriptionTextStyle}"
                Text="Это займёт всего несколько секунд" />
        </StackPanel>
    </Grid>
</UserControl>
