<UserControl
    x:Class="BarkFluff.Client.WPF.Pages.SetupPages.CreateAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crop="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preview="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:setupPages="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages"
    xmlns:twofa="clr-namespace:BarkFluff.Client.WPF.Pages.SetupPages.Registration"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="4600"
    d:DesignWidth="720"
    mc:Ignorable="d">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок и название сервера  -->
        <StackPanel
            x:Name="TitleServerNameBar"
            Grid.Row="0"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="28"
                    Height="28"
                    Source="/Resources/Images/barkfluff_logo.png" />
                <TextBlock
                    x:Name="ServerNameBlock"
                    Margin="12,0,0,0"
                    Loaded="TextBlock_Loaded"
                    Style="{DynamicResource LittleTitleTextStyle}"
                    Text="servername" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource DescriptionTextStyle}"
                Text="{DynamicResource L_CreateAccount_Title}" />

            <!--  Progress indicator  -->
            <StackPanel
                x:Name="ProgressIndicatorPanel"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    x:Name="StepIndicatorText"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="{DynamicResource L_CreateAccount_StepFormat_19}" />
                <ProgressBar
                    x:Name="StepProgressBar"
                    Width="200"
                    Height="4"
                    Margin="0,8,0,0"
                    Background="#333333"
                    BorderThickness="0"
                    Foreground="#df5000"
                    Maximum="9"
                    Minimum="0"
                    Value="1" />
            </StackPanel>
        </StackPanel>

        <!--  Основная область контента  -->
        <Grid
            x:Name="MainGrid"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch" />

        <StackPanel
            x:Name="MainContainer"
            Grid.Row="0"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Loaded="MainContainer_Loaded"
            Orientation="Vertical">

            <!--  Step 1: Имя и фамилия  -->
            <StackPanel
                x:Name="Step1"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="{DynamicResource L_CreateAccount_Personal_Title}" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <!--  Имя  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_FirstName_Label}" />
                        <ui:TextBox
                            x:Name="FirstNameEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="{DynamicResource L_CreateAccount_FirstName_Placeholder}"
                            Style="{DynamicResource InputTextBoxStyle}"
                            Tag="Names"
                            TextChanged="FirstNameEnter_TextChanged" />
                        <TextBlock
                            x:Name="FirstNameValidationText"
                            Margin="0,0,0,15"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <!--  Фамилия  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_LastName_Label}" />
                        <ui:TextBox
                            x:Name="LastNameEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="{DynamicResource L_CreateAccount_LastName_Placeholder}"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="LastNameEnter_TextChanged" />
                        <TextBlock
                            x:Name="LastNameValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <!--  Информация  -->
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Name_Hint1}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Name_Hint2}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Name_Hint3}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Name_Hint4}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 2: Логин  -->
            <StackPanel
                x:Name="Step2"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="{DynamicResource L_CreateAccount_Username_Title}" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_Login_Label}" />
                        <ui:TextBox
                            x:Name="LoginEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="Apogee"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="LoginEnter_TextChanged" />
                        <TextBlock
                            x:Name="LoginValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Login_Hint1}" />
                            <TextBlock
                                Margin="15,2,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Login_Hint2}" />
                            <TextBlock
                                Margin="15,2,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Login_Hint3}" />
                            <TextBlock
                                Margin="15,2,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Login_Hint4}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Login_Hint5}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Login_Hint6}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 3: Email  -->
            <StackPanel
                x:Name="Step3"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="{DynamicResource L_CreateAccount_Email_Title}" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_Email_Label}" />
                        <ui:TextBox
                            x:Name="EmailEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PlaceholderText="apogee@barkfluff.ru"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="EmailEnter_TextChanged" />
                        <TextBlock
                            x:Name="EmailValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Email_Hint1}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Email_Hint2}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_Email_Hint3}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 4: Код подтверждения  -->
            <StackPanel
                x:Name="Step4"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="{DynamicResource L_CreateAccount_EmailConfirm_Title}" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_EmailConfirm_Label}" />
                        <ui:TextBox
                            x:Name="VerificationCodeEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            MaxLength="6"
                            PlaceholderText="123456"
                            Style="{DynamicResource InputTextBoxStyle}"
                            TextChanged="VerificationCodeEnter_TextChanged" />
                        <TextBlock
                            x:Name="VerificationCodeValidationText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                x:Name="EmailHelperText"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_EmailConfirm_Hint1}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_CreateAccount_EmailConfirm_Hint2}" />
                            <TextBlock
                                x:Name="RemainingAttemptsText"
                                HorizontalAlignment="Left"
                                Foreground="#FF9800"
                                Style="{StaticResource TipsStyle}"
                                Text=""
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 5: Пароль  -->
            <StackPanel
                x:Name="Step5"
                Width="380"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="{DynamicResource L_CreateAccount_Password_Title}" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel>
                        <!--  Пароль  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_Password_Label}" />
                        <ui:PasswordBox
                            x:Name="PasswordEnter"
                            Margin="0,0,0,8"
                            KeyDown="TextBox_KeyDown"
                            PasswordChanged="PasswordEnter_TextChanged"
                            PlaceholderText="{DynamicResource L_CreateAccount_Password_Placeholder}"
                            Style="{DynamicResource InputTextBoxStyle}" />

                        <!--  Индикатор силы пароля  -->
                        <ProgressBar
                            x:Name="PasswordStrengthBar"
                            Height="4"
                            Margin="0,0,0,5"
                            Background="#333333"
                            BorderThickness="0"
                            Foreground="#FF4646"
                            Maximum="100"
                            Minimum="0"
                            Value="2" />

                        <TextBlock
                            x:Name="PasswordDifficultyIndicator"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DescriptionTextStyle}"
                            Text="{DynamicResource L_Password_StartTyping}" />

                        <!--  Password requirements checklist  -->
                        <StackPanel x:Name="PasswordRequirementsPanel" Margin="0,0,0,15">
                            <TextBlock
                                x:Name="ReqMinLength"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Rule_MinLength}" />
                            <TextBlock
                                x:Name="ReqUpperCase"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Rule_Uppercase}" />
                            <TextBlock
                                x:Name="ReqLowerCase"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Rule_Lowercase}" />
                            <TextBlock
                                x:Name="ReqDigit"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Rule_Digits}" />
                            <TextBlock
                                x:Name="ReqSpecialChar"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Rule_Special}" />
                        </StackPanel>

                        <!--  Подтверждение пароля  -->
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource LittleTitleTextStyle}"
                            Text="{DynamicResource L_CreateAccount_PasswordConfirm_Label}" />
                        <ui:PasswordBox
                            x:Name="PasswordRepeatedEnter"
                            Margin="0,0,0,5"
                            KeyDown="TextBox_KeyDown"
                            PasswordChanged="PasswordRepeatedEnter_TextChanged"
                            PlaceholderText="{DynamicResource L_CreateAccount_PasswordConfirm_Placeholder}"
                            Style="{DynamicResource InputTextBoxStyle}" />
                        <TextBlock
                            x:Name="PasswordMatchText"
                            Margin="0,0,0,20"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="12"
                            Foreground="#888888"
                            Text="" />

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Recommendation_Mix}"
                                TextWrapping="WrapWithOverflow" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Recommendation_AddDigits}" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource TipsStyle}"
                                Text="{DynamicResource L_Password_Recommendation_MinLen}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 6: Загрузка изображения  -->
            <StackPanel
                x:Name="Step6"
                Width="600"
                Height="800"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">

                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource TitleTextStyle}"
                    Text="{DynamicResource L_CreateAccount_Avatar_Title}" />

                <Border Style="{DynamicResource MainStyleBorder}">
                    <StackPanel HorizontalAlignment="Center">
                        <crop:CropImage
                            x:Name="Cropper"
                            Width="600"
                            Height="700"
                            Panel.ZIndex="100"
                            DataContext="CreateAccount"
                            Loaded="CropperLoaded" />
                        <TextBlock
                            Margin="0,15,0,0"
                            Style="{StaticResource DescriptionTextStyle}"
                            Text="{DynamicResource L_CreateAccount_Avatar_Hint}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Step 7: Добавление описания  -->
            <StackPanel
                x:Name="Step7"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource TitleTextStyle}"
                        Text="{DynamicResource L_CreateAccount_Profile_Title}" />
                    <preview:PreviewUser x:Name="PreviewUserElement" Loaded="PreviewUserElement_Loaded" />
                </StackPanel>

            </StackPanel>
            <!--  Step 8: подключение 2fa  -->
            <ScrollViewer
                x:Name="Step8" Width="800"
                Margin="-30,-30,-30,-30"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
                <twofa:TwoFA
                    x:Name="OtpSuggestion"
                    VerticalAlignment="Stretch"
                    Loaded="OtpSuggestion_Loaded" />
            </ScrollViewer>
            <!--  Step 9: Завершение регистрации  -->
            <StackPanel
                x:Name="Step9"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <setupPages:CompletionRegistration x:Name="CompletionRegistrationElement" />
            </StackPanel>

        </StackPanel>

        <!--  Нижняя панель с кнопками  -->
        <StackPanel
            x:Name="ButtonBottomBar"
            Grid.Row="2"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Orientation="Vertical">

            <!--  Кнопки навигации  -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <ui:Button
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Style="{StaticResource MainButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="{DynamicResource L_CreateAccount_Next}" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="ArrowRight12" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="CreateButton"
                    Click="NextButton_Click"
                    Style="{StaticResource MainButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource MainButtonTextLeft}" Text="{DynamicResource L_CreateAccount_Submit}" />
                        <ui:SymbolIcon Style="{StaticResource ButtonSymbolRight}" Symbol="Add12" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>