<Application
    x:Class="BarkFluff.Client.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Themes/DarkTheme.xaml" />
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--  ==================================================================  -->
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{Binding Source={x:Static SystemParameters.WindowGlassColor}}" />

            <!--  Для надежности перезапишем и другие вариации имен кистей библиотеки  -->
            <SolidColorBrush x:Key="SystemAccentBrush" Color="{Binding Source={x:Static SystemParameters.WindowGlassColor}}" />
            <!--  Шрифт  -->
            <FontFamily x:Key="AdwaitaSans">pack://application:,,,/;component/Fonts/AdwaitaSans-Regular.ttf</FontFamily>
            <FontFamily x:Key="OpenSans">pack://application:,,,/;component/Fonts/OpenSans-VariableFont_wdth,wght.ttf</FontFamily>
            <FontFamily x:Key="OpenSansItalic">pack://application:,,,/;component/Fonts/OpenSans-Italic-VariableFont_wdth,wght.ttf</FontFamily>
            <FontFamily x:Key="Neucha">pack://application:,,,/;component/Fonts/Neucha-Regular.ttf</FontFamily>
            <FontFamily x:Key="NotoSansDisplay">pack://application:,,,/;component/Fonts/NotoSansDisplay-VariableFont_wdth,wght.ttf</FontFamily>

            <VisualBrush x:Key="BlurredBackgroundBrush" Visual="{Binding ElementName=BackgroundChatImage}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
