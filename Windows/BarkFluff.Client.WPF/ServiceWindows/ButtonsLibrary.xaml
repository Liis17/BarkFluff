<UserControl
    x:Class="BarkFluff.Client.WPF.ServiceWindows.ButtonsLibrary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.ServiceWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="2000"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <Grid Background="#1a1a1a">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Orientation="Vertical">

                <!--  Оригинальная кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Оригинальная кнопка" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="24,12"
                    HorizontalAlignment="Center"
                    Background="#df5000"
                    BorderThickness="0"
                    CornerRadius="22"
                    Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button">
                            <Setter Property="Background" Value="#df5000" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C54700" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#AB3D00" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="White"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="White"
                            Text="Начать новый чат" />
                    </StackPanel>
                </ui:Button>

                <!--  1. Градиентная кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="1. Градиентная кнопка с неоновым акцентом" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="20,14"
                    HorizontalAlignment="Center"
                    BorderThickness="1"
                    CornerRadius="16"
                    Cursor="Hand">
                    <ui:Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#6366f1" />
                            <GradientStop Offset="1" Color="#8b5cf6" />
                        </LinearGradientBrush>
                    </ui:Button.Background>
                    <ui:Button.BorderBrush>
                        <SolidColorBrush Color="#a855f7" />
                    </ui:Button.BorderBrush>
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#7c3aed" />
                                                <GradientStop Offset="1" Color="#a855f7" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="White"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Создать" />
                    </StackPanel>
                </ui:Button>

                <!--  2. Стеклянная кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="2. Стеклянная кнопка (Glassmorphism)" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="22,13"
                    HorizontalAlignment="Center"
                    Background="#4D1a1a1a"
                    BorderBrush="#33ffffff"
                    BorderThickness="1"
                    CornerRadius="20"
                    Cursor="Hand">
                    <ui:Button.Effect>
                        <BlurEffect Radius="2" />
                    </ui:Button.Effect>
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#662a2a2a" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#e5e7eb"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#f3f4f6"
                            Text="Добавить" />
                    </StackPanel>
                </ui:Button>

                <!--  3. Outline кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="3. Outline кнопка с анимированной заливкой" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="18,12"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#10b981"
                    BorderThickness="2"
                    CornerRadius="12"
                    Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3310b981" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#6610b981" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#10b981"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#10b981"
                            Text="Запустить" />
                    </StackPanel>
                </ui:Button>

                <!--  4. Тёмная кнопка с акцентом  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="4. Тёмная кнопка с цветным акцентом" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="20,16"
                    HorizontalAlignment="Center"
                    Background="#1f2937"
                    BorderThickness="0"
                    CornerRadius="8"
                    Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#374151" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#111827" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="4"
                            Height="20"
                            Margin="0,0,12,0"
                            Background="#f59e0b"
                            CornerRadius="4" />
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#f9fafb"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#f9fafb"
                            Text="Начать" />
                    </StackPanel>
                </ui:Button>

                <!--  5. Кнопка с тенью  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="5. Кнопка с тенью и подсветкой" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="24,14"
                    HorizontalAlignment="Center"
                    Background="#dc2626"
                    BorderThickness="0"
                    CornerRadius="18"
                    Cursor="Hand">
                    <ui:Button.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Opacity="0.4"
                            ShadowDepth="4"
                            Color="#dc2626" />
                    </ui:Button.Effect>
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#ef4444" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#b91c1c" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="White"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Действие" />
                    </StackPanel>
                </ui:Button>

                <!--  6. Минималистичная кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="6. Минималистичная плоская кнопка" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    Background="#27272a"
                    BorderThickness="0"
                    CornerRadius="6"
                    Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3f3f46" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#18181b" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#a1a1aa"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="Regular"
                            Foreground="#e4e4e7"
                            Text="Новый элемент" />
                    </StackPanel>
                </ui:Button>

                <!--  7. Кнопка с градиентной рамкой  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="7. Кнопка с градиентной рамкой" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="20,12"
                    HorizontalAlignment="Center"
                    Background="#0f172a"
                    BorderThickness="2"
                    CornerRadius="14"
                    Cursor="Hand">
                    <ui:Button.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#0ea5e9" />
                            <GradientStop Offset="1" Color="#3b82f6" />
                        </LinearGradientBrush>
                    </ui:Button.BorderBrush>
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1e293b" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#020617" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#0ea5e9"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#cbd5e1"
                            Text="Создать проект" />
                    </StackPanel>
                </ui:Button>

                <!--  8. Кнопка-капсула  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="8. Кнопка-капсула с мягким свечением" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="28,16"
                    HorizontalAlignment="Center"
                    Background="#7c3aed"
                    BorderThickness="0"
                    CornerRadius="50"
                    Cursor="Hand">
                    <ui:Button.Effect>
                        <DropShadowEffect
                            BlurRadius="16"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#7c3aed" />
                    </ui:Button.Effect>
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#8b5cf6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#6d28d9" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="White"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Продолжить" />
                    </StackPanel>
                </ui:Button>

                <!--  9. Двухтонная кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="9. Кнопка с двухтонным дизайном" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="12"
                    Cursor="Hand">
                    <Border CornerRadius="12">
                        <Grid>
                            <Border
                                Width="40"
                                HorizontalAlignment="Left"
                                Background="#fbbf24"
                                CornerRadius="12,0,0,12" />
                            <Border
                                Margin="40,0,0,0"
                                Background="#262626"
                                CornerRadius="0,12,12,0" />
                            <StackPanel Margin="16,12" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    Foreground="White"
                                    Symbol="Add16" />
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="Выполнить" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ui:Button>

                <!--  10. Матовая кнопка  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="10. Кнопка с матовым эффектом" />
                <ui:Button
                    Margin="0,0,0,30"
                    Padding="22,14"
                    HorizontalAlignment="Center"
                    Background="#80444444"
                    BorderBrush="#52525b"
                    BorderThickness="1"
                    CornerRadius="10"
                    Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#8052525b" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#803f3f46" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#f4f4f5"
                            Symbol="Add16" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#f4f4f5"
                            Text="Открыть" />
                    </StackPanel>
                </ui:Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>