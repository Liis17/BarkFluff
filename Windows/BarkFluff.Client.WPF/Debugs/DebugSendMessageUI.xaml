<UserControl
    x:Class="BarkFluff.Client.WPF.Debugs.DebugSendMessageUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.Debugs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#1e1e1e">
        <StackPanel
            MinWidth="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock Foreground="White" Text="Сообщение" />
            <TextBox x:Name="Text" />
            <TextBlock Foreground="White" Text="ChatID" />
            <TextBox x:Name="ChatID" />
            <Button
                Padding="15,5,15,5"
                HorizontalAlignment="Center"
                Click="Button_Click"
                Content="Отправить  по chatID" />
            <Separator />
            <TextBlock Foreground="White" Text="UserID" />
            <TextBox x:Name="UserID" />
            <Button
                Padding="15,5,15,5"
                HorizontalAlignment="Center"
                Click="Button_Click_1"
                Content="Отправить по userID" />
        </StackPanel>
    </Grid>
</UserControl>
