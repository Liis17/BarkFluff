<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.CropImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="500"
    Height="600"
    MaxWidth="500"
    MaxHeight="600"
    d:DesignHeight="600"
    d:DesignWidth="500"
    AllowDrop="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.25" />
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>
    <Grid Background="#1e1e1e">
        <Grid x:Name="ButtonGrid">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <ui:Button
                    Click="LoadButton_Click"
                    Style="{StaticResource RequiredButton}"
                    ToolTip="{DynamicResource L_CropImage_Tooltip_PickFile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="{DynamicResource L_CropImage_SelectAvatar}" />
                        <ui:SymbolIcon Style="{StaticResource RequiredButtonIconStyle}" Symbol="ArrowDownload20" />
                    </StackPanel>
                </ui:Button>
                <TextBlock
                    Margin="0,10,0,0"
                    Style="{DynamicResource DescriptionTextStyle}"
                    Text="{DynamicResource L_CropImage_OrDrop}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="CropGrid">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="100"
                Orientation="Vertical">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="5"
                        Click="Button_Click"
                        Style="{DynamicResource RequiredButton}"
                        ToolTip="{DynamicResource L_CropImage_Tooltip_Apply}">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="{DynamicResource L_CropImage_Crop}" />
                            <ui:SymbolIcon Style="{StaticResource RequiredButtonIconStyle}" Symbol="Cut20" />
                        </StackPanel>

                    </ui:Button>
                    <ui:Button
                        Margin="5"
                        Click="ResetPosition"
                        Style="{DynamicResource AdaptiveButton}"
                        ToolTip="{DynamicResource L_CropImage_Tooltip_Reset}">
                        <ui:SymbolIcon
                            Margin="25,0,25,0"
                            Style="{StaticResource AdaptiveButtonIconStyle}"
                            Symbol="ArrowMoveInward20" />
                    </ui:Button>
                    <ui:Button
                        Margin="5"
                        Click="LoadButton_Click"
                        Style="{DynamicResource AdaptiveButton}"
                        ToolTip="{DynamicResource L_CropImage_Tooltip_PickOther}">
                        <ui:SymbolIcon
                            Margin="25,0,25,0"
                            Filled="False"
                            Style="{StaticResource AdaptiveButtonIconStyle}"
                            Symbol="ImageArrowCounterclockwise20" />
                    </ui:Button>
                    <ui:Button
                        x:Name="CancelButton"
                        Margin="5"
                        Click="CancelButton_Click"
                        Style="{DynamicResource AdaptiveButton}"
                        ToolTip="{DynamicResource L_CropImage_Tooltip_Cancel}">
                        <ui:SymbolIcon
                            Margin="25,0,25,0"
                            Style="{StaticResource AdaptiveButtonIconStyle}"
                            Symbol="Dismiss20" />
                    </ui:Button>
                </StackPanel>
                <Border
                    Height="50"
                    Margin="5"
                    Padding="20,10,20,10"
                    Background="{DynamicResource ButtonBackground}"
                    Style="{DynamicResource MainStyleBorder}">
                    <Slider
                        x:Name="ZoomSlider"
                        Width="300"
                        HorizontalAlignment="Center"
                        Maximum="2.5"
                        Minimum="0.5"
                        TickFrequency="0.05"
                        TickPlacement="BottomRight"
                        Value="1.0" />
                </Border>

            </StackPanel>
            <Grid
                Height="200"
                Margin="-1"
                VerticalAlignment="Bottom"
                Panel.ZIndex="10">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#FF000000" />
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            <Canvas x:Name="MainCanvas" ClipToBounds="True">

                <Image x:Name="ImageControl" RenderTransformOrigin="0.5,0.5" />
                <Canvas
                    x:Name="MaskCanvas"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    IsHitTestVisible="False">
                    <Path Fill="#99000000">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,500,600" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry
                                        Center="250,250"
                                        RadiusX="200"
                                        RadiusY="200" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                </Canvas>
                <Rectangle
                    x:Name="CropBorder"
                    Canvas.Left="50"
                    Canvas.Top="50"
                    Width="400"
                    Height="400"
                    IsHitTestVisible="False"
                    Stroke="Transparent"
                    StrokeThickness="2" />
            </Canvas>
        </Grid>

    </Grid>
</UserControl>
