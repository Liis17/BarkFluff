<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.UnreadSeparatorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Border
            Padding="12,6"
            HorizontalAlignment="Center"
            Background="#33CE6432"
            BorderBrush="#FFCE6432"
            BorderThickness="1"
            CornerRadius="12">
            <TextBlock
                FontSize="11"
                FontWeight="Medium"
                Foreground="#FFCE6432"
                Text="Непрочитанные сообщения" />
        </Border>
    </Grid>
</UserControl>
