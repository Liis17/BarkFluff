<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.PreviewUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <!--  Main background with subtle gradient  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main card with Windows 11 Mica-like effect  -->
        <Border Style="{DynamicResource MainStyleBorder}">
            <StackPanel>
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <!--  User info section with avatar  -->
                    <StackPanel
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">

                        <!--  Avatar with glow effect  -->
                        <Border
                            Width="110"
                            Height="110"
                            Margin="0,0,28,0"
                            CornerRadius="55">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="0.4"
                                    ShadowDepth="4"
                                    Color="#000000" />
                            </Border.Effect>
                            <!--  Subtle gradient ring around avatar  -->
                            <Border Padding="3" CornerRadius="55">

                                <Border Background="#2A2A40" CornerRadius="52">
                                    <Grid>
                                        <local:CachedAvatar
                                            x:Name="AvatarCached"
                                            Width="104"
                                            Height="104"
                                            CornerRadius="52"
                                            EnableDynamicShadow="False"
                                            Visibility="Collapsed" />

                                        <!--  Placeholder icon with modern styling  -->
                                        <ui:SymbolIcon
                                            x:Name="AvatarPlaceholder"
                                            Panel.ZIndex="-1"
                                            FontSize="44"
                                            Foreground="#40FFFFFF"
                                            Symbol="Person24" />
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>

                        <!--  Name and username  -->
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">

                            <TextBlock
                                x:Name="FullNameText"
                                Margin="0,0,0,6"
                                Style="{DynamicResource TitleTextStyle}"
                                Text="{DynamicResource L_PreviewUser_Loading}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource DescriptionTextStyle}" Text="@" />
                                <TextBlock
                                    x:Name="UsernameText"
                                    Style="{DynamicResource DescriptionTextStyle}"
                                    Text="" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!--  Description label  -->
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="{DynamicResource L_PreviewUser_Description}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ui:TextBox
                            x:Name="AboutTextBox"
                            MinWidth="400"
                            AcceptsReturn="True"
                            PlaceholderText="{DynamicResource L_PreviewUser_BioPlaceholder}"
                            Style="{DynamicResource InputTextBoxStyle}"
                            Text=""
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Disabled" />
                    </ScrollViewer>

                    <!--  Error message  -->
                    <TextBlock
                        x:Name="ErrorTextBlockMessage"
                        Margin="0,12,0,0"
                        Foreground="#FFEF4444"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text=""
                        Visibility="Collapsed" />

                    <!--  Windows 11 style accent save button  -->
                    <ui:Button
                        x:Name="SaveButton"
                        Margin="0,8,0,10"
                        Click="SaveButton_Click"
                        Style="{StaticResource RequiredButton}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Style="{StaticResource RequiredButtonTextStyle}" Text="{DynamicResource L_PreviewUser_Save}" />
                                <ui:SymbolIcon Style="{StaticResource RequiredButtonIconStyle}" Symbol="Checkmark24" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>

                <!--  Footer hint text  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="10,0,10,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Vertical">
                    <TextBlock
                        MaxWidth="420"
                        Style="{DynamicResource DescriptionTextStyle}"
                        Text="{DynamicResource L_PreviewUser_Footer}"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
