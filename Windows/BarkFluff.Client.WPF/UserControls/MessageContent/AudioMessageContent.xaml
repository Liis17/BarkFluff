<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.MessageContent.AudioMessageContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="70"
    d:DesignWidth="320"
    mc:Ignorable="d">
    <Border
        x:Name="AudioContainer"
        MinWidth="260"
        MaxWidth="380"
        Padding="12"
        Background="#20000000"
        CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Play/Pause button  -->
            <Border
                x:Name="ActionButton"
                Grid.Column="0"
                Width="44"
                Height="44"
                Margin="0,0,12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#df5000"
                CornerRadius="22"
                Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF6B1A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ui:SymbolIcon
                    x:Name="ActionIcon"
                    FontSize="20"
                    Foreground="White"
                    Symbol="ArrowDownload24" />
            </Border>

            <!--  Content area  -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  File name  -->
                <TextBlock
                    x:Name="FileNameText"
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="audio.mp3"
                    TextTrimming="CharacterEllipsis" />

                <!--  Download progress bar  -->
                <ProgressBar
                    x:Name="DownloadProgressBar"
                    Grid.Row="1"
                    Height="4"
                    Margin="0,0,0,6"
                    Background="#30FFFFFF"
                    Foreground="#df5000"
                    Maximum="100"
                    Visibility="Collapsed" />

                <!--  Audio timeline slider  -->
                <Slider
                    x:Name="TimelineSlider"
                    Grid.Row="1"
                    Height="20"
                    Margin="-4,0,-4,0"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    Style="{DynamicResource AudioSliderStyle}"
                    Visibility="Collapsed" />

                <!--  Time display  -->
                <TextBlock
                    x:Name="TimeDisplay"
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="11"
                    Foreground="#AAFFFFFF"
                    Text="--:--" />
            </Grid>

            <!--  Download progress percent (overlay)  -->
            <TextBlock
                x:Name="ProgressPercentText"
                Grid.Column="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontFamily="{DynamicResource AdwaitaSans}"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#df5000"
                Text=""
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
