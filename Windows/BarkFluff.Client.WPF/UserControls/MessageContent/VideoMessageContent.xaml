<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.MessageContent.VideoMessageContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="200"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Grid>
        <Border
            x:Name="VideoBorder"
            Margin="0"
            CornerRadius="12">
            <Border.Clip>
                <RectangleGeometry
                    x:Name="ClipGeometry"
                    RadiusX="12"
                    RadiusY="12" />
            </Border.Clip>
            <Grid>
                <!--  Video preview image (placeholder)  -->
                <local:CachedImage
                    x:Name="PreviewCachedImage"
                    MaxWidth="400"
                    MaxHeight="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Visibility="Collapsed" />

                <!--  Fallback preview image  -->
                <Image
                    x:Name="PreviewImage"
                    MaxWidth="400"
                    MaxHeight="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="pack://application:,,,/BarkFluff;component/Resources/Placeholders/video.png"
                    Stretch="Uniform" />

                <!--  Play button overlay (shown when cached)  -->
                <Border
                    x:Name="PlayButton"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#80000000"
                    CornerRadius="25"
                    Visibility="Collapsed">
                    <ui:SymbolIcon
                        FontSize="24"
                        Foreground="White"
                        Symbol="Play24" />
                </Border>

                <!--  Download progress bar (shown during download, top of preview)  -->
                <ProgressBar
                    x:Name="DownloadProgressBar"
                    Height="4"
                    VerticalAlignment="Top"
                    Background="#30FFFFFF"
                    Foreground="#df5000"
                    Maximum="100"
                    Visibility="Collapsed" />

                <!--  File size + download button pill (top-right)  -->
                <Border
                    x:Name="DownloadPill"
                    Margin="0,8,8,0"
                    Padding="8,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#CC000000"
                    CornerRadius="12"
                    Cursor="Hand"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            FontSize="14"
                            Foreground="White"
                            Symbol="ArrowDownload24" />
                        <TextBlock
                            x:Name="FileSizeText"
                            Margin="4,0,0,0"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            Foreground="White"
                            Text="" />
                    </StackPanel>
                </Border>

                <!--  Download progress overlay (shown during download)  -->
                <Border
                    x:Name="ProgressOverlay"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#CC000000"
                    CornerRadius="25"
                    Visibility="Collapsed">
                    <Grid>
                        <!--  Circular progress (using Arc approach with Path)  -->
                        <Ellipse
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#40FFFFFF"
                            StrokeThickness="3" />
                        <TextBlock
                            x:Name="ProgressText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="0%" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
