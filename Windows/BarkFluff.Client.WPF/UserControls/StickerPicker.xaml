<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.StickerPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="310"
    Height="500"
    d:DesignHeight="500"
    d:DesignWidth="310"
    mc:Ignorable="d">
    <Border
        Background="#1E1E1E"
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Direction="270"
                Opacity="0.5"
                ShadowDepth="6"
                Color="Black" />
        </Border.Effect>

        <Grid>
            <!--  Загрузка  -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Visible">
                <ui:ProgressRing
                    Width="48"
                    Height="48"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="13"
                    Foreground="#FFAAAAAA"
                    Text="Загрузка стикеров..." />
            </StackPanel>

            <!--  Пусто  -->
            <StackPanel
                x:Name="EmptyPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ui:SymbolIcon
                    FontSize="48"
                    Foreground="#FF555555"
                    Symbol="Sticker16" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="13"
                    Foreground="#FF777777"
                    Text="Стикеры не найдены" />
            </StackPanel>

            <!--  Список стикерпаков  -->
            <ScrollViewer
                x:Name="ContentScrollViewer"
                Padding="8,8,4,8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel x:Name="PacksContainer" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
