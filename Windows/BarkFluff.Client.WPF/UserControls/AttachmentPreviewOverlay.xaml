<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.AttachmentPreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="500"
    AllowDrop="True"
    DragEnter="UserControl_DragEnter"
    DragLeave="UserControl_DragLeave"
    DragOver="UserControl_DragOver"
    Drop="UserControl_Drop"
    mc:Ignorable="d">

    <Border
        x:Name="MainBorder"
        MaxWidth="640"
        MaxHeight="720"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource BorderBlock}"

        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="40"
                Direction="270"
                Opacity="0.4"
                ShadowDepth="12"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Заголовок  -->
                <TextBlock
                    x:Name="HeaderTextBlock"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AdwaitaSans}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource L_AttachmentPreview_Title}" />

                <!--  Кнопка добавления вложений  -->
                <ui:Button
                    x:Name="AddAttachmentButton"
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Margin="8,0,4,0"
                    Padding="0"
                    
                    Click="AddAttachmentButton_Click"
                    CornerRadius="6">
                    <ui:SymbolIcon FontSize="18" Symbol="Add24" />
                </ui:Button>

                <!--  Кнопка закрытия  -->
                <ui:Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    
                    Click="CancelButton_Click"
                    CornerRadius="6">
                    <ui:SymbolIcon FontSize="18" Symbol="Dismiss24" />
                </ui:Button>
            </Grid>

            <!--  Preview Area  -->
            <Border
                Grid.Row="1"
                Padding="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource BorderBlock}"
                CornerRadius="6">

                <Grid>
                    <!--  Grid mode for images (Telegram style)  -->
                    <ScrollViewer
    x:Name="ImagesScrollViewer"
    MaxHeight="400"
    HorizontalAlignment="Stretch"
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
                        <UniformGrid
        x:Name="ImagesGrid"
        Columns="3"
        HorizontalAlignment="Center" />
                    </ScrollViewer>

                    <!--  List mode for files  -->
                    <ScrollViewer
    x:Name="FilesScrollViewer"
    MaxHeight="400"
    HorizontalAlignment="Stretch"
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto"
    Visibility="Collapsed">
                        <StackPanel x:Name="FilesList" />
                    </ScrollViewer>
                </Grid>
                

            </Border>


            <!--  Message Text Input  -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Строка с текстовым полем и кнопкой отправки  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="12,8"
                        Background="{DynamicResource BorderBlock}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBox
                            x:Name="MessageTextBox"
                            MinHeight="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="{DynamicResource AdwaitaSans}"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            MaxHeight="80"
                            TextWrapping="Wrap">
                            <TextBox.Resources>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <ui:Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Height="36"
                        Padding="12,0"
                        Appearance="Primary"
                        Click="SendButton_Click"
                        CornerRadius="6"
                        ToolTip="{DynamicResource L_AttachmentPreview_Send}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="Send24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource AdwaitaSans}"
                                FontSize="13"
                                Text="{DynamicResource L_AttachmentPreview_Send}" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <!--  Галочки с опциями  -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <CheckBox
                        x:Name="SendAsFileCheckBox"
                        Checked="SendAsFileCheckBox_Changed"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Unchecked="SendAsFileCheckBox_Changed"
                        Visibility="Collapsed">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Symbol="ArrowExportUp24" />
                                <TextBlock Text="{DynamicResource L_AttachmentPreview_SendNoCompression}" />
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                    <CheckBox
                        x:Name="SendSeparatelyCheckBox"
                        Margin="0,6,0,0"
                        FontFamily="{DynamicResource AdwaitaSans}"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Symbol="SplitHorizontal24" />
                                <TextBlock Text="{DynamicResource L_AttachmentPreview_SendNoGrouping}" />
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
