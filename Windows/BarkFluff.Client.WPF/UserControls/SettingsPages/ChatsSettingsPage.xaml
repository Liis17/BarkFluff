<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.ChatsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:BarkFluff.Client.WPF.Services.App.Converter"
    d:DesignHeight="750"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <local:BaseSettingsPage.Resources>
        <conv:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadiusConverter"/>
    </local:BaseSettingsPage.Resources>
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">

            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="Чаты" />

            <!-- ── Тема приложения ── -->
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DescriptionText}" Margin="2,8,0,4" Text="ТЕМА ПРИЛОЖЕНИЯ" />
            <Border Padding="16" Background="{DynamicResource TextBackground}" CornerRadius="8" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FF5086B5" Symbol="PaintBrush24" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Тема приложения" />
                    </StackPanel>
                    <StackPanel x:Name="ThemePanel" Margin="0,4,0,0">
                        <Border x:Name="ThemeLight" Padding="12" CornerRadius="6" Margin="0,2" Cursor="Hand"
                                MouseLeftButtonUp="ThemeOption_Click" Tag="light">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TitleText}" FontSize="13" Text="Светлая"/>
                                <Ellipse x:Name="RadioLight" Grid.Column="1" Width="18" Height="18"
                                         Stroke="{DynamicResource DescriptionText}" StrokeThickness="2" Fill="Transparent"/>
                            </Grid>
                        </Border>
                        <Border x:Name="ThemeDark" Padding="12" CornerRadius="6" Margin="0,2" Cursor="Hand"
                                MouseLeftButtonUp="ThemeOption_Click" Tag="dark">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TitleText}" FontSize="13" Text="Тёмная"/>
                                <Ellipse x:Name="RadioDark" Grid.Column="1" Width="18" Height="18"
                                         Stroke="{DynamicResource DescriptionText}" StrokeThickness="2" Fill="Transparent"/>
                            </Grid>
                        </Border>
                        <Border x:Name="ThemeSystem" Padding="12" CornerRadius="6" Margin="0,2" Cursor="Hand"
                                MouseLeftButtonUp="ThemeOption_Click" Tag="system">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TitleText}" FontSize="13" Text="Системная"/>
                                <Ellipse x:Name="RadioSystem" Grid.Column="1" Width="18" Height="18"
                                         Stroke="{DynamicResource DescriptionText}" StrokeThickness="2" Fill="Transparent"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Внешний вид сообщений ── -->
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DescriptionText}" Margin="2,12,0,4" Text="ВНЕШНИЙ ВИД СООБЩЕНИЙ" />
            <Border Padding="16" Background="{DynamicResource TextBackground}" CornerRadius="8" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Foreground="#FFCA6D34" Symbol="Chat24" Margin="0,0,8,0"/>
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Скругление пузырьков"/>
                    </StackPanel>

                    <!-- Превью пузырьков -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Чужое -->
                        <Border Grid.Column="0" HorizontalAlignment="Left" Padding="10,6" MaxWidth="140"
                                Background="#FF3D86C6" Margin="0,0,4,0"
                                CornerRadius="{Binding ElementName=CornerSlider, Path=Value, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                            <TextBlock Text="Привет! 👋" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                        <!-- Своё -->
                        <Border Grid.Column="1" HorizontalAlignment="Right" Padding="10,6" MaxWidth="140"
                                Background="#FFDF5000" Margin="4,0,0,0"
                                CornerRadius="{Binding ElementName=CornerSlider, Path=Value, Converter={StaticResource DoubleToCornerRadiusConverter}}">
                            <TextBlock Text="Как дела? 😊" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                    <!-- Слайдер -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0" FontSize="11" Foreground="{DynamicResource DescriptionText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="CornerSlider" Grid.Column="1" Minimum="0" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="CornerSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" Text="20" FontSize="11" Foreground="{DynamicResource DescriptionText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="CornerValueLabel" FontSize="11" Foreground="{DynamicResource DescriptionText}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" Text="12"/>
                </StackPanel>
            </Border>

            <!-- ── Фоны чата ── -->
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DescriptionText}" Margin="2,12,0,4" Text="ФОНЫ ЧАТА" />
            <Border Padding="12" Background="{DynamicResource TextBackground}" CornerRadius="8" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Foreground="#FF9B59B6" Symbol="Image24" Margin="0,0,8,0"/>
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Фоновые изображения"/>
                        <TextBlock x:Name="BgStatusText" Foreground="{DynamicResource DescriptionText}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Text=""/>
                    </StackPanel>

                    <!-- Сетка фонов в ScrollViewer -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="BackgroundsGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid x:Name="BgUniformGrid" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="3"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Cursor="Hand">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Удалить фон" Tag="{Binding FileId}"
                                                          Click="DeleteBackground_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <!-- Квадрат через ViewBox трюк -->
                                        <Viewbox Stretch="UniformToFill">
                                            <Image
                                                Width="120" Height="120"
                                                Source="{Binding PreviewSource}"
                                                Stretch="UniformToFill"/>
                                        </Viewbox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Кнопка добавить -->
                    <Button
                        x:Name="AddBackgroundBtn"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="AddBackground_Click"
                        Style="{DynamicResource DefaultButtonStyle}"
                        Content="＋  Добавить фон" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
