<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.AboutServerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">

            <!-- Заголовок -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="{DynamicResource L_Settings_AboutServer_Title}" />

            <!-- Блок: информация о сервере -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,8,0,4" Text="{DynamicResource L_Settings_AboutServer_InfoHeader}" />

            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Symbol="Server24"
                            FontSize="32"
                            Foreground="{DynamicResource TitleText}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="ServerNameText"
                                FontSize="16" FontWeight="SemiBold"
                                Foreground="{DynamicResource TitleText}"
                                Text="..." />
                            <TextBlock
                                x:Name="ServerAddressText"
                                FontSize="12"
                                Foreground="{DynamicResource DescriptionText}"
                                Margin="0,3,0,0"
                                Text="..." />
                            <TextBlock
                                x:Name="ServerDescriptionText"
                                FontSize="12"
                                Foreground="{DynamicResource DescriptionText}"
                                Margin="0,4,0,0"
                                TextWrapping="Wrap"
                                Visibility="Collapsed"
                                Text="" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Блок: соединение -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,12,0,4" Text="{DynamicResource L_Settings_AboutServer_ConnectionHeader}" />

            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <StackPanel>
                    <Button
                        x:Name="PingButton"
                        Content="{DynamicResource L_Settings_AboutServer_PingButton}"
                        HorizontalAlignment="Stretch"
                        Click="PingButton_Click"
                        Style="{DynamicResource DefaultButtonStyle}" />

                    <TextBlock
                        x:Name="PingStatusText"
                        FontSize="12"
                        Foreground="{DynamicResource DescriptionText}"
                        Margin="0,10,0,0"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Блок: микросервисы -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,12,0,4" Text="{DynamicResource L_Settings_AboutServer_ServicesHeader}" />

            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <ItemsControl
                    x:Name="ServicesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Width="8" Height="8"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Fill="{Binding StatusColor}" />
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="18,0,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TitleText}"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="{DynamicResource DescriptionText}"
                                    VerticalAlignment="Center"
                                    Margin="8,0"
                                    Text="{Binding Endpoint}" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding StatusColor}"
                                    Text="{Binding StatusLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
