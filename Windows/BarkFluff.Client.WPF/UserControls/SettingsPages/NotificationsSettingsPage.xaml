<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.NotificationsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">
            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="{DynamicResource L_Settings_Notifications_Title}" />

            <!-- Описание -->
            <TextBlock
                Margin="0,8,0,12"
                Foreground="{DynamicResource DescriptionText}"
                FontSize="12"
                TextWrapping="Wrap"
                Text="{DynamicResource L_Settings_Notifications_Description}" />

            <!-- Звук уведомлений -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="#FF57BB62"
                        Symbol="Speaker224" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Notifications_Sound_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,2,0,0" Text="{DynamicResource L_Settings_Notifications_Sound_Description}" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="SoundToggle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Checked="SoundToggle_Changed"
                        Unchecked="SoundToggle_Changed" />
                </Grid>
            </Border>

            <!-- Режимы уведомлений -->
            <StackPanel x:Name="NotificationModePanel" Margin="0,4,0,0">

                <!-- Отключены -->
                <Border
                    x:Name="ModeDisabled"
                    Padding="16"
                    Background="{DynamicResource TextBackground}"
                    CornerRadius="8"
                    Margin="0,4"
                    Cursor="Hand"
                    MouseLeftButtonUp="Mode_Click"
                    Tag="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DescriptionText}"
                            Symbol="AlertOff24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Notifications_Mode_Disabled_Title}" />
                            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,2,0,0" Text="{DynamicResource L_Settings_Notifications_Mode_Disabled_Description}" />
                        </StackPanel>
                        <Ellipse
                            x:Name="RadioDisabled"
                            Grid.Column="2"
                            Width="20" Height="20"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource DescriptionText}"
                            StrokeThickness="2"
                            Fill="Transparent" />
                    </Grid>
                </Border>

                <!-- Скрыть всё -->
                <Border
                    x:Name="ModeHidden"
                    Padding="16"
                    Background="{DynamicResource TextBackground}"
                    CornerRadius="8"
                    Margin="0,4"
                    Cursor="Hand"
                    MouseLeftButtonUp="Mode_Click"
                    Tag="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DescriptionText}"
                            Symbol="EyeOff24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Notifications_Mode_HiddenContent_Title}" />
                            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,2,0,0" Text="{DynamicResource L_Settings_Notifications_Mode_HiddenContent_Description}" />
                        </StackPanel>
                        <Ellipse
                            x:Name="RadioHidden"
                            Grid.Column="2"
                            Width="20" Height="20"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource DescriptionText}"
                            StrokeThickness="2"
                            Fill="Transparent" />
                    </Grid>
                </Border>

                <!-- Только отправитель -->
                <Border
                    x:Name="ModeSenderOnly"
                    Padding="16"
                    Background="{DynamicResource TextBackground}"
                    CornerRadius="8"
                    Margin="0,4"
                    Cursor="Hand"
                    MouseLeftButtonUp="Mode_Click"
                    Tag="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DescriptionText}"
                            Symbol="Person24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Notifications_Mode_SenderOnly_Title}" />
                            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,2,0,0" Text="{DynamicResource L_Settings_Notifications_Mode_SenderOnly_Description}" />
                        </StackPanel>
                        <Ellipse
                            x:Name="RadioSenderOnly"
                            Grid.Column="2"
                            Width="20" Height="20"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource DescriptionText}"
                            StrokeThickness="2"
                            Fill="Transparent" />
                    </Grid>
                </Border>

                <!-- Текст без превью -->
                <Border
                    x:Name="ModeFullText"
                    Padding="16"
                    Background="{DynamicResource TextBackground}"
                    CornerRadius="8"
                    Margin="0,4"
                    Cursor="Hand"
                    MouseLeftButtonUp="Mode_Click"
                    Tag="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DescriptionText}"
                            Symbol="TextDescription24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Notifications_Mode_FullTextNoPreview_Title}" />
                            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,2,0,0" Text="{DynamicResource L_Settings_Notifications_Mode_FullTextNoPreview_Description}" />
                        </StackPanel>
                        <Ellipse
                            x:Name="RadioFullText"
                            Grid.Column="2"
                            Width="20" Height="20"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource DescriptionText}"
                            StrokeThickness="2"
                            Fill="Transparent" />
                    </Grid>
                </Border>

                <!-- Полностью с превью -->
                <Border
                    x:Name="ModeFullPreview"
                    Padding="16"
                    Background="{DynamicResource TextBackground}"
                    CornerRadius="8"
                    Margin="0,4"
                    Cursor="Hand"
                    MouseLeftButtonUp="Mode_Click"
                    Tag="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DescriptionText}"
                            Symbol="Image24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Notifications_Mode_FullWithPreview_Title}" />
                            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,2,0,0" Text="{DynamicResource L_Settings_Notifications_Mode_FullWithPreview_Description}" />
                        </StackPanel>
                        <Ellipse
                            x:Name="RadioFullPreview"
                            Grid.Column="2"
                            Width="20" Height="20"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource DescriptionText}"
                            StrokeThickness="2"
                            Fill="Transparent" />
                    </Grid>
                </Border>

            </StackPanel>
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
