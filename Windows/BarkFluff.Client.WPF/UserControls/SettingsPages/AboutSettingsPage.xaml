<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="720"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">

            <!-- Заголовок -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="О приложении" />

            <!-- Блок: приложение -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,8,0,4" Text="ПРИЛОЖЕНИЕ" />

            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Symbol="AppGeneric24"
                        FontSize="32"
                        Foreground="{DynamicResource TitleText}"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16" FontWeight="SemiBold"
                            Foreground="{DynamicResource TitleText}"
                            Text="BarkFluff Desktop" />
                        <TextBlock
                            x:Name="AppVersionText"
                            FontSize="12"
                            Foreground="{DynamicResource DescriptionText}"
                            Margin="0,3,0,0"
                            Text="Версия: ..." />
                        <TextBlock
                            x:Name="DotnetVersionText"
                            FontSize="12"
                            Foreground="{DynamicResource DescriptionText}"
                            Margin="0,2,0,0"
                            Text=".NET: ..." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Блок: система -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,12,0,4" Text="СИСТЕМА" />

            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <StackPanel>
                    <!-- ОС -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="Операционная система" />
                            <TextBlock x:Name="OsVersionText" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..." />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Center" Foreground="#FF79AEDC" Symbol="Desktop24" />
                    </Grid>
                    <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" Margin="0,0,0,10" />
                    <!-- Процессор -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="Процессор" />
                            <TextBlock x:Name="CpuText" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" TextWrapping="Wrap" Text="..." />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Center" Foreground="#FFCA6D34" Symbol="Connected16" />
                    </Grid>
                    <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" Margin="0,0,0,10" />
                    <!-- RAM -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="Оперативная память" />
                            <TextBlock x:Name="RamText" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..." />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Center" Foreground="#FF57BB62" Symbol="Memory16" />
                    </Grid>
                    <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" Margin="0,0,0,10" />
                    <!-- Архитектура -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="Архитектура" />
                            <TextBlock x:Name="ArchText" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..." />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Center" Foreground="#FF9B59B6" Symbol="DesktopPulse20" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Блок: подключение к серверу -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,12,0,4" Text="ПОДКЛЮЧЕНИЕ" />

            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <StackPanel>
                    <!-- Адрес сервера -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="Сервер" />
                            <TextBlock x:Name="ServerAddressText" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..." />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource DescriptionText}" Symbol="Server24" />
                    </Grid>

                    <!-- Кнопка пинга -->
                    <Button
                        x:Name="PingButton"
                        Content="Проверить соединение"
                        HorizontalAlignment="Stretch"
                        Click="PingButton_Click"
                        Style="{DynamicResource DefaultButtonStyle}" />

                    <!-- Результат пинга -->
                    <TextBlock
                        x:Name="PingStatusText"
                        FontSize="12"
                        Foreground="{DynamicResource DescriptionText}"
                        Margin="0,10,0,0"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!-- Список микросервисов -->
                    <ItemsControl
                        x:Name="ServicesList"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Цветной индикатор статуса -->
                                    <Ellipse
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Width="8" Height="8"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Fill="{Binding StatusColor}" />
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="18,0,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TitleText}"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="{DynamicResource DescriptionText}"
                                        VerticalAlignment="Center"
                                        Margin="8,0"
                                        Text="{Binding Endpoint}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding StatusColor}"
                                        Text="{Binding StatusLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
