<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.SessionsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">
            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="{DynamicResource L_Settings_Sessions_Title}" />

            <!-- Текущее устройство -->
            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,4,0,8" Text="{DynamicResource L_Settings_Sessions_CurrentDevice}" />
            <Border
                x:Name="CurrentDeviceBorder"
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Foreground="#FF156ADC"
                        Symbol="Desktop24"
                        Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            x:Name="CurrentDeviceName"
                            Foreground="{DynamicResource TitleText}"
                            FontSize="14"
                            FontWeight="Medium"
                            Text="{DynamicResource L_Common_Loading}" />
                        <TextBlock
                            x:Name="CurrentDeviceInfo"
                            Foreground="{DynamicResource DescriptionText}"
                            FontSize="12"
                            Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Активные сессии -->
            <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,0,0,8" Text="{DynamicResource L_Settings_Sessions_OtherSessions}" />
            <StackPanel x:Name="SessionsList" />

            <!-- Кнопки -->
            <ui:Button
                x:Name="TerminateAllButton"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Click="TerminateAll_Click"
                Cursor="Hand"
                Background="#df5000"
                Foreground="White"
                Content="{DynamicResource L_Settings_Sessions_TerminateAll}"
                Visibility="Collapsed" />

            <!-- Статус -->
            <TextBlock
                x:Name="StatusText"
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="{DynamicResource DescriptionText}" />
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
