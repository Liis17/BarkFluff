<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.SettingsMenuDeviceBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Height="70"
    HorizontalAlignment="Stretch"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Grid>
                <ui:SymbolIcon
                    x:Name="BlurredIcon"
                    Foreground="{Binding IconColor, ElementName=Root}"
                    Style="{StaticResource SettingsSymbolIcon}"
                    Symbol="{Binding IconSymbol, ElementName=Root}">
                    <ui:SymbolIcon.Effect>
                        <BlurEffect
                            x:Name="BlurEffectElement"
                            Radius="0"
                            RenderingBias="Performance" />
                    </ui:SymbolIcon.Effect>
                </ui:SymbolIcon>
                <ui:SymbolIcon
                    Foreground="{Binding IconColor, ElementName=Root}"
                    Style="{StaticResource SettingsSymbolIcon}"
                    Symbol="{Binding IconSymbol, ElementName=Root}" />
            </Grid>

            <TextBlock Style="{StaticResource SettingsMenuBlockText}" Text="{Binding Text, ElementName=Root}" />
        </StackPanel>
        <Grid
            Margin="0,0,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    Style="{StaticResource DynamicTextSecondary}"
                    Text="Текущее устройство" />
                <TextBlock
                    x:Name="CurrentDevice"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SettingsMenuBlockText}"
                    Text="" />
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
