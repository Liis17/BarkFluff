<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.CacheSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource SettingsContentBackground}">
        <StackPanel Margin="24,16,24,24">
            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="Кеш" />

            <!-- Размер кеша -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Размер кеша" />
                        <TextBlock
                            x:Name="CacheSizeText"
                            Foreground="{DynamicResource DescriptionText}"
                            FontSize="12"
                            Margin="0,4,0,0"
                            Text="Подсчёт..." />
                    </StackPanel>
                    <ui:SymbolIcon
                        Grid.Column="1"
                        Foreground="#FF68A540"
                        Symbol="DatabaseStack16" />
                </Grid>
            </Border>

            <!-- Очистка -->
            <ui:Button
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Click="ClearCache_Click"
                Cursor="Hand"
                Background="#df5000"
                Foreground="White"
                Content="Очистить кеш" />

            <!-- Статус -->
            <TextBlock
                x:Name="StatusText"
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="{DynamicResource DescriptionText}" />
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
