<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.CacheSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">

            <!-- Заголовок -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="{DynamicResource L_Settings_Cache_Title}" />

            <!-- Статус -->
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,4,0,8"
                Text="{DynamicResource L_Settings_Cache_Counting}" />

            <!-- Прогресс-бар общего использования диска -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FF68A540" Symbol="DatabaseStack16" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Cache_DiskUsage_Title}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TotalUsageText"
                        Foreground="{DynamicResource DescriptionText}"
                        FontSize="12"
                        Margin="0,0,0,8"
                        Text="..." />
                    <controls:MultiSegmentProgressUserControl
                        x:Name="DiskProgress"
                        EmptyBrush="{DynamicResource ButtonBackground}" />
                    <!-- Легенда -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.85">
                        <Ellipse Width="8" Height="8" Fill="#FF3D86C6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource DescriptionText}" Text="{DynamicResource L_Settings_Cache_Legend_App}" Margin="0,0,12,0"/>
                        <Ellipse Width="8" Height="8" Fill="#FF68A540" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource DescriptionText}" Text="{DynamicResource L_Settings_Cache_Legend_FileCache}" Margin="0,0,12,0"/>
                        <Ellipse Width="8" Height="8" Fill="#FFCA6D34" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource DescriptionText}" Text="{DynamicResource L_Settings_Cache_Legend_Database}" Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Заголовок секции типов кеша -->
            <TextBlock
                FontSize="11" FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,12,0,4"
                Text="{DynamicResource L_Settings_Cache_ByTypes_Header}" />

            <!-- 2-столбиковая сетка типов кеша -->
            <UniformGrid Columns="2">

                <!-- Аватары -->
                <Border x:Name="AvatarBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="0,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Avatars}"/>
                            <TextBlock x:Name="AvatarSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="AvatarMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Avatar" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- Изображения -->
                <Border x:Name="ImageBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="4,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Images}"/>
                            <TextBlock x:Name="ImageSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="ImageMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Image" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- Видео -->
                <Border x:Name="VideoBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="0,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Videos}"/>
                            <TextBlock x:Name="VideoSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="VideoMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Video" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- GIF -->
                <Border x:Name="GifBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="4,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Gif}"/>
                            <TextBlock x:Name="GifSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="GifMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Gif" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- Документы -->
                <Border x:Name="DocBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="0,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Documents}"/>
                            <TextBlock x:Name="DocSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="DocMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Document" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- Аудио -->
                <Border x:Name="AudioBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="4,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Audio}"/>
                            <TextBlock x:Name="AudioSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="AudioMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Audio" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- Сообщения (БД) -->
                <Border x:Name="MsgBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="0,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Messages}"/>
                            <TextBlock x:Name="MsgSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="MsgMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Messages" Click="MenuButton_Click" />
                    </Grid>
                </Border>

                <!-- Чаты (БД) -->
                <Border x:Name="ChatBlock" Padding="14" Background="{DynamicResource TextBackground}"
                        CornerRadius="8" Margin="4,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Cache_Type_Chats}"/>
                            <TextBlock x:Name="ChatSize" FontSize="12" Foreground="{DynamicResource DescriptionText}" Margin="0,3,0,0" Text="..."/>
                        </StackPanel>
                        <Button x:Name="ChatMenu" Grid.Column="1" VerticalAlignment="Top"
                                Style="{DynamicResource TransparentButtonStyle}"
                                Content="···" FontSize="16" Foreground="{DynamicResource DescriptionText}"
                                Tag="Chats" Click="MenuButton_Click" />
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Кнопка полной очистки -->
            <Button
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                Click="ClearAll_Click"
                Background="#df5000"
                Foreground="White"
                Content="{DynamicResource L_Settings_Cache_ClearAll}"
                Style="{DynamicResource DefaultButtonStyle}" />

        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
