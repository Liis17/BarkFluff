<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.PrivacySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Height="550"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="#1f1f1f">
        <StackPanel Margin="20">
            <!-- Кнопка "Назад" -->
            <Button
                HorizontalAlignment="Left"
                Click="GoBack_Click"
                Cursor="Hand"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        Foreground="#E0E0E0"
                        Symbol="ArrowLeft24" />
                    <TextBlock Foreground="#E0E0E0" Text="Назад" />
                </StackPanel>
            </Button>

            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="Конфиденциальность" />

            <!-- Настройки конфиденциальности -->
            <StackPanel Margin="0,10,0,0">
                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Кто видит профиль" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Все пользователи" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF3FA29F"
                            Symbol="Person24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Последний онлайн" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Все пользователи" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF3FA29F"
                            Symbol="Clock24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Фотографии профиля" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Все пользователи" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF3FA29F"
                            Symbol="Image24" />
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="#2D2D2D"
                    CornerRadius="8"
                    Margin="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#E0E0E0" FontSize="14" FontWeight="Medium" Text="Пересылка" />
                            <TextBlock Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0" Text="Пересылка сообщений" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            Foreground="#FF3FA29F"
                            Symbol="ArrowForward24" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
