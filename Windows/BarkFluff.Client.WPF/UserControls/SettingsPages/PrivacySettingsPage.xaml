<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.PrivacySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">
            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="{DynamicResource L_Settings_Privacy_Title}" />

            <!-- Загрузка / ошибка -->
            <TextBlock
                x:Name="StatusText"
                Foreground="{DynamicResource DescriptionText}"
                FontSize="12"
                Margin="0,4,0,8"
                Text="{DynamicResource L_Settings_Privacy_LoadingSettings}" />

            <!-- Группа: Профиль -->
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,8,0,4"
                Text="{DynamicResource L_Settings_Privacy_Group_Profile}" />

            <!-- Публичная страница на сайте -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Privacy_PublicPage_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource L_Settings_Privacy_PublicPage_Description}" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="ProfileVisibleSwitch"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="ProfileVisibleSwitch_Changed"
                        Unchecked="ProfileVisibleSwitch_Changed" />
                </Grid>
            </Border>

            <!-- Видимость в поиске -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Privacy_SearchVisible_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource L_Settings_Privacy_SearchVisible_Description}" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="SearchVisibleSwitch"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="SearchVisibleSwitch_Changed"
                        Unchecked="SearchVisibleSwitch_Changed" />
                </Grid>
            </Border>

            <!-- Группа: Кто видит -->
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource DescriptionText}"
                Margin="2,12,0,4"
                Text="{DynamicResource L_Settings_Privacy_Group_WhoSees}" />

            <!-- Онлайн-статус -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Privacy_Online_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource L_Settings_Privacy_Online_Description}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="OnlineVisibilityCombo"
                        Grid.Column="1"
                        Width="130"
                        VerticalAlignment="Center"
                        SelectionChanged="OnlineVisibilityCombo_SelectionChanged">
                        <ComboBoxItem Tag="0" Content="{DynamicResource L_Settings_Privacy_Visibility_All}" />
                        <ComboBoxItem Tag="1" Content="{DynamicResource L_Settings_Privacy_Visibility_Friends}" />
                        <ComboBoxItem Tag="2" Content="{DynamicResource L_Settings_Privacy_Visibility_Nobody}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Аватар -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Privacy_Avatar_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource L_Settings_Privacy_Avatar_Description}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="AvatarVisibilityCombo"
                        Grid.Column="1"
                        Width="130"
                        VerticalAlignment="Center"
                        SelectionChanged="AvatarVisibilityCombo_SelectionChanged">
                        <ComboBoxItem Tag="0" Content="{DynamicResource L_Settings_Privacy_Visibility_All}" />
                        <ComboBoxItem Tag="1" Content="{DynamicResource L_Settings_Privacy_Visibility_Friends}" />
                        <ComboBoxItem Tag="2" Content="{DynamicResource L_Settings_Privacy_Visibility_Nobody}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Описание профиля (Био) -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Privacy_Bio_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource L_Settings_Privacy_Bio_Description}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="BioVisibilityCombo"
                        Grid.Column="1"
                        Width="130"
                        VerticalAlignment="Center"
                        SelectionChanged="BioVisibilityCombo_SelectionChanged">
                        <ComboBoxItem Tag="0" Content="{DynamicResource L_Settings_Privacy_Visibility_All}" />
                        <ComboBoxItem Tag="1" Content="{DynamicResource L_Settings_Privacy_Visibility_Friends}" />
                        <ComboBoxItem Tag="2" Content="{DynamicResource L_Settings_Privacy_Visibility_Nobody}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Почта -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Privacy_Email_Title}" />
                        <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource L_Settings_Privacy_Email_Description}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="EmailVisibilityCombo"
                        Grid.Column="1"
                        Width="130"
                        VerticalAlignment="Center"
                        SelectionChanged="EmailVisibilityCombo_SelectionChanged">
                        <ComboBoxItem Tag="0" Content="{DynamicResource L_Settings_Privacy_Visibility_All}" />
                        <ComboBoxItem Tag="1" Content="{DynamicResource L_Settings_Privacy_Visibility_Friends}" />
                        <ComboBoxItem Tag="2" Content="{DynamicResource L_Settings_Privacy_Visibility_Nobody}" />
                    </ComboBox>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
