<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.SecuritySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="650"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel Margin="24,16,24,24">
            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="{DynamicResource L_Settings_Security_Title}" />

            <!-- Смена пароля -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FFC58C39" Symbol="LockClosed32" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Security_Password_Title}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="PasswordStepText"
                        Foreground="{DynamicResource DescriptionText}"
                        FontSize="12"
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Text="{DynamicResource L_Settings_Security_Password_Step1_Hint}" />

                    <!-- Шаг 1: Запрос кода -->
                    <StackPanel x:Name="PasswordStep1" Visibility="Visible">
                        <ui:Button
                            Click="RequestPasswordReset_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="{DynamicResource L_Settings_Security_Password_SendCode}" />
                    </StackPanel>

                    <!-- Шаг 2: Ввод кода -->
                    <StackPanel x:Name="PasswordStep2" Visibility="Collapsed">
                        <ui:TextBox
                            x:Name="ResetCodeBox"
                            Margin="0,4"
                            FontSize="14"
                            MaxLength="6"
                            PlaceholderText="{DynamicResource L_Settings_Security_Password_CodePlaceholder}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Click="ConfirmResetCode_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="{DynamicResource L_Settings_Security_Password_ConfirmCode}" />
                    </StackPanel>

                    <!-- Шаг 3: Новый пароль -->
                    <StackPanel x:Name="PasswordStep3" Visibility="Collapsed">
                        <PasswordBox
                            x:Name="NewPasswordBox"
                            Margin="0,4"
                            Padding="8"
                            FontSize="14" />
                        <PasswordBox
                            x:Name="ConfirmPasswordBox"
                            Margin="0,4"
                            Padding="8"
                            FontSize="14" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Click="SetNewPassword_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="{DynamicResource L_Settings_Security_Password_SaveNew}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2FA -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FFC58C39" Symbol="Shield24" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Security_TwoFa_Title}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TwoFaStatusText"
                        Foreground="{DynamicResource DescriptionText}"
                        FontSize="12"
                        Text="{DynamicResource L_Settings_Security_TwoFa_DefaultHint}" />
                    <Image
                        x:Name="QrImage"
                        Width="200"
                        Height="200"
                        Margin="0,8"
                        Visibility="Collapsed" />
                    <ui:TextBox
                        x:Name="OtpCodeBox"
                        Margin="0,4"
                        FontSize="14"
                        PlaceholderText="{DynamicResource L_Settings_Security_TwoFa_OtpPlaceholder}"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button
                            x:Name="SetupTwoFaButton"
                            Click="SetupTwoFa_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="{DynamicResource L_Settings_Security_TwoFa_Setup}" />
                        <ui:Button
                            x:Name="ConfirmTwoFaButton"
                            Margin="8,0,0,0"
                            Click="ConfirmTwoFa_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="{DynamicResource L_Settings_Security_TwoFa_Confirm}"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="DisableTwoFaButton"
                            Margin="8,0,0,0"
                            Click="DisableTwoFa_Click"
                            Cursor="Hand"
                            Background="#df5000"
                            Foreground="White"
                            Content="{DynamicResource L_Settings_Security_TwoFa_Disable}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PIN-код -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FFC58C39" Symbol="Calculator24" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="{DynamicResource L_Settings_Security_Pin_Title}" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Text="{DynamicResource L_Settings_Security_Pin_Description}" />
                    <PasswordBox
                        x:Name="PinBox"
                        Margin="0,8,0,0"
                        Padding="8"
                        MaxLength="6"
                        FontSize="14" />
                    <ui:Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Click="SavePin_Click"
                        Cursor="Hand"
                        Style="{DynamicResource Win11Default}"
                        Content="{DynamicResource L_Settings_Security_Pin_Save}" />
                </StackPanel>
            </Border>

            <!-- Статус -->
            <TextBlock
                x:Name="StatusText"
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="{DynamicResource DescriptionText}" />
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
