<local:BaseSettingsPage
    x:Class="BarkFluff.Client.WPF.UserControls.SettingsPages.SecuritySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource SettingsContentBackground}">
        <StackPanel Margin="24,16,24,24">
            <!-- Заголовок страницы -->
            <TextBlock Style="{DynamicResource HeaderSettings}" Text="Защита" />

            <!-- Смена пароля -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FFC58C39" Symbol="LockClosed32" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Смена пароля" />
                    </StackPanel>
                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Margin="0,4"
                        Padding="8"
                        FontSize="14" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Margin="0,4"
                        Padding="8"
                        FontSize="14" />
                    <ui:Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Click="ChangePassword_Click"
                        Cursor="Hand"
                        Style="{DynamicResource Win11Default}"
                        Content="Изменить пароль" />
                </StackPanel>
            </Border>

            <!-- 2FA -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FFC58C39" Symbol="Shield24" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Двухфакторная аутентификация" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TwoFaStatusText"
                        Foreground="{DynamicResource DescriptionText}"
                        FontSize="12"
                        Text="Нажмите для настройки 2FA" />
                    <Image
                        x:Name="QrImage"
                        Width="200"
                        Height="200"
                        Margin="0,8"
                        Visibility="Collapsed" />
                    <ui:TextBox
                        x:Name="OtpCodeBox"
                        Margin="0,4"
                        FontSize="14"
                        PlaceholderText="Введите код из приложения"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button
                            x:Name="SetupTwoFaButton"
                            Click="SetupTwoFa_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="Настроить" />
                        <ui:Button
                            x:Name="ConfirmTwoFaButton"
                            Margin="8,0,0,0"
                            Click="ConfirmTwoFa_Click"
                            Cursor="Hand"
                            Style="{DynamicResource Win11Default}"
                            Content="Подтвердить"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PIN-код -->
            <Border
                Padding="16"
                Background="{DynamicResource TextBackground}"
                CornerRadius="8"
                Margin="0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="#FFC58C39" Symbol="Calculator24" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Medium" Text="Код доступа (PIN)" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource DescriptionText}" FontSize="12" Text="PIN-код для быстрого входа в приложение" />
                    <PasswordBox
                        x:Name="PinBox"
                        Margin="0,8,0,0"
                        Padding="8"
                        MaxLength="6"
                        FontSize="14" />
                    <ui:Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Click="SavePin_Click"
                        Cursor="Hand"
                        Style="{DynamicResource Win11Default}"
                        Content="Сохранить PIN" />
                </StackPanel>
            </Border>

            <!-- Статус -->
            <TextBlock
                x:Name="StatusText"
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="{DynamicResource DescriptionText}" />
        </StackPanel>
    </Grid>
</local:BaseSettingsPage>
