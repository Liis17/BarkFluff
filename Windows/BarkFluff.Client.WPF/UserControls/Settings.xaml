<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="700"
    Height="600"
    d:DesignHeight="700"
    d:DesignWidth="720"
    mc:Ignorable="d">
    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource SettingsContentBackground}"
        ClipToBounds="True"
        CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SettingsSidebarBackground}"
                CornerRadius="12,0,0,12">
                <DockPanel Margin="0,12,0,12">
                    <!-- Profile header -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:CachedAvatar
                                x:Name="SidebarAvatar"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                EnableDynamicShadow="False" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="SidebarDisplayName"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TitleText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="" />
                                <TextBlock
                                    x:Name="SidebarUsername"
                                    FontSize="12"
                                    Foreground="{DynamicResource DescriptionText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="" />
                            </StackPanel>
                        </Grid>
                        <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" />
                    </StackPanel>

                    <!-- Version at bottom -->
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        Margin="16,0,0,4"
                        FontSize="11"
                        Foreground="{DynamicResource DescriptionText}"
                        Text="BarkFluff Desktop" />

                    <!-- Navigation items -->
                    <ListBox
                        x:Name="NavListBox"
                        Style="{DynamicResource SettingsSidebarListBox}"
                        SelectionChanged="NavListBox_SelectionChanged">
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Profile">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Person24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Profile}" />
                            </StackPanel>
                        </ListBoxItem>
                        <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" />
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="General">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Settings24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_General}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Notifications">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Alert28" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Notifications}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Language">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Globe24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Language}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Security">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="LockClosed32" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Security}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Privacy">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="ShieldLock28" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Privacy}" />
                            </StackPanel>
                        </ListBoxItem>
                        <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" />
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Personalization">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="PaintBrush24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Personalization}" />
                            </StackPanel>
                        </ListBoxItem>
                        <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" />
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Cloud">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Cloud24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Cloud}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Cache">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="DatabaseStack16" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Cache}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="Sessions">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="PhoneDesktop28" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_Sessions}" />
                            </StackPanel>
                        </ListBoxItem>
                        <Separator Style="{DynamicResource SettingsSidebarSeparator}" IsHitTestVisible="False" Focusable="False" />
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="AboutApp">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Info24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_AboutApp}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{DynamicResource SettingsSidebarItem}" Tag="AboutServer">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource TitleText}" Symbol="Server24" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource TitleText}" Text="{DynamicResource L_Settings_Sidebar_AboutServer}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Content area -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource SettingsContentBackground}"
                ClipToBounds="True"
                CornerRadius="0,12,12,0">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ContentControl
                        x:Name="PageContentControl"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
