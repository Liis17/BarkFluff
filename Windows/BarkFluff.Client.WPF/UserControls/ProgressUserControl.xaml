<UserControl
    x:Class="BarkFluff.Client.WPF.UserControls.ProgressUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BarkFluff.Client.WPF.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <DockPanel Height="10" LastChildFill="True">
        <Border
            x:Name="ProgressBorder"
            Width="300"
            HorizontalAlignment="Left"
            Background="{Binding ProgressBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CornerRadius="5" />

        <Border
            x:Name="EmptyBorder"
            Width="100"
            HorizontalAlignment="Right"
            Background="{Binding EmptyBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CornerRadius="5" />
    </DockPanel>
</UserControl>
