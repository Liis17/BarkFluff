<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Профиль пользователя с Material 3 дизайном -->
    <LinearLayout
        android:id="@+id/drawerProfileSection"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="?attr/colorPrimary"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Аватар: FrameLayout для наложения с увеличенным радиусом -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <!-- Аватар картинка -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/drawerAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="?attr/colorOnPrimary"
                    app:strokeWidth="2dp" />

                <!-- Плейсхолдер с инициалами -->
                <TextView
                    android:id="@+id/drawerAvatarPlaceholder"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </FrameLayout>

            <!-- Имя и юзернейм -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drawerFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Пользователь"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnPrimary" />

                <TextView
                    android:id="@+id/drawerUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.85"
                    android:text="\@username"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Меню с Navigation Rail стилем -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- Секция: Основное -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Основное"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- Избранное -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuFavorites"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Избранное"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_favorite"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorPrimary" />

            <!-- Архив -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuArchive"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Архив"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_history"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Контакты -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuContacts"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Контакты"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Звонки -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuCalls"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Звонки"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Разделитель -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp" />

            <!-- Секция: Сообщества -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:text="Сообщества"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- Создать группу -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuCreateGroup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Создать группу"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_grid"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Создать канал -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuCreateChannel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Создать канал"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Разделитель -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp" />

            <!-- Секция: Настройки -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:text="Настройки"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- Настройки -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Настройки"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Помощь -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuHelp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="16dp"
                android:text="Помощь"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:icon="@drawable/ic_help"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Версия приложения -->
    <TextView
        android:id="@+id/drawerAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="16dp"
        android:text="BarkFluff v1.0"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
