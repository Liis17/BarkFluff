<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.barkfluff.android.ui.welcome.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">

        <action
            android:id="@+id/action_welcome_to_serverSelection"
            app:destination="@id/serverSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/serverSelectionFragment"
        android:name="com.barkfluff.android.ui.serverselection.ServerSelectionFragment"
        android:label="@string/server_selection_title"
        tools:layout="@layout/fragment_server_selection">

        <action
            android:id="@+id/action_serverSelection_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.barkfluff.android.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_chatList"
            app:destination="@id/chatListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_login_to_serverSelection"
            app:destination="@id/serverSelectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatListFragment"
        android:name="com.barkfluff.android.ui.chatlist.ChatListFragment"
        android:label="@string/chats_title"
        tools:layout="@layout/fragment_chat_list" />

</navigation>
